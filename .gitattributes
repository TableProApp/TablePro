# Auto detect text files and perform LF normalization
* text=auto
# Swift files
*.swift text diff=swift
# Xcode project files
*.storyboard binary
*.xib binary
*.xcassets binary
*.xcdatamodeld binary
# Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
# Audio
*.mp3 binary
*.wav binary
*.aiff binary
*.m4a binary
# Video
*.mp4 binary
*.mov binary
# Archives
*.zip binary
*.tar.gz binary
# Markdown - force LF
*.md text eol=lf
# Shell scripts - force LF
*.sh text eol=lf
# Swift source - force LF
*.swift text eol=lf
# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf

# Vendored C headers (database driver bridges, SQLite, tree-sitter grammars)
Plugins/*/C*/include/** linguist-vendored
Packages/TableProCore/Sources/CSQLite/include/sqlite3*.h linguist-vendored
TablePro/Core/SSH/CLibSSH2/** linguist-vendored
Packages/TableProGrammars/Sources/TreeSitterGrammars/** linguist-vendored

# Third-party license texts, copied verbatim
Native/DamengBridge/LICENSES/** linguist-vendored
Packages/TableProEditor/LICENSE-*.md linguist-vendored
TablePro/Resources/ThirdPartyLicenses/texts/** linguist-vendored
# Joins the SQLite copyright page and the source blessing with a sentence of its own.
TablePro/Resources/ThirdPartyLicenses/texts/sqlite.txt -linguist-vendored

# Generated Linux files (Cargo, xgettext, cargo-about, license_metadata.py)
linux/Cargo.lock linguist-generated
linux/po/tablepro.pot linguist-generated
linux/data/licenses/** linguist-generated
linux/build-aux/debian/copyright linguist-generated
