# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## Generated Xcode projects
#
# Both projects are generated from their project.yml by scripts/generate-project.sh.
# Package.resolved is not generated: it pins every Swift package revision for CI, so
# it stays tracked inside the otherwise-ignored project bundles.
/TablePro.xcodeproj/
!/TablePro.xcodeproj/project.xcworkspace/
!/TablePro.xcodeproj/project.xcworkspace/xcshareddata/
!/TablePro.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!/TablePro.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/TableProMobile/TableProMobile.xcodeproj/
!/TableProMobile/TableProMobile.xcodeproj/project.xcworkspace/
!/TableProMobile/TableProMobile.xcodeproj/project.xcworkspace/xcshareddata/
!/TableProMobile/TableProMobile.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!/TableProMobile/TableProMobile.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

## User settings
xcuserdata/

