#include "Base.xcconfig"

DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
GCC_DYNAMIC_NO_PIC = NO
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone

// The app's entitlements. scripts/build-local.sh overrides this with
// TablePro/TablePro.Local.entitlements to sign a fork's build ad-hoc; because only the app target
// reads it, the path cannot reach a Swift package target, which would resolve it against its own
// checkout and fail with "Build input file cannot be found".
TABLEPRO_ENTITLEMENTS = TablePro/TablePro.Debug.entitlements
