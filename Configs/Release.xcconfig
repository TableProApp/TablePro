#include "Base.xcconfig"

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
MTL_ENABLE_DEBUG_INFO = NO
SWIFT_COMPILATION_MODE = wholemodule

// Here rather than on the xcodebuild command line, where an override reaches every target in the
// graph, SPM packages included. LLVM_LTO is the Clang knob: it reaches the C bridge modules, not
// Swift, which has its own SWIFT_LTO and leaves it off.
GCC_OPTIMIZATION_LEVEL = s
SWIFT_OPTIMIZATION_LEVEL = -O
LLVM_LTO = YES_THIN
