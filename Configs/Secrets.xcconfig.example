// Copy to Configs/Secrets.xcconfig and fill in. Configs/Secrets.xcconfig is gitignored,
// so nothing here ever reaches a commit. Every value is optional: Configs/Base.xcconfig
// includes this file with #include?, so the build works without it.

// Signs analytics payloads. Leave empty for local development.
ANALYTICS_HMAC_SECRET =

// Your Apple Developer team, for building under your own signing identity.
TABLEPRO_DEVELOPMENT_TEAM = YOUR_TEAM_ID

// The macOS app's bundle identifier. Change it when building under a personal team,
// because com.TablePro is tied to the official team's provisioning profile.
TABLEPRO_APP_BUNDLE_IDENTIFIER = com.yourhandle.TablePro
