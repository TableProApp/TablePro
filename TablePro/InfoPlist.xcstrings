    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro reads database settings from the project folder you choose."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro는 선택한 프로젝트 폴더에서 데이터베이스 설정을 읽습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro, seçtiğiniz proje klasöründen veritabanı ayarlarını okur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro đọc cài đặt cơ sở dữ liệu từ thư mục dự án bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 会从你选择的项目文件夹中读取数据库设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 會從你選擇的專案資料夾中讀取資料庫設定。"
          }
        }
      }
    },
