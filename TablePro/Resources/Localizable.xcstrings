        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng này không có trigger. Trigger tự động chạy khi các dòng được chèn, cập nhật hoặc xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
