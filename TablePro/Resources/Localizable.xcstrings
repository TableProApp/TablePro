            "value" : "Truy vấn này có thể sửa đổi hoặc xóa dữ liệu vĩnh viễn và không thể hoàn tác.\n\n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此查询可能永久修改或删除数据，且无法撤销。\n\n%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此查詢可能會永久修改或刪除資料，且無法復原。\n\n%@"
          }
        }
      }
    },
