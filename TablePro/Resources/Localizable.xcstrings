        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿼리 완료를 기다리는 최대 시간입니다. 제한하지 않으려면 0으로 설정하십시오. 새 연결에 적용됩니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps maximum d'attente pour que une requête soit terminée. Définie à 0 pour aucune limite. Appliquée aux nouvelles connexions."
          }
        }
      }
