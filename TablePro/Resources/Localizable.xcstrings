          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro ne reçoit aucun financement et ne vend aucun donnée. Si vous voulez faire plus, le parrainage va au même endroit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 不接受投资，也不出售数据。如果你想多做一点，赞助也流向同一个地方。"
