            "state" : "translated",
            "value" : "cancel arrête la requête, kill met fin à la session (cancel par défaut)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cancel은 쿼리를 중지하고 kill은 세션을 종료합니다(기본값 cancel)"
          }
        },
        "tr" : {
          "stringUnit" : {
