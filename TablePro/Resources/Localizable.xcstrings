          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未安裝 %@ 外掛。是否要從外掛市集下載？"
          }
        }
      }
    },
    "The %@ plugin is not installed. You can download it from the plugin marketplace." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin %@ n'est pas installé. Vous pouvez le télécharger depuis le marché des plugins."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 플러그인이 설치되어 있지 않습니다. 플러그인 마켓플레이스에서 다운로드할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
