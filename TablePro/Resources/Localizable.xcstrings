          }
        }
      }
    },
    "This license has reached its activation limit. Deactivate another Mac first." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette licence a atteint sa limite d’activations. Désactivez d’abord un autre Mac."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 라이선스는 활성화 한도에 도달했습니다. 먼저 다른 Mac에서 비활성화하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu lisans etkinleştirme sınırına ulaştı. Önce başka bir Mac'i devre dışı bırakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấy phép này đã đạt giới hạn kích hoạt. Hãy huỷ kích hoạt một máy Mac khác trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此许可证已达到激活上限。请先停用另一台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授權已達啟用上限。請先停用另一台 Mac。"
          }
        }
      }
    },
    "This license has reached its activation limit. Remove a Mac from your account, then activate again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette licence a atteint sa limite d’activations. Retirez un Mac de votre compte, puis activez-la de nouveau."
          }
        }
      }
    },
    "This license was activated on a different Mac. Activate it here to use paid features." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
