        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作將從這台機器移除授權。你可以稍後重新啟用。"
          }
        }
      }
    },
    "This will reset all settings across every section to their default values." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
