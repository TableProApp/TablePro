    "Every query you run is saved. Choose View > Show Query History to search them and load one back into the editor." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque requête exécutée est enregistrée. Choisissez Présentation > Afficher l’historique des requêtes pour les rechercher et en recharger une dans l’éditeur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행한 모든 쿼리는 저장됩니다. 보기 > 쿼리 기록 보기를 선택하여 검색하고 편집기로 다시 불러오세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştırdığınız her sorgu kaydedilir. Aramak ve birini düzenleyiciye geri yüklemek için Görünüm > Sorgu Geçmişini Göster öğesini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi truy vấn bạn chạy đều được lưu. Chọn Xem > Hiện lịch sử truy vấn để tìm và nạp lại một truy vấn vào trình soạn thảo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你运行的每条查询都会被保存。选择“显示 > 显示查询历史”搜索它们，并将其中一条载回编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你執行的每個查詢都會儲存。選擇「顯示方式 > 顯示查詢記錄」搜尋它們，並將其中一個載回編輯器。"
          }
        }
      }
    },
    "Every query you run is saved. Press %@ to search them and load one back into the editor." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque requête exécutée est enregistrée. Appuyez sur %@ pour les rechercher et en recharger une dans l’éditeur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행한 모든 쿼리는 저장됩니다. %@을(를) 눌러 검색하고 편집기로 다시 불러오세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştırdığınız her sorgu kaydedilir. Aramak ve birini düzenleyiciye geri yüklemek için %@ tuşlarına basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi truy vấn bạn chạy đều được lưu. Nhấn %@ để tìm và nạp lại một truy vấn vào trình soạn thảo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你运行的每条查询都会被保存。按 %@ 搜索它们，并将其中一条载回编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你執行的每個查詢都會儲存。按 %@ 搜尋它們，並將其中一個載回編輯器。"
          }
        }
      }
    },
    "Every result set a script returned, in order, when it returned more than one" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jeu de résultats renvoyé par un script, dans l’ordre, lorsqu’il en a renvoyé plusieurs"
          }
        }
      }
    },
    "Every row already in %@ is removed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les lignes déjà présentes dans %@ sont supprimées."
          }
        }
      }
    },
    "Every row and column" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les lignes et colonnes"
          }
        }
      }
    },
    "Every row in each destination table is deleted first. This cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les lignes de chaque table de destination sont d’abord supprimées. Cette opération est irréversible."
          }
        }
      }
    },
    "Every row must be an array with one value per column." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne doit être un tableau contenant une valeur par colonne."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 행은 열마다 값 하나를 가진 배열이어야 합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satır, sütun başına bir değer içeren bir dizi olmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi dòng phải là một mảng có một giá trị cho mỗi cột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一行都必须是数组，每列对应一个值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一列都必須是陣列，每個欄位對應一個值。"
          }
        }
      }
    },
    "Every saved connection this client may use, with its live session state" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque connexion enregistrée que ce client peut utiliser, avec l’état actuel de sa session"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 클라이언트가 사용할 수 있는 저장된 모든 연결과 실시간 세션 상태"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu istemcinin kullanabileceği kayıtlı tüm bağlantılar ve canlı oturum durumları"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi kết nối đã lưu mà client này được dùng, kèm trạng thái phiên hiện thời"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此客户端可以使用的所有已保存连接，及其实时会话状态"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此用戶端可以使用的所有已儲存連線，及其即時工作階段狀態"
          }
        }
      }
    },
    "Every shared column is generated, so there is nothing to write." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les colonnes partagées sont générées : il n’y a donc rien à écrire."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유하는 모든 열이 생성 열이므로 기록할 내용이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılan her sütun üretilmiş sütundur, bu yüzden yazılacak bir şey yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi cột chung đều là cột được sinh ra, nên không có gì để ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有共有的列都是生成列，因此没有需要写入的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有共有的欄位都是產生欄位，因此沒有需要寫入的內容。"
          }
        }
      }
    },
    "Every table needs at least one column. Click + to get started" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque table doit avoir au moins une colonne. Cliquez sur + pour commencer"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 테이블에는 열이 하나 이상 있어야 합니다. +를 클릭하여 시작하십시오"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her tablonun en az bir sütuna ihtiyacı vardır. Başlamak için + tıklayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
