    },
    "“%1$@” exited with status %2$d on the server: %3$@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» s’est terminé avec le statut %2$d sur le serveur : %3$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 “%1$@”이(가) 상태 %2$d(으)로 종료되었습니다: %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” sunucuda %2$d durumuyla sonlandı: %3$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” kết thúc với mã trạng thái %2$d trên máy chủ: %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” 在服务器上以状态 %2$d 退出：%3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” 在伺服器上以狀態 %2$d 結束：%3$@"
          }
        }
      }
    },
    "“%1$@” is encoded as %2$@, which can't represent some of the text in its tab. The file was not changed. Use Save As to save the text as UTF-8." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est encodé en %2$@, ce qui ne peut pas représenter une partie du texte dans son onglet. Le fichier n’a pas été modifié. Utilisez Enregistrer sous pour enregistrer le texte en UTF-8."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”은(는) %2$@(으)로 인코딩되어 있어 탭의 일부 텍스트를 나타낼 수 없습니다. 파일은 변경되지 않았습니다. 텍스트를 UTF-8로 저장하려면 다른 이름으로 저장을 사용하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” %2$@ ile kodlanmış ve bu kodlama sekmedeki metnin bir kısmını gösteremiyor. Dosya değiştirilmedi. Metni UTF-8 olarak kaydetmek için Farklı Kaydet'i kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” được mã hoá bằng %2$@, không thể biểu diễn một phần văn bản trong tab. Tệp không bị thay đổi. Dùng Lưu thành để lưu văn bản dưới dạng UTF-8."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”的编码为 %2$@，无法表示标签页中的部分文本。文件未被更改。请使用“存储为”将文本存储为 UTF-8。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」的編碼為 %2$@，無法表示標籤頁中的部分文字。檔案未被更改。請使用「儲存為」將文字儲存為 UTF-8。"
          }
        }
      }
    },
