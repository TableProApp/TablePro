          "stringUnit" : {
            "state" : "translated",
            "value" : "이 저장은 복원할 수 없음"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Kayıt Geri Yüklenemez"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khôi phục lần lưu này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
