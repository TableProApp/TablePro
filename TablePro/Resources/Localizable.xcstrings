        }
      }
    },
    "This engine has no conflict handling for INSERT, so the rows are written as plain inserts." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce moteur ne gère pas les conflits pour INSERT : les lignes sont donc écrites comme de simples insertions."
          }
        }
      }
    },
    "This engine has no SQL dialect, so it cannot produce SQL output." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce moteur n’a pas de dialecte SQL et ne peut donc pas produire de sortie SQL."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
