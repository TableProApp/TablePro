    "Both sides are one connection, so the server copies the rows itself. There is no row-by-row progress, and Stop cannot interrupt it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux côtés utilisent la même connexion ; le serveur copie donc lui-même les lignes. Il n’y a pas de progression ligne par ligne et Arrêter ne peut pas l’interrompre."
          }
        }
      }
    },
    "BQL queries do not support SQL parameters" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes BQL ne prennent pas en charge les paramètres SQL"
          }
        }
      }
    },
    "BQL queries need rledger. Install rustledger so rledger is on PATH or Homebrew, or set TABLEPRO_RUSTLEDGER_BINARY to its path." : {
