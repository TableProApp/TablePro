        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진이 내보낼 결과 집합을 반환하지 않았습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor dışa aktarılacak bir sonuç kümesi döndürmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engine không trả về tập kết quả nào để xuất."
