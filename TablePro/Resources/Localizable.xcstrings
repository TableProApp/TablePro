          }
        }
      }
    },
    "Maximum rows to return. Defaults to the server's configured row limit." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal de lignes à renvoyer. Par défaut, la limite de lignes configurée sur le serveur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반환할 최대 행 수입니다. 기본값은 서버에 설정된 행 제한입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
