    "%1$@ %2$@ is dropped and recreated, so anything depending on it fails until it exists again." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ bị xóa rồi tạo lại, nên mọi thứ phụ thuộc vào nó sẽ lỗi cho đến khi nó tồn tại trở lại."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@을(를) 삭제한 뒤 다시 만들기 때문에, 이에 의존하는 항목은 다시 만들어질 때까지 실패합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 会被删除后重新创建，因此依赖它的对象在它重新存在之前都会失败。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ silinip yeniden oluşturulur, bu yüzden ona bağlı olan her şey yeniden var olana kadar başarısız olur."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 會先刪除再重新建立，因此依賴它的項目在重新存在之前都會失敗。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ est supprimé et recréé, donc tout ce qui dépend de lui échoue jusqu'à ce qu'il existe à nouveau."
          }
        }
      }
    },
