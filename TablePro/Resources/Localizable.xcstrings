      }
    },
    "Watched folders are scanned for .tablepro files. Connections appear read only in the sidebar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers surveillés sont scannés à la recherche de fichiers .tablepro. Les connexions apparaissent comme lues-seules dans la barre latérale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감시 중인 폴더에서 .tablepro 파일을 검색합니다. 연결은 사이드바에 읽기 전용으로 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlenen klasörler .tablepro dosyaları için taranır. Bağlantılar Sidebar'da salt okunur olarak görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thư mục theo dõi được quét để tìm file .tablepro. Kết nối hiển thị chỉ đọc trong thanh bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会扫描受监视文件夹中的 .tablepro 文件。这些连接在侧边栏中以只读方式显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受監視的資料夾會被掃描以尋找 .tablepro 檔案。這些連線會在側邊欄中以唯讀方式顯示。"
          }
        }
      }
    },
