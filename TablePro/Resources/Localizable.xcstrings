          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式中缺少內建的範例資料庫。"
          }
        }
      }
    },
    "The catalog location is not a folder: %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카탈로그 위치가 폴더가 아닙니다: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
