        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định tắt. Bật lên để mã hóa các mật khẩu đã lưu bằng một cụm mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
