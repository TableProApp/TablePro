    "Only %1$d of %2$d bytes of %3$@ arrived." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls %1$d octets sur %2$d de %3$@ sont arrivés."
