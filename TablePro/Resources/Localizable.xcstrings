          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎沒有 SQL 方言，因此無法產生 SQL 輸出。"
          }
        }
      }
    },
    "This engine has no SQL dialect, so tables cannot be selected generically." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce moteur n’a pas de dialecte SQL : les tables ne peuvent donc pas être sélectionnées de façon générique."
          }
