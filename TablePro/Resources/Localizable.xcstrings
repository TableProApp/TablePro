    "Optional. A key from the Cursor dashboard is used instead of signing in." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Une clé du tableau de bord du curseur est utilisée au lieu de se connecter."
          }
        },
        "ko" : {
          "stringUnit" : {
