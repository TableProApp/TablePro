        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấy phép này đã được kích hoạt trên một máy Mac khác. Kích hoạt tại đây để dùng các tính năng trả phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
