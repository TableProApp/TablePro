    "Cassandra %@ is not supported. TablePro requires Cassandra 3.0 or later (the system_schema keyspace was introduced in 3.0)." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cassandra %@ n’est pas pris en charge. TablePro nécessite Cassandra 3.0 ou version ultérieure (le keyspace system_schema a été introduit dans la version 3.0)."
          }
        }
      }
    },
    "Cassandra cannot change the primary key column %@. Delete the row and add it again with the new key." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cassandra ne peut pas modifier la colonne de clé primaire %@. Supprimez la ligne et ajoutez-la à nouveau avec la nouvelle clé."
          }
        }
      }
    },
    "Cassandra cannot filter rows with %@." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cassandra ne peut pas filtrer les lignes avec %@."
          }
        }
      }
    },
    "Cassandra columns have no comment." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les colonnes Cassandra n’ont pas de commentaire."
          }
        }
      }
    },
    "Cassandra columns have no default value." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les colonnes Cassandra n’ont pas de valeur par défaut."
          }
        }
      }
    },
    "Cassandra filters can only require every condition to match." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres Cassandra peuvent uniquement exiger que toutes les conditions soient remplies."
          }
        }
      }
    },
    "Cassandra has no NOT NULL constraint." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cassandra n’a pas de contrainte NOT NULL."
          }
        }
      }
    },
    "Cassandra orders rows only by clustering columns within one partition, so a table cannot be sorted by a column." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cassandra ne trie les lignes que par colonnes de clustering au sein d’une même partition ; une table ne peut donc pas être triée par une colonne."
          }
        }
      }
    },
