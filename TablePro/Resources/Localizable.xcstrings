        }
      }
    },
    "The statements may or may not be saved. Check the table before running them again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclarations peuvent être sauvegardées ou non. Vérifiez la table avant de les exécuter à nouveau."
          }
