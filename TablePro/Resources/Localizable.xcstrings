    "Encoded as %@. Saving keeps this encoding, and a character it can't represent stops the save." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encodé en %@. Le sauvegarde conserve cette encodage, et un caractère qu'il ne peut pas représenter arrête le sauvegarde."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 인코딩됨. 저장해도 이 인코딩이 유지되며, 표현할 수 없는 문자가 있으면 저장이 중단됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile kodlanmış. Kaydetme bu kodlamayı korur; gösterilemeyen bir karakter kaydetmeyi durdurur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã hoá %@. Khi lưu, mã hoá này được giữ nguyên, và ký tự không biểu diễn được sẽ khiến việc lưu dừng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编码为 %@。存储时保留此编码，遇到无法表示的字符时会停止存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編碼為 %@。儲存時保留此編碼，遇到無法表示的字元時會停止儲存。"
          }
        }
      }
    },
