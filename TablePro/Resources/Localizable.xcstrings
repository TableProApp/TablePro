    "The filter on %@ is not one expression. Remove the semicolon." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtre sur %@ n'est pas une seule expression. Supprimez le point-virgule."
          }
        }
      }
    },
    "The first call asks. The answer is remembered for that client until you revoke it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première appel demande. La réponse est mémorisée pour ce client jusqu'à ce que vous la révoquez."
          }
        }
      }
    },
    "The folder \"%@\" will be deleted. Items inside will be moved to the parent level." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier \"%@\" sera supprimé. Les éléments à l'intérieur seront déplacés au niveau parent."
