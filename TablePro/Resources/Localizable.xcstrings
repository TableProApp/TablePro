    "TablePro takes no funding, sells no data, and has no investors to answer to. Licenses are the whole business model." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro không nhận vốn đầu tư, không bán dữ liệu, và không có nhà đầu tư nào để phải báo cáo. Giấy phép là toàn bộ mô hình kinh doanh."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro yatırım almaz, veri satmaz ve hesap vereceği yatırımcısı yoktur. İş modelinin tamamı lisanslardır."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro는 투자를 받지 않고, 데이터를 팔지 않으며, 답해야 할 투자자도 없습니다. 라이선스가 사업 모델의 전부입니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 不接受投資，不出售資料，也沒有需要交代的投資人。授權就是全部的商業模式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 不接受投资，不出售数据，也没有需要交代的投资人。许可证就是全部的商业模式。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro ne reçoit aucun financement, ne vend aucun donnée et n'a pas d'investisseurs à répondre. Les licences sont l'ensemble du modèle économique."
          }
        }
      }
    },
