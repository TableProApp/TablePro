    "Allowing a statement applies to this run only. It is never saved." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation d’une instruction ne s’applique qu’à cette exécution. Elle n’est jamais enregistrée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구문 허용은 이번 실행에만 적용되며 저장되지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ifadeye izin vermek yalnızca bu çalıştırma için geçerlidir. Asla kaydedilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc cho phép một câu lệnh chỉ áp dụng cho lần chạy này. Nó không bao giờ được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许某条语句仅对本次运行有效，永远不会被保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許某條陳述式僅對本次執行有效，永遠不會被儲存。"
          }
        }
