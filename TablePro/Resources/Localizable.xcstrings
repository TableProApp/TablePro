    "The %@ request must be a JSON object" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête %@ doit être un objet JSON"
          }
        }
      }
    },
    "The %1$@ plugin could not be installed: %2$@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’installer le plugin %1$@ : %2$@"
          }
        }
      }
    },
    "The %1$@ request is not valid JSON: %2$@" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête %1$@ n’est pas un JSON valide : %2$@"
          }
        }
      }
    },
    "The %1$@ sorted rows differently than the comparison expects, near key %2$@. Pick a numeric key, or one that sorts by byte value." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La %1$@ a trié les lignes différemment de ce qu’attend la comparaison, près de la clé %2$@. Choisissez une clé numérique, ou une clé triée par valeur d’octet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 키 %2$@ 부근에서 비교가 예상한 것과 다른 순서로 행을 정렬했습니다. 숫자 키나 바이트 값으로 정렬되는 키를 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, satırları karşılaştırmanın beklediğinden farklı sıraladı, %2$@ anahtarının yakınında. Sayısal bir anahtar ya da bayt değerine göre sıralanan bir anahtar seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã sắp xếp các dòng khác với những gì so sánh mong đợi, gần khóa %2$@. Hãy chọn khóa dạng số, hoặc khóa sắp xếp theo giá trị byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 对行的排序与比较预期不同，出现在键 %2$@ 附近。请选择数值型键，或按字节值排序的键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 對列的排序與比較預期不同，出現在鍵 %2$@ 附近。請選擇數值型鍵，或按位元組值排序的鍵。"
          }
        }
      }
    },
    "The %d batches before it stay applied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %d lots précédents restent appliqués."
          }
        }
      }
    },
    "The %d statements before it stay applied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %d instructions précédentes restent appliquées."
          }
        }
      }
    },
    "The Access application policy must use a Service Auth rule, or Cloudflare still prompts for browser sign-in." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La politique de l’application Access doit utiliser une règle Service Auth, sinon Cloudflare demande toujours une connexion dans le navigateur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access 애플리케이션 정책에서 Service Auth 규칙을 사용해야 합니다. 그렇지 않으면 Cloudflare가 계속 브라우저 로그인을 요청합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access uygulama politikası bir Service Auth kuralı kullanmalıdır; aksi halde Cloudflare yine tarayıcıdan giriş ister."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chính sách ứng dụng Access phải dùng quy tắc Service Auth, nếu không Cloudflare vẫn yêu cầu đăng nhập qua trình duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access 应用策略必须使用 Service Auth 规则，否则 Cloudflare 仍会要求浏览器登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access 應用程式原則必須使用 Service Auth 規則，否則 Cloudflare 仍會要求透過瀏覽器登入。"
          }
        }
      }
    },
