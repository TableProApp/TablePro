        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此連線每次連線時都會用你的憑證執行 SQL。"
          }
        }
      }
    },
    "This connection switched database with USE, which reconnecting would undo." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion a changé de base de données avec USE, ce que la reconnexion annulerait."
          }
        }
      }
    },
    "This connection uses a credential profile that isn't on this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion utilise un profil d’identifiants absent de ce Mac."
          }
        }
      }
    },
    "This connection was deleted on another device or window. Your changes were not saved." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion a été supprimée sur un autre appareil ou dans une autre fenêtre. Vos modifications n’ont pas été enregistrées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결이 다른 기기 또는 창에서 삭제되었습니다. 변경 사항은 저장되지 않았습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
