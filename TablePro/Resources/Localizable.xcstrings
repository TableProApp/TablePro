    "The source and the destination are the same database." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la destination sont la même base de données."
          }
        }
      }
    },
    "The source and the target are the same database." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la cible sont la même base de données."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본과 대상이 같은 데이터베이스입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynak ve hedef aynı veritabanı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguồn và đích là cùng một cơ sở dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
