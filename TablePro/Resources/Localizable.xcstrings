            "value" : "某張資料表的 CREATE 陳述式，按引擎回報的原樣。"
          }
        }
      }
    },
    "The Cursor CLI is not installed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le CLI Cursor n'est pas installé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
