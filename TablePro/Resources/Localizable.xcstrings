            "value" : "La structure des tables utilisées par cette requête est lu lorsque la demande est envoyée."
          }
        }
      }
    },
    "The table %@ was already created with different columns. Choose another name." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La table %@ a déjà été créée avec des colonnes différentes. Choisissez un autre nom."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테이블 %@은(는) 다른 열 구성으로 이미 생성되어 있습니다. 다른 이름을 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tablosu farklı sütunlarla zaten oluşturulmuş. Başka bir ad seçin."
          }
