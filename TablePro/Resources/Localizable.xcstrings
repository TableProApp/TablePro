    "'%@' cannot be changed from the grid." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas être modifié depuis la grille."
          }
        }
      }
    },
    "'%@' cannot be saved from the grid. SurrealDB ignores it on a relation, so delete the relation and RELATE it again. Otherwise, UPDATE it in the editor." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas être enregistré depuis la grille. SurrealDB l’ignore sur une relation, supprimez donc la relation et exécutez de nouveau RELATE. Sinon, utilisez UPDATE dans l’éditeur."
          }
        }
      }
    },
    "'%@' has no primary key, so identical rows cannot be told apart. Add a primary key, or edit the rows with a query." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas de clé primaire, les lignes identiques ne peuvent donc pas être distinguées. Ajoutez une clé primaire ou modifiez les lignes avec une requête."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'에 기본 키가 없어 동일한 행을 구분할 수 없습니다. 기본 키를 추가하거나 쿼리로 행을 편집하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' birincil anahtara sahip değil, bu yüzden aynı satırlar birbirinden ayırt edilemiyor. Bir birincil anahtar ekleyin veya satırları bir sorguyla düzenleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' không có khoá chính nên không thể phân biệt các dòng giống nhau. Hãy thêm khoá chính, hoặc sửa các dòng bằng truy vấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 没有主键，因此无法区分完全相同的行。请添加主键，或用查询编辑这些行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 沒有主鍵，因此無法區分完全相同的列。請新增主鍵，或用查詢編輯這些列。"
          }
        }
      }
    },
    "'%@' has no primary key, so the row is found by matching every column. Another client may have changed it, or a value in it cannot be compared. Your edit is still here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas de clé primaire, la ligne est donc retrouvée en comparant chaque colonne. Un autre client l’a peut-être modifiée, ou l’une de ses valeurs ne peut pas être comparée. Votre modification est conservée."
          }
        }
      }
    },
    "'%@' is a field of a nested array. Edit the array in '%@' instead." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est un champ d’un tableau imbriqué. Modifiez plutôt le tableau dans « %@ »."
          }
        }
      }
    },
    "'%@' is document metadata and cannot be edited." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » fait partie des métadonnées du document et ne peut pas être modifié."
          }
        }
      }
    },
    "'%@' is not a process id on this engine. Take one from get_server_dashboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un identifiant de processus sur ce moteur. Utilisez-en un fourni par get_server_dashboard."
          }
        }
      }
    },
    "'%@' is not a valid regular expression." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas une expression régulière valide."
          }
        }
      }
    },
    "'%@' is set by etcd and cannot be edited." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est défini par etcd et ne peut pas être modifié."
          }
        }
      }
    },
    "'since' must not be later than 'until'." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« since » ne doit pas être postérieur à « until »."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since'는 'until'보다 늦을 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since', 'until' değerinden sonra olamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since' không được muộn hơn 'until'."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since' 不能晚于 'until'。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since' 不能晚於 'until'。"
          }
        }
      }
    },
    "\"%@\"" : {
      "localizations" : {
