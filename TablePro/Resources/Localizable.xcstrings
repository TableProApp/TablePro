    "A command named \"/%@\" already exists." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"/%@\" 명령이 이미 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"/%@\" adında bir komut zaten var."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lệnh có tên \"/%@\" đã tồn tại."
          }
        },
