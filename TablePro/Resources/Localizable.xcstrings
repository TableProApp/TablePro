    "%@ does not support reading rows in key order, which data compare needs." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không hỗ trợ đọc dòng theo thứ tự khóa, điều mà so sánh dữ liệu cần."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不支援依鍵順序讀取列，而資料比較需要這項功能。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不支持按键顺序读取行，而数据比较需要这一点。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 데이터 비교에 필요한 키 순서 행 읽기를 지원하지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne prend pas en charge la lecture des lignes dans l'ordre clé, ce qui est nécessaire pour les comparaisons de données."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, veri karşılaştırmasının gerektirdiği anahtar sırasına göre satır okumayı desteklemiyor."
          }
