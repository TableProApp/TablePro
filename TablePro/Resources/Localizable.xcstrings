    "Edit: read-only tools plus running queries. Destructive DDL stays blocked." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Édition : outils en lecture seule et exécution de requêtes. Le DDL destructeur reste bloqué."
