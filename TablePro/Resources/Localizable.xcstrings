            "value" : "尚未安裝 %@ 命令列工具。"
          }
        }
      }
    },
    "The %@ line in ~/.ssh/config does not accept the token %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ line in ~/.ssh/config does not accept the token %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne %1$@ dans ~/.ssh/config n'accepte pas le jeton %2$@."
          }
        }
      }
    },
    "The %@ line in ~/.ssh/config ends in a lone %%. Write %%%% for a literal percent sign." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne %@ dans ~/.ssh/config se termine par un %. Écrivez %%%% pour un signe de pourcentage littéral."
          }
        }
      }
    },
    "The %@ line in ~/.ssh/config has a ${ with no closing brace." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne %@ dans ~/.ssh/config a un ${ sans parenthèses de fermeture."
          }
        }
      }
    },
    "The %@ line in ~/.ssh/config uses ${%@}, which is not set in the environment." : {
      "localizations" : {
