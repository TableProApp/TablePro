    "Table name '%@' may only contain letters, digits, underscore, and '.'." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom de table « %@ » ne peut contenir que des lettres, des chiffres, le trait de soulignement et « . »."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테이블 이름 '%@'에는 문자, 숫자, 밑줄, '.'만 사용할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' tablo adı yalnızca harf, rakam, alt çizgi ve '.' içerebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên bảng '%@' chỉ được chứa chữ cái, chữ số, dấu gạch dưới và '.'."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表名 '%@' 只能包含字母、数字、下划线和 '.'。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料表名稱 '%@' 只能包含字母、數字、底線和 '.'。"
          }
        }
      }
    },
