          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿼리에 NUL 문자(U+0000)가 있어 실행하지 않았습니다. 제거한 후 다시 시도하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
