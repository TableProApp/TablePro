    "TablePro takes no funding and sells no data. If you want to do more, sponsorship goes to the same place." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro không nhận vốn đầu tư và không bán dữ liệu. Nếu bạn muốn góp thêm, tài trợ cũng đi về cùng một nơi."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
