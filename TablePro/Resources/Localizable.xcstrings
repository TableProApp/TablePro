        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些變更會撤銷 %@ 的所有權限，也就是此連線使用的帳號。"
          }
        }
      }
    },
    "These connections open their tunnel by running a command on this Mac, every time they connect:\n\n%@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces connexions ouvrent leur tunnel en exécutant une commande sur ce Mac, chaque fois qu'elles se connectent :\n\n%@"
          }
        }
      }
    },
    "These rows came from another database than the one this tab is now using." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lignes proviennent d'une autre base de données que celle que cette onglet utilise actuellement."
          }
