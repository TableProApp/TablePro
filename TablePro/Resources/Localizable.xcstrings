    "Saved queries are limited to %@ so they fit in iCloud. Save a query this large as a .sql file instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes enregistrées sont limitées à %@ pour tenir dans iCloud. Enregistrez plutôt une requête de cette taille dans un fichier .sql."
