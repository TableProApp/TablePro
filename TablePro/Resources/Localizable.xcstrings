    "These changes alter %@, the account this connection uses." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces changements modifient %@, le compte utilisé par cette connexion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 변경 사항은 이 연결에서 사용하는 계정 %@을(를) 변경합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değişiklikler, bu bağlantının kullandığı hesap olan %@ hesabını değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi này sửa %@, tài khoản mà kết nối này đang dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些更改会修改 %@，也就是此连接使用的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些變更會修改 %@，也就是此連線使用的帳號。"
          }
        }
      }
    },
    "These changes drop %@, the account this connection uses." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces changements suppriment %@, le compte utilisé par cette connexion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 변경 사항은 이 연결에서 사용하는 계정 %@을(를) 삭제합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değişiklikler, bu bağlantının kullandığı hesap olan %@ hesabını siler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi này xoá %@, tài khoản mà kết nối này đang dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些更改会删除 %@，也就是此连接使用的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些變更會刪除 %@，也就是此連線使用的帳號。"
          }
        }
      }
    },
    "These changes revoke every privilege from %@, the account this connection uses." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces changements révoquent tous les privilèges de %@, le compte utilisé par cette connexion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 변경 사항은 이 연결에서 사용하는 계정 %@의 모든 권한을 취소합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu değişiklikler, bu bağlantının kullandığı hesap olan %@ hesabından tüm yetkileri geri alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi này thu hồi mọi quyền của %@, tài khoản mà kết nối này đang dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些更改会撤销 %@ 的所有权限，也就是此连接使用的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些變更會撤銷 %@ 的所有權限，也就是此連線使用的帳號。"
          }
        }
      }
    },
    "These connections open their tunnel by running a command on this Mac, every time they connect:\n\n%@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces connexions ouvrent leur tunnel en exécutant une commande sur ce Mac, à chaque connexion :\n\n%@"
          }
        }
      }
    },
    "These databases have open transactions: %@. Closing rolls them back and discards their uncommitted changes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces bases de données ont des transactions ouvertes : %@. Les fermer annule ces transactions et abandonne leurs modifications non validées."
          }
        }
      }
    },
    "These databases have open transactions: %@. Disconnecting rolls them back and discards their uncommitted changes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces bases de données ont des transactions ouvertes : %@. La déconnexion annule ces transactions et abandonne leurs modifications non validées."
          }
        }
      }
    },
    "These messages use the %@ compression codec, which TablePro cannot read." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces messages utilisent le codec de compression %@, que TablePro ne peut pas lire."
          }
        }
      }
    },
    "These rows came from another database than the one this tab is now using." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lignes proviennent d’une autre base de données que celle qu’utilise maintenant cet onglet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 행들은 이 탭이 현재 사용 중인 데이터베이스가 아닌 다른 데이터베이스에서 왔습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu satırlar, bu sekmenin şu anda kullandığından başka bir veritabanından geldi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dòng này đến từ một cơ sở dữ liệu khác với cơ sở dữ liệu mà tab này đang dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些行来自与此标签页当前所用数据库不同的另一个数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些列來自與此標籤頁目前所用資料庫不同的另一個資料庫。"
          }
        }
      }
    },
    "These rows cannot be edited because TablePro cannot tell which table they came from." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lignes ne peuvent pas être modifiées, car TablePro ne peut pas déterminer de quelle table elles proviennent."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro가 이 행들이 어느 테이블에서 왔는지 알 수 없어 편집할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro bu satırların hangi tablodan geldiğini bilemediği için bu satırlar düzenlenemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể sửa các dòng này vì TablePro không xác định được chúng đến từ bảng nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法编辑这些行，因为 TablePro 无法判断它们来自哪张表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法編輯這些列，因為 TablePro 無法判斷它們來自哪張資料表。"
          }
        }
      }
    },
    "These rows come from a view, which cannot be edited." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lignes proviennent d’une vue, qui ne peut pas être modifiée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 행들은 편집할 수 없는 뷰에서 왔습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu satırlar düzenlenemeyen bir görünümden geliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dòng này đến từ một view, vốn không sửa được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
