      }
    },
    "This row has no value for this field." : {

    },
    "This row's _id is binary data whose subtype is not known, so TablePro cannot tell which document it names." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
