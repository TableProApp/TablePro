    "TablePro connects to the first broker over a tunnel. Partitions led by other brokers cannot be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro se connecte au premier broker via un tunnel. Les partitions dont le leader est un autre broker ne peuvent pas être lues."
          }
        }
      }
    },
    "TablePro connects to the first host over a tunnel. Replica set failover is not available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro se connecte au premier hôte via un tunnel. Le basculement du jeu de réplicas n’est pas disponible."
          }
        }
      }
    },
    "TablePro connects to the first host over a tunnel. The other hosts are not used." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro se connecte au premier hôte via un tunnel. Les autres hôtes ne sont pas utilisés."
          }
        }
      }
    },
    "TablePro connects to the first node over a tunnel, as a single server. Keys on other nodes cannot be reached." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro se connecte au premier nœud via un tunnel, comme à un serveur unique. Les clés situées sur les autres nœuds sont inaccessibles."
          }
        }
      }
    },
