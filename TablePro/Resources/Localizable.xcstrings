          }
        }
      }
    },
    "This connection loads SQLite extensions that have not been approved on this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion charge des extensions SQLite qui n'ont pas été approuvées sur ce Mac."
          }
        }
      }
    },
    "This connection loads SQLite extensions, and their functions can read and write files. A statement from outside TablePro can call only the functions built into SQLite. Run this one in TablePro instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion charge les extensions SQLite, et leurs fonctions peuvent lire et écrire des fichiers. Une instruction provenant de l'extérieur de TablePro ne peut appeler que les fonctions intégrées à SQLite. Exécutez-en une dans TablePro à la place."
          }
        }
      }
    },
    "This connection runs SQL every time it connects, using your credentials." : {
      "comment" : "A description of the startup SQL for a database connection.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion exécute SQL chaque fois qu'elle se connecte, en utilisant vos identifiants."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
