    "A %@ index has no equivalent on this engine." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un index %@ n'a pas d'équivalent sur ce moteur."
          }
        }
      }
    },
    "A built-in plugin \"%@\" already provides this bundle ID" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plugin intégré \"%@\" fournit déjà cet identifiant de paquets."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 제공 플러그인 \"%@\"에서 이미 이 번들 ID를 제공합니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A built-giriş plugin \"%@\" already provides this bundle ID"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin tích hợp \"%@\" đã cung cấp bundle ID này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置插件 \"%@\" 已提供此 bundle ID"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建外掛「%@」已提供此 bundle ID"
          }
        }
      }
    },
    "A Cloudflare tunnel already exists for connection: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tunnel Cloudflare existe déjà pour la connexion : %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연결에 대한 Cloudflare 터널이 이미 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantı için zaten bir Cloudflare tüneli var: %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có Cloudflare tunnel cho kết nối: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该连接已存在Cloudflare隧道：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個連線已存在 Cloudflare 隧道：%@"
          }
        }
      }
    },
    "A column left out of the comparison is still written on insert and update. A filter and a row limit read only the rows they select, on both sides." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une colonne omise dans la comparaison est toujours écrite sur insérer et mettre à jour. Un filtre et une limite de rang ne lisent que les rangs qu'ils sélectionnent, des deux côtés."
          }
        }
      }
    },
    "A column left out of the comparison is still written on insert and update. Changing either list needs another comparison." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une colonne manquante dans la comparaison est toujours écrite sur l'insérer et la mettre à jour. Le changement de l'une des listes nécessite une autre comparaison."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비교에서 제외한 열도 삽입과 업데이트에는 그대로 기록됩니다. 두 목록 중 하나를 바꾸면 다시 비교해야 합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karşılaştırmanın dışında bırakılan bir sütun, ekleme ve güncellemede yine de yazılır. Listelerden birini değiştirmek yeni bir karşılaştırma gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cột bị bỏ khỏi so sánh vẫn được ghi khi chèn và cập nhật. Thay đổi một trong hai danh sách cần so sánh lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被排除在比较之外的列，在插入和更新时仍会写入。更改任一列表都需要重新比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被排除在比較之外的欄位，在插入和更新時仍會寫入。變更任一清單都需要重新比較。"
          }
        }
      }
    },
    "A column was set to a default or a function, so its stored value is unknown." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une colonne a été définie sur une valeur par défaut ou une fonction, donc sa valeur stockée est inconnue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 열이 기본값이나 함수로 설정되어 저장된 값을 알 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sütun varsayılana veya bir fonksiyona ayarlandı, bu yüzden saklanan değeri bilinmiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cột được đặt thành giá trị mặc định hoặc một hàm, nên giá trị lưu trữ của nó không xác định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个列被设为默认值或函数，因此其存储的值未知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某個欄位被設為預設值或函式，因此其儲存的值未知。"
          }
        }
      }
    },
    "A command is required" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un commande est requis"
          }
        }
      }
    },
    "A command named \"/%@\" already exists." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un commande nommé \"/%@\" existe déjà."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"/%@\" 명령이 이미 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
