          }
        }
      }
    },
    "This document has no _id, so it cannot be edited here." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document n’a pas d’_id et ne peut donc pas être modifié ici."
          }
        }
      }
    },
    "This document holds a NaN. MongoDB treats every NaN as the same value, so a save could not tell whether someone else changed it." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document contient un NaN. MongoDB considère tous les NaN comme une même valeur : un enregistrement ne pourrait donc pas savoir si quelqu’un d’autre l’a modifié."
          }
        }
      }
    },
    "This document holds a value text cannot write back exactly, such as a subdocument like {\"$numberInt\": \"5\"}." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document contient une valeur que le texte ne peut pas restituer exactement, par exemple un sous-document comme {\"$numberInt\": \"5\"}."
          }
        }
      }
    },
    "This document holds a value that cannot be edited as text." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document contient une valeur qui ne peut pas être modifiée sous forme de texte."
          }
        }
      }
    },
    "This document holds JavaScript code with a scope. MongoDB compares a scope by value, so a save could not tell whether someone else changed it." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document contient du code JavaScript avec une portée. MongoDB compare une portée par valeur : un enregistrement ne pourrait donc pas savoir si quelqu’un d’autre l’a modifié."
          }
        }
      }
    },
    "This document is nested more than %d levels deep, which is too deep to edit here." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document comporte plus de %d niveaux d’imbrication, ce qui est trop profond pour le modifier ici."
