    "%@ accepted the SSH connection but refused the SFTP subsystem." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a accepté la connexion SSH mais a refusé le sous-système SFTP."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) SSH 연결은 수락했지만 SFTP 하위 시스템은 거부했습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ SSH bağlantısını kabul etti ancak SFTP alt sistemini reddetti."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã chấp nhận kết nối SSH nhưng từ chối hệ thống con SFTP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 接受了 SSH 连接，但拒绝了 SFTP 子系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 接受了 SSH 連線，但拒絕了 SFTP 子系統。"
          }
        }
      }
    },
    "%@ accepts null" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ accepte null"
          }
        }
      }
    },
    "%@ acts on the whole database. Omit 'table'." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agit sur toute la base de données. Omettez « table »."
          }
        }
      }
    },
    "%@ are invalid, so queries skip them and exports leave them out. Drop them, or rebuild them with REINDEX." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont invalides, donc les requêtes les ignorent et les exports ne les incluent pas. Supprimez-les ou reconstruisez-les avec REINDEX."
          }
        }
      }
    },
    "%@ cannot add or remove a table's constraints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ajouter ni supprimer les contraintes d’un tableau."
          }
        }
      }
    },
    "%@ cannot add or remove a table's foreign keys." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ajouter ni supprimer les clés étrangères d’une table."
          }
        }
      }
    },
    "%@ cannot add or remove a table's indexes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ajouter ni supprimer les index d’une table."
          }
        }
      }
    },
    "%@ cannot be compared, because its driver does not expose metadata." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être comparé, car son pilote n'expose pas de métadonnées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 드라이버가 메타데이터를 제공하지 않아 비교할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ karşılaştırılamaz, çünkü sürücüsü meta veri sunmuyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể so sánh %@ vì driver của nó không cung cấp metadata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法比较 %@，因为其驱动不提供元数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法比較 %@，因為其驅動程式不提供中繼資料。"
          }
        }
      }
    },
    "%@ cannot be empty" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être vide"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 필드는 비워 둘 수 없습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cannot be boş"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không được để trống"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能为空"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能為空白"
          }
        }
      }
    },
    "%@ cannot be narrowed to some rows or columns, because this database has no SQL." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être limité à certaines lignes ou colonnes, car cette base de données ne possède pas de SQL."
          }
        }
      }
    },
    "%@ cannot be negative" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être négatif"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 값은 음수일 수 없습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cannot be negatif"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không được là số âm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能为负数"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能為負數"
          }
        }
      }
    },
    "%@ cannot be scripted with its indexes, because the target's index statements would name a different schema than its definition." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être scripté avec ses index, car les instructions d’index de la cible nommeraient un schéma différent de sa définition."
          }
        }
      }
    },
    "%@ cannot be scripted, because its definition is not a statement that recreates it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être scripté, car sa définition n’est pas une instruction qui le recrée."
          }
        }
      }
    },
    "%@ cannot change the order of a table's columns." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas modifier l’ordre des colonnes d’un tableau."
          }
        }
      }
    },
    "%@ cannot compare two of its own databases at once, because it reads both through one connection. Use a second connection for the target." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas comparer deux de ses propres bases de données à la fois, car il les lit toutes les deux via une seule connexion. Utilisez une deuxième connexion pour la cible."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 하나의 연결로 양쪽을 읽기 때문에 자체 데이터베이스 두 개를 동시에 비교할 수 없습니다. 대상에는 다른 연결을 사용하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kendi iki veritabanını aynı anda karşılaştıramaz, çünkü ikisini de tek bağlantı üzerinden okur. Hedef için ikinci bir bağlantı kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thể so sánh hai cơ sở dữ liệu của chính nó cùng lúc, vì nó đọc cả hai qua một kết nối. Hãy dùng kết nối thứ hai cho đích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法同时比较自身的两个数据库，因为它通过一个连接读取两者。请为目标使用第二个连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法同時比較自身的兩個資料庫，因為它透過一個連線讀取兩者。請為目標使用第二個連線。"
          }
        }
      }
    },
    "%@ cannot create a database." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas créer de base de données."
          }
        }
      }
    },
    "%@ cannot edit a table's structure." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas modifier la structure d’un tableau."
          }
        }
      }
    },
    "%@ cannot have constraints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas avoir de contraintes."
          }
        }
      }
    },
    "%@ cannot have indexes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas avoir d’index."
          }
        }
      }
    },
    "%@ cannot make this change to a table's columns." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas apporter cette modification aux colonnes d’un tableau."
          }
        }
      }
    },
    "%@ cannot restore a deleted row with its original key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas restaurer une ligne supprimée avec sa clé originale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 삭제된 행을 원래 키로 복원할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, silinmiş bir satırı özgün anahtarıyla geri yükleyemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thể khôi phục dòng đã xoá với khoá gốc của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法用原来的键恢复已删除的行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法用原來的鍵還原已刪除的列。"
          }
        }
      }
    },
    "%@ cannot start with a dash or contain spaces" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas commencer par un tiret ou contenir des espaces."
          }
        }
      }
    },
    "%@ cannot take rows from this file, so no table was created." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas prendre de lignes de ce fichier, donc aucune table n'a été créée."
          }
        }
      }
    },
    "%@ cells" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cellules"
          }
        }
      }
    },
    "%@ changed after it was compared. Compare again before generating the script." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a changé après avoir été comparé. Comparez à nouveau avant de générer le script."
          }
        }
      }
    },
    "%@ completed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terminé"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 완료"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tamamlandı"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hoàn tất"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已完成"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已完成"
          }
        }
      }
    },
    "%@ connections open a server, not a database file, so there is nothing to fetch over SSH." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les connexions %@ ouvrent un serveur, pas un fichier de base de données, donc il n'y a rien à récupérer via SSH."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연결은 데이터베이스 파일이 아니라 서버를 여는 것이므로 SSH로 가져올 것이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantıları bir veritabanı dosyasını değil bir sunucuyu açar, bu yüzden SSH üzerinden alınacak bir şey yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối %@ mở một máy chủ chứ không phải tệp cơ sở dữ liệu, nên không có gì để tải qua SSH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 连接打开的是服务器而不是数据库文件，因此没有内容需要通过 SSH 获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 連線開啟的是伺服器而不是資料庫檔案，因此沒有內容需要透過 SSH 取得。"
          }
        }
      }
    },
