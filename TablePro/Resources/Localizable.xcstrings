        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Authentication, IP adresini değil sunucunun ana bilgisayar adını ister. Kerberos servis principal'ları IP adreslerine kayıtlı değildir."
