    "Making %@ NOT NULL fails if any existing row holds NULL." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendre %@ NOT NULL échoue si une ligne existante contient NULL."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 행에 NULL이 있으면 %@을(를) NOT NULL로 만드는 작업은 실패합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sütununu NOT NULL yapmak, mevcut herhangi bir satır NULL tutuyorsa başarısız olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt %@ thành NOT NULL sẽ thất bại nếu có dòng hiện tại chứa NULL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
