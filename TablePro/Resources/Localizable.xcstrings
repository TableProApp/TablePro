      }
    },
    "Dropping check constraint %@ stops it validating new rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer la contrainte de vérification %@ met fin à la validation des nouvelles lignes."
