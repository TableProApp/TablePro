    },
    "%@ DB requires a database index" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ DB nécessite un index de base de données"
          }
        }
      }
    },
    "%@ does not accept this column change." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’accepte pas cette modification de colonne."
          }
        }
      }
    },
    "%@ does not allow NULL, so its default cannot be NULL" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’autorise pas NULL, sa valeur par défaut ne peut donc pas être NULL"
          }
        }
      }
    },
    "%@ does not report structure metadata that can be compared." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne fournit pas de métadonnées de structure comparables."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 비교할 수 있는 구조 메타데이터를 제공하지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ karşılaştırılabilir yapı meta verisi bildirmiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không cung cấp metadata cấu trúc để so sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不提供可用于比较的结构元数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不提供可用於比較的結構中繼資料。"
          }
        }
      }
    },
    "%@ does not support reading rows in key order, which data compare needs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne prend pas en charge la lecture des lignes dans l’ordre des clés, nécessaire à la comparaison des données."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 데이터 비교에 필요한 키 순서 행 읽기를 지원하지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, veri karşılaştırmasının gerektirdiği anahtar sırasına göre satır okumayı desteklemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không hỗ trợ đọc dòng theo thứ tự khóa, điều mà so sánh dữ liệu cần."
          }
        },
        "zh-Hans" : {
