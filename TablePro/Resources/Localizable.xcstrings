          }
        }
      }
    },
    "A DynamoDB table declares only its key attributes. The items you write add every other attribute." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
