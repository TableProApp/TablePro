        }
      }
    },
    "%@ is already used by \"%@\" in %@. Reassigning removes it from that action." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already used by \"%2$@\" in %3$@. Reassigning removes it from that action."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est déjà utilisé par \"%2$@\" dans %3$@. La réaffectation le retire de cette action."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 키는 이미 \"%2$@\" 동작(%3$@)에서 사용 중입니다. 다시 할당하면 해당 동작에서 제거됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zaten %3$@ içindeki \"%2$@\" tarafından kullanılıyor. Yeniden atamak onu o eylemden kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đang được dùng bởi \"%2$@\" trong %3$@. Gán lại sẽ gỡ nó khỏi thao tác đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@已被%3$@中的\"%2$@\"使用。重新指定会将其从该操作中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已被 %2$@ 中的「%3$@」使用。重新指派會將它從該動作中移除。"
          }
        }
      }
    },
    "%@ is invalid, so queries skip it and exports leave it out. Drop it, or rebuild it with REINDEX." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est invalide, donc les requêtes le sautaient et les exportations le laissaient de côté. Supprimez-le ou reconstruisez-le avec REINDEX."
          }
        }
      }
    },
    "%@ is left with no unique index a concurrent refresh can use, so REFRESH MATERIALIZED VIEW CONCURRENTLY fails on it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne dispose plus d'un index unique que peut utiliser une mise à jour concurrente, de sorte que REFRESH MATERIALIZED VIEW CONCURRENTLY échoue sur celui-ci."
          }
        }
      }
    },
    "%@ is no longer a saved connection." : {
