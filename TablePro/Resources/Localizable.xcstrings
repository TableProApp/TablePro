        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 변경 사항이 있습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilmemiş değişiklikleriniz var"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thay đổi chưa lưu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您有未保存的更改"
