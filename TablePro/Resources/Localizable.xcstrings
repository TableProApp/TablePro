          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些列來自檢視表，檢視表不可編輯。"
          }
        }
      }
    },
    "These two engines cannot share a script." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces deux moteurs ne peuvent pas partager un même script."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 두 엔진은 스크립트를 공유할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iki motor bir betiği paylaşamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai engine này không thể dùng chung một script."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这两个引擎无法共用一个脚本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這兩個引擎無法共用一個指令稿。"
          }
        }
      }
    },
    "This account uses a password verifier the database driver does not support." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte utilise un vérificateur de mot de passe que le pilote de base de données ne prend pas en charge."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정은 데이터베이스 드라이버가 지원하지 않는 암호 검증 형식을 사용합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesap, veritabanı sürücüsünün desteklemediği bir parola doğrulayıcı kullanıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản này dùng password verifier mà driver cơ sở dữ liệu không hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户使用了数据库驱动不支持的口令校验器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此帳戶使用了資料庫驅動程式不支援的密碼驗證器。"
          }
        }
      }
    },
    "This action needs ⌘ or ⌃. Option and Shift can join them, but cannot hold a shortcut on their own." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action nécessite ⌘ ou ⌃. Option et Maj peuvent s’y ajouter, mais ne peuvent pas former un raccourci à elles seules."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동작에는 ⌘ 또는 ⌃가 필요합니다. Option과 Shift는 함께 쓸 수는 있지만 단독으로 단축키를 이룰 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eylem ⌘ veya ⌃ gerektirir. Option ve Shift bunlara eşlik edebilir, ama tek başlarına bir kısayol tutamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hành động này cần ⌘ hoặc ⌃. Option và Shift có thể đi kèm, nhưng không thể tự mình giữ một phím tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作需要 ⌘ 或 ⌃。Option 和 Shift 可以搭配它们，但不能单独构成快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作需要 ⌘ 或 ⌃。Option 和 Shift 可以搭配它們，但不能單獨構成快速鍵。"
          }
        }
      }
    },
    "this broker does not coordinate that group" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ce broker ne coordonne pas ce groupe"
          }
        }
      }
    },
    "This broker does not support the %@ request at all." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce broker ne prend pas du tout en charge la requête %@."
          }
        }
      }
    },
    "this broker is not the cluster controller" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ce broker n’est pas le contrôleur du cluster"
          }
        }
      }
    },
    "this broker no longer leads the partition" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ce broker n’est plus le leader de la partition"
          }
        }
      }
    },
    "This broker supports %@ v%d to v%d, and TablePro needs v%d." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce broker prend en charge %@ de v%d à v%d, et TablePro nécessite v%d."
          }
        }
      }
    },
    "This build of DuckDB does not accept a read-only access mode" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de DuckDB n’accepte pas le mode d’accès en lecture seule"
          }
        }
      }
    },
    "This change needs %@ to be recreated, and it cannot be recreated from the definition the database stored for it. Virtual tables, such as full-text search tables, are the usual reason." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification nécessite de recréer %@, ce qui est impossible à partir de la définition stockée par la base de données. Les tables virtuelles, comme les tables de recherche en texte intégral, en sont la cause habituelle."
          }
        }
      }
    },
    "This change was not authorized" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification n’a pas été autorisée"
          }
        }
      }
    },
    "This client does not have access to that connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce client n’a pas accès à cette connexion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 클라이언트에는 해당 연결에 대한 접근 권한이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu istemcinin o bağlantıya erişimi yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Client này không có quyền truy cập kết nối đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此客户端无权访问该连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
