        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 쿼리는 데이터를 영구적으로 변경하거나 삭제할 수 있으며 실행 취소할 수 없습니다.\n\n%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sorgu verileri kalıcı olarak değiştirebilir veya silebilir ve geri alınamaz.\n\n%@"
          }
        },
        "vi" : {
          "stringUnit" : {
