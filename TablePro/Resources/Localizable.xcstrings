      }
    },
    "Foreign keys between %@ reference each other, so no order puts every parent before its children. Those tables are written in the order they were listed, and the dump cannot be restored while foreign keys are enforced." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés étrangères entre %@ se référencent mutuellement, si bien qu’aucun ordre ne place chaque parent avant ses enfants. Ces tables sont écrites dans l’ordre où elles ont été listées, et le dump ne peut pas être restauré tant que les clés étrangères sont appliquées."
          }
        }
      }
    },
