          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrelenmiş etkinlik günlüğünü CSV olarak dışa aktar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xuất nhật ký hoạt động đã lọc ra CSV"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
