    "SRID %d is a projected coordinate system. Maps places longitude and latitude only, so these shapes cannot be drawn. Query ST_Transform(geom, 4326) to see them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le SRID %d est un système de coordonnées projetées. Plans ne positionne que des longitudes et des latitudes, ces formes ne peuvent donc pas être dessinées. Utilisez ST_Transform(geom, 4326) dans la requête pour les afficher."
          }
        }
      }
    },
