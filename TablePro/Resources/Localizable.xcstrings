          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapı eşitlemesi eşleşen veritabanı türleri gerektirir. %1$@ ve %2$@ karşılaştırılabilir ama betik üretilmez."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구조 동기화에는 같은 데이터베이스 타입이 필요합니다. %@과(와) %@은(는) 비교할 수 있지만 스크립트는 생성되지 않습니다."
          }
        },
        "en" : {
          "stringUnit" : {
