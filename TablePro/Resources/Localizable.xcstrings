    "The driver cannot write a new row." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conducteur ne peut pas écrire une nouvelle ligne."
          }
        }
      }
    },
    "The driver cannot write an edited row." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas écrire une ligne modifiée."
          }
        }
      }
    },
    "The dump is copied into this database, and the change cannot be undone. If an object it holds already exists, the restore stops before copying anything." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déchet est copié dans cette base de données, et le changement ne peut pas être annulé. Si un objet qu'il contient existe déjà, la restauration s'arrête avant de copier quoi que ce soit."
          }
        }
      }
    },
    "The dump is imported into this database, and the change cannot be undone. The import needs an empty database and stops if this one already holds objects." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déversement est importé dans cette base de données, et le changement ne peut pas être annulé. L'importation nécessite une base de données vide et s'arrête si celle-ci contient déjà des objets."
          }
        }
      }
    },
    "The dump is replayed into this database. Objects it names are overwritten and the change cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déversement est répliqué dans cette base de données. Les objets qu'il nomme sont écrasés et le changement ne peut pas être annulé."
          }
        }
      }
    },
    "The dump is replayed into this database. Objects that already exist are kept, not replaced, and the dump's data is added to them. The change cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déballage est reproduit dans cette base de données. Les objets qui existent déjà sont conservés, non remplacés, et les données du déballage sont ajoutées à eux. Le changement ne peut pas être annulé."
          }
        }
      }
    },
    "The encrypted file is corrupt or incomplete" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier crypté est corrompu ou incomplett."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 파일이 손상되었거나 불완전합니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifreli dosya bozuk veya eksik"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp mã hóa bị hỏng hoặc không đầy đủ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
