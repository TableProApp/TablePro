    "Over an SSH tunnel, TablePro connects directly to the first host. Replica set failover is not available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un tunnel SSH, TablePro se connecte directement au premier hôte. Le basculement de réplication n'est pas disponible."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qua đường hầm SSH, TablePro kết nối trực tiếp tới máy chủ đầu tiên. Không hỗ trợ chuyển đổi dự phòng replica set."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 SSH 通道時，TablePro 會直接連線到第一個主機。無法使用複本集容錯移轉。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
