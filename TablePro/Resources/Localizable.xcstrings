            "value" : "Mục"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目"
          }
        }
      }
    },
    "Its columns pass the %@ bytes this engine can index." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses colonnes dépassent les %@ octets que ce moteur peut indexer."
          }
        }
      }
    },
    "Its columns pass the 3,072 bytes this engine can index, even with each cut to a prefix." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses colonnes dépassent les 3 072 octets que ce moteur peut indexer, même en réduisant chacune à un préfixe."
          }
        }
      }
    },
    "Its definition is written in %1$@'s own SQL, which %2$@ does not parse." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa définition est écrite dans le SQL propre à %1$@, que %2$@ n’analyse pas."
          }
        }
      }
    },
    "Its definition names the source's own database or schema, so it is only copied where that name is the same." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa définition nomme la base de données ou le schéma propre à la source : elle n’est donc copiée que là où ce nom est identique."
          }
        }
      }
    },
    "Its expression %@ is written in the source's own dialect, so the column is created as an ordinary one and its values are copied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son expression %@ est écrite dans le dialecte propre à la source : la colonne est donc créée comme une colonne ordinaire et ses valeurs sont copiées."
          }
        }
      }
    },
    "Its indexes are left out, because the target is not known to take indexes on this kind of object." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses index sont omis, car la cible n’est pas connue pour accepter des index sur ce type d’objet."
          }
        }
      }
    },
    "Its indexes are left out, because the target's index statements would name a different schema than its definition." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses index sont omis, car les instructions d’index de la cible nommeraient un schéma différent de celui de sa définition."
          }
        }
      }
    },
    "Its indexes could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses index n’ont pas pu être lus : %@"
          }
        }
      }
    },
    "Its key includes %@, an expression in the source engine's SQL." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa clé inclut %@, une expression dans le SQL du moteur source."
          }
        }
      }
    },
    "Its structure could not be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa structure n’a pas pu être lue."
          }
        }
      }
    },
    "Its WHERE clause is not supported here, so it covers every row." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa clause WHERE n’est pas prise en charge ici : il couvre donc toutes les lignes."
          }
        }
      }
    },
    "Joins this column with the one to its right." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joint cette colonne à celle située à sa droite."
          }
        }
      }
    },
