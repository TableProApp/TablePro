          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ '%2$@' silme"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xoá %1$@ '%2$@'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %1$@ '%2$@'"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 %1$@ '%2$@'"
          }
        }
      }
    },
    "Dropping %1$@ %2$@ removes it from the target." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dépôt de %1$@ %2$@ le supprime de la cible."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@을(를) 삭제하면 대상에서 제거됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ silmek onu hedeften kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa %1$@ %2$@ sẽ loại bỏ nó khỏi đích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %1$@ %2$@ 会将其从目标中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 %1$@ %2$@ 會將其從目標中移除。"
          }
        }
      }
    },
    "Dropping check constraint %@ stops it validating new rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de la contrainte de contrôle %@ l'arrête de valider les nouvelles lignes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CHECK 제약 조건 %@을(를) 삭제하면 새 행에 대한 검증이 중단됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kontrol kısıtlamasını silmek, yeni satırları doğrulamasını durdurur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoá ràng buộc CHECK %@ sẽ khiến nó ngừng kiểm tra các dòng mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 CHECK 约束 %@ 后，它将不再校验新行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 CHECK 約束 %@ 後，它將不再驗證新列。"
          }
        }
      }
    },
    "Dropping column %@ permanently removes its data." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer une colonne %@ supprime définitivement ses données."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 %@을(를) 삭제하면 해당 데이터가 영구적으로 제거됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sütununu silmek verisini kalıcı olarak kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa cột %@ sẽ loại bỏ dữ liệu của nó vĩnh viễn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除列 %@ 会永久移除其数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除欄位 %@ 會永久移除其資料。"
          }
        }
      }
    },
    "Dropping index %@ can slow existing queries." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La baisse de l'indice %@ peut ralentir les requêtes existantes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인덱스 %@을(를) 삭제하면 기존 쿼리가 느려질 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ indeksini silmek mevcut sorguları yavaşlatabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa chỉ mục %@ có thể làm chậm các truy vấn hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除索引 %@ 可能会拖慢现有查询。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除索引 %@ 可能會拖慢現有查詢。"
          }
        }
      }
    },
    "Dropping materialized view %@ discards its stored rows along with its indexes, comments and privileges." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dépôt d'une vue matérialisée %@ rejette ses lignes stockées ainsi que ses index, commentaires et privilèges."
          }
        }
      }
    },
    "Dropping materialized view %@ discards its stored rows, comments and privileges. The rows are computed again and the source's indexes are created on it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dépôt de la vue matérialisée %@ rejette ses lignes, commentaires et privilèges stockés. Les lignes sont recomputées et les index de la source sont créés dessus."
          }
        }
      }
    },
    "Dropping table %@ permanently removes the table and all of its rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retrait de la table %@ supprime définitivement la table et toutes ses lignes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테이블 %@을(를) 삭제하면 테이블과 모든 행이 영구적으로 제거됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tablosunu silmek tabloyu ve tüm satırlarını kalıcı olarak kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa bảng %@ sẽ loại bỏ vĩnh viễn bảng và toàn bộ dòng của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除表 %@ 会永久移除该表及其所有行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除資料表 %@ 會永久移除該資料表及其所有列。"
          }
        }
      }
    },
    "Dropping..." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En train de tomber..."
          }
        },
