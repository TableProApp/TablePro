    "This will remove the license from this machine. You can reactivate later." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera la licence de cette machine. Vous pourrez la réactiver plus tard."
