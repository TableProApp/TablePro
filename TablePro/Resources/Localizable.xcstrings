    "Changing %@ from %@ to %@ can truncate existing values." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing %1$@ from %2$@ to %3$@ can truncate existing values."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer %1$@ de %2$@ à %3$@ peut tronquer les valeurs existantes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) %@에서 %@(으)로 변경하면 기존 값이 잘릴 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sütununu %2$@ türünden %3$@ türüne değiştirmek mevcut değerleri kısaltabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi %1$@ từ %2$@ sang %3$@ có thể cắt ngắn các giá trị hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %1$@ 从 %2$@ 改为 %3$@ 可能会截断现有值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 %1$@ 從 %2$@ 改為 %3$@ 可能會截斷現有值。"
          }
        }
      }
    },
    "Changing a column's type re-reads every value in it. Text that looks like a number becomes one, so '007' is stored as 7." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier le type d’une colonne relit chacune de ses valeurs. Un texte qui ressemble à un nombre devient un nombre ; « 007 » est donc stocké sous la forme 7."
          }
        }
      }
    },
    "Changing check constraint %@ re-checks every existing row and fails if any violates it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier la contrainte de vérification %@ revérifie chaque ligne existante et échoue si l’une d’elles ne la respecte pas."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CHECK 제약 조건 %@을(를) 변경하면 기존 행을 모두 다시 검사하며, 하나라도 위반하면 실패합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kontrol kısıtlamasını değiştirmek mevcut her satırı yeniden denetler ve herhangi biri ihlal ederse başarısız olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi ràng buộc CHECK %@ sẽ kiểm tra lại mọi dòng hiện có và thất bại nếu có dòng vi phạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改 CHECK 约束 %@ 会重新检查每一个现有行，若有任何行违反则会失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改 CHECK 約束 %@ 會重新檢查每一個現有列，若有任何列違反則會失敗。"
          }
        }
      }
    },
    "Changing the collation of %@ can change sort order and uniqueness." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier le classement de %@ peut changer l’ordre de tri et l’unicité."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 콜레이션을 변경하면 정렬 순서와 고유성이 달라질 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ karşılaştırmasını değiştirmek sıralama düzenini ve benzersizliği değiştirebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi đối chiếu của %@ có thể thay đổi thứ tự sắp xếp và tính duy nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改 %@ 的排序规则可能会改变排序顺序和唯一性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更 %@ 的定序可能會改變排序順序和唯一性。"
          }
        }
      }
    },
    "Changing the primary key rebuilds the table and can fail on duplicate values." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier la clé primaire reconstruit la table et peut échouer en cas de valeurs en double."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 키를 변경하면 테이블을 다시 만들며, 값이 중복되면 실패할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birincil anahtarı değiştirmek tabloyu yeniden oluşturur ve yinelenen değerlerde başarısız olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi khóa chính sẽ dựng lại bảng và có thể thất bại khi có giá trị trùng lặp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改主键会重建表，并可能因重复值而失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更主鍵會重建資料表，並可能因重複值而失敗。"
          }
        }
      }
    },
    "Changing which rows are shown will discard all unsaved changes." : {
