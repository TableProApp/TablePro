    "This server is Databend. Edit the connection and choose Databend as its type." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est un serveur Databend. Modifiez la connexion et choisissez Databend comme type."
          }
        }
      }
    },
    "This server is not running in cluster mode. Set Connection Mode to Standalone, or point Cluster mode at a node started with cluster-enabled yes." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne fonctionne pas en mode cluster. Réglez Mode de connexion sur Autonome, ou faites pointer le mode Cluster vers un nœud démarré avec cluster-enabled yes."
          }
        }
      }
    },
    "This server is part of a Redis Cluster, so requests for keys it does not own will fail. Set Connection Mode to Cluster and list this address under Cluster Seed Nodes." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur fait partie d’un Redis Cluster : les requêtes portant sur des clés qu’il ne détient pas échoueront donc. Réglez Mode de connexion sur Cluster et ajoutez cette adresse dans Nœuds d’amorçage du cluster."
          }
        }
      }
    },
    "This server predates Redis 6 and takes no username. Clear the Username field." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est antérieur à Redis 6 et n’accepte pas de nom d’utilisateur. Videz le champ Nom d’utilisateur."
          }
        }
      }
    },
    "This server requires authentication." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur exige une authentification."
          }
        }
      }
    },
    "This server runs Atlas Search but cannot list its search indexes, so one that uses the field cannot be ruled out. Check the collection's search indexes in Atlas, then change the field from a query tab." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur exécute Atlas Search mais ne peut pas lister ses index de recherche : il est donc impossible d’exclure qu’un index utilise ce champ. Vérifiez les index de recherche de la collection dans Atlas, puis modifiez le champ depuis un onglet de requête."
          }
        }
      }
    },
    "This sets %lld loaded rows. Review and Save to apply." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette valeur sera définie pour %lld lignes chargées. Vérifiez et enregistrez pour appliquer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불러온 행을 %lld개로 설정합니다. 적용하려면 검토한 후 저장하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, yüklenmiş %lld satırın değerini ayarlar. Uygulamak için gözden geçirip kaydedin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này đặt giá trị cho %lld hàng đã tải. Xem lại và Lưu để áp dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将设置 %lld 个已加载的行。请检查后保存以应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會設定 %lld 列已載入的資料。請檢查後儲存以套用。"
          }
        }
      }
    },
    "This sets 1 loaded row. Review and Save to apply." : {
