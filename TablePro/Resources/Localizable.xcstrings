          }
        }
      }
    },
    "The declared length is kept for reference but is not enforced." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longueur déclarée est conservée à titre indicatif, mais n’est pas appliquée."
