    "Return size, engine, collation, and timestamps the engine records for one table." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyer la taille, le moteur, le classement et les horodatages que le moteur enregistre pour une table."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진이 한 테이블에 대해 기록하는 크기, 엔진, 콜레이션, 타임스탬프를 반환합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorun bir tablo için kaydettiği boyutu, motoru, karşılaştırma kuralını ve zaman damgalarını döndürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả về kích thước, engine, collation và các dấu thời gian mà engine ghi lại cho một bảng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回引擎为某张表记录的大小、引擎、排序规则和时间戳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回傳引擎為某張資料表記錄的大小、引擎、定序和時間戳記。"
          }
        }
      }
    },
    "Return table counts and sizes for one database, or for every database when 'database' is omitted." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyer le nombre et la taille des tables d’une base de données, ou de toutes les bases de données si « database » est omis."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
