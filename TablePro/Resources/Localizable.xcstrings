        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾「%@」將被刪除。其中的項目將移至上一層。"
          }
        }
      }
    },
    "The following %d queries may permanently modify or delete data. This action cannot be undone.\n\n%@" : {
