    "The disconnect was cancelled." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déconnexion a été annulée."
          }
        }
      }
    },
    "The document changed on the server after it was opened, so nothing was saved. Copy your text, then open it again." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document a été modifié sur le serveur après son ouverture : rien n’a donc été enregistré. Copiez votre texte, puis rouvrez le document."
          }
        }
      }
    },
    "The document has not loaded, so there is nothing to save it over." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document n’a pas été chargé : il n’y a donc rien à remplacer par l’enregistrement."
          }
        }
      }
    },
    "The document is nested more than %d levels deep." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document comporte plus de %d niveaux d’imbrication."
          }
        }
      }
    },
    "The document's _id is unknown, so it cannot be addressed." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le _id du document est inconnu : il est donc impossible de le cibler."
          }
        }
      }
    },
    "The Downloads folder is not available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier Téléchargements n’est pas disponible."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드 폴더를 사용할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilenler klasörü kullanılamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục Downloads không khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载文件夹不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載檔案夾無法使用。"
          }
        }
      }
    },
    "The driver cannot delete %lld rows marked for deletion." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas supprimer %lld lignes marquées pour suppression."
          }
        }
      }
    },
    "The driver cannot delete a row marked for deletion." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas supprimer une ligne marquée pour suppression."
          }
        }
      }
    },
    "The driver cannot write %lld edited rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas écrire %lld lignes modifiées."
          }
        }
      }
    },
    "The driver cannot write %lld new rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas écrire %lld nouvelles lignes."
          }
        }
      }
    },
    "The driver cannot write a new row." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas écrire une nouvelle ligne."
          }
        }
      }
    },
    "The driver cannot write an edited row." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote ne peut pas écrire une ligne modifiée."
          }
        }
      }
    },
    "The dump is copied into this database, and the change cannot be undone. If an object it holds already exists, the restore stops before copying anything." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dump est copié dans cette base de données, et la modification est irréversible. Si un objet qu’il contient existe déjà, la restauration s’arrête avant toute copie."
          }
        }
      }
    },
    "The dump is imported into this database, and the change cannot be undone. The import needs an empty database and stops if this one already holds objects." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dump est importé dans cette base de données, et la modification est irréversible. L’importation nécessite une base de données vide et s’arrête si celle-ci contient déjà des objets."
          }
        }
      }
    },
    "The dump is replayed into this database. Objects it names are overwritten and the change cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dump est rejoué dans cette base de données. Les objets qu’il nomme sont écrasés et la modification est irréversible."
          }
        }
      }
    },
    "The dump is replayed into this database. Objects that already exist are kept, not replaced, and the dump's data is added to them. The change cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dump est rejoué dans cette base de données. Les objets existants sont conservés, et non remplacés, et les données du dump y sont ajoutées. La modification est irréversible."
          }
        }
      }
    },
    "The dump was written as %1$lld numbered parts, %2$@ through %3$@. Restore them in order." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dump a été écrit en %1$lld parties numérotées, de %2$@ à %3$@. Restaurez-les dans l’ordre."
          }
        }
      }
    },
    "The emulator endpoint must be a local address, such as http://127.0.0.1:9020." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point de terminaison de l’émulateur doit être une adresse locale, par exemple http://127.0.0.1:9020."
          }
        }
      }
    },
    "The encrypted file is corrupt or incomplete" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier chiffré est corrompu ou incomplet"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 파일이 손상되었거나 불완전합니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifreli dosya bozuk veya eksik"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp mã hóa bị hỏng hoặc không đầy đủ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密文件已损坏或不完整"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密的檔案已損毀或不完整"
          }
        }
      }
    },
    "The endpoint answered with a redirect, which DynamoDB never sends. Check the Custom Endpoint." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point de terminaison a répondu par une redirection, ce que DynamoDB n’envoie jamais. Vérifiez le point de terminaison personnalisé."
          }
        }
      }
    },
    "The endpoint did not answer over HTTP" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point de terminaison n’a pas répondu en HTTP"
          }
        }
      }
    },
    "The endpoint must start with https:// or http://" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point de terminaison doit commencer par https:// ou http://"
          }
        }
      }
    },
    "The export file could not be written." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’écrire le fichier d’exportation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기 파일을 쓸 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarma dosyası yazılamadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ghi được tệp xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入导出文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法寫入匯出檔案。"
          }
        }
      }
    },
    "The extension failed to start: %@" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec du démarrage de l’extension : %@"
          }
        }
      }
    },
    "The extra rows are pending in the transaction already open on this connection. Roll it back to discard them. '%@' has no primary key, so identical rows cannot be told apart." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes supplémentaires sont en attente dans la transaction déjà ouverte sur cette connexion. Annulez-la pour les abandonner. « %@ » n’a pas de clé primaire : les lignes identiques ne peuvent donc pas être distinguées."
          }
        }
      }
    },
    "The field “%@” appears more than once." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ « %@ » apparaît plusieurs fois."
          }
        }
      }
    },
    "The file changed while the operation ran, so nothing was applied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a été modifié pendant l’opération : rien n’a donc été appliqué."
          }
        }
      }
    },
    "The file could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le fichier : %@"
          }
        }
      }
    },
    "The file goes back to its last committed version. You can't undo this action." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier revient à sa dernière version validée. Vous ne pourrez pas annuler cette action."
          }
        }
      }
    },
    "The file goes back to its staged version. You can't undo this action." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier revient à sa version indexée. Vous ne pourrez pas annuler cette action."
          }
        }
      }
    },
    "The file has no function named %@." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ne contient aucune fonction nommée %@."
          }
        }
      }
    },
    "The file has not finished opening." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ouverture du fichier n’est pas terminée."
          }
        }
      }
    },
    "The file has uncommitted changes. Restoring this version replaces them, and you can't undo this action." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient des modifications non validées. Restaurer cette version les remplace, et vous ne pourrez pas annuler cette action."
          }
        }
      }
    },
    "The file holds a single value, not a list of rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient une seule valeur, et non une liste de lignes."
          }
        }
      }
    },
    "The file holds one object, not a list of rows. Open a JSON array of objects or a JSON Lines file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient un seul objet, et non une liste de lignes. Ouvrez un tableau JSON d’objets ou un fichier JSON Lines."
          }
        }
      }
    },
    "The file is copied to this Mac and opened read-only. The original on the server is never written to." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est copié sur ce Mac et ouvert en lecture seule. L’original sur le serveur n’est jamais modifié."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 이 Mac으로 복사되어 읽기 전용으로 열립니다. 서버의 원본에는 절대 쓰지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya bu Mac'e kopyalanır ve salt okunur açılır. Sunucudaki özgün dosyaya asla yazılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp được sao chép về máy Mac này và mở ở chế độ chỉ đọc. Bản gốc trên máy chủ không bao giờ bị ghi vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件会被复制到这台 Mac 并以只读方式打开。服务器上的原始文件绝不会被写入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該檔案會被複製到這台 Mac 並以唯讀方式開啟。伺服器上的原始檔案絕不會被寫入。"
          }
        }
      }
    },
    "The file is empty." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est vide."
          }
        }
      }
    },
    "The file is too large to read from Git." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est trop volumineux pour être lu depuis Git."
          }
        }
      }
    },
    "The file or its staged version changed before it could be written. Nothing was replaced." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ou sa version indexée a changé avant de pouvoir être écrit. Rien n’a été remplacé."
          }
        }
      }
    },
    "The filter field is not in the toolbar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ de filtre ne figure pas dans la barre d’outils."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필터 필드가 도구 막대에 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre alanı araç çubuğunda değil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trường bộ lọc không có trên thanh công cụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筛选字段不在工具栏中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "篩選欄位不在工具列中。"
          }
        }
      }
    },
    "The filter on %@ is not one expression. Remove the semicolon." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtre sur %@ ne constitue pas une seule expression. Supprimez le point-virgule."
          }
        }
      }
    },
    "The first call asks. The answer is remembered for that client until you revoke it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier appel demande l’autorisation. La réponse est mémorisée pour ce client jusqu’à ce que vous la révoquiez."
          }
        }
      }
    },
    "The first sheet has no header row to map columns from." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première feuille ne comporte aucune ligne d’en-tête à partir de laquelle associer les colonnes."
          }
        }
      }
    },
    "The folder \"%@\" will be deleted. Items inside will be moved to the parent level." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier « %@ » sera supprimé. Son contenu sera déplacé au niveau parent."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 폴더가 삭제됩니다. 폴더 안의 항목은 상위 단계로 이동됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" klasörü silinecek. İçindeki öğeler bir üst seviyeye taşınacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục \"%@\" sẽ bị xoá. Các mục bên trong sẽ được chuyển lên cấp cha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹 \"%@\" 将被删除。其中的项目将移至上一级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾「%@」將被刪除。其中的項目將移至上一層。"
          }
        }
      }
    },
    "The following %d queries may permanently modify or delete data. This action cannot be undone.\n\n%@" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The following %1$d queries may permanently modify or delete data. This action cannot be undone.\n\n%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %1$d requêtes suivantes peuvent modifier ou supprimer définitivement des données. Cette action est irréversible.\n\n%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
