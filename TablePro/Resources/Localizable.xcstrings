    "Compared %@ keys in key order. Rows past the limit were not read on either side, and rows with NULL in a key column are not read under a limit." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ clés comparées dans l’ordre des clés. Les lignes au-delà de la limite n’ont été lues d’aucun côté, et les lignes contenant NULL dans une colonne clé ne sont pas lues lorsqu’une limite s’applique."
          }
        }
      }
    },
    "Compared %@. %d differences." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Compared %1$@. %2$d differences."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparaison de %1$@ terminée. %2$d différences."
          }
        }
      }
    },
    "Compared %@. %d differences. Nothing has been written." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Compared %1$@. %2$d differences. Nothing has been written."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparaison de %1$@ terminée. %2$d différences. Rien n’a été écrit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@을(를) 비교했습니다. 차이점 %2$d개. 아무것도 기록되지 않았습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
