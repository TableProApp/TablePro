    "Default row sort is applied when a table first opens. Sort direction also sets which way the first click on a column header sorts." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設列排序在首次開啟表格時套用。排序方向同時決定首次點按欄標題時的排序方向。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 행 정렬은 테이블을 처음 열 때 적용됩니다. 정렬 방향은 열 머리글을 처음 클릭했을 때의 정렬 방향도 결정합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp xếp hàng mặc định được áp dụng khi mở bảng lần đầu. Hướng sắp xếp cũng quyết định chiều sắp xếp của lần nhấp đầu tiên vào tiêu đề cột."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan satır sıralaması tablo ilk açıldığında uygulanır. Sıralama yönü, bir sütun başlığına yapılan ilk tıklamanın yönünü de belirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认行排序在首次打开表时应用。排序方向同时决定首次点击列标题时的排序方向。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "L'ordre par rangée par défaut est appliqué lorsque la table s'ouvre pour la première fois. La direction d'ordre définit également dans quelle direction le premier clic sur un en-tête de colonne est effectué.",
            "state" : "translated"
          }
        }
      }
    },
    "Prevent CSV formula injection by prefixing values starting with =, +, -, @ with a single quote" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过在以 =、+、-、@ 开头的值前添加单引号来防止 CSV 公式注入"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "=, +, -, @로 시작하는 값 앞에 작은따옴표(')를 붙여 CSV 수식 삽입을 방지합니다"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn chặn chèn công thức CSV bằng cách thêm dấu nháy đơn trước các giá trị bắt đầu bằng =, +, -, @"
          }
        },
        "tr" : {
          "stringUnit" : {
