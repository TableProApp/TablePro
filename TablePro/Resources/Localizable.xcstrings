    "The Dameng connection is closed." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Dameng est fermée."
          }
        }
      }
    },
    "The Dameng connection was lost, so the open transaction was rolled back. Run its statements again." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Dameng a été perdue : la transaction ouverte a donc été annulée. Exécutez de nouveau ses instructions."
          }
        }
      }
    },
    "The Dameng operation failed." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération Dameng a échoué."
          }
        }
      }
    },
    "The Dameng port must be between 1 and 65535." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port Dameng doit être compris entre 1 et 65535."
          }
        }
      }
    },
    "The Dameng schema name cannot be empty." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom du schéma Dameng ne peut pas être vide."
          }
        }
      }
    },
    "The database “%@” has an open transaction. Closing rolls it back and discards its uncommitted changes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données « %@ » a une transaction ouverte. La fermer annule cette transaction et abandonne ses modifications non validées."
          }
        }
      }
    },
    "The database “%@” has an open transaction. Disconnecting rolls it back and discards its uncommitted changes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données « %@ » a une transaction ouverte. La déconnexion annule cette transaction et abandonne ses modifications non validées."
          }
        }
      }
    },
    "The database and collection names together must be %ld bytes or fewer." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms de la base de données et de la collection ne doivent pas dépasser %ld octets au total."
          }
        }
      }
    },
    "the database file" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le fichier de base de données"
          }
        }
      }
    },
    "The database file is no longer at %@." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de base de données ne se trouve plus à l’emplacement %@."
          }
        }
      }
    },
    "The database filter hides every database on this connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtre de bases de données masque toutes les bases de données de cette connexion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스 필터로 인해 이 연결의 모든 데이터베이스가 숨겨졌습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veritabanı filtresi bu bağlantıdaki tüm veritabanlarını gizliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ lọc cơ sở dữ liệu đang ẩn mọi cơ sở dữ liệu trên kết nối này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库筛选隐藏了此连接上的所有数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫篩選隱藏了此連線上的所有資料庫。"
          }
        }
      }
    },
    "The database is a copy of a file on the SSH server, and changes are never written back, so the connection is always Read-Only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de données est une copie d’un fichier situé sur le serveur SSH, et les modifications n’y sont jamais réécrites : la connexion est donc toujours en lecture seule."
          }
        }
      }
    },
    "The database name is longer than the 128 bytes FreeTDS takes." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom de la base de données dépasse les 128 octets acceptés par FreeTDS."
          }
        }
      }
    },
    "The database server enforced this, not TablePro's Safe Mode. You are most likely connected to a read replica, or the server sets new transactions to read-only. Connect to the primary server to write.\n\nServer response: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette restriction vient du serveur de base de données, et non du mode sécurisé de TablePro. Vous êtes très probablement connecté à un réplica en lecture, ou le serveur définit les nouvelles transactions en lecture seule. Connectez-vous au serveur principal pour écrire.\n\nRéponse du serveur : %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro의 안전 모드가 아니라 데이터베이스 서버에서 적용한 제한입니다. 읽기 전용 복제본에 연결했거나 서버에서 새 트랜잭션을 읽기 전용으로 설정했을 가능성이 큽니다. 쓰려면 기본 서버에 연결하십시오.\n\n서버 응답: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu TablePro'nun Safe Mode ayarı değil, veritabanı sunucusu uyguladı. Büyük olasılıkla bir okuma kopyasına bağlısınız veya sunucu yeni işlemleri salt okunur yapıyor. Yazmak için birincil sunucuya bağlanın.\n\nSunucu yanıtı: %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là do máy chủ cơ sở dữ liệu áp đặt, không phải Chế độ an toàn của TablePro. Nhiều khả năng bạn đang kết nối tới bản sao chỉ đọc, hoặc máy chủ đặt các giao dịch mới ở chế độ chỉ đọc. Hãy kết nối tới máy chủ chính để ghi.\n\nPhản hồi của máy chủ: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是数据库服务器的限制，不是 TablePro 的安全模式。你很可能连接到了只读副本，或者服务器将新事务设为只读。请连接主服务器以写入。\n\n服务器响应：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是資料庫伺服器的限制，不是 TablePro 的安全模式。你很可能連線到唯讀副本，或伺服器將新交易設為唯讀。請連線到主要伺服器以寫入。\n\n伺服器回應：%@"
          }
        }
      }
    },
    "The database server rejected this write because the connection is read-only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur de base de données a refusé cette écriture, car la connexion est en lecture seule."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 읽기 전용이어서 데이터베이스 서버에서 이 쓰기 작업을 거부했습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı salt okunur olduğu için veritabanı sunucusu bu yazma işlemini reddetti."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ cơ sở dữ liệu từ chối thao tác ghi này vì kết nối ở chế độ chỉ đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据库服务器拒绝了此次写入，因为该连接为只读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料庫伺服器拒絕了這次寫入，因為該連線為唯讀。"
          }
        }
      }
    },
    "The database this user belongs to" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
