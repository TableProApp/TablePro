    "The app stays free, all of it. If TablePro is useful to you, a license is what pays for the next release." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application reste gratuite, tout le monde. Si TablePro vous est utile, une licence est ce qui paie la prochaine version."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 전체가 계속 무료입니다. TablePro가 쓸모 있었다면, 라이선스가 다음 릴리스를 만듭니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın tamamı ücretsiz kalır. TablePro işinize yarıyorsa, bir sonraki sürümü lisanslar finanse eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn bộ ứng dụng vẫn miễn phí. Nếu TablePro hữu ích với bạn, giấy phép là thứ chi trả cho bản phát hành tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个 App 一直免费。如果 TablePro 对你有用，许可证支付了下一个版本的开发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整個 App 一直免費。如果 TablePro 對你有用，授權支付了下一個版本的開發。"
          }
        }
      }
    },
    "The assistant answers once the connection is up" : {
