        }
      }
    },
    "The copy writes no INCLUDE clause here, so %@ are left out of the index." : {
      "comment" : "A list of columns that are not stored in the index.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie ne contient pas de clause INCLUDE ici, donc %@ est omis de l'index."
          }
        }
      }
    },
    "The CREATE statement" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La déclaration CREATE"
          }
        }
      }
    },
    "The CREATE statement for one table, as the engine reports it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'instruction CREATE pour une table, telle que le moteur le rapporte."
