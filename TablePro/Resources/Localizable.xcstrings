    },
    "The source could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire la source : %@"
          }
        }
      }
    },
    "The source driver cannot be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le pilote de la source."
          }
        }
      }
    },
    "The source driver cannot stream rows for a comparison." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote de la source ne peut pas transmettre de lignes en continu pour une comparaison."
