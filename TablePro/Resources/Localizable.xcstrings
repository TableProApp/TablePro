          "stringUnit" : {
            "state" : "translated",
            "value" : "這次儲存無法還原"
          }
        }
      }
    },
    "This save reuses the column name %@ while the table is being recreated, and the recreated table would hold it twice. Save the change that frees the name first, then the one that takes it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet enregistrement réutilise le nom de colonne %@ pendant la recréation de la table, et la table recréée le contiendrait deux fois. Enregistrez d’abord la modification qui libère le nom, puis celle qui le reprend."
          }
        }
      }
    },
    "This save was made on a different connection. Open that connection to restore it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet enregistrement a été effectué sur une autre connexion. Ouvrez cette connexion pour le restaurer."
