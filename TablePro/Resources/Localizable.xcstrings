    "Pro features stop here right away. You can activate this license again later." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctionnalités Pro s'arrêtent ici tout de suite. Vous pouvez activer cette licence à nouveau plus tard."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 기능이 이 Mac에서 즉시 중지됩니다. 나중에 이 라이선스를 다시 활성화할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro özellikleri burada hemen durur. Bu lisansı daha sonra yeniden etkinleştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tính năng Pro dừng ngay tại đây. Bạn có thể kích hoạt lại giấy phép này sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 功能会在此立即停用。你之后可以重新激活此许可证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 功能會在此立即停用。你之後可以重新啟用此授權。"
          }
        }
