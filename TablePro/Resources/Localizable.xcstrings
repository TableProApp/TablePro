    "Query timeout applies only to database drivers that support it. Use 0 for no limit. Reconnect to apply changes." : {
      "comment" : "A tooltip that describes the query timeout.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps d'attente de la requête ne s'applique qu'aux pilotes de base de données qui le prennent en charge. Utilisez 0 pour aucune limite. Reconnectez-vous pour appliquer les modifications."
          }
        }
      }
    },
