      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Column count mismatch on line %1$d: expected %2$d columns, found %3$d."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inégalité de nombre de colonnes sur la ligne %1$d : %2$d colonnes attendues, %3$d colonnes trouvées."
          }
