          }
        }
      }
    },
    "This row's key cannot be matched, so it cannot be checked before writing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de cette ligne ne peut pas être mise en correspondance : elle ne peut donc pas être vérifiée avant l’écriture."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 행의 키를 일치시킬 수 없어 쓰기 전에 확인할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu satırın anahtarı eşleştirilemiyor, bu yüzden yazmadan önce denetlenemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không khớp được khoá của dòng này, nên không thể kiểm tra trước khi ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
