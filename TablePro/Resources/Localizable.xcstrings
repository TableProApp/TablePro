    "“%@” will be permanently deleted. External clients using this token will lose access immediately." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 将被永久删除。使用此令牌的外部客户端将立即失去访问权限。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 항목이 영구적으로 삭제됩니다. 이 토큰을 사용하는 외부 클라이언트는 즉시 접근 권한을 잃습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sẽ bị xóa vĩnh viễn. Các client bên ngoài đang dùng token này sẽ mất quyền truy cập ngay lập tức."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sera supprimé définitivement. Les clients externes utilisant ce jeton perdront immédiatement l’accès."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" kalıcı olarak silinecek. Bu token'ı kullanan harici istemciler erişimi anında kaybedecek."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將會永久刪除。使用此權杖的外部用戶端將立即失去存取權限。"
          }
        }
      }
    },
    "Timed out during the Oracle login handshake. The server accepted the network connection but did not finish logging in." : {
