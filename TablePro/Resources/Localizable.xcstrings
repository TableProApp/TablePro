          }
        }
      }
    },
    "A connection reads only the secrets its own database type declares, so one profile can carry several engines' keys." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion ne lit que les secrets déclarés par son propre type de base de données, un même profil peut donc contenir les clés de plusieurs moteurs."
          }
        }
