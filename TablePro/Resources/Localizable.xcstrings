          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未安裝 %@ 外掛。你可以從外掛市集下載。"
          }
        }
      }
    },
    "The %@ plugin is turned off." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin %@ est désactivé."
          }
        }
      }
    },
    "The %1$@ plugin could not be installed: %2$@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin %1$@ n'a pas pu être installé : %2$@"
          }
        }
      }
    },
    "The %1$@ sorted rows differently than the comparison expects, near key %2$@. Pick a numeric key, or one that sorts by byte value." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes triées %1$@ sont triées différemment de ce que la comparaison attend, près de la clé %2$@. Choisissez une clé numérique, ou une qui trie par valeur en octets."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 키 %2$@ 부근에서 비교가 예상한 것과 다른 순서로 행을 정렬했습니다. 숫자 키나 바이트 값으로 정렬되는 키를 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, satırları karşılaştırmanın beklediğinden farklı sıraladı, %2$@ anahtarının yakınında. Sayısal bir anahtar ya da bayt değerine göre sıralanan bir anahtar seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã sắp xếp các dòng khác với những gì so sánh mong đợi, gần khóa %2$@. Hãy chọn khóa dạng số, hoặc khóa sắp xếp theo giá trị byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 对行的排序与比较预期不同，出现在键 %2$@ 附近。请选择数值型键，或按字节值排序的键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 對列的排序與比較預期不同，出現在鍵 %2$@ 附近。請選擇數值型鍵，或按位元組值排序的鍵。"
          }
        }
      }
    },
    "The %d batches before it stay applied." : {
      "comment" : "The number of statements that remain applied.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %d lots avant cela restent appliqués."
          }
        }
      }
    },
    "The %d statements before it stay applied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclarations %d précédentes restent applicables."
          }
        }
      }
    },
    "The Access application policy must use a Service Auth rule, or Cloudflare still prompts for browser sign-in." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La politique d'application Access doit utiliser une règle d'authentification de service, ou Cloudflare demande toujours la connexion du navigateur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access 애플리케이션 정책에서 Service Auth 규칙을 사용해야 합니다. 그렇지 않으면 Cloudflare가 계속 브라우저 로그인을 요청합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
