    },
    "%@ is changed twice in this save. Save one change to it at a time." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est modifié deux fois dans cet enregistrement. Enregistrez une seule modification à la fois."
          }
        }
      }
    },
    "%@ is invalid, so queries skip it and exports leave it out. Drop it, or rebuild it with REINDEX." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas valide, donc les requêtes l’ignorent et les exportations l’omettent. Supprimez-le ou reconstruisez-le avec REINDEX."
          }
        }
      }
    },
    "%@ is left with no unique index a concurrent refresh can use, so REFRESH MATERIALIZED VIEW CONCURRENTLY fails on it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a plus aucun index unique utilisable par une actualisation concurrente, REFRESH MATERIALIZED VIEW CONCURRENTLY échoue donc sur cette vue."
          }
        }
      }
    },
