          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会从数据库中永久删除所选行，且无法撤销。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Cela supprime définitivement les lignes sélectionnées de la base de données et ne peut pas être annulé.",
