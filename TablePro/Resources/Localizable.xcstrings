        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已完成"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已完成"
          }
        }
      }
    },
    "%@ connections open a server, not a database file, so there is nothing to fetch over SSH." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les connexions %@ ouvrent un serveur, et non un fichier de base de données, il n’y a donc rien à récupérer via SSH."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연결은 데이터베이스 파일이 아니라 서버를 여는 것이므로 SSH로 가져올 것이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantıları bir veritabanı dosyasını değil bir sunucuyu açar, bu yüzden SSH üzerinden alınacak bir şey yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối %@ mở một máy chủ chứ không phải tệp cơ sở dữ liệu, nên không có gì để tải qua SSH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 连接打开的是服务器而不是数据库文件，因此没有内容需要通过 SSH 获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 連線開啟的是伺服器而不是資料庫檔案，因此沒有內容需要透過 SSH 取得。"
          }
        }
      }
    },
    "%@ contains characters Spanner does not allow." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contient des caractères non autorisés par Spanner."
