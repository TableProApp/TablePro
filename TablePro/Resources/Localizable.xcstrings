        }
      }
    },
    "A connection reads only the secrets its own database type declares, so one profile can carry several engines' keys." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion ne lit que les secrets déclarés par le type de base de données de son propre système, de sorte qu'un profil peut contenir les clés de plusieurs moteurs."
          }
        }
      }
    },
    "A connection with this name, host, and type already exists." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
