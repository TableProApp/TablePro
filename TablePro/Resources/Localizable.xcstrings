    },
    "The .bacpac always carries the whole schema. Only the chosen tables' data is narrowed, and tables they reference by foreign key have to be chosen too." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le .bacpac contient toujours tout le schéma. Seuls les données des tables choisies sont réduites, et les tables qu'elles renvoient par clé étrangère doivent également être choisies."
          }
        }
      }
    },
    "The '%1$@' variant does not run the statement. Leave 'analyze' off, or pass one that does: %2$@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variante '%1$@' ne lance pas l'instruction. Laissez 'analyze' en dehors, ou passez une qui le fait : %2$@."
          }
        }
      }
    },
    "The %@ command line tool is not installed." : {
      "localizations" : {
