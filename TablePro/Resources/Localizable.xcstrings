    },
    "'%@' has no primary key, so identical rows cannot be told apart. Add a primary key, or edit the rows with a query." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» n'a pas de clé primaire, donc des lignes identiques ne peuvent pas être distinguées. Ajoutez une clé primaire ou modifiez les lignes avec une requête."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'에 기본 키가 없어 동일한 행을 구분할 수 없습니다. 기본 키를 추가하거나 쿼리로 행을 편집하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' birincil anahtara sahip değil, bu yüzden aynı satırlar birbirinden ayırt edilemiyor. Bir birincil anahtar ekleyin veya satırları bir sorguyla düzenleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' không có khoá chính nên không thể phân biệt các dòng giống nhau. Hãy thêm khoá chính, hoặc sửa các dòng bằng truy vấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 没有主键，因此无法区分完全相同的行。请添加主键，或用查询编辑这些行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 沒有主鍵，因此無法區分完全相同的列。請新增主鍵，或用查詢編輯這些列。"
          }
        }
      }
    },
    "'%@' has no primary key, so the row is found by matching every column. Another client may have changed it, or a value in it cannot be compared. Your edit is still here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» n’a pas de clé primaire, donc la ligne est trouvée en faisant correspondre chaque colonne. Un autre client l’a peut-être modifiée, ou une valeur qu’elle contient ne peut pas être comparée. Votre modification est toujours là."
          }
        }
      }
    },
    "'%@' is a reserved Windows device name" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» est un nom de périphérique Windows réservé"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 이름은 Windows에서 예약된 장치 이름입니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' ayrılmış bir Windows aygıt adıdır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' là tên thiết bị Windows dành riêng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 是 Windows 保留设备名"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是 Windows 保留的裝置名稱"
          }
        }
      }
    },
    "'%@' is not a process id on this engine. Take one from get_server_dashboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' n'est pas un identifiant de processus sur ce moteur. Prenez-en un depuis get_server_dashboard."
          }
        }
      }
    },
    "'since' must not be later than 'until'." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« since » ne doit pas être postérieur à « until »."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since'는 'until'보다 늦을 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since', 'until' değerinden sonra olamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since' không được muộn hơn 'until'."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since' 不能晚于 'until'。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'since' 不能晚於 'until'。"
          }
        }
      }
    },
    "\"%@\"" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\""
          }
        }
      }
    },
    "“%@” and its token are removed from this Mac. Sessions lose its tools." : {
      "comment" : "A message in a confirmation alert that lets the user remove a server. The argument is the name of the server.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» et son jeton sont supprimés de ce Mac. Les sessions perdent ses outils."
          }
        }
      }
    },
    "“%@” is compressed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» est compressé."
          }
        }
      }
    },
    "“%@” is no longer at that location." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est plus à cet emplacement."
          }
        }
      }
    },
    "\"%@\" is not a library." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» n’est pas une bibliothèque."
          }
        }
      }
    },
    "\"%@\" is not a valid AWS region." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas une région AWS valide."
          }
        }
      }
    },
    "“%@” is still in use" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» est toujours utilisé"
          }
        }
      }
    },
    "“%@” now holds the current result of its query." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» contient maintenant le résultat actuel de sa requête."
          }
        }
      }
    },
    "“%@” owns database objects" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» possède des objets de base de données"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스 객체의 소유자는 “%@”입니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” veritabanı nesnelerinin sahibi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đang sở hữu các đối tượng cơ sở dữ liệu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 拥有数据库对象"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」擁有資料庫物件"
          }
        }
      }
    },
    "\"%@\" was changed since you opened it. Review the diff and choose how to resolve." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» a été modifié depuis que vous l’avez ouvert. Consultez les différences et choisissez comment résoudre le conflit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 항목이 열린 후 변경되었습니다. 차이점을 검토하고 해결 방법을 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" siz açtıktan sonra değiştirildi. Farkları inceleyin ve nasıl çözeceğinizi seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" đã thay đổi kể từ khi bạn mở. Xem lại phần khác biệt và chọn cách xử lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"在您打开后已被更改。请查看差异并选择处理方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在你開啟後已被變更。請查看差異並選擇處理方式。"
          }
        }
      }
    },
    "\"%@\" was deleted or moved." : {
