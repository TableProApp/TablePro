          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 연결에서는 한 번에 하나의 터널만 사용할 수 있습니다. Cloudflare 터널을 사용하려면 SSH 터널을 비활성화하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
