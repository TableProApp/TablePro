          }
        }
      }
    },
    "This permanently deletes the selected rows from the database and can't be undone." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作會從資料庫中永久刪除所選的列，且無法復原。"
          }
        },
        "vi" : {
          "stringUnit" : {
