          }
        }
      }
    },
    "The connection to Redis dropped, so the keys this session was watching are no longer watched." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à Redis a été interrompue : les clés surveillées par cette session ne le sont donc plus."
          }
        }
      }
    },
    "The connection to Redis dropped, so the open MULTI block was lost and nothing in it ran." : {
      "extractionState" : "manual",
