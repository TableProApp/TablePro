    "A DynamoDB index can't be changed. Delete it and save, then add the new one once the old one is gone." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
