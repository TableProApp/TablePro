        "fr" : {
          "stringUnit" : {
            "value" : "Aucune pièce d'identité n'est envoyée. Utilisez-la lorsque le serveur gère lui-même l'authentification, comme un hôte SSH Tailscale.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gửi thông tin đăng nhập nào. Dùng khi máy chủ tự xử lý xác thực, ví dụ máy chủ SSH của Tailscale."
          }
        }
      }
