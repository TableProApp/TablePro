          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ cấu trúc cần các loại cơ sở dữ liệu giống nhau. %1$@ và %2$@ có thể được so sánh, nhưng không có script nào được tạo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "La synchronisation de la structure nécessite des types de bases de données correspondants. %1$@ et %2$@ peuvent être comparés, mais aucun script n'est généré.",
