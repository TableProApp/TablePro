          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ kết nối, bảng yêu thích, cài đặt và hồ sơ SSH giữa các máy Mac của bạn qua iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 iCloud 在你的多台 Mac 之间同步连接、表收藏、设置和 SSH 配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
