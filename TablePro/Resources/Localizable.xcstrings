        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 \"%@\"의 SSO 세션이 만료되었습니다. 브라우저에서 로그인하시겠습니까?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" profilinin SSO oturumunun süresi doldu. Tarayıcınızla giriş yapmak ister misiniz?"
