        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버에서 확인 코드를 요청하면 연결할 때 TablePro가 코드 입력을 요청합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
