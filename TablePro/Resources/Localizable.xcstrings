    "Compare lists the tables both sides share. Choose the tables to compare, then press Compare." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparer liste les tableaux que les deux parties partagent. Choisissez les tableaux à comparer, puis appuyez sur Comparer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비교는 양쪽이 공유하는 테이블을 나열합니다. 비교할 테이블을 선택한 다음 비교를 누르십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karşılaştırma, iki tarafın da paylaştığı tabloları listeler. Karşılaştırılacak tabloları seçin, sonra Karşılaştır'a basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh liệt kê các bảng có ở cả hai bên. Chọn các bảng cần so sánh, rồi nhấn So sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较会列出双方共有的表。选择要比较的表，然后点按“比较”。"
