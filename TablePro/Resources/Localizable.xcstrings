      }
    },
    "The statements ran but the transaction could not be committed: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclarations ont été exécutées mais la transaction n'a pas pu être effectuée : %@"
          }
