          }
        }
      }
    },
    "%@ holds an empty key, which the MongoDB client library will not insert. Set it to NULL, then set it on the saved document." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contient une clé vide, que la bibliothèque cliente MongoDB n’insère pas. Définissez-le sur NULL, puis renseignez-le dans le document enregistré."
          }
        }
      }
    },
    "%@ holds binary data. Edit it as bytes, or set it to NULL." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contient des données binaires. Modifiez-le sous forme d’octets, ou définissez-le sur NULL."
          }
        }
      }
    },
    "%@ holds text in some rows and documents or arrays in others, so this value could be either. Change it with a query." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contient du texte dans certaines lignes et des documents ou des tableaux dans d’autres, cette valeur peut donc être l’un ou l’autre. Modifiez-la avec une requête."
          }
        }
      }
    },
    "%@ in the workbook expands to far more data than it holds, so it was not read." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
