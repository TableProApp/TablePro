    "The SSO session for profile \"%@\" has expired. Sign in with your browser?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 \"%@\"의 SSO 세션이 만료되었습니다. 브라우저에서 로그인하시겠습니까?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên SSO của hồ sơ \"%@\" đã hết hạn. Đăng nhập bằng trình duyệt?"
          }
