          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎沒有回傳可匯出的結果集。"
          }
        }
      }
    },
    "The export file could not be written." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier d'exportation n'a pas pu être écrit."
