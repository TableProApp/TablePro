    "What an INSERT does when the row already exists. MySQL, MariaDB, PostgreSQL and SQLite each spell this differently; an engine with no spelling for it writes plain inserts and the summary says so." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que fait un INSERT lorsque la ligne existe déjà. MySQL, MariaDB, PostgreSQL et SQLite l’écrivent chacun différemment ; un moteur sans syntaxe pour cela écrit de simples insertions, et le résumé l’indique."
          }
        }
      }
    },
