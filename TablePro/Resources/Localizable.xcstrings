          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã đã được sao chép vào clipboard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码已复制到剪贴板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證碼已複製到剪貼簿。"
          }
        }
      }
    },
    "The connection is not available. Reconnect and try again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 사용할 수 없습니다. 다시 연결한 후 재시도하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı kullanılamıyor. Yeniden bağlanıp tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối không khả dụng. Hãy kết nối lại và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接不可用。请重新连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
