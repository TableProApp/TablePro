    "Thanks. Your license is what pays for the next release." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci. C’est votre licence qui finance la prochaine version."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감사합니다. 여러분의 라이선스가 다음 릴리스를 만듭니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teşekkürler. Bir sonraki sürümü sizin lisansınız finanse ediyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm ơn bạn. Giấy phép của bạn là thứ chi trả cho bản phát hành tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢谢。你的许可证支付了下一个版本的开发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "謝謝。你的授權支付了下一個版本的開發。"
          }
        }
      }
    },
    "That connection is no longer open." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion n’est plus ouverte."
