    "Are you sure you want to delete the group \"%@\" and its subgroups? Their connections will be moved to the top level." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer le groupe « %@ » et ses sous-groupes ? Leurs connexions seront déplacées au niveau supérieur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 그룹과 하위 그룹을 삭제하시겠습니까? 그 안의 연결은 최상위 수준으로 이동됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" grubunu ve alt gruplarını silmek istediğinize emin misiniz? İçlerindeki bağlantılar üst seviyeye taşınacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc muốn xóa nhóm \"%@\" và các nhóm con của nó? Các kết nối bên trong sẽ được chuyển lên cấp cao nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要删除分组 \"%@\" 及其子分组吗？其中的连接将移至顶层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定要刪除群組「%@」及其子群組嗎？其中的連線將移至頂層。"
          }
        }
      }
    },
