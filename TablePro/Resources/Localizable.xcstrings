    "Pro features stop on this Mac right away. You can activate this license again later." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 功能會在此 Mac 上立即停用。你之後可以重新啟用此授權。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 기능이 이 Mac에서 즉시 중지됩니다. 나중에 이 라이선스를 다시 활성화할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tính năng Pro dừng ngay trên máy Mac này. Bạn có thể kích hoạt lại giấy phép này sau."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro özellikleri bu Mac'te hemen durur. Bu lisansı daha sonra yeniden etkinleştirebilirsiniz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Les fonctionnalités Pro s'arrêtent immédiatement sur ce Mac. Vous pouvez réactiver cette licence plus tard.",
            "state" : "translated"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 功能会在此 Mac 上立即停用。你之后可以重新激活此许可证。"
          }
        }
      }
    },
