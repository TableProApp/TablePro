          }
        }
      }
    },
    "The table has no column named %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La table n'a pas de colonne nommée %@."
          }
        }
      }
    },
    "The table has no primary key, so this row cannot be identified." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La table n'a pas de clé primaire, donc cette ligne ne peut pas être identifiée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테이블에 기본 키가 없어 이 행을 식별할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablonun birincil anahtarı yok, bu yüzden bu satır tanımlanamıyor."
          }
        },
        "vi" : {
