    "Listens on all interfaces (0.0.0.0), reachable from your local network." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute sur toutes les interfaces (0.0.0.0), accessible depuis votre réseau local."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 인터페이스(0.0.0.0)에서 수신 대기하므로 로컬 네트워크에서 접근할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
