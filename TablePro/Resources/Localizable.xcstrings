    "%@ +%d more" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ +%2$d more"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ +%2$d autres"
          }
        }
      }
    },
    "%@ accepted the SSH connection but refused the SFTP subsystem." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a accepté la connexion SSH mais a refusé le sous-système SFTP."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) SSH 연결은 수락했지만 SFTP 하위 시스템은 거부했습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ SSH bağlantısını kabul etti ancak SFTP alt sistemini reddetti."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã chấp nhận kết nối SSH nhưng từ chối hệ thống con SFTP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 接受了 SSH 连接，但拒绝了 SFTP 子系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 接受了 SSH 連線，但拒絕了 SFTP 子系統。"
          }
        }
      }
    },
    "%@ accepts null" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ accepte null"
          }
        }
      }
    },
    "%@ acts on the whole database. Omit 'table'." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agit sur toute la base de données. Omettez « table »."
          }
        }
      }
    },
    "%@ are invalid, so queries skip them and exports leave them out. Drop them, or rebuild them with REINDEX." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne sont pas valides, donc les requêtes les ignorent et les exportations les omettent. Supprimez-les ou reconstruisez-les avec REINDEX."
          }
        }
      }
    },
    "%@ can only be compared with a whole number." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut être comparé qu’à un nombre entier."
          }
        }
      }
    },
    "%@ cannot add or remove a table's constraints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ajouter ni supprimer les contraintes d’une table."
          }
        }
      }
    },
    "%@ cannot add or remove a table's foreign keys." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ajouter ni supprimer les clés étrangères d’une table."
          }
        }
      }
    },
    "%@ cannot add or remove a table's indexes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ajouter ni supprimer les index d’une table."
          }
        }
      }
    },
    "%@ cannot be compared, because its driver does not expose metadata." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être comparé, car son pilote n’expose pas de métadonnées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 드라이버가 메타데이터를 제공하지 않아 비교할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ karşılaştırılamaz, çünkü sürücüsü meta veri sunmuyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể so sánh %@ vì driver của nó không cung cấp metadata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法比较 %@，因为其驱动不提供元数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法比較 %@，因為其驅動程式不提供中繼資料。"
          }
        }
      }
    },
    "%@ cannot be empty" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être vide"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 필드는 비워 둘 수 없습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cannot be boş"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không được để trống"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能为空"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能為空白"
          }
        }
      }
    },
    "%@ cannot be narrowed to some rows or columns, because this database has no SQL." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être limité à certaines lignes ou colonnes, car cette base de données ne prend pas en charge SQL."
          }
        }
      }
    },
    "%@ cannot be negative" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être négatif"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 값은 음수일 수 없습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cannot be negatif"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không được là số âm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能为负数"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能為負數"
          }
        }
      }
    },
    "%@ cannot be scripted with its indexes, because the target's index statements would name a different schema than its definition." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de générer le script de %@ avec ses index, car les instructions d’index de la cible désigneraient un autre schéma que sa définition."
          }
        }
      }
    },
    "%@ cannot be scripted, because its definition is not a statement that recreates it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de générer le script de %@, car sa définition n’est pas une instruction qui le recrée."
          }
        }
      }
    },
    "%@ cannot be the primary key. MongoDB keys every document by _id." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être la clé primaire. MongoDB identifie chaque document par _id."
          }
        }
      }
    },
    "%@ cannot change the order of a table's columns." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas modifier l’ordre des colonnes d’une table."
          }
        }
      }
    },
    "%@ cannot compare two of its own databases at once, because it reads both through one connection. Use a second connection for the target." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas comparer deux de ses propres bases de données à la fois, car il les lit via une seule connexion. Utilisez une deuxième connexion pour la cible."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 하나의 연결로 양쪽을 읽기 때문에 자체 데이터베이스 두 개를 동시에 비교할 수 없습니다. 대상에는 다른 연결을 사용하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kendi iki veritabanını aynı anda karşılaştıramaz, çünkü ikisini de tek bağlantı üzerinden okur. Hedef için ikinci bir bağlantı kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thể so sánh hai cơ sở dữ liệu của chính nó cùng lúc, vì nó đọc cả hai qua một kết nối. Hãy dùng kết nối thứ hai cho đích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法同时比较自身的两个数据库，因为它通过一个连接读取两者。请为目标使用第二个连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法同時比較自身的兩個資料庫，因為它透過一個連線讀取兩者。請為目標使用第二個連線。"
          }
        }
      }
    },
    "%@ cannot create a database." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas créer de base de données."
          }
        }
      }
    },
    "%@ cannot edit a table's structure." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas modifier la structure d’une table."
          }
        }
      }
    },
    "%@ cannot have constraints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas avoir de contraintes."
          }
        }
      }
    },
    "%@ cannot have indexes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas avoir d’index."
          }
        }
      }
    },
    "%@ cannot index an expression. Index a generated column instead." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas indexer une expression. Indexez plutôt une colonne générée."
          }
        }
      }
    },
    "%@ cannot make this change to a table's columns." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas apporter cette modification aux colonnes d’une table."
          }
        }
      }
    },
    "%@ cannot restore a deleted row with its original key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas restaurer une ligne supprimée avec sa clé d’origine."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 삭제된 행을 원래 키로 복원할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, silinmiş bir satırı özgün anahtarıyla geri yükleyemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thể khôi phục dòng đã xoá với khoá gốc của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法用原来的键恢复已删除的行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法用原來的鍵還原已刪除的列。"
          }
        }
      }
    },
    "%@ cannot start with a dash or contain spaces" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas commencer par un tiret ni contenir d’espaces"
          }
        }
      }
    },
    "%@ cannot take rows from this file, so no table was created." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas extraire de lignes de ce fichier, aucune table n’a donc été créée."
          }
        }
      }
    },
    "%@ cells" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cellules"
          }
        }
      }
    },
    "%@ changed after it was compared. Compare again before generating the script." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été modifié après la comparaison. Comparez de nouveau avant de générer le script."
          }
        }
      }
    },
    "%@ changed after this save was prepared, so nothing was changed. Review the save and save again." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été modifié après la préparation de cet enregistrement, rien n’a donc été modifié. Vérifiez l’enregistrement, puis enregistrez de nouveau."
          }
        }
      }
    },
    "%@ changed while its documents were being checked, so nothing was changed. Save again." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été modifié pendant la vérification de ses documents, rien n’a donc été modifié. Enregistrez de nouveau."
          }
        }
      }
    },
    "%@ completed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terminé"
          }
        },
        "ko" : {
