    "This change needs %@ to be recreated, and it cannot be recreated from the definition the database stored for it. Virtual tables, such as full-text search tables, are the usual reason." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "value" : "Ce changement nécessite que %@ soit recréé, et il ne peut pas être recréé à partir de la définition stockée dans la base de données pour lui. Les tables virtuelles, telles que les tables de recherche de texte intégral, sont la raison habituelle.",
            "state" : "translated"
          }
        }
      }
    },
    "Restrict to one connection. Omit for every readable connection." : {
      "localizations" : {
