          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지를 이동하면 데이터가 다시 로드되고 저장하지 않은 모든 변경 사항이 폐기됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
