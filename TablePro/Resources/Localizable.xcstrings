    "TablePro's Safe Mode is set to read-only for this connection. Destructive operations are not permitted." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode sécurisé de TablePro est réglé en lecture seule pour cette connexion. Les opérations destructrices ne sont pas autorisées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결에서는 TablePro의 안전 모드가 읽기 전용으로 설정되어 있습니다. 파괴적인 작업은 허용되지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantı için TablePro'nun Safe Mode ayarı salt okunur. Yıkıcı işlemlere izin verilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ an toàn của TablePro đang đặt kết nối này ở chế độ chỉ đọc. Không cho phép các thao tác phá hủy dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 的安全模式已将此连接设为只读。不允许执行破坏性操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 的安全模式已將此連線設為唯讀。不允許執行破壞性操作。"
          }
        }
      }
    },
    "TablePro's Safe Mode is set to read-only for this connection. Set it to Confirm Writes or higher to allow this tool." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
