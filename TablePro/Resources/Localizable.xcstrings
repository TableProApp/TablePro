    "The SQL after DEFAULT. A text value needs its own quotes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le SQL qui suit DEFAULT. Une valeur texte doit avoir ses propres guillemets."
          }
        }
      }
    },
    "The SQL Server Kerberos service principal name is not registered." : {
      "extractionState" : "manual",
