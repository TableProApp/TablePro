          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu motorun bir SQL lehçesi yok, bu yüzden tablolar genel bir şekilde seçilemiyor."
          }
        },
        "vi" : {
