    "Excel on Windows needs this to read UTF-8. Other readers show it as part of the first value." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excel sur Windows a besoin de cela pour lire UTF-8. D'autres lecteurs le montrent comme faisant partie de la première valeur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows의 Excel은 UTF-8을 읽으려면 이것이 필요합니다. 다른 리더는 첫 번째 값의 일부로 표시합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows'taki Excel, UTF-8 okumak için buna ihtiyaç duyar. Diğer okuyucular bunu ilk değerin parçası olarak gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excel trên Windows cần dấu này để đọc UTF-8. Các trình đọc khác hiển thị nó như một phần của giá trị đầu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows 版 Excel 需要它才能读取 UTF-8。其他阅读器会将它显示为第一个值的一部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows 版 Excel 需要它才能讀取 UTF-8。其他讀取器會將它顯示為第一個值的一部分。"
          }
        }
      }
    },
