          }
        }
      }
    },
    "The connection to Redis dropped after EXEC was sent, so whether the block ran is unknown." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
