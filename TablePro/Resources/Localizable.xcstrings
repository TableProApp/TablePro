    "One username and password, shared by any number of connections. Change it here and every connection using it signs in with the new one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom d'utilisateur et un mot de passe, partagés par un nombre illimité de connexions. Changez-le ici et chaque connexion qui l'utilise se connecte avec le nouveau."
          }
        }
      }
    },
    "Only %1$d of %2$d bytes of %3$@ arrived." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement %1$d de %2$d octets de %3$@ sont arrivés."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@의 %2$d바이트 중 %1$d바이트만 도착했습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ için %2$d baytın yalnızca %1$d baytı ulaştı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ %1$d trên %2$d byte của %3$@ đã tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 的 %2$d 字节中只到达了 %1$d 字节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 的 %2$d 位元組中只到達了 %1$d 位元組。"
          }
        }
      }
    },
    "Only a SQL dump is read compressed. Expand it first, then import the %@." : {
      "comment" : "A suggestion to expand a compressed SQL dump before importing. The argument is the name of the format that the user can choose from the list.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul un décompte SQL est lu compressé. Développez-le d'abord, puis importez le %@."
          }
        }
      }
    },
    "Only affects new saves. Re-save a password to update its sync." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'affecte que les nouveaux sauvegardes. Sauvegardez à nouveau un mot de passe pour mettre à jour sa synchronisation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 저장하는 항목에만 적용됩니다. 동기화 설정을 업데이트하려면 암호를 다시 저장하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yeni kayıtları etkiler. Bir parolanın eşzamanlamasını güncellemek için parolayı yeniden kaydedin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ áp dụng cho lần lưu mới. Lưu lại mật khẩu để cập nhật đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响新保存的内容。重新保存密码以更新其同步状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅影響新儲存的內容。重新儲存密碼以更新其同步狀態。"
          }
        }
      }
    },
