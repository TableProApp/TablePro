    "Keeps the first row of each group of matching rows. Rows hidden by a filter or search are not compared." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve la première ligne de chaque groupe de lignes correspondantes. Les lignes masquées par un filtre ou une recherche ne sont pas comparées."
          }
        }
      }
    },
    "Keeps the last %d versions on this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve les %d dernières versions sur ce Mac."
          }
        }
      }
    },
    "Keeps what rows looked like before each save, on this Mac only, for 7 days. It is encrypted, and never synced." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve l’état des lignes avant chaque enregistrement, sur ce Mac uniquement, pendant 7 jours. Ces données sont chiffrées et jamais synchronisées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 저장 이전의 행 상태를 이 Mac에만 7일 동안 보관합니다. 암호화되며 동기화되지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kaydetmeden önce satırların nasıl göründüğünü yalnızca bu Mac'te 7 gün saklar. Şifrelenir ve asla eşitlenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ lại trạng thái của các dòng trước mỗi lần lưu, chỉ trên máy Mac này, trong 7 ngày. Dữ liệu được mã hoá và không bao giờ đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在这台 Mac 上保留每次保存之前的行内容，保留 7 天。它是加密的，且从不同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在這台 Mac 上保留每次儲存之前的列內容，保留 7 天。它是加密的，且從不同步。"
          }
        }
      }
    },
