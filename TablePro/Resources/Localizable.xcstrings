          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來源和目標是同一個資料庫。"
          }
        }
      }
    },
    "The source and the target are the same database. Choose a different target." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la cible sont la même base de données. Choisissez une cible différente."
          }
        }
      }
    },
    "The source and the target have no table of the same name." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la cible n'ont pas de table du même nom."
          }
        }
      }
    },
    "The source and the target share no writable column." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source et la cible n'ont pas de colonne écrivable en commun."
          }
        }
      }
    },
    "The source could not be read with its filter: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source ne pouvait pas être lu avec son filtre : %@"
          }
        }
      }
    },
    "The source could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source n'a pas pu être lu : %@"
          }
        }
      }
    },
    "The source driver cannot be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote de source ne peut pas être lu."
          }
        }
      }
    },
    "The source driver cannot stream rows for a comparison." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote de source ne peut pas diffuser des lignes pour une comparaison."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 드라이버는 비교를 위해 행을 스트리밍할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynak sürücü karşılaştırma için satır akıtamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Driver nguồn không thể đọc dòng theo luồng để so sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源驱动无法为比较流式读取行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來源驅動程式無法為比較串流讀取列。"
          }
        }
      }
    },
    "The source driver cannot stream rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote de source ne peut pas diffuser des lignes."
          }
        }
      }
    },
    "The source reports no definition for it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source ne rapporte aucune définition pour cela."
          }
        }
      }
    },
    "The source returned a body rather than a statement that recreates it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source a renvoyé un corps plutôt qu'une déclaration qui le recrée."
          }
        }
      }
    },
    "The source returned an empty definition." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source a renvoyé une définition vide."
          }
        }
      }
    },
    "The source, the target, the mode and the options come back when you load it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source, la cible, le mode et les options reviennent lorsque vous la chargez."
          }
        }
      }
    },
    "The source's definition could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La définition de la source n'a pas pu être lu : %@"
          }
        }
      }
    },
    "The source's indexes could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les index de la source ne pouvaient pas être lus : %@"
          }
        }
      }
    },
    "The SQL after DEFAULT. A text value needs its own quotes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La SQL après DEFAULT. Une valeur de texte a besoin de ses propres guillemets."
          }
        }
      }
    },
    "The SSH account cannot read %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte SSH ne peut pas lire %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 계정이 %@을(를) 읽을 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH hesabı %@ dosyasını okuyamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản SSH không đọc được %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 SSH 账户无法读取 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該 SSH 帳號無法讀取 %@。"
          }
        }
      }
    },
    "The SSH agent from %@ holds no key matching the identity file set for this host. Check that the file names a key the agent has, or clear it to offer every key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent SSH de %@ ne contient pas de clé correspondant au fichier d'identité défini pour cet hôte. Vérifiez que les noms de fichiers correspondent à la clé que l'agent possède, ou supprimez-les pour offrir toutes les clés."
          }
        }
      }
    },
    "The SSH agent from %@ holds no keys. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The SSH agent from %1$@ holds no keys. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent SSH de %1$@ ne possède aucune clé. %2$@"
          }
        }
      }
    },
    "The SSH server closed the connection while the agent's keys were being offered. Servers accept a limited number of tries, 6 by default, and an agent holding more keys than that runs out before the right one. Name the key with IdentityFile and IdentitiesOnly yes for this host in ~/.ssh/config, or set Identity File on this connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH a fermé la connexion pendant que les clés de l'agent étaient proposées. Les serveurs acceptent un nombre limité d'essais, 6 par défaut, et un agent qui détient plus de clés que cela s'épuise avant la bonne. Nommez la clé avec IdentityFile et IdentitiesOnly oui pour cet hôte dans ~/.ssh/config, ou définissez le fichier d'identité sur cette connexion."
          }
        }
      }
    },
    "The SSH server connects to this socket instead of Host and Port. A database on a socket cannot negotiate TLS, so TablePro turns it off; the SSH tunnel still encrypts the whole path." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH se connecte à ce socket au lieu d'Host et de Port. Une base de données sur un socket ne peut pas négocier TLS, donc TablePro l'éteint ; le tunnel SSH cryptage toujours l'ensemble du chemin."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버는 호스트 및 포트 대신 이 소켓에 연결합니다. 소켓의 데이터베이스는 TLS를 협상할 수 없으므로 TablePro에서 TLS를 끕니다. 단, SSH 터널은 전체 경로를 계속 암호화합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucusu, Sunucu ve Port yerine bu sokete bağlanır. Soket üzerindeki bir veritabanı TLS anlaşması yapamaz, bu yüzden TablePro TLS'i kapatır; SSH tüneli yine de tüm yolu şifreler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ SSH kết nối tới socket này thay vì Máy chủ và Cổng. Cơ sở dữ liệu trên socket không thể thương lượng TLS, nên TablePro tắt TLS; đường hầm SSH vẫn mã hóa toàn bộ đường truyền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器会连接到此 socket，而不是主机和端口。socket 上的数据库无法协商 TLS，因此 TablePro 会关闭 TLS；SSH 隧道仍然加密整条链路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器會連線到此 socket，而不是主機與連接埠。socket 上的資料庫無法協商 TLS，因此 TablePro 會關閉 TLS；SSH 通道仍會加密整條路徑。"
          }
        }
      }
    },
    "The SSH server could not reach %@. That address is resolved from the SSH server, not from your Mac, so a database that only listens on 127.0.0.1 needs Host set to localhost. Also check that sshd allows TCP forwarding (AllowTcpForwarding). (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The SSH server could not reach %1$@. That address is resolved from the SSH server, not from your Mac, so a database that only listens on 127.0.0.1 needs Host set to localhost. Also check that sshd allows TCP forwarding (AllowTcpForwarding). (%2$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH n'a pas pu atteindre %1$@. Cette adresse est résolue par le serveur SSH, et non par votre Mac, donc une base de données qui ne s'écoute que sur 127.0.0.1 nécessite que l'hôte soit défini sur localhost. Vérifiez également que sshd autorise le redirection TCP (AllowTcpForwarding). (%2$@)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버에서 %1$@에 연결할 수 없습니다. 이 주소는 Mac이 아니라 SSH 서버에서 확인되므로, 127.0.0.1에서만 수신하는 데이터베이스의 호스트는 localhost로 설정해야 합니다. sshd에서 TCP 전달(AllowTcpForwarding)을 허용하는지도 확인하십시오. (%2$@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucusu %1$@ adresine ulaşamadı. Bu adres sizin Mac'inizden değil, SSH sunucusundan çözümlenir; bu yüzden yalnızca 127.0.0.1 dinleyen bir veritabanı için Sunucu alanı localhost olmalıdır. Ayrıca sshd'nin TCP yönlendirmeye izin verdiğini denetleyin (AllowTcpForwarding). (%2$@)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ SSH không thể kết nối tới %1$@. Địa chỉ đó được phân giải từ máy chủ SSH chứ không phải từ máy Mac của bạn, nên cơ sở dữ liệu chỉ lắng nghe trên 127.0.0.1 cần đặt Máy chủ là localhost. Ngoài ra hãy kiểm tra sshd có cho phép chuyển tiếp TCP không (AllowTcpForwarding). (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器无法访问 %1$@。该地址是从 SSH 服务器解析的，而不是从你的 Mac 解析，因此只监听 127.0.0.1 的数据库需要把主机设为 localhost。另请检查 sshd 是否允许 TCP 转发（AllowTcpForwarding）。(%2$@)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器無法連到 %1$@。該位址是從 SSH 伺服器解析的，而不是從你的 Mac 解析，因此只監聽 127.0.0.1 的資料庫需要將主機設為 localhost。另請檢查 sshd 是否允許 TCP 轉送（AllowTcpForwarding）。(%2$@)"
          }
        }
      }
    },
    "The SSH server did not accept passwordless authentication. Choose Password, Private Key, or SSH Agent." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH n'a pas accepté l'authentification sans mot de passe. Choisissez Mot de passe, Clé privée ou Agent SSH."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버에서 암호 없는 인증을 허용하지 않았습니다. 암호, 개인 키 또는 SSH 에이전트를 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucusu parolasız kimlik doğrulamayı kabul etmedi. Parola, Özel Anahtar veya SSH Agent seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ SSH không chấp nhận xác thực không mật khẩu. Hãy chọn Mật khẩu, Khóa riêng hoặc SSH Agent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器不接受无密码认证。请选择密码、私钥或 SSH Agent。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器不接受無密碼驗證。請選擇密碼、私密金鑰或 SSH Agent。"
          }
        }
      }
    },
    "The SSH server did not open a forwarding channel to %@ within %d seconds. Check for a firewall between the SSH server and that address." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The SSH server did not open a forwarding channel to %1$@ within %2$d seconds. Check for a firewall between the SSH server and that address."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH n'a pas ouvert un canal de redirection vers %1$@ dans %2$d secondes. Vérifiez s'il y a un pare-feu entre le serveur SSH et cette adresse."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버가 %2$d초 이내에 %1$@에 대한 전달 채널을 열지 못했습니다. SSH 서버와 해당 주소 사이에 방화벽이 있는지 확인하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucusu %2$d saniye içinde %1$@ adresine bir yönlendirme kanalı açmadı. SSH sunucusu ile bu adres arasında güvenlik duvarı olup olmadığını denetleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ SSH không mở kênh chuyển tiếp tới %1$@ trong %2$d giây. Hãy kiểm tra tường lửa giữa máy chủ SSH và địa chỉ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器未在 %2$d 秒内建立到 %1$@ 的转发通道。请检查 SSH 服务器与该地址之间是否有防火墙。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器未在 %2$d 秒內建立到 %1$@ 的轉送通道。請檢查 SSH 伺服器與該位址之間是否有防火牆。"
          }
        }
      }
    },
    "The SSH server does not offer that authentication method." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH ne propose pas ce mode d'authentification."
          }
        }
      }
    },
    "The SSH server is asking for additional verification." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH demande une vérification supplémentaire."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버에서 추가 인증을 요청하고 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucusu ek doğrulama istiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ SSH đang yêu cầu xác minh bổ sung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器要求进行额外验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器要求進行額外驗證。"
          }
        }
      }
    },
    "The SSH server would not forward the socket %@. Check that the path exists on the server and that sshd allows socket forwarding (AllowStreamLocalForwarding). (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The SSH server would not forward the socket %1$@. Check that the path exists on the server and that sshd allows socket forwarding (AllowStreamLocalForwarding). (%2$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur SSH ne renvoyait pas le socket %1$@. Vérifiez que le chemin existe sur le serveur et que sshd autorise le renvoi du socket (AllowStreamLocalForwarding). (%2$@)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 서버에서 소켓 %1$@ 전달을 허용하지 않았습니다. 서버에 해당 경로가 있는지, sshd에서 소켓 전달(AllowStreamLocalForwarding)을 허용하는지 확인하십시오. (%2$@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH sunucusu %1$@ soketini yönlendirmedi. Yolun sunucuda var olduğunu ve sshd'nin soket yönlendirmeye izin verdiğini denetleyin (AllowStreamLocalForwarding). (%2$@)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ SSH không chuyển tiếp socket %1$@. Hãy kiểm tra đường dẫn có tồn tại trên máy chủ và sshd có cho phép chuyển tiếp socket không (AllowStreamLocalForwarding). (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器未转发 socket %1$@。请检查该路径在服务器上是否存在，以及 sshd 是否允许 socket 转发（AllowStreamLocalForwarding）。(%2$@)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 伺服器未轉送 socket %1$@。請檢查該路徑在伺服器上是否存在，以及 sshd 是否允許 socket 轉送（AllowStreamLocalForwarding）。(%2$@)"
          }
        }
      }
    },
    "The ssh-agent macOS runs, from SSH_AUTH_SOCK. 1Password and Secretive listen elsewhere." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent ssh macOS s'exécute, à partir de SSH_AUTH_SOCK. 1Password et Secretive écoutent ailleurs."
          }
        }
      }
    },
    "The SSO session for profile \"%@\" has expired. Sign in with your browser?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
