        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối này chạy SQL mỗi lần kết nối, bằng thông tin đăng nhập của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
