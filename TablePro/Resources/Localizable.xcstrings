            "state" : "translated",
            "value" : "來源驅動程式無法為比較串流讀取列。"
          }
        }
      }
    },
    "The source driver cannot stream rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote de la source ne peut pas transmettre de lignes en continu."
          }
        }
      }
    },
    "The source reports no definition for it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source n’indique aucune définition pour cet objet."
          }
        }
      }
    },
    "The source returned a body rather than a statement that recreates it." : {
      "localizations" : {
