      }
    },
    "The app stays free, all of it. If TablePro is useful to you, a license is what pays for the next release." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app reste gratuite, dans son intégralité. Si TablePro vous est utile, c’est une licence qui finance la prochaine version."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 전체가 계속 무료입니다. TablePro가 쓸모 있었다면, 라이선스가 다음 릴리스를 만듭니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın tamamı ücretsiz kalır. TablePro işinize yarıyorsa, bir sonraki sürümü lisanslar finanse eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn bộ ứng dụng vẫn miễn phí. Nếu TablePro hữu ích với bạn, giấy phép là thứ chi trả cho bản phát hành tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个 App 一直免费。如果 TablePro 对你有用，许可证支付了下一个版本的开发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整個 App 一直免費。如果 TablePro 對你有用，授權支付了下一個版本的開發。"
          }
        }
      }
    },
    "The assistant answers once the connection is up" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant répondra une fois la connexion établie"
          }
        }
      }
    },
    "The authenticity of host '%@' can't be established.\n\n%@ key fingerprint is:\n%@\n\nAre you sure you want to continue connecting?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The authenticity of host '%1$@' can't be established.\n\n%2$@ key fingerprint is:\n%3$@\n\nAre you sure you want to continue connecting?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authenticité de l’hôte « %1$@ » ne peut pas être établie.\n\nL’empreinte de la clé %2$@ est :\n%3$@\n\nVoulez-vous vraiment continuer à vous connecter ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 '%1$@'의 신뢰성을 확인할 수 없습니다.\n\n%2$@ 키 지문:\n%3$@\n\n계속 연결하시겠습니까?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The authenticity / host '%@' can't be established.\n\n%@ key fingerprint is:\n%@\n\nAre you sure you want to continue connecting?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác minh tính xác thực của máy chủ '%@'.\n\nVân tay khóa %@ là:\n%@\n\nBạn có chắc chắn muốn tiếp tục kết nối?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认主机 '%@' 的真实性。\n\n%@ 密钥指纹为：\n%@\n\n确定要继续连接吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認主機「%1$@」的真實性。\n\n%2$@ 金鑰指紋為：\n%3$@\n\n你確定要繼續連線嗎？"
          }
        }
      }
    },
    "The AWS credentials for this profile have expired. Sign in again and retry." : {
