      }
    },
    "For a metered path on Anthropic's commercial terms, add the Claude provider with an API key instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un chemin mesuré selon les conditions commerciales d'Anthropic, ajoutez plutôt le fournisseur Claude avec une clé API."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic의 상용 약관에 따른 종량제 방식을 이용하려면 대신 API 키를 사용해 Claude 제공자를 추가하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic'in ticari koşullarıyla kullanım başına ödemeli bir yol için bunun yerine Claude sağlayıcısını bir API anahtarıyla ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu muốn cách tính phí theo mức dùng theo điều khoản thương mại của Anthropic, hãy thêm nhà cung cấp Claude bằng khóa API."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若想走 Anthropic 商业条款下的按量计费路径，请改为添加带 API 密钥的 Claude 提供方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若想走 Anthropic 商業條款下的按量計費路徑，請改為新增帶 API 金鑰的 Claude 供應商。"
          }
        }
      }
    },
    "foreign key" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé étrangère"
          }
        }
      }
    },
    "Foreign key" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé étrangère"
          }
        }
      }
    },
    "Foreign key %@ matches %@ on the target but the names differ." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Foreign key %1$@ matches %2$@ on the target but the names differ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé étrangère %1$@ correspond à %2$@ sur la cible, mais les noms diffèrent."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외래 키 %@은(는) 대상의 %@과(와) 일치하지만 이름이 다릅니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ yabancı anahtarı hedefteki %2$@ ile eşleşiyor ama adları farklı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ngoại %1$@ khớp với %2$@ trên đích nhưng tên khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外键 %1$@ 与目标上的 %2$@ 相同，但名称不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外鍵 %1$@ 與目標上的 %2$@ 相同，但名稱不同。"
          }
        }
      }
    },
    "Foreign key must have at least one column, a referenced table, and a referenced column" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé étrangère doit comporter au moins une colonne, une table référencée et une colonne référencée."
