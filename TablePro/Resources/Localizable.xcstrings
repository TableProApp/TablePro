          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密的檔案已損毀或不完整"
          }
        }
      }
    },
    "The engine returned no result set to export." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur n'a pas renvoyé de jeu de résultats à exporter."
