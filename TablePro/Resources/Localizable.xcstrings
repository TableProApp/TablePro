          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir veritabanındaki tablo ve görünüm adları. Göz atılanın dışına bakmak için database ve schema, yaklaşık satır sayıları için row_counts=true geçirin."
