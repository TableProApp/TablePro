            "value" : "이 계획을 트리로 읽을 수 없습니다. 원시 출력을 표시합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu plan ağaç olarak okunamadı. Ham çıktı gösteriliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được kế hoạch này dưới dạng cây. Đang hiển thị kết quả thô."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将此执行计划读取为树形结构。显示原始输出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將此執行計畫讀取為樹狀結構。顯示原始輸出。"
          }
        }
      }
    },
