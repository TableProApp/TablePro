    "Open a database to browse its tables." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez une base de données pour parcourir ses tables."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테이블을 보려면 데이터베이스를 여세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablolarına göz atmak için bir veritabanı açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
