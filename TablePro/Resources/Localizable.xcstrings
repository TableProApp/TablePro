        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 항목이 이 Mac과 다른 기기에서 모두 수정되었습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" bu Mac ve başka bir cihazda değiştirildi."
