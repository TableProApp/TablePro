    "Statements already executed stay committed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instructions déjà exécutées restent validées."
          }
        }
      }
    },
    "Statements run on the SSH server, so reads and writes act on the live database. The server needs python3." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instructions s’exécutent sur le serveur SSH : les lectures et les écritures s’appliquent donc à la base de données réelle. Le serveur doit disposer de python3."
          }
        }
      }
    },
    "Statements TablePro generated and ran" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instructions générées et exécutées par TablePro"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro가 생성하고 실행한 명령문"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro'nun ürettiği ve çalıştırdığı ifadeler"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các câu lệnh mà TablePro đã tạo và chạy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 生成并运行的语句"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro 產生並執行的陳述式"
          }
        }
      }
    },
    "Statements that already ran stay applied to %@. Compare again to see where it stands." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instructions déjà exécutées restent appliquées à %@. Relancez la comparaison pour voir son état actuel."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 실행된 구문은 %@에 적용된 상태로 남습니다. 현재 상태를 보려면 다시 비교하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten çalışmış ifadeler %@ üzerinde uygulanmış kalır. Durumu görmek için yeniden karşılaştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những câu lệnh đã chạy vẫn được áp dụng trên %@. Hãy so sánh lại để xem tình trạng hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已经执行的语句仍应用在 %@ 上。请重新比较以查看当前状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已經執行的陳述式仍套用在 %@ 上。請重新比較以查看目前狀態。"
          }
        }
      }
    },
    "Statements that read or write files, or that run server-side code, cannot be sent from outside the app. Run this one in TablePro instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instructions qui lisent ou écrivent des fichiers, ou qui exécutent du code côté serveur, ne peuvent pas être envoyées depuis l’extérieur de l’app. Exécutez plutôt celle-ci dans TablePro."
          }
        }
      }
    },
