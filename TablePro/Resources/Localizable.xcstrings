          }
        }
      }
    },
    "Open a different file from the Welcome window." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un autre fichier depuis la fenêtre de bienvenue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작 윈도우에서 다른 파일을 여십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoş Geldiniz penceresinden farklı bir dosya açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở tệp khác từ cửa sổ Chào mừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
