            "value" : "La ligne %1$@ dans ~/.ssh/config utilise ${%2$@}, qui n'est pas définie dans l'environnement."
          }
        }
      }
    },
    "The %@ plugin could not be loaded." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin %@ n'a pas pu être chargé."
          }
        }
      }
    },
    "The %@ plugin is not installed. TablePro offers to install it on connect." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin %@ n'est pas installé. TablePro vous propose de l'installer sur connect."
          }
        }
      }
    },
    "The %@ plugin is not installed. Would you like to download it from the plugin marketplace?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plugin %@ n'est pas installé. Voulez-vous le télécharger depuis le marché des plugins ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 플러그인이 설치되어 있지 않습니다. 플러그인 마켓플레이스에서 다운로드하시겠습니까?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ plugin is not installed. Would you like to indirme it from the plugin marketplace?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin %@ chưa được cài đặt. Bạn có muốn tải về từ chợ plugin?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 插件未安装。是否要从插件市场下载？"
