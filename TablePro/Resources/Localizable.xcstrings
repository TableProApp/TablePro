        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기 파일을 쓸 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarma dosyası yazılamadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ghi được tệp xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入导出文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法寫入匯出檔案。"
          }
        }
      }
    },
    "The extra rows are pending in the transaction already open on this connection. Roll it back to discard them. '%@' has no primary key, so identical rows cannot be told apart." : {
      "comment" : "A suggestion to roll back a transaction.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes supplémentaires sont en attente dans la transaction déjà ouverte sur cette connexion. Revoyez-les pour les rejeter. '%@' n'a pas de clé primaire, donc les lignes identiques ne peuvent pas être distinguées."
          }
        }
      }
    },
    "The file changed while the operation ran, so nothing was applied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a changé pendant que l'opération se déroulait, donc rien n'a été appliqué."
          }
        }
      }
    },
    "The file could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n'a pas pu être lu : %@"
          }
        }
      }
    },
    "The file goes back to its last committed version. You can't undo this action." : {
      "comment" : "Confirmation message for discarding changes to a file.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier retourne à sa dernière version enregistrée. Vous ne pouvez pas annuler cette action."
          }
        }
      }
    },
    "The file goes back to its staged version. You can't undo this action." : {
      "comment" : "Confirmation message for discarding changes to a favorite.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier retourne à sa version en cours de mise en scène. Vous ne pouvez pas annuler cette action."
          }
        }
      }
    },
    "The file has not finished opening." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n'a pas encore été complètement ouvert."
          }
        }
      }
    },
    "The file has uncommitted changes. Restoring this version replaces them, and you can't undo this action." : {
      "comment" : "Confirmation message when restoring a file that has uncommitted changes.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a des modifications non engagées. La restauration de cette version les remplace, et vous ne pouvez pas annuler cette action."
          }
        }
      }
    },
    "The file holds a single value, not a list of rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient une seule valeur, pas une liste de lignes."
          }
        }
      }
    },
    "The file holds one object, not a list of rows. Open a JSON array of objects or a JSON Lines file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient un seul objet, pas une liste de lignes. Ouvrez un tableau JSON d'objets ou un fichier JSON Lines."
          }
        }
      }
    },
    "The file is copied to this Mac and opened read-only. The original on the server is never written to." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est copié sur ce Mac et ouvert en lecture seule. L'original sur le serveur n'est jamais écrit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 이 Mac으로 복사되어 읽기 전용으로 열립니다. 서버의 원본에는 절대 쓰지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya bu Mac'e kopyalanır ve salt okunur açılır. Sunucudaki özgün dosyaya asla yazılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp được sao chép về máy Mac này và mở ở chế độ chỉ đọc. Bản gốc trên máy chủ không bao giờ bị ghi vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件会被复制到这台 Mac 并以只读方式打开。服务器上的原始文件绝不会被写入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該檔案會被複製到這台 Mac 並以唯讀方式開啟。伺服器上的原始檔案絕不會被寫入。"
          }
        }
      }
    },
    "The file is empty." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est vide."
          }
        }
      }
    },
    "The file is too large to read from Git." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est trop grand pour être lu depuis Git."
          }
        }
      }
    },
    "The file or its staged version changed before it could be written. Nothing was replaced." : {
      "comment" : "Error message when a file is restored from a version that has been modified.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ou sa version modifiée a changé avant qu'il ne puisse être écrit. Rien n'a été remplacé."
          }
        }
      }
    },
    "The filter field is not in the toolbar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
