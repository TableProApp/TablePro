            "value" : "골뱅이표"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "et işareti"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ký hiệu a còng"
          }
        },
