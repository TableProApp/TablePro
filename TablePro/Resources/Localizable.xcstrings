        }
      }
    },
    "That Mac keeps working until its next check, within 7 days, and then paid features pause there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac continue de fonctionner jusqu’à sa prochaine vérification, dans les 7 jours, puis les fonctionnalités payantes y sont suspendues."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 Mac은 7일 이내의 다음 확인까지 계속 작동하며, 그 후 유료 기능이 일시 중지됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac, 7 gün içindeki bir sonraki denetime kadar çalışmayı sürdürür, ardından ücretli özellikler orada duraklar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy Mac đó vẫn hoạt động cho đến lần kiểm tra kế tiếp trong vòng 7 ngày, sau đó các tính năng trả phí sẽ tạm dừng ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那台 Mac 会持续使用到 7 天内的下次检查，之后付费功能会在该设备上暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那台 Mac 會持續使用到 7 天內的下次檢查，之後付費功能會在該裝置上暫停。"
          }
        }
      }
    },
    "That Mac keeps working until its next check, within 7 days, and then Pro features pause there." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac continue de fonctionner jusqu’à sa prochaine vérification, dans les 7 jours, puis les fonctionnalités Pro y sont suspendues."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 Mac은 7일 이내의 다음 확인까지 계속 작동하며, 그 후 Pro 기능이 일시 중지됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac, 7 gün içindeki bir sonraki denetime kadar çalışmayı sürdürür, ardından Pro özellikleri orada duraklar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy Mac đó vẫn hoạt động cho đến lần kiểm tra kế tiếp trong vòng 7 ngày, sau đó các tính năng Pro sẽ tạm dừng ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那台 Mac 会持续使用到 7 天内的下次检查，之后 Pro 功能会在该设备上暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那台 Mac 會持續使用到 7 天內的下次檢查，之後 Pro 功能會在該裝置上暫停。"
          }
        }
      }
    },
    "That maintenance operation is not available on this connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération de maintenance n’est pas disponible sur cette connexion."
