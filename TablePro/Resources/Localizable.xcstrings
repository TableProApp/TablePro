      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 {{query}} 表示当前编辑器查询，{{schema}} 表示活动 Schema，{{database}} 表示活动数据库名称，{{body}} 表示命令后输入的任意文本。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 편집기 쿼리에는 {{query}}, 활성 스키마에는 {{schema}}, 활성 데이터베이스 이름에는 {{database}}, 명령 뒤에 입력한 텍스트에는 {{body}}를 사용하십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng {{query}} cho truy vấn hiện tại trong trình soạn, {{schema}} cho schema đang hoạt động, {{database}} cho tên cơ sở dữ liệu đang hoạt động, và {{body}} cho văn bản gõ sau lệnh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez {{query}} pour la requête actuelle de l'éditeur, {{schema}} pour le schéma actif, {{database}} pour le nom de la base de données active et {{body}} pour tout texte saisi après la commande."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 {{query}} 代表目前編輯器的查詢，{{schema}} 代表使用中的綱要，{{database}} 代表使用中的資料庫名稱，{{body}} 代表指令後輸入的任何文字。"
          }
        },
        "tr" : {
          "stringUnit" : {
