      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur limite la vitesse de TablePro. Réessayez sous peu."
          }
        }
      }
    },
    "The server is writing the file…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur écrit le fichier..."
          }
        }
      }
    },
    "The server no longer knows this license key." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne connaît plus cette clé de licence."
          }
