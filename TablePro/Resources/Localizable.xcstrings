    "Use your Cursor subscription with no API key. Requires the Cursor CLI." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre abonnement Cursor sans clé API. Nécessite la CLI Cursor."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
