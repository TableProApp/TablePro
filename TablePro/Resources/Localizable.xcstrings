    },
    "Its columns pass the %@ bytes this engine can index." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses colonnes passent les %@ octets que ce moteur peut indexer."
          }
        }
      }
    },
    "Its columns pass the 3,072 bytes this engine can index, even with each cut to a prefix." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses colonnes dépassent les 3 072 octets que ce moteur peut indexer, même avec chaque coupure en préfixe."
          }
        }
      }
    },
    "Its definition is written in %1$@'s own SQL, which %2$@ does not parse." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa définition est écrite dans le propre SQL de %1$@, que %2$@ ne parcourt pas."
          }
        }
      }
    },
    "Its definition names the source's own database or schema, so it is only copied where that name is the same." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa définition nomme la propre base de données ou le propre schéma de la source, de sorte qu'elle n'est copiée que là où ce nom est le même."
          }
        }
      }
    },
    "Its expression %@ is written in the source's own dialect, so the column is created as an ordinary one and its values are copied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son expression %@ est écrite dans le dialecte propre de la source, de sorte que la colonne est créée comme une colonne ordinaire et ses valeurs sont copiées."
          }
        }
      }
    },
    "Its indexes are left out, because the target is not known to take indexes on this kind of object." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses index sont omis, car il n'est pas connu que la cible prenne des index sur ce type d'objet."
          }
        }
      }
    },
    "Its indexes are left out, because the target's index statements would name a different schema than its definition." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses indices sont omis, car les déclarations d'index de la cible nommeraient un schéma différent de sa définition."
          }
        }
      }
    },
    "Its indexes could not be read: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses indices ne pouvaient pas être lus : %@"
          }
        }
      }
    },
    "Its key includes %@, an expression in the source engine's SQL." : {
      "comment" : "A description of an index that cannot be copied because of an expression in its key. The argument is a comma-separated list of the expressions.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa clé comprend %@, une expression dans le SQL du moteur de source."
          }
        }
      }
    },
    "Its structure could not be read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa structure ne pouvait pas être lu."
          }
        }
      }
    },
    "Its WHERE clause is not supported here, so it covers every row." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa clause WHERE n'est pas prise en charge ici, donc elle couvre chaque ligne."
          }
        }
      }
    },
    "Join the two columns into one, placing this text between the values." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joignez les deux colonnes en une seule, en plaçant ce texte entre les valeurs."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 열을 하나로 결합하고 값 사이에 이 텍스트를 넣습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki sütunu tek sütunda birleştirir ve değerlerin arasına bu metni koyar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gộp hai cột thành một, đặt đoạn văn bản này giữa các giá trị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将两列合并为一列，并在两个值之间插入这段文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將兩個欄位合併為一個，並在兩個值之間插入這段文字。"
          }
        }
      }
    },
    "Joins this column with the one to its right." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joignez cette colonne à celle à sa droite."
          }
        }
      }
    },
