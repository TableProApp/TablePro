        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평균을 내는 데 필요한 최소 실행 횟수인 %lld회 이상 실행된 쿼리가 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
