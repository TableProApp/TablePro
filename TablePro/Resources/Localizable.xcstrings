            "value" : "Synchronise les connexions, les favoris de tables, les réglages et les profils SSH sur tous vos Mac via iCloud."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud를 통해 Mac 간에 연결, 테이블 즐겨찾기, 설정 및 SSH 프로필을 동기화합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
