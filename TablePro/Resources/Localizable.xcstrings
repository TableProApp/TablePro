    },
    "MongoDB cannot address a field named %@. A field name cannot start with $ or contain a dot." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB ne peut pas adresser un champ nommé %@. Un nom de champ ne peut pas commencer par $ ni contenir de point."
          }
        }
      }
    },
    "MongoDB cannot make this change to a document." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB ne peut pas apporter cette modification à un document."
          }
        }
      }
    },
    "MongoDB cannot read this document: %@" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB ne peut pas lire ce document : %@"
          }
        }
      }
    },
    "MongoDB cannot read this document." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB ne peut pas lire ce document."
          }
        }
      }
    },
    "MongoDB did not return a cursor for this query." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB n’a pas renvoyé de curseur pour cette requête."
          }
        }
      }
    },
    "MongoDB does not let a document's _id change. Duplicate the row with the new _id, then delete this one." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB ne permet pas de modifier l’_id d’un document. Dupliquez la ligne avec le nouvel _id, puis supprimez celle-ci."
          }
        }
      }
    },
    "MongoDB driver has no TLS fallback. Preferred and Required both force TLS. Use Required for MongoDB Atlas and other hosted instances." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pilote MongoDB n’a pas de repli TLS. Préféré et Requis imposent tous deux TLS. Utilisez Requis pour MongoDB Atlas et les autres instances hébergées."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB 드라이버에는 TLS 폴백이 없습니다. Preferred와 Required 모두 TLS를 강제합니다. MongoDB Atlas 및 기타 호스팅 인스턴스에는 Required를 사용하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB sürücüsünde TLS geri dönüşü yoktur. Tercih Edilen ve Zorunlu'nun ikisi de TLS'yi zorunlu kılar. MongoDB Atlas ve diğer barındırılan sunucular için Zorunlu kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Driver MongoDB không có cơ chế dự phòng TLS. Preferred và Required đều buộc dùng TLS. Dùng Required cho MongoDB Atlas và các instance được lưu trữ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB 驱动没有 TLS 回退。“首选”和“必需”都会强制使用 TLS。连接 MongoDB Atlas 和其他托管实例时请使用“必需”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB 驅動程式沒有 TLS 後備機制。「偏好」和「必要」都會強制使用 TLS。連接 MongoDB Atlas 與其他託管執行個體時請使用「必要」。"
          }
        }
      }
    },
    "MongoDB gzipped archive" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive MongoDB compressée (gzip)"
          }
        }
      }
    },
    "MongoDB has no %@ index." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB n’a pas d’index %@."
          }
        }
      }
    },
    "MongoDB has no default values, so %@ cannot be set to DEFAULT." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB n’a pas de valeurs par défaut : %@ ne peut donc pas être défini sur DEFAULT."
          }
        }
      }
    },
    "MongoDB lists this as a “%@” rather than a collection, so its documents cannot be edited here." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MongoDB indique qu’il s’agit d’un « %@ » et non d’une collection : ses documents ne peuvent donc pas être modifiés ici."
          }
        }
      }
    },
    "MongoDB query language. Use to import into MongoDB." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langage de requête MongoDB. À utiliser pour importer dans MongoDB."
