    "Dropping %1$@ %2$@ removes it from the target." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "value" : "Le dépôt de %1$@ %2$@ le supprime de la cible.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa %1$@ %2$@ sẽ loại bỏ nó khỏi đích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %1$@ %2$@ 会将其从目标中移除。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ silmek onu hedeften kaldırır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 %1$@ %2$@ 會將其從目標中移除。"
          }
        },
        "ko" : {
