    "_id cannot be renamed, removed or used as a new name. MongoDB keys every document by it." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "_id ne peut pas être renommé, supprimé ni utilisé comme nouveau nom. MongoDB identifie chaque document par ce champ."
          }
        }
      }
    },
    "_id must be an objectId. MongoDB generates it for every new document." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
