    "The query did not finish within the configured timeout, so the connection was reset. Run the query again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查询未在配置的超时时间内完成，因此连接已重置。请重新运行该查询。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truy vấn không hoàn tất trong thời gian chờ đã cấu hình, nên kết nối đã bị đặt lại. Hãy chạy lại truy vấn."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿼리가 설정된 제한 시간 내에 완료되지 않아 연결을 재설정했습니다. 쿼리를 다시 실행하십시오."
          }
        },
