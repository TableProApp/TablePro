          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编码为 %@。存储时保留此编码，遇到无法表示的字符时会停止存储。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã hoá %@. Khi lưu, mã hoá này được giữ nguyên, và ký tự không biểu diễn được sẽ khiến việc lưu dừng lại."
          }
        }
      }
