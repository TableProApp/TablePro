        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 변경 사항을 취소하고 선택한 설정으로 파일을 다시 읽습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
