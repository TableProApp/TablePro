    "Compared %1$@ keys in key order, up to %2$@. Filter both sides past that key for the next rows. NULL keys are not read under a limit." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ clés comparées dans l’ordre des clés, jusqu’à %2$@. Filtrez les deux côtés au-delà de cette clé pour obtenir les lignes suivantes. Les clés NULL ne sont pas lues lorsqu’une limite s’applique."
          }
        }
      }
    },
