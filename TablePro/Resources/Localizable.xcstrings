    },
    "The source returned an empty definition." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source a renvoyé une définition vide."
          }
        }
      }
    },
    "The source, the target, the mode and the options come back when you load it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source, la cible, le mode et les options sont restaurés lorsque vous la chargez."
          }
        }
      }
    },
    "The source's definition could not be read: %@" : {
      "localizations" : {
        "fr" : {
