        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur Oracle est plus ancien que la version 11.1, que le pilote de base de données ne prend pas en charge."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Oracle 서버는 릴리스 11.1보다 이전 버전이며 데이터베이스 드라이버에서 지원하지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Oracle sunucusu, veritabanı sürücüsünün desteklemediği 11.1 sürümünden daha eski."
