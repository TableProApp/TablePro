        }
      }
    },
    "Maximum time for TCP, TLS, authentication, tunnel, and proxy setup. Leave blank to use the %d-second default." : {
      "comment" : "A help message for the connect timeout.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps maximum pour la configuration de TCP, TLS, d'authentification, de tunnel et de proxy. Laissez vide pour utiliser la valeur par défaut de %d secondes."
          }
        }
      }
    },
    "Maximum time to wait for a query to complete. Set to 0 for no limit. Applied to new connections." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps maximum d'attente pour que une requête soit terminée. Définie à 0 pour aucune limite. Appliquée aux nouvelles connexions."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿼리 완료를 기다리는 최대 시간입니다. 제한하지 않으려면 0으로 설정하십시오. 새 연결에 적용됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgunun tamamlanması için beklenecek maksimum süre. Sınır olmaması için 0 yapın. Yeni bağlantılara uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian chờ tối đa để truy vấn hoàn thành. Đặt 0 để không giới hạn. Áp dụng cho kết nối mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待查询完成的最长时间。设为 0 表示不限制。应用于新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待查詢完成的最長時間。設為 0 表示不限制。套用至新連線。"
          }
        }
      }
    },
