    "Watch shared folders for connection files." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez des dossiers partagés pour y détecter des fichiers de connexion."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 폴더에서 연결 파일을 감시합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılan klasörleri bağlantı dosyaları için izleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi thư mục chia sẻ để tìm tệp kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监视共享文件夹中的连接文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監看共用資料夾中的連線檔案。"
          }
        }
      }
    },
    "Watched folders are scanned for .tablepro files. Connections appear read only in the sidebar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers surveillés sont analysés à la recherche de fichiers .tablepro. Les connexions apparaissent en lecture seule dans la barre latérale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감시 중인 폴더에서 .tablepro 파일을 검색합니다. 연결은 사이드바에 읽기 전용으로 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlenen klasörler .tablepro dosyaları için taranır. Bağlantılar Sidebar'da salt okunur olarak görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thư mục theo dõi được quét để tìm file .tablepro. Kết nối hiển thị chỉ đọc trong thanh bên."
          }
        },
