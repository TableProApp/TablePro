    "Both sides are one connection, so the server copies the rows itself. There is no row-by-row progress, and Stop cannot interrupt it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux côtés sont une seule connexion, donc le serveur copie lui-même les lignes. Il n'y a pas de progression ligne par ligne, et Stop ne peut pas l'interrompre."
          }
        }
      }
    },
    "Brief summary of the issue" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
