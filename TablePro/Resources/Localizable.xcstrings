          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜잭션은 건너뛰고 계속하기와 함께 쓸 수 없습니다. 두 가지를 함께 쓰면 대상이 절반만 적용된 상태로 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事务不能与“跳过并继续”组合：两者一起会让目标处于应用了一半的状态。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une transaction ne peut pas être combinée avec skip et continue : ensemble, elles laisseraient la moitié de la cible non appliquée."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易不能與「略過並繼續」組合：兩者一起會讓目標處於套用一半的狀態。"
          }
        }
      }
    },
    "%@ reads and writes through one connection, so it cannot copy rows between two of its databases. Use a second connection for the target." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lit et écrit à travers une seule connexion, il ne peut donc pas copier des lignes entre deux de ses bases de données. Utilisez une deuxième connexion pour la cible."
          }
        }
      }
    },
