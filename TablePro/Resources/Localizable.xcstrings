        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 '%2$@'이(가) 있는 토큰 '%1$@'은(는) '%3$@'에 접근할 수 없습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' izinli '%@' token'ı '%@' kaynağına erişemiyor"
