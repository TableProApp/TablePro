    "The %1$@ sorted rows differently than the comparison expects, near key %2$@. Pick a numeric key, or one that sorts by byte value." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 对行的排序与比较预期不同，出现在键 %2$@ 附近。请选择数值型键，或按字节值排序的键。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã sắp xếp các dòng khác với những gì so sánh mong đợi, gần khóa %2$@. Hãy chọn khóa dạng số, hoặc khóa sắp xếp theo giá trị byte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 키 %2$@ 부근에서 비교가 예상한 것과 다른 순서로 행을 정렬했습니다. 숫자 키나 바이트 값으로 정렬되는 키를 선택하십시오."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 對列的排序與比較預期不同，出現在鍵 %2$@ 附近。請選擇數值型鍵，或按位元組值排序的鍵。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, satırları karşılaştırmanın beklediğinden farklı sıraladı, %2$@ anahtarının yakınında. Sayısal bir anahtar ya da bayt değerine göre sıralanan bir anahtar seçin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Les lignes triées %1$@ sont triées différemment de ce que la comparaison attend, près de la clé %2$@. Choisissez une clé numérique, ou une qui trie par valeur en octets.",
            "state" : "translated"
          }
        }
      }
    },
    "Adding check constraint %@ scans the table and fails if any existing row violates it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 CHECK 约束 %@ 会扫描整张表，若有任何现有行违反约束则会失败。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ràng buộc CHECK %@ sẽ quét toàn bảng và thất bại nếu có dòng hiện có vi phạm."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CHECK 제약 조건 %@을(를) 추가하면 테이블을 검사하며, 기존 행 중 하나라도 위반하면 실패합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增 CHECK 約束 %@ 會掃描整張資料表，若有任何現有列違反約束則會失敗。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kontrol kısıtlaması eklemek tabloyu tarar ve mevcut satırlardan biri bunu ihlal ederse başarısız olur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ajout de la contrainte de vérification %@ effectue une vérification de la table et échoue si une ligne existante la viole."
          }
        }
      }
    },
