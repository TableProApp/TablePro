        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法比對這一列的鍵，因此寫入前無法核對它。"
          }
        }
      }
    },
    "This Save Cannot Be Restored" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet enregistrement ne peut pas être restauré"
          }
