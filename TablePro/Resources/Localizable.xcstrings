    "TablePro cannot sign an RDS token for \"%@\". Enter the RDS Endpoint (for example mydb.abc123.us-east-1.rds.amazonaws.com:5432) when you connect through a port forward or bastion." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TablePro ne peut pas signer de jeton RDS pour « %@ ». Saisissez le point de terminaison RDS (par exemple mydb.abc123.us-east-1.rds.amazonaws.com:5432) lorsque vous vous connectez via une redirection de port ou un bastion."
          }
        }
      }
    },
