            "value" : "서버가 이 라이선스 키를 더 이상 알지 못합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bu lisans anahtarını artık tanımıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ không còn nhận ra khóa giấy phép này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
