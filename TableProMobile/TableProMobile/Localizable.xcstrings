    "The query did not finish within the configured timeout, so the connection was reset. Run the query again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쿼리가 설정된 제한 시간 내에 완료되지 않아 연결을 재설정했습니다. 쿼리를 다시 실행하십시오."
          }
        }
      }
    },
    "The query returned no rows." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
