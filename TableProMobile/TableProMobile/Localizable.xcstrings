      }
    },
    "This query will modify data. Are you sure you want to continue?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 쿼리는 데이터를 변경합니다. 계속하시겠습니까?"
