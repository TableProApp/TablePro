    "\"%@\" is a name the database keeps for itself. Choose another name." : {
      "extractionState" : "manual",
      "generatesSymbol" : false
    },
    "\"%@\" is in the list more than once." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 항목이 목록에 두 번 이상 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" có trong danh sách nhiều hơn một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 在列表中出现了不止一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在列表中出現不只一次。"
          }
        }
      }
    },
    "\"%@\" is not a file." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 항목은 파일이 아닙니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" không phải là tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 不是文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是檔案。"
          }
        }
      }
    },
    "\"%@\" is not a full path." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 항목은 전체 경로가 아닙니다."
