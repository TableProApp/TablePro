        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此连接的 CA 证书在本设备上不可读（%@）。证书文件不会在设备之间同步，请在此处添加证书，或将 SSL 模式降为“必需”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
