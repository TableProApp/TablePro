        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" không phải là đường dẫn đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 不是完整路径。"
