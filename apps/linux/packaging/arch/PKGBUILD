# Internal BookiE RC recipe. Do not submit this package to the AUR.
# `scripts/build-arch-rc.sh` resolves the signed-off RC tag to an immutable
# commit, source/vendor checksums and build-input manifest.
# shellcheck shell=bash disable=SC2034,SC2154,SC2164

pkgname=bookie
pkgver="${TABLEPRO_RC_VERSION:?Build through scripts/build-arch-rc.sh}"
pkgrel="${TABLEPRO_RC_PKGREL:-1}"
pkgdesc="Native Linux database client (internal release candidate)"
arch=('x86_64')
provides=("tablepro=$pkgver")
conflicts=('tablepro')
replaces=('tablepro')
url="https://github.com/cozyGarage/BookiE"
license=('AGPL-3.0-or-later')
depends=('gtk4>=1:4.14' 'glib2>=2.80' 'libadwaita>=1:1.5' 'gtksourceview5>=5.12' 'libsecret' 'openssl' 'krb5' 'sqlite')
makedepends=('rust>=1:1.98' 'pkgconf' 'clang' 'gettext')
checkdepends=('desktop-file-utils' 'appstream')
options=('!lto')

_commit="${TABLEPRO_RC_COMMIT:?Use scripts/build-arch-rc.sh to resolve the immutable candidate commit}"
_archive_sha256="${TABLEPRO_RC_SHA256:?Use scripts/build-arch-rc.sh to calculate the source checksum}"
_archive="${TABLEPRO_RC_ARCHIVE:?Use scripts/build-arch-rc.sh to prepare the candidate archive}"
_vendor_sha256="${TABLEPRO_RC_VENDOR_SHA256:?Use scripts/build-arch-rc.sh to calculate the vendor checksum}"
_vendor_archive="${TABLEPRO_RC_VENDOR_ARCHIVE:?Use scripts/build-arch-rc.sh to prepare the vendor archive}"
_metadata="${TABLEPRO_RC_METADATA:?Use scripts/build-arch-rc.sh to write the input manifest}"
_metadata_sha256="${TABLEPRO_RC_METADATA_SHA256:?Use scripts/build-arch-rc.sh to verify the input manifest}"
source=("$(basename "$_archive")" "$(basename "$_vendor_archive")")
sha256sums=("$_archive_sha256" "$_vendor_sha256")

prepare() {
  cd "$srcdir/TablePro-${_commit}"
  local metadata_checksum
  metadata_checksum="$(sha256sum "$_metadata" | awk '{print $1}')"
  [[ "$metadata_checksum" == "$_metadata_sha256" ]]
  install -Dm644 "$_metadata" "$srcdir/TablePro-${_commit}/apps/linux/packaging/arch/BUILD_INPUTS.json"
  cargo metadata --locked --offline --format-version 1 --no-deps > /dev/null
}

build() {
  cd "$srcdir/TablePro-${_commit}"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --offline -p tablepro-app -p tablepro-agentd
  cargo build --release --locked --offline -p tablepro-ssh --bin tablepro-askpass
}

check() {
  cd "$srcdir/TablePro-${_commit}"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --workspace --exclude tablepro-driver-duckdb --lib --bins --locked --offline
  desktop-file-validate apps/linux/flatpak/com.tablepro.linux.desktop
  appstreamcli validate --no-net apps/linux/flatpak/com.tablepro.linux.metainfo.xml
}

package() {
  cd "$srcdir/TablePro-${_commit}"
  install -Dm755 "$srcdir/target/release/tablepro-app" "$pkgdir/usr/bin/bookie"
  install -Dm755 "$srcdir/target/release/tablepro-agentd" "$pkgdir/usr/bin/bookie-agentd"
  install -Dm755 "$srcdir/target/release/tablepro-askpass" "$pkgdir/usr/bin/tablepro-askpass"
  ln -s bookie "$pkgdir/usr/bin/tablepro"
  ln -s bookie-agentd "$pkgdir/usr/bin/tablepro-agentd"
  install -Dm644 apps/linux/flatpak/com.tablepro.linux.desktop \
    "$pkgdir/usr/share/applications/com.tablepro.linux.desktop"
  install -Dm644 apps/linux/flatpak/com.tablepro.linux.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.tablepro.linux.metainfo.xml"
  install -Dm644 apps/linux/flatpak/icons/scalable/com.tablepro.linux.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.tablepro.linux.svg"
  install -Dm644 apps/linux/data/com.tablepro.linux.gschema.xml \
    "$pkgdir/usr/share/glib-2.0/schemas/com.tablepro.linux.gschema.xml"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
  install -Dm644 apps/linux/packaging/arch/BUILD_INPUTS.json \
    "$pkgdir/usr/share/doc/$pkgname/BUILD_INPUTS.json"
  install -Dm644 apps/linux/packaging/THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 apps/linux/packaging/policy.example.toml \
    "$pkgdir/usr/share/doc/$pkgname/policy.example.toml"

  local catalog locale
  for catalog in apps/linux/po/*.po; do
    [[ -e "$catalog" ]] || continue
    locale="$(basename "$catalog" .po)"
    install -d "$pkgdir/usr/share/locale/$locale/LC_MESSAGES"
    msgfmt "$catalog" -o "$pkgdir/usr/share/locale/$locale/LC_MESSAGES/tablepro.mo"
  done
}
