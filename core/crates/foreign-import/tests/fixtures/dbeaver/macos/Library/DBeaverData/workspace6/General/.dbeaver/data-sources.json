						"type": "CONFIG",
						"enabled": true,
						"save-password": false,
						"properties": {
							"ssl.method": "CERTIFICATES",
							"ssl.ca.cert": "/certs/mysql-ca.pem",
							"ssl.require": "true",
							"ssl.verify.server": "true",
							"ssl.public.key.retrieve": "false"
						}
					}
