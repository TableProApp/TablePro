		"mysql-ssl-required": {
			"provider": "mysql",
			"name": "MySQL SSL required",
			"configuration": {
				"host": "db.example.com",
				"handlers": {
					"mysql_ssl": {
						"type": "CONFIG",
						"enabled": true,
						"save-password": false,
						"properties": {
							"ssl.method": "CERTIFICATES",
							"ssl.require": "true",
							"ssl.verify.server": "false",
							"ssl.public.key.retrieve": "false"
						}
					}
				}
			}
		},
