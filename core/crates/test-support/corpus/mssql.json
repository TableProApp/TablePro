{
  "why": "tiberius describes a result column by its wire type alone, with no scale, so an editor run shows the fraction a time value has. A browse page takes the scale from the catalogue.",
  "columns": [
    {
      "column": "v datetime2(7)",
      "values": [
        { "sql": "'0001-01-01 00:00:00'", "shows": "0001-01-01 00:00:00.0000000", "edited": "0001-01-01 00:00:00" },
        { "sql": "'9999-12-31 23:59:59.9999999'", "shows": "9999-12-31 23:59:59.9999999" },
        { "sql": "'2024-02-29 12:00:00.5'", "shows": "2024-02-29 12:00:00.5000000", "edited": "2024-02-29 12:00:00.5" },
        { "sql": "NULL", "shows": null }
      ]
    },
    {
      "why": "The offset a value was written with is the one it shows. The server keeps the instant in UTC, which has to stay in range.",
      "column": "v datetimeoffset(3)",
      "values": [
        { "sql": "'2024-03-10 02:30:00 -08:00'", "shows": "2024-03-10 02:30:00.000-08:00", "edited": "2024-03-10 02:30:00-08:00" },
        { "sql": "'0001-01-01 00:00:00 -14:00'", "shows": "0001-01-01 00:00:00.000-14:00", "edited": "0001-01-01 00:00:00-14:00" },
        { "sql": "'9999-12-31 23:59:59.999 +14:00'", "shows": "9999-12-31 23:59:59.999+14:00" }
      ]
    },
    {
      "column": "v datetime",
      "values": [
        { "sql": "'1753-01-01 00:00:00'", "shows": "1753-01-01 00:00:00.000", "edited": "1753-01-01 00:00:00" },
        { "sql": "'9999-12-31 23:59:59.997'", "shows": "9999-12-31 23:59:59.997" },
        { "sql": "'2024-01-01 12:00:00.123'", "shows": "2024-01-01 12:00:00.123" }
      ]
    },
    {
      "column": "v smalldatetime",
      "values": [
        { "sql": "'2079-06-06 23:59:00'", "shows": "2079-06-06 23:59:00" }
      ]
    },
    {
      "column": "v date",
      "values": [
        { "sql": "'0001-01-01'", "shows": "0001-01-01" },
        { "sql": "'9999-12-31'", "shows": "9999-12-31" }
      ]
    },
    {
      "column": "v time(7)",
      "values": [
        { "sql": "'23:59:59.9999999'", "shows": "23:59:59.9999999" },
        { "sql": "'00:00:00'", "shows": "00:00:00.0000000", "edited": "00:00:00" }
      ]
    },
    {
      "column": "v decimal(38, 38)",
      "values": [
        { "sql": "0.99999999999999999999999999999999999999", "shows": "0.99999999999999999999999999999999999999" }
      ]
    },
    {
      "column": "v decimal(38, 0)",
      "values": [
        { "sql": "99999999999999999999999999999999999999", "shows": "99999999999999999999999999999999999999" },
        { "sql": "-99999999999999999999999999999999999999", "shows": "-99999999999999999999999999999999999999" }
      ]
    },
    {
      "column": "v decimal(10, 4)",
      "values": [
        { "sql": "-1.5", "shows": "-1.5000" },
        { "sql": "0", "shows": "0.0000" },
        { "sql": "NULL", "shows": null }
      ]
    },
    {
      "why": "A table tab reads MONEY cast to a decimal. tiberius hands an editor run a float, exact only to about 5.5 * 10^11, past which the cell says it cannot read the value.",
      "column": "v money",
      "values": [
        { "sql": "-12.34", "shows": "-12.3400" },
        { "sql": "123456789.1234", "shows": "123456789.1234" },
        { "sql": "922337203685477.5807", "shows": "922337203685477.5807", "edited": "<unreadable money>" },
        { "sql": "-922337203685477.5808", "shows": "-922337203685477.5808", "edited": "<unreadable money>" }
      ]
    },
    {
      "column": "v smallmoney",
      "values": [
        { "sql": "-214748.3648", "shows": "-214748.3648" }
      ]
    },
    {
      "why": "SQL Server keeps the first three groups little-endian, so a reader that takes the bytes in order scrambles them.",
      "column": "v uniqueidentifier",
      "values": [
        { "sql": "'6F9619FF-8B86-D011-B42D-00C04FC964FF'", "shows": "6f9619ff-8b86-d011-b42d-00c04fc964ff" },
        { "sql": "NULL", "shows": null }
      ]
    },
    {
