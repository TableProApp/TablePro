{
  "why": "sqlx gives a result column no fractional digits and no BIT length, so an editor run shows the fraction a value has and a BIT in the whole bytes it arrived in. A browse page takes both from the catalogue. A column marked only is for that flavour.",
  "columns": [
    {
      "column": "v DATETIME(6)",
      "values": [
        { "sql": "'1000-01-01 00:00:00'", "shows": "1000-01-01 00:00:00.000000", "edited": "1000-01-01 00:00:00" },
        { "sql": "'9999-12-31 23:59:59.999999'", "shows": "9999-12-31 23:59:59.999999" },
        { "sql": "'2024-02-29 12:00:00.5'", "shows": "2024-02-29 12:00:00.500000", "edited": "2024-02-29 12:00:00.5" },
        { "sql": "NULL", "shows": null }
      ]
    },
    {
      "column": "v DATETIME",
      "values": [
        { "sql": "'2024-03-10 02:30:00'", "shows": "2024-03-10 02:30:00" }
      ]
    },
    {
      "why": "Browse pins its session to UTC and reads an instant; the editor reads the wall time in the server's zone, UTC here.",
      "column": "v TIMESTAMP(3) NULL",
      "values": [
        { "sql": "'1970-01-01 00:00:01'", "shows": "1970-01-01 00:00:01.000+00:00", "edited": "1970-01-01 00:00:01" },
        { "sql": "'2038-01-19 03:14:07.999'", "shows": "2038-01-19 03:14:07.999+00:00", "edited": "2038-01-19 03:14:07.999" },
        { "sql": "NULL", "shows": null }
      ]
    },
    {
      "column": "v DATE",
      "values": [
