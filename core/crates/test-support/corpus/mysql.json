    {
      "why": "MySQL keeps JSON in a binary form of its own, so it prints the document again, keys sorted and numbers normalised, as the mysql client shows it.",
      "only": "mysql",
      "column": "v JSON",
      "values": [
        { "sql": "'{\"b\": 1, \"a\": [1, 2.50, \"x\"], \"ü\": null}'", "shows": "{\"a\": [1, 2.5, \"x\"], \"b\": 1, \"ü\": null}" },
        { "sql": "'[]'", "shows": "[]" },
        { "sql": "NULL", "shows": null }
      ]
    },
    {
      "only": "mysql",
      "column": "v BINARY(16)",
      "values": [
        { "sql": "UUID_TO_BIN('123e4567-e89b-12d3-a456-426614174000')", "shows": "0x123e4567e89b12d3a456426614174000" }
      ]
    },
    {
      "why": "MariaDB's JSON is LONGTEXT with a check, kept as written.",
