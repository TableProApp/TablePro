theory SyncLogChain
begin

// ADR 0053: Rollback and forks, Restore, Stale or missing state (the re-pin), with 0054's anchored checkpoint.
// One log, appended by its signer. The server is malicious: it can present any prefix, replay statements and lose
// the log's tail in a restore. C follows the log and keeps every head it pinned. A device whose state went stale
// pins again from its anchor, never at a head below it. A fork needs the signing key, which a thief can steal, and
// it freezes the log for good.

builtins: hashing, signing, natural-numbers

rule Log:
  let
    gp = <'statement', ~l, %1, 'zero', 'genesis'>
  in
  [ Fr(~l), Fr(~k) ]
  --[ OnlyOnce('log'), Appended(~l, %1, h(<gp, sign(gp, ~k)>)) ]->
  [ !LogKey(~l, ~k), Signer(~l, %1, h(<gp, sign(gp, ~k)>)), !SignedHead(~l, %1, h(<gp, sign(gp, ~k)>))
  , Out(<gp, sign(gp, ~k)>) ]

rule Append:
  let
    sp = <'statement', l, %n %+ %1, h(pst), ~x>
  in
  [ Signer(l, %n, h(pst)), !LogKey(l, k), Fr(~x) ]
  --[ Appended(l, %n %+ %1, h(<sp, sign(sp, k)>)) ]->
  [ Signer(l, %n %+ %1, h(<sp, sign(sp, k)>)), !SignedHead(l, %n %+ %1, h(<sp, sign(sp, k)>))
  , Out(<sp, sign(sp, k)>) ]

rule C_Start:
  let
    gp = <'statement', l, %1, 'zero', x>
  in
  [ !LogKey(l, k), In(<gp, sign(gp, k)>), Fr(~c) ]
  --[ OnlyOnce(<'client', l>), CHead(~c, l, %1, h(<gp, sign(gp, k)>)) ]->
  [ !CAt(~c, l, %1, h(<gp, sign(gp, k)>)) ]

// C takes only the statement at its newest head's seq plus one that names that head as prev.
rule C_Extend:
  let
    sp = <'statement', l, %n %+ %1, h(pst), x>
  in
  [ !CAt(c, l, %n, h(pst)), !LogKey(l, k), In(<sp, sign(sp, k)>) ]
  --[ UseHead(c, l, %n), NotFrozen(c, l), CHead(c, l, %n %+ %1, h(<sp, sign(sp, k)>)) ]->
  [ !CAt(c, l, %n %+ %1, h(<sp, sign(sp, k)>)), !Held(c, l, %n %+ %1, <sp, sign(sp, k)>) ]

// A server that lost the tail in a restore: C publishes again every statement it holds above the server's head.
rule C_Republish:
  [ !Held(c, l, %n, st) ] --> [ Out(st) ]

// A valid statement at a seq C holds, with another hash: a fork alarm.
rule C_Fork:
  let
    sp = <'statement', l, %m, p, x>
  in
  [ !Held(c, l, %m, st), !LogKey(l, k), In(<sp, sign(sp, k)>) ]
  --[ Neq(st, <sp, sign(sp, k)>), ForkAlarm(c, l, %m), Frozen(c, l) ]->
  [ ]

// C writes a secret under the log's keys only while the log is not frozen.
rule C_WriteSecret:
  [ !CAt(c, l, %n, hd), Fr(~s) ]
  --[ NotFrozen(c, l), SecretWritten(c, l, ~s) ]->
  [ ]

rule StealLogKey:
  [ !LogKey(l, k) ] --[ KeyStolen(l) ]-> [ Out(k) ]

// The state went stale: C trusts only its anchor's head, and pins again through a comparison with another holder,
// which gives it a head that holder verified.
rule C_Repin:
  [ !CAt(c, l, %a, ha), !SignedHead(l, %m, hd) ]
  --[ UseHead(c, l, %a), NotBelow(%a, %m), NotFrozen(c, l), Repinned(c, l, %m), CHead(c, l, %m, hd) ]->
  [ !CAt(c, l, %m, hd) ]

// C builds only on its newest head; for a re-pin that is the anchor's.
restriction NewestHead:
  "All c l n m hm #i #j. UseHead(c, l, n)@i & CHead(c, l, m, hm)@j & #j < #i ==> m = n | m << n"

restriction NotFrozen:
  "All c l #i #f. NotFrozen(c, l)@i & Frozen(c, l)@f & #f < #i ==> F"

restriction NotBelow:
  "All a m #i. NotBelow(a, m)@i ==> a = m | a << m"

restriction Neq:
  "All x y #i. Neq(x, y)@i ==> not (x = y)"

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

lemma chain_executable:
  exists-trace
  "Ex c l h2 #i. CHead(c, l, %1 %+ %1, h2)@i"

lemma repin_executable:
  exists-trace
  "Ex c l m #i. Repinned(c, l, m)@i"

// The signer's seq only grows, so it signs one statement per seq.
lemma appended_seq_grows [reuse, use_induction]:
  "All l n m h1 h2 #i #j. Appended(l, n, h1)@i & Appended(l, m, h2)@j & #i < #j ==> n << m"

lemma appended_once_per_seq [reuse]:
  "All l n h1 h2 #i #j. Appended(l, n, h1)@i & Appended(l, n, h2)@j ==> #i = #j"

// Every head C pins is one the signer appended, at that seq, unless the key was stolen.
lemma heads_are_the_signers [reuse]:
  "All c l n hd #i. CHead(c, l, n, hd)@i ==> (Ex #a. Appended(l, n, hd)@a & #a < #i) | (Ex #s. KeyStolen(l)@s)"

// 0053's claim: rollback is refused through chained heads, re-pins included. A stolen signing key makes forks,
// which fork_freezes_the_log covers.
lemma no_rollback:
  "All c l n m h1 h2 #i #j. CHead(c, l, n, h1)@i & CHead(c, l, m, h2)@j & #i < #j ==>
     n << m | (n = m & h1 = h2) | (Ex #s. KeyStolen(l)@s)"

// An honest signer never forks its own log, so C raises no fork alarm unless the signing key was stolen.
lemma no_false_fork_alarm:
  "All c l m #i. ForkAlarm(c, l, m)@i ==> Ex #s. KeyStolen(l)@s & #s < #i"

lemma fork_executable:
  exists-trace
  "Ex c l m #i. ForkAlarm(c, l, m)@i"

// 0053's claim: a fork freezes its log. After C sees one, it accepts no statement on that log and writes no secret.
lemma fork_freezes_the_log:
  "All c l m #f. ForkAlarm(c, l, m)@f ==>
     not (Ex n hd #i. CHead(c, l, n, hd)@i & #f < #i) & not (Ex s #w. SecretWritten(c, l, s)@w & #f < #w)"

end
