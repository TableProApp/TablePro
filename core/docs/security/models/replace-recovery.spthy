theory SyncReplaceRecoveryKey
begin

// ADR 0053: Flows: Replace Recovery Key; Identity log, `replace`. The person replaces S with S'. Later the attacker
// gets the old S, for example a found paper. The server is malicious and keeps every blob and wrap. C is a client
// that follows the identity log. Phase 1 is before the replace, phase 2 after it.
// Flag OLDREPLACE models 0053 before G0 round 1 (e8879f95ee): Replace keeps IK and AK and only seals them to a new RK.

builtins: hashing, signing, asymmetric-encryption, symmetric-encryption

functions: kid/1, krw/2

macros:
  blob(S, a, ik, rk) = senc(<'tablepro/v1/recovery', a, ik, rk>, krw(S, a)),
  rkwrap(a, ak, rk) = aenc(<'tablepro/v1/wrap', a, 'account-key', ak>, pk(rk))

rule Genesis:
  let
    gp = <'genesis', ~a, pk(~ik), pk(~rk), kid(~ak)>
  in
  [ Fr(~a), Fr(~S), Fr(~ik), Fr(~rk), Fr(~ak) ]
  --[ OnlyOnce('genesis') ]->
  [ !Phase1(~a, ~S, ~ik, ~rk, ~ak), !Holder(~a, ~ak), !ClientIK1(~a, pk(~ik))
  , Out(~a), Out(blob(~S, ~a, ~ik, ~rk)), Out(rkwrap(~a, ~ak, ~rk)), Out(<gp, sign(gp, ~ik)>) ]

#ifdef OLDREPLACE
rule Replace:
  let
    rp = <'recovery', a, pk(~rk2)>
  in
  [ !Phase1(a, S, ik, rk, ak), Fr(~S2), Fr(~rk2) ]
  --[ OnlyOnce('replace'), Replaced(a), IKAfterReplace(a, ik), PersonReplaceTo(a, pk(ik)), AKAfterReplace(a, ak) ]->
  [ !Phase2(a, ~S2, ik, ~rk2, ak)
  , Out(blob(~S2, a, ik, ~rk2)), Out(rkwrap(a, ak, ~rk2)), Out(<rp, sign(rp, ik)>) ]

rule C_SeeReplace:
  let
    rp = <'recovery', a, rk2pub>
  in
  [ !ClientIK1(a, pk(ik)), In(<rp, sign(rp, ik)>) ]
  --[ ClientSawReplace(a), ClientSawReplaceTo(a, pk(ik)), OnlyOnce(<'client-replace', a>) ]->
  [ !ClientIK2(a, pk(ik)) ]
#else
// `replace` is signed by the IK in force and endorsed by the new IK. It also rotates SK and AK.
rule Replace:
  let
    rp = <'replace', a, pk(ik), pk(~ik2), pk(~rk2), kid(~ak2)>
  in
  [ !Phase1(a, S, ik, rk, ak), Fr(~S2), Fr(~ik2), Fr(~rk2), Fr(~ak2) ]
  --[ OnlyOnce('replace'), Replaced(a), IKAfterReplace(a, ~ik2), PersonReplaceTo(a, pk(~ik2)), AKAfterReplace(a, ~ak2) ]->
  [ !Phase2(a, ~S2, ~ik2, ~rk2, ~ak2), !Holder(a, ~ak2)
  , Out(blob(~S2, a, ~ik2, ~rk2)), Out(rkwrap(a, ~ak2, ~rk2))
  , Out(<rp, sign(rp, ik), sign(rp, ~ik2)>) ]

rule C_SeeReplace:
  let
    rp = <'replace', a, pk(ik), pk(ik2), rk2pub, akkid>
  in
  [ !ClientIK1(a, pk(ik)), In(<rp, sign(rp, ik), sign(rp, ik2)>) ]
  --[ ClientSawReplace(a), ClientSawReplaceTo(a, pk(ik2)), OnlyOnce(<'client-replace', a>) ]->
  [ !ClientIK2(a, pk(ik2)) ]
#endif

// C extends the identity log only with statements the IK in force signs.
rule C_Extend1:
  [ !ClientIK1(a, pk(ik)), In(<<'statement', a, x>, sign(<'statement', a, x>, ik)>) ]
  --[ BeforeClientReplace(a), ClientExtended(a, x) ]->
  [ ]

rule C_Extend2:
  [ !ClientIK2(a, pk(ik)), In(<<'statement', a, x>, sign(<'statement', a, x>, ik)>) ]
  --[ ClientExtended(a, x) ]->
  [ ]

// A reset that starts a new generation, after a fork, is endorsed by the IK in force.
rule C_FollowGeneration1:
  [ !ClientIK1(a, pk(ik)), In(<<'generation', a, x>, sign(<'generation', a, x>, ik)>) ]
  --[ BeforeClientReplace(a), ClientFollowsGeneration(a, pk(ik)) ]->
  [ ]

rule C_FollowGeneration2:
  [ !ClientIK2(a, pk(ik)), In(<<'generation', a, x>, sign(<'generation', a, x>, ik)>) ]
  --[ ClientFollowsGeneration(a, pk(ik)) ]->
  [ ]

rule PersonSigns1:
  [ !Phase1(a, S, ik, rk, ak), Fr(~x) ]
  --[ BeforeReplace(a), PersonStatement(a, ~x) ]->
  [ Out(<<'statement', a, ~x>, sign(<'statement', a, ~x>, ik)>) ]

rule PersonSigns2:
  [ !Phase2(a, S, ik, rk, ak), Fr(~x) ]
  --[ PersonStatement(a, ~x) ]->
  [ Out(<<'statement', a, ~x>, sign(<'statement', a, ~x>, ik)>) ]

// The old S leaks after the replace.
rule RevealOldS:
  [ !Phase1(a, S, ik, rk, ak), !Phase2(a, S2, ik2, rk2, ak2) ] --[ RevealOldS(a) ]-> [ Out(S) ]

rule RevealCurrentS:
  [ !Phase2(a, S, ik, rk, ak) ] --[ RevealCurrentS(a) ]-> [ Out(S) ]

rule RevealHolder:
  [ !Holder(a, ak) ] --[ RevealHolder(a, ak) ]-> [ Out(ak) ]

restriction BeforeReplace:
  "All a #i #r. BeforeReplace(a)@i & Replaced(a)@r ==> #i < #r"

restriction BeforeClientReplace:
  "All a #i #r. BeforeClientReplace(a)@i & ClientSawReplace(a)@r ==> #i < #r"

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

lemma replace_executable:
  exists-trace
  "Ex a x #r #s #e. Replaced(a)@r & ClientSawReplace(a)@s & ClientExtended(a, x)@e & #s < #e
     & not (Ex #o. RevealOldS(a)@o) & not (Ex #o. RevealCurrentS(a)@o)"

// After a Replace, the old recovery key gives no identity key in force.
lemma old_recovery_key_gives_no_identity:
  "All a ik #r #j. IKAfterReplace(a, ik)@r & K(ik)@j ==> Ex #x. RevealCurrentS(a)@x"

// After a Replace, the old recovery key gives no account key in force.
lemma old_recovery_key_gives_no_account_key:
  "All a ak #r #j. AKAfterReplace(a, ak)@r & K(ak)@j ==>
     (Ex #x. RevealCurrentS(a)@x) | (Ex #x. RevealHolder(a, ak)@x)"

// 0053's claim as worded: an old S after a `replace` can extend no log.
lemma old_recovery_key_extends_no_log:
  "All a x #r #e. ClientSawReplace(a)@r & ClientExtended(a, x)@e & #r < #e ==>
     (Ex #p. PersonStatement(a, x)@p)
     | (Ex #y. RevealCurrentS(a)@y)"

// The claim at a client that has seen the person's own replace.
lemma old_recovery_key_extends_no_log_after_the_replace:
  "All a ik2 x #r #q #e. ClientSawReplaceTo(a, ik2)@r & PersonReplaceTo(a, ik2)@q & ClientExtended(a, x)@e & #r < #e ==>
     (Ex #p. PersonStatement(a, x)@p)
     | (Ex #y. RevealCurrentS(a)@y)"

// 0053's claim: no IK a client saw replaced starts a new generation for it.
lemma replaced_ik_starts_no_generation:
  "All a ik2 ik #r #q #i. ClientSawReplaceTo(a, ik2)@r & PersonReplaceTo(a, ik2)@q & ClientFollowsGeneration(a, ik)@i
     & #r < #i ==> ik = ik2 | (Ex #y. RevealCurrentS(a)@y)"

end
