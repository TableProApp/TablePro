theory SyncServerEnforcement
begin

// ADR 0053: Server enforcement (D8), Key objects as records, Flows: Reset with its delay and cancel.
// The server is honest. The attacker holds a bearer token for every account (a phished session or IdP), can
// steal holders and can learn a recovery key. Clients reach the server over TLS: the attacker cannot read their
// requests, but sends its own.
// The heads' compare-and-set is in identity-heads.spthy and log-chain.spthy. Here the server keeps the IK in force
// and the device set, and checks DPoP proofs against the set.
// A reset waits 7 days as pending, and any holder in the set or S can cancel it. The model has no clock: an
// activation may come at any time after the reset, so "the full delay" means a pending reset nobody cancelled.
// Flag OLDRESET models 0053 before G0 round 1 (e8879f95ee), where a reset applied at once.

builtins: hashing, signing

macros:
  dpop(jti, htm, a) = <'dpop+jwt', jti, htm, a, h(<'access-token', a>)>

rule Attacker_Request:
  [ In(m) ] --> [ ToServer(m) ]

rule SignUp:
  [ Fr(~a) ] --> [ SrvEmpty(~a), !PersonAccount(~a), Out(~a) ]

// Genesis is trust on first use: the server takes it from any session while the account has no identity log.
rule P_Genesis:
  let
    gp  = <'genesis', a, pk(~ik), pk(~hsig), ~hid>
    dp  = dpop(~jti, 'genesis', a)
  in
  [ !PersonAccount(a), Fr(~ik), Fr(~hsig), Fr(~hid), Fr(~jti) ]
  --[ OnlyOnce(<'genesis', a>), PersonIK(a, pk(~ik)), HonestKey(a, pk(~hsig))
    , HolderSent(a, pk(~hsig), <'genesis', gp>) ]->
  [ !IK(a, ~ik), !Holder(a, ~hsig), ToServer(<'genesis', <gp, sign(gp, ~ik)>, <dp, sign(dp, ~hsig)>>) ]

rule Srv_Genesis:
  let
    gp  = <'genesis', a, pk(ik), pk(hsig), hid>
    dp  = dpop(jti, 'genesis', a)
  in
  [ SrvEmpty(a), ToServer(<'genesis', <gp, sign(gp, ik)>, <dp, sign(dp, hsig)>>) ]
  --[ JtiUsed(jti), Unique(hid), SrvIK(a, pk(ik)), SrvMember(a, pk(hsig), <'root', hid>)
    , Accepted(a, pk(hsig), <'genesis', gp>) ]->
  [ !IKTaken(a, pk(ik)), !SMem(a, pk(hsig), <'root', hid>, pk(ik)) ]

// An approved holder approves an honest new holder after a comparison (device-approval.spthy).
rule H_Approve:
  let
    ap = <'add', a, 'approval', pk(~nsig), ~nid, pk(hsig)>
    dp = dpop(~jti, 'append', a)
  in
  [ !Holder(a, hsig), Fr(~nsig), Fr(~nid), Fr(~jti) ]
  --[ HonestKey(a, pk(~nsig)), HolderSent(a, pk(hsig), <'add', ap>) ]->
  [ !Holder(a, ~nsig), ToServer(<'add', <ap, sign(ap, hsig)>, <dp, sign(dp, hsig)>>) ]

// The approver signs the add with its own key and proves that key with DPoP; it must be in the set under the IK
// in force.
rule Srv_Add:
  let
    ap = <'add', a, 'approval', pk(nk), nid, pk(bysig)>
    dp = dpop(jti, 'append', a)
  in
  [ !IKTaken(a, ik), !SMem(a, pk(bysig), blin, ik), ToServer(<'add', <ap, sign(ap, bysig)>, <dp, sign(dp, bysig)>>) ]
  --[ InForce(a, ik), JtiUsed(jti), Unique(nid), UseMem(a, blin), SrvMember(a, pk(nk), <'lin', nid, blin>)
    , Accepted(a, pk(bysig), <'add', ap>) ]->
  [ !SMem(a, pk(nk), <'lin', nid, blin>, ik) ]

// Recovery with S: the new holder signs its own add with IK and proves its own key.
rule P_Recover:
  let
    ap = <'add', a, 'recovery', pk(~nsig), ~nid>
    dp = dpop(~jti, 'append', a)
  in
  [ !IK(a, ik), Fr(~nsig), Fr(~nid), Fr(~jti) ]
  --[ HonestKey(a, pk(~nsig)), HolderSent(a, pk(~nsig), <'add-recovery', ap>) ]->
  [ !Holder(a, ~nsig), ToServer(<'add-recovery', <ap, sign(ap, ik)>, <dp, sign(dp, ~nsig)>>) ]

rule Srv_Recover:
  let
    ap = <'add', a, 'recovery', pk(nsig), nid>
    dp = dpop(jti, 'append', a)
  in
  [ !IKTaken(a, pk(ik)), ToServer(<'add-recovery', <ap, sign(ap, ik)>, <dp, sign(dp, nsig)>>) ]
  --[ InForce(a, pk(ik)), JtiUsed(jti), Unique(nid), SrvMember(a, pk(nsig), <'root', nid>)
    , Accepted(a, pk(nsig), <'add-recovery', ap>) ]->
  [ !SMem(a, pk(nsig), <'root', nid>, pk(ik)) ]

// Reset when S is lost: a new IK, endorsed by the holder it names, which must be in the set. Its place in the log
// makes each reset statement unique, which the nonce stands for.
rule H_Reset:
  let
    rp = <'reset', a, pk(~ik2), pk(hsig), ~n>
    dp = dpop(~jti, 'append', a)
  in
  [ !Holder(a, hsig), Fr(~ik2), Fr(~n), Fr(~jti) ]
  --[ PersonIK(a, pk(~ik2)), HolderSent(a, pk(hsig), <'reset', rp>) ]->
  [ !IK(a, ~ik2), !PersonReset(a, ~ik2, h(rp))
  , ToServer(<'reset', <rp, sign(rp, ~ik2)>, sign(<'endorse', rp>, hsig), <dp, sign(dp, hsig)>>) ]

#ifdef OLDRESET
rule Srv_Reset:
  let
    rp = <'reset', a, pk(ik2), pk(hsig), n>
    dp = dpop(jti, 'append', a)
  in
  [ !IKTaken(a, ik), !SMem(a, pk(hsig), hlin, ik)
  , ToServer(<'reset', <rp, sign(rp, ik2)>, sign(<'endorse', rp>, hsig), <dp, sign(dp, hsig)>>) ]
  --[ InForce(a, ik), JtiUsed(jti), Unique(h(rp)), UseMem(a, hlin), SrvIK(a, pk(ik2)), ResetBy(a, pk(hsig))
    , Accepted(a, pk(hsig), <'reset', rp>) ]->
  [ !IKTaken(a, pk(ik2)), !SMem(a, pk(hsig), hlin, pk(ik2)) ]
#else
rule Srv_Reset:
  let
    rp = <'reset', a, pk(ik2), pk(hsig), n>
    dp = dpop(jti, 'append', a)
  in
  [ !IKTaken(a, ik), !SMem(a, pk(hsig), hlin, ik)
  , ToServer(<'reset', <rp, sign(rp, ik2)>, sign(<'endorse', rp>, hsig), <dp, sign(dp, hsig)>>) ]
  --[ InForce(a, ik), JtiUsed(jti), Unique(h(rp)), UseMem(a, hlin), ResetPending(a, pk(ik2), h(rp)), ResetBy(a, pk(hsig))
    , Accepted(a, pk(hsig), <'reset', rp>) ]->
  [ PendingReset(a, pk(ik2), h(rp), pk(hsig), hlin) ]

// A `fresh` reset from a holder outside the set, which the server takes only when the set is empty. The model lets
// any session push one at any time, which gives the attacker more than the rule does.
rule Srv_ResetFresh:
  let
    rp = <'reset', a, pk(ik2), pk(hsig), n, 'fresh'>
    dp = dpop(jti, 'append', a)
  in
  [ !IKTaken(a, ik), ToServer(<'reset', <rp, sign(rp, ik2)>, sign(<'endorse', rp>, hsig), <dp, sign(dp, hsig)>>), Fr(~nid) ]
  --[ InForce(a, ik), JtiUsed(jti), Unique(h(rp)), ResetPending(a, pk(ik2), h(rp)), ResetBy(a, pk(hsig))
    , FreshReset(a, pk(hsig)) ]->
  [ PendingReset(a, pk(ik2), h(rp), pk(hsig), <'root', ~nid>) ]

// Any holder the logs list cancels a reset the person did not make, whatever the server says of its row, as does S
// through any statement the IK in force signs.
rule H_Cancel:
  let
    cp = <'cancel', a, rid>
    dp = dpop(~jti, 'append', a)
  in
  [ !Holder(a, hsig), In(rid), Fr(~jti) ]
  --[ HolderSent(a, pk(hsig), <'cancel', cp>) ]->
  [ ToServer(<'cancel', <cp, sign(cp, hsig)>, <dp, sign(dp, hsig)>>) ]

rule Srv_CancelByHolder:
  let
    cp = <'cancel', a, rid>
    dp = dpop(jti, 'append', a)
  in
  [ !IKTaken(a, ik), !SMem(a, pk(hsig), lin, ik), PendingReset(a, ik2pub, rid, rh, rlin)
  , ToServer(<'cancel', <cp, sign(cp, hsig)>, <dp, sign(dp, hsig)>>) ]
  --[ InForce(a, ik), JtiUsed(jti), Cancelled(a, rid), CancelledBy(a, pk(hsig)), Accepted(a, pk(hsig), <'cancel', cp>) ]->
  [ ]

rule P_CancelWithS:
  let
    cp = <'cancel', a, rid>
  in
  [ !IK(a, ik), In(rid) ] --> [ ToServer(<'cancel-ik', <cp, sign(cp, ik)>>) ]

rule Srv_CancelByIK:
  let
    cp = <'cancel', a, rid>
  in
  [ !IKTaken(a, pk(ik)), PendingReset(a, ik2pub, rid, rh, rlin), ToServer(<'cancel-ik', <cp, sign(cp, ik)>>) ]
  --[ InForce(a, pk(ik)), Cancelled(a, rid) ]->
  [ ]

// After the delay, the reset's own IK signs `activate`, and the set becomes the holder it named.
rule Srv_Activate:
  let
    ap = <'activate', a, rid>
  in
  [ PendingReset(a, pk(ik2), rid, rh, rlin), ToServer(<'activate', <ap, sign(ap, ik2)>>) ]
  --[ SrvIK(a, pk(ik2)), Activated(a, rid) ]->
  [ !IKTaken(a, pk(ik2)), !SMem(a, rh, rlin, pk(ik2)) ]

rule H_Activate:
  let
    ap = <'activate', a, rid>
  in
  [ !PersonReset(a, ik2, rid) ] --> [ ToServer(<'activate', <ap, sign(ap, ik2)>>) ]
#endif

// Any other key-object or envelope write, and every personal read, passes the same check.
rule H_Write:
  let
    dp = dpop(~jti, 'write', a)
  in
  [ !Holder(a, hsig), Fr(~jti), Fr(~body) ]
  --[ HolderSent(a, pk(hsig), <'write', ~body>) ]->
  [ ToServer(<'write', ~body, <dp, sign(dp, hsig)>>) ]

rule Srv_Write:
  let
    dp = dpop(jti, 'write', a)
  in
  [ !IKTaken(a, ik), !SMem(a, pk(hsig), lin, ik), ToServer(<'write', body, <dp, sign(dp, hsig)>>) ]
  --[ InForce(a, ik), JtiUsed(jti), UseMem(a, lin), Accepted(a, pk(hsig), <'write', body>) ]->
  [ ]

// An admin's portal removal, or the person's removal of the device row: the holder and those it approved.
rule AdminRemove:
  [ !SMem(a, hk, lin, ik) ] --[ Cut(a, lin), RowRemoved(a, hk) ]-> [ ]

rule Compromise:
  [ !Holder(a, hsig) ] --[ Compromise(a, pk(hsig)) ]-> [ Out(hsig) ]

rule RevealIK:
  [ !IK(a, ik) ] --[ RevealIK(a) ]-> [ Out(ik) ]

// The IK in force is the one the server took last.
restriction InForce:
  "All a ik ik2 #i #g #h. InForce(a, ik)@i & SrvIK(a, ik)@g & SrvIK(a, ik2)@h & #g < #h & #h < #i ==> F"

restriction NotCut:
  "All a lin linX #i #j. UseMem(a, lin)@i & Cut(a, linX)@j & #j < #i ==> not (linX = lin) & not (linX << lin)"

// Each jti is kept for longer than a proof's iat window, so a proof is taken once.
restriction JtiOnce:
  "All x #i #j. JtiUsed(x)@i & JtiUsed(x)@j ==> #i = #j"

restriction Unique:
  "All x #i #j. Unique(x)@i & Unique(x)@j ==> #i = #j"

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

lemma members_are_honest_or_a_break_in [reuse, use_induction]:
  "All a hk lin #i. SrvMember(a, hk, lin)@i ==>
     (Ex #h. HonestKey(a, hk)@h)
     | (Ex h #c. Compromise(a, h)@c)
     | (Ex #r. RevealIK(a)@r)
     | (Ex ik #g. SrvIK(a, ik)@g & not (Ex #p. PersonIK(a, ik)@p))"

lemma enforcement_executable:
  exists-trace
  "Ex a nk nid lin b #j #i. SrvMember(a, nk, <'lin', nid, lin>)@j & Accepted(a, nk, <'write', b>)@i
     & not (Ex h #c. Compromise(a, h)@c) & not (Ex #r. RevealIK(a)@r)"

// D8: with no stolen holder, no leaked S and no attacker genesis, every write the server takes came from an
// honest holder, so a phished session writes no key object and no envelope. A `fresh` reset is the one write it may
// start, and it stays pending under the veto (reset_needs_s_or_full_delay).
lemma write_needs_approved_holder:
  "All a hk m #i. Accepted(a, hk, m)@i ==>
     (Ex #j. HolderSent(a, hk, m)@j & #j < #i)
     | (Ex h #c. Compromise(a, h)@c)
     | (Ex #r. RevealIK(a)@r)
     | (Ex ik #g. SrvIK(a, ik)@g & not (Ex #p. PersonIK(a, ik)@p))"

// D7, G0 round 1 H1, 0053's claim: once the person's identity is in force, another identity takes effect only with
// S, or after a reset that stayed pending with no cancel.
lemma reset_needs_s_or_full_delay:
  "All a ik0 ik #g #p #i. SrvIK(a, ik0)@g & PersonIK(a, ik0)@p & SrvIK(a, ik)@i & #g < #i ==>
     (Ex #q. PersonIK(a, ik)@q)
     | (Ex #r. RevealIK(a)@r)
     | (Ex rid #w. ResetPending(a, ik, rid)@w & #w < #i & not (Ex #c. Cancelled(a, rid)@c))"

#ifdef OLDRESET
#else
// 0053's claim: removing the rows of the person's devices, as a phished session or an admin can, never takes the
// cancel away from a holder the logs list.
lemma row_removal_keeps_the_cancel:
  exists-trace
  "Ex a h ik rid #x #p #c. RowRemoved(a, h)@x & ResetPending(a, ik, rid)@p & #x < #p & CancelledBy(a, h)@c
     & Cancelled(a, rid)@c & (Ex #k. HonestKey(a, h)@k) & not (Ex #q. PersonIK(a, ik)@q)
     & not (Ex #y. Compromise(a, h)@y)"

// A thief's reset, cancelled by one of the person's holders, never takes effect.
lemma stolen_holder_reset_cancelled:
  exists-trace
  "Ex a h ik rid #c #p #x. Compromise(a, h)@c & ResetBy(a, h)@p & ResetPending(a, ik, rid)@p & Cancelled(a, rid)@x
     & not (Ex #q. PersonIK(a, ik)@q) & not (Ex #v. Activated(a, rid)@v)"
#endif

end
