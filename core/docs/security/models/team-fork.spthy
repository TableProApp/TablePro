theory SyncTeamFork
begin

// ADR 0053: Rollback and forks, Ending a team fork. At the fork point the team has signers A and B, so n = 2 and
// k = 2. A is honest; the attacker holds B and runs the server, so it builds the branches as it likes from what A and
// B signed. G verifies both branches and a `resolve` that keeps one and drops the other.

builtins: hashing, signing

rule Team:
  [ Fr(~t), Fr(~ka), Fr(~kb) ]
  --[ OnlyOnce('team') ]->
  [ !Key(~t, 'A', ~ka), !Key(~t, 'B', ~kb), !AKey(~t, ~ka), Out(<~t, pk(~ka), pk(~kb), ~kb>) ]

// A cancels a time-locked removal of itself, or revokes, on a branch the server shows it.
rule A_SignsOnBranch:
  let
    sp = <'statement', t, br, kind, x, 'A'>
  in
  [ !AKey(t, ka), In(<br, kind, x>) ]
  --[ ASigned(t, br, kind, x) ]->
  [ Out(<sp, sign(sp, ka)>) ]

// G takes a statement on a branch from a fork-point signer. A removal of a signer on a branch is a completion by B.
rule G_OnBranch:
  let
    sp = <'statement', t, br, kind, x, s>
  in
  [ !Key(t, s, k), In(<sp, sign(sp, k)>) ]
  --[ OnBranch(t, br, kind, x) ]->
  [ !Branch(t, br, kind, x) ]

// A approves a resolve; the model lets it approve any, so only G's checks stop a bad one.
rule A_ApproveResolve:
  let
    ap = <'approve-resolve', t, kept, dropped, 'A'>
  in
  [ !AKey(t, ka), In(<kept, dropped>) ]
  --[ AApproved(t, kept, dropped) ]->
  [ Out(<ap, sign(ap, ka)>) ]

// G takes a resolve with k = 2 approvals from distinct signers of the fork point that neither branch removes.
rule G_Resolve:
  let
    a1 = <'approve-resolve', t, kept, dropped, s1>
    a2 = <'approve-resolve', t, kept, dropped, s2>
  in
  [ !Key(t, s1, k1), !Key(t, s2, k2), In(<a1, sign(a1, k1)>), In(<a2, sign(a2, k2)>) ]
  --[ Neq(s1, s2), NotRemovedOnEither(t, kept, dropped, s1), NotRemovedOnEither(t, kept, dropped, s2)
    , KeepsCancels(t, kept, dropped), KeepsRevocations(t, kept, dropped), Resolved(t, kept, dropped) ]->
  [ ]

restriction Neq:
  "All x y #i. Neq(x, y)@i ==> not (x = y)"

restriction NotRemovedOnEither:
  "All t kept dropped s #i. NotRemovedOnEither(t, kept, dropped, s)@i ==>
     not (Ex #j. OnBranch(t, kept, 'remove-signer', s)@j & #j < #i)
     & not (Ex #j. OnBranch(t, dropped, 'remove-signer', s)@j & #j < #i)"

// A resolve never drops a cancel or a withdraw the dropped branch holds, unless the kept branch holds it too.
restriction KeepsCancels:
  "All t kept dropped x #i #j. KeepsCancels(t, kept, dropped)@i & OnBranch(t, dropped, 'cancel', x)@j & #j < #i ==>
     Ex #m. OnBranch(t, kept, 'cancel', x)@m & #m < #i"

// Nor a revocation, unless it is signed again on the kept branch.
restriction KeepsRevocations:
  "All t kept dropped x #i #j. KeepsRevocations(t, kept, dropped)@i & OnBranch(t, dropped, 'revoke', x)@j & #j < #i ==>
     Ex #m. OnBranch(t, kept, 'revoke', x)@m & #m < #i"

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

lemma resolve_executable:
  exists-trace
  "Ex t kept dropped x #i #c. Resolved(t, kept, dropped)@i & ASigned(t, kept, 'cancel', x)@c"

// 0053's claim: with two signers at the fork point, B alone resolves no fork, whatever either branch removes.
lemma resolve_counts_k_at_the_fork_point:
  "All t kept dropped #i. Resolved(t, kept, dropped)@i ==> Ex #a. AApproved(t, kept, dropped)@a & #a < #i"

// 0053's claim: no resolve drops a cancel G verified on the dropped branch. A cancel the server withholds from G is
// a split view, which the threat model lists.
lemma resolve_never_drops_a_cancel:
  "All t kept dropped x #i #c. Resolved(t, kept, dropped)@i & OnBranch(t, dropped, 'cancel', x)@c & #c < #i ==>
     Ex #m. OnBranch(t, kept, 'cancel', x)@m & #m < #i"

// 0053's claim: no resolve drops a revocation G verified, unless it is signed again on the kept branch.
lemma resolve_never_drops_a_revocation:
  "All t kept dropped x #i #c. Resolved(t, kept, dropped)@i & OnBranch(t, dropped, 'revoke', x)@c & #c < #i ==>
     Ex #m. OnBranch(t, kept, 'revoke', x)@m & #m < #i"

end
