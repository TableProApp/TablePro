theory SyncTeamSigners
begin

// ADR 0053: Team log (`signer_add`, `signer_remove`, `approve`, the time-locked removal and its cancel, `reroot`),
// The sole owner after a reset, D15 and the maintainer's k = min(2, n). Signers A and B; A is honest. The attacker holds B's key, runs the server and may hold
// an owner role, so it can write any statement B or an attacker account signs, and can claim that A reset. G
// verifies the team log. n counts every signer in the set; nothing the server says and no reset lowers it.
// The model has no clock: a time-locked removal completes any time after its start unless its target cancelled.
// Flag UNCHECKED drops three checks G makes: a cancel ends a removal, only the holders the team pinned may cancel, and
// a re-root needs an empty signer set. Each lemma that rests on one of them is then falsified, so none is vacuous.

builtins: hashing, signing

// A's holder a1 is listed in the logs the team pinned for A.
rule Team:
  [ Fr(~t), Fr(~ka), Fr(~kb), Fr(~a1) ]
  --[ OnlyOnce('team'), SignerIn(~t, 'A'), SignerIn(~t, 'B'), AEndorsed(~t, 'B') ]->
  [ !Key(~t, 'A', ~ka), !Key(~t, 'B', ~kb), !AKey(~t, ~ka)
  , !ListedHolder(~t, 'A', pk(~a1)), !AHonestHolder(~t, ~a1)
  , Out(<~t, pk(~ka), pk(~kb), pk(~a1)>) ]

// A reset of A's account, which the server may have made up. Its new IK and the holder it names are the attacker's.
// As the sole owner, the reset account may start A's time-locked removal, but its holder is not one the team pinned.
#ifdef UNCHECKED
rule ResetAccountOfA:
  [ !Key(t, 'A', ka), Fr(~ik2), Fr(~hr) ]
  --[ OnlyOnce(<'reset', t>), Suspended(t, 'A'), ResetHolder(t, pk(~hr)) ]->
  [ !ResetAccount(t, 'A', ~ik2), !ListedHolder(t, 'A', pk(~hr)), Out(<~ik2, ~hr, pk(~hr)>) ]

#else
rule ResetAccountOfA:
  [ !Key(t, 'A', ka), Fr(~ik2), Fr(~hr) ]
  --[ OnlyOnce(<'reset', t>), Suspended(t, 'A'), ResetHolder(t, pk(~hr)) ]->
  [ !ResetAccount(t, 'A', ~ik2), Out(<~ik2, ~hr, pk(~hr)>) ]

#endif

rule CorruptB:
  [ !Key(t, 'B', kb) ] --[ Corrupt(t, 'B') ]-> [ Out(kb) ]

// A proposes adding an honest account, which is all A ever proposes or approves.
rule A_ProposeAdd:
  let
    sp = <'signer_add', t, ~h, 'A'>
  in
  [ !AKey(t, ka), Fr(~h) ]
  --[ AEndorsed(t, ~h) ]->
  [ Out(<sp, sign(sp, ka)>) ]

// A cancels any time-locked removal that targets it, from its holder a1.
rule A_CancelTimelock:
  let
    cp = <'signer_remove_cancel', t, pid, 'A', pk(a1)>
  in
  [ !AHonestHolder(t, a1), In(pid) ]
  -->
  [ Out(<cp, sign(cp, a1)>) ]

rule A_RemoveSelf:
  let
    rp = <'signer_remove', t, 'A', 'A'>
  in
  [ !AKey(t, ka) ] --[ AOwnRemoval(t) ]-> [ Out(<rp, sign(rp, ka)>) ]

rule V_ProposeAdd:
  let
    sp = <'signer_add', t, p, s>
  in
  [ !Key(t, s, k), In(<sp, sign(sp, k)>) ]
  --[ InSet(t, s) ]->
  [ !Proposal(t, h(sp), 'add', p, s) ]

rule V_ProposeRemove:
  let
    rp = <'signer_remove', t, x, s>
  in
  [ !Key(t, s, k), In(<rp, sign(rp, k)>) ]
  --[ InSet(t, s), Neq(x, s) ]->
  [ !Proposal(t, h(rp), 'remove', x, s) ]

rule V_RemoveSelf:
  let
    rp = <'signer_remove', t, s, s>
  in
  [ !Key(t, s, k), In(<rp, sign(rp, k)>) ]
  --[ InSet(t, s), SignerOut(t, s), SelfRemoved(t, s) ]->
  [ ]

rule V_Approve:
  let
    ap = <'approve', t, pid, s>
  in
  [ !Key(t, s, k), In(<ap, sign(ap, k)>) ]
  --[ InSet(t, s) ]->
  [ !Approval(t, pid, s) ]


rule V_AddAlone:
  [ !Proposal(t, pid, 'add', p, s) ]
  --[ OnlySigner(t, s), InSet(t, s), SignerIn(t, p), SignerAdded(t, p), Once(<t, pid>) ]->
  [ ]

rule V_AddWithApproval:
  [ !Proposal(t, pid, 'add', p, s1), !Approval(t, pid, s2) ]
  --[ Neq(s1, s2), InSet(t, s1), InSet(t, s2), SignerIn(t, p), SignerAdded(t, p), Once(<t, pid>) ]->
  [ ]

// Removing another signer with k = min(2, n) distinct signers other than the target.
rule V_RemoveWithApproval:
  [ !Proposal(t, pid, 'remove', x, s1), !Approval(t, pid, s2) ]
  --[ Neq(s1, s2), Neq(s2, x), InSet(t, s1), InSet(t, s2), InSet(t, x), SignerOut(t, x), RemovedByOthers(t, x)
    , RemovedWithK(t, x), Once(<t, pid>) ]->
  [ ]

// The time-locked removal: any one other signer starts it, the target cancels it, and it completes after the delay.
rule V_TimelockStart:
  let
    rp = <'signer_remove', t, x, s, 'timelock'>
  in
  [ !Key(t, s, k), In(<rp, sign(rp, k)>) ]
  --[ InSet(t, s), InSet(t, x), Neq(x, s), TimelockStarted(t, x, h(rp)), Once(h(rp)) ]->
  [ PendingRemoval(t, x, h(rp)) ]

// A cancel from any holder the logs the team pinned for the target list, whatever its row or role. It ends the
// removal for good; nothing voids it.
// The sole owner after a reset starts the removal of its own old signer identity.
rule V_TimelockStartByResetAccount:
  let
    rp = <'signer_remove', t, x, 'reset-account', 'timelock'>
  in
  [ !ResetAccount(t, x, ik2), In(<rp, sign(rp, ik2)>) ]
  --[ InSet(t, x), TimelockStarted(t, x, h(rp)), StartedByResetAccount(t, x, h(rp)), Once(h(rp)) ]->
  [ PendingRemoval(t, x, h(rp)) ]

rule V_TimelockCancel:
  let
    cp = <'signer_remove_cancel', t, pid, x, pk(hk)>
  in
  [ !ListedHolder(t, x, pk(hk)), In(<cp, sign(cp, hk)>) ]
  --[ TimelockCancelled(t, pid, pk(hk)), CancelledBy(t, x, pk(hk)) ]->
  [ ]

rule V_TimelockComplete:
  [ PendingRemoval(t, x, pid) ]
  --[ NoCancelInForce(t, pid), InSet(t, x), SignerOut(t, x), RemovedByOthers(t, x), TimelockCompleted(t, x, pid) ]->
  [ ]

// An account the server lists as owner writes `reroot`; G takes it only when the signer set is empty.
rule V_Reroot:
  [ In(<'reroot', t, r>) ]
  --[ NoSignerLeft(t), Reroot(t, r) ]->
  [ ]

#ifdef UNCHECKED
#else
restriction NoCancelInForce:
  "All t pid h #i #c. NoCancelInForce(t, pid)@i & TimelockCancelled(t, pid, h)@c & #c < #i ==> F"

restriction NoSignerLeft:
  "All t #i. NoSignerLeft(t)@i ==>
     All s #j. SignerIn(t, s)@j & #j < #i ==> Ex #o. SignerOut(t, s)@o & #o < #i"
#endif

restriction InSet:
  "All t s #i. InSet(t, s)@i ==> (Ex #j. SignerIn(t, s)@j & #j < #i) & not (Ex #o. SignerOut(t, s)@o & #o < #i)"

restriction OnlySigner:
  "All t s #i. OnlySigner(t, s)@i ==>
     not (Ex s2 #j. SignerIn(t, s2)@j & #j < #i & not (s2 = s) & not (Ex #o. SignerOut(t, s2)@o & #o < #i))"

restriction JoinOnce:
  "All t s #i #j. SignerIn(t, s)@i & SignerIn(t, s)@j ==> #i = #j"

restriction Neq:
  "All x y #i. Neq(x, y)@i ==> not (x = y)"

restriction Once:
  "All x #i #j. Once(x)@i & Once(x)@j ==> #i = #j"

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x)@i & OnlyOnce(x)@j ==> #i = #j"

// Both signers leave, and an owner re-roots the team.
lemma reroot_executable:
  exists-trace
  "Ex t r #i. Reroot(t, r)@i"

// A adds a third signer with B's approval.
lemma signers_executable:
  exists-trace
  "Ex t p #i #e. SignerAdded(t, p)@i & AEndorsed(t, p)@e & not (p = 'B')"

// A cancels B's time-locked removal of A and stays.
lemma timelock_cancelled:
  exists-trace
  "Ex t pid h #s #c. TimelockStarted(t, 'A', pid)@s & TimelockCancelled(t, pid, h)@c
     & not (Ex #r. StartedByResetAccount(t, 'A', pid)@r) & not (Ex #o. SignerOut(t, 'A')@o)"

// While A is a signer, B adds no signer without A.
lemma no_signer_added_alone:
  "All t p #i #a. SignerAdded(t, p)@i & SignerIn(t, 'A')@a & #a < #i & not (Ex #o. SignerOut(t, 'A')@o & #o < #i) ==>
     Ex #e. AEndorsed(t, p)@e"

// 0053's claim: no signer is removed by another with fewer than k approvals, unless a time-locked removal ran its
// delay without the target's cancel.
lemma no_signer_removed_by_one_other:
  "All t #i. RemovedByOthers(t, 'A')@i ==>
     Ex pid #s. TimelockStarted(t, 'A', pid)@s & #s < #i & not (Ex h #c. TimelockCancelled(t, pid, h)@c & #c < #i)"

// 0053's claim: a cancel ends a time-locked removal for good.
lemma cancel_ends_a_removal_for_good:
  "All t x pid h #c #i. TimelockCancelled(t, pid, h)@c & TimelockCompleted(t, x, pid)@i & #c < #i ==> F"

// 0053's claim: the old signer's veto holds against a removal its own reset account starts, and the holder the
// reset names cannot cancel.
lemma old_signers_veto_holds_against_its_reset_account:
  exists-trace
  "Ex t pid h #s #c. StartedByResetAccount(t, 'A', pid)@s & TimelockCancelled(t, pid, h)@c & #s < #c
     & not (Ex #o. SignerOut(t, 'A')@o)"

lemma reset_holder_cannot_cancel:
  "All t x h hr #c #r. CancelledBy(t, x, h)@c & ResetHolder(t, hr)@r & h = hr ==> F"

// 0053's claim: a reset, even one the server made up, removes no signer, so it lowers neither n nor k.
lemma reset_removes_no_signer:
  "All t s #o. SignerOut(t, s)@o ==>
     (Ex #r. SelfRemoved(t, s)@r) | (Ex #r. RemovedWithK(t, s)@r) | (Ex pid #r. TimelockCompleted(t, s, pid)@r)"

// 0053's claim: no re-root takes effect while a signer is left.
lemma no_reroot_while_a_signer_is_left:
  "All t r s #i #j. Reroot(t, r)@i & SignerIn(t, s)@j & #j < #i ==> Ex #o. SignerOut(t, s)@o & #o < #i"

end
