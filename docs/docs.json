{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "TablePro",
  "description": "TablePro is a native macOS database client for MySQL, PostgreSQL, SQLite, MongoDB, Redis and 20 more, built on AppKit and SwiftUI with a plugin-based driver system.",
  "colors": {
    "primary": "#A85A00",
    "light": "#FFBB6B",
    "dark": "#A85A00"
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://tablepro.app"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "TablePro",
      "og:type": "website",
      "twitter:card": "summary_large_image"
    },
    "organization": {
      "id": "https://tablepro.app/#organization",
      "name": "TablePro",
      "url": "https://tablepro.app",
      "sameAs": [
        "https://github.com/TableProApp/TablePro"
      ]
    }
  },
  "search": {
    "prompt": "Search the docs"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "That page moved or never existed",
      "description": "Try [the docs home](/), or search with `Cmd+K`. If a link here sent you, [open an issue](https://github.com/TableProApp/TablePro/issues)."
    }
  },
  "redirects": [
    {
      "source": "/features/php-viewer",
      "destination": "/features/json-viewer"
    },
    {
      "source": "/customization/overview",
      "destination": "/customization/settings"
    },
    {
      "source": "/features/quick-switcher",
      "destination": "/features/open-quickly"
    },
    {
      "source": "/features/export",
      "destination": "/features/import-export"
    },
    {
      "source": "/features/import",
      "destination": "/features/import-export"
    }
  ],
