    "functions": [
      "array_position",
      "array_remove",
      "array_append",
      "array_prepend"
    ],
    "assertions": [
      "A same-named shadow enum leads transaction search_path while the target enum and table remain schema-qualified.",
      "The first array parameter is inferred as the target enum array from the typed enum element argument.",
