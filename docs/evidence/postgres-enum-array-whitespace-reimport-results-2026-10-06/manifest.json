  "expected_array_literal": "{\"NULL\",\"\",\" leading\",\"trailing \",\"\u6771\u4eac\",\"a,b\",\"a\\\"b\",\"<tag>&\",\"=1+1\",\"slash\\\\path\",NULL}",
