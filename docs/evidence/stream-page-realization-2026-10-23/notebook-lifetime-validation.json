{
  "gtk": "4.24.1",
  "compiler_flags": [
    "-Wall",
    "-Wextra",
    "-Werror"
  ],
  "runs": [
    {
      "backend": "atspi",
      "exit_code": 1,
      "after_window_destroy": {
        "labels_alive": 250,
        "contexts_alive": 250,
        "children_alive": 0
      }
    },
    {
      "backend": "test",
      "exit_code": 1,
      "after_window_destroy": {
        "labels_alive": 250,
        "contexts_alive": 250,
        "children_alive": 0
      }
    },
    {
      "backend": "none",
      "exit_code": 1,
      "after_window_destroy": {
        "labels_alive": 250,
        "contexts_alive": 0,
        "children_alive": 0
      }
    }
  ]
}
