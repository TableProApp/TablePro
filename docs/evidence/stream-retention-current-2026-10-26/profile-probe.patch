+fn large_byte_page(bytes_per_cell: usize) -> Arc<QueryResult> {
+    let mut result = page(&[]).as_ref().clone();
+    result.columns = (0..60)
+        .map(|index| ColumnInfo {
+            name: format!("payload_{index}"),
+            data_type: "BYTEA".into(),
+            nullable: true,
+            primary_key: false,
+            is_auto_increment: false,
+            default_value: None,
+            is_generated: false,
+            comment: None,
+            collation: None,
+            enum_type: None,
+            domain_type: None,
+        })
+        .collect();
+    let row = (0..60)
+        .map(|_| Value::Bytes(vec![7; bytes_per_cell]))
+        .collect::<Vec<_>>();
+    assert!(tablepro_core::QueryResultBudget::default().admit(&row));
+    result.rows = vec![row];
+    Arc::new(result)
+}
+
+fn stream_outcome(sql: &str, page: Arc<QueryResult>) -> StatementOutcome {
+    let mut cache = super::super::stream_pages::StreamPageCache::default();
+    cache.append(0, page).expect("append page");
+    StatementOutcome {
+        kind: StatementOutcomeKind::Streamed(Box::new(
+            cache.snapshot(super::super::stream_pages::StreamTerminal::Complete, None),
+        )),
+        ..rows(sql)
+    }
+}
+
+fn process_memory_mib(field: &str) -> usize {
+    std::fs::read_to_string("/proc/self/status")
+        .expect("process status")
+        .lines()
+        .find_map(|line| {
+            line.strip_prefix(field)?
+                .split_whitespace()
+                .next()?
+                .parse::<usize>()
+                .ok()
+        })
+        .expect("RSS")
+        / 1024
+}
+
+#[test]
+#[ignore = "one-off current-source retained-page profile"]
+fn profile_current_stream_pin_and_preview_owners() {
+    let payload_bytes_per_cell = 1024 * 1024;
+    let mut weak_pages: Vec<Weak<QueryResult>> = Vec::new();
+    let mut pins = PinnedResults::default();
+    println!("baseline_rss_mib={}", process_memory_mib("VmRSS:"));
+    println!("baseline_hwm_mib={}", process_memory_mib("VmHWM:"));
+    for index in 0..MAX_PINNED {
+        let page = large_byte_page(payload_bytes_per_cell);
+        weak_pages.push(Arc::downgrade(&page));
+        pins.show(vec![stream_outcome(&format!("SELECT {index}"), page)]);
+        assert_eq!(pins.pin_last(), index + 1);
+    }
+    println!("four_pins_rss_mib={}", process_memory_mib("VmRSS:"));
+    println!("four_pins_hwm_mib={}", process_memory_mib("VmHWM:"));
+    let active_page = large_byte_page(payload_bytes_per_cell);
+    weak_pages.push(Arc::downgrade(&active_page));
+    let shown = pins.show(vec![stream_outcome("SELECT active", active_page)]);
+    let visible_rows = shown
+        .iter()
+        .flat_map(|outcome| match &outcome.kind {
+            StatementOutcomeKind::Streamed(result) => result
+                .pages
+                .iter()
+                .filter_map(|page| crate::ui::row_object::RowObject::from_shared(page, 0, None))
+                .collect::<Vec<_>>(),
+            _ => Vec::new(),
+        })
+        .collect::<Vec<_>>();
+    for row in &visible_rows {
+        row.preview_values_from_result();
+    }
+    let retained_bytes = weak_pages
+        .iter()
+        .filter_map(Weak::upgrade)
+        .map(|page| page.estimated_row_bytes())
+        .sum::<usize>();
+    println!("pins_plus_active_rss_mib={}", process_memory_mib("VmRSS:"));
+    println!("pins_plus_active_hwm_mib={}", process_memory_mib("VmHWM:"));
+    println!("visible_preview_rss_mib={}", process_memory_mib("VmRSS:"));
+    println!("visible_preview_hwm_mib={}", process_memory_mib("VmHWM:"));
+    println!(
+        "retained_pages={}",
+        weak_pages.iter().filter(|page| page.upgrade().is_some()).count()
+    );
+    println!("retained_estimated_bytes={retained_bytes}");
+    println!(
+        "retained_cells={}",
+        weak_pages
+            .iter()
+            .filter_map(Weak::upgrade)
+            .map(|page| page.rows.iter().map(Vec::len).sum::<usize>())
+            .sum::<usize>()
+    );
+    drop(visible_rows);
+    drop(shown);
+    drop(pins);
+    println!(
+        "pages_after_owner_drop={}",
+        weak_pages.iter().filter(|page| page.upgrade().is_some()).count()
+    );
+}
