+#[test]
+#[ignore = "one-off two-editor and cancelled export-page profile"]
+fn profile_two_editor_and_cancelled_export_page_owners() {
+    use crate::ui::export_dialog::{PageFetcher, PageFetcherFactory};
+    use std::sync::{Mutex, Weak};
+    use tablepro_core::export::{ExportError, RowPage};
+    use tokio_util::sync::CancellationToken;
+
+    let bytes_per_cell = 256 * 1024;
+    let mut editor_pages: Vec<Weak<QueryResult>> = Vec::new();
+    let mut editors = Vec::new();
+    println!("baseline_rss_mib={}", profile_memory_mib("VmRSS:"));
+    println!("baseline_hwm_mib={}", profile_memory_mib("VmHWM:"));
+    println!("baseline_rss_kib={}", profile_memory_kib("VmRSS:"));
+    println!("baseline_hwm_kib={}", profile_memory_kib("VmHWM:"));
+    let page_bytes = profile_large_page(bytes_per_cell, 7).estimated_row_bytes();
+
+    for editor_index in 0..2 {
+        let mut editor = PinnedResults::default();
+        for pin_index in 0..MAX_PINNED {
+            let page = profile_large_page(bytes_per_cell, editor_index + pin_index as u8);
+            editor_pages.push(Arc::downgrade(&page));
+            editor.show(vec![profile_streamed("SELECT pinned", page)]);
+            assert_eq!(editor.pin_last(), pin_index + 1);
+        }
+        let active = profile_large_page(bytes_per_cell, editor_index + 8);
+        editor_pages.push(Arc::downgrade(&active));
+        let shown = editor.show(vec![profile_streamed("SELECT active", active)]);
+        drop(shown);
+        editors.push(editor);
+    }
+
+    let editor_payload_bytes = editor_pages
+        .iter()
+        .filter_map(Weak::upgrade)
+        .map(|page| page.estimated_row_bytes())
+        .sum::<usize>();
+    println!("editor_page_payload_bytes={editor_payload_bytes}");
+    println!("editor_page_count={}", editor_pages.len());
+    println!("two_editors_rss_mib={}", profile_memory_mib("VmRSS:"));
+    println!("two_editors_hwm_mib={}", profile_memory_mib("VmHWM:"));
+    println!("two_editors_rss_kib={}", profile_memory_kib("VmRSS:"));
+    println!("two_editors_hwm_kib={}", profile_memory_kib("VmHWM:"));
+
+    let export_rows: RowPage = Arc::try_unwrap(profile_large_page(bytes_per_cell, 9))
+        .expect("unique export page")
+        .rows;
+    let export_page = Arc::new(export_rows);
+    let export_page_weak = Arc::downgrade(&export_page);
+    let export_state = Arc::new(Mutex::new(Some(export_page.clone())));
+    let factory_state = export_state.clone();
+    let factory: PageFetcherFactory = Arc::new(move |cancel: CancellationToken| {
+        let page_state = factory_state.clone();
+        PageFetcher::new(
+            move || {
+                if cancel.is_cancelled() {
+                    drop(page_state.lock().expect("export state").take());
+                    return Err(ExportError::Cancelled);
+                }
+                let Some(page) = page_state.lock().expect("export state").take() else {
+                    return Ok(None);
+                };
+                Ok(Some((*page).clone()))
+            },
+            || Ok(()),
+        )
+    });
+    let cancel = CancellationToken::new();
+    let mut fetcher = factory(cancel.clone());
+    drop(export_page);
+    drop(export_state);
+    println!("export_page_payload_bytes={page_bytes}");
+    println!("export_in_flight_rss_mib={}", profile_memory_mib("VmRSS:"));
+    println!("export_in_flight_hwm_mib={}", profile_memory_mib("VmHWM:"));
+    println!("export_in_flight_rss_kib={}", profile_memory_kib("VmRSS:"));
+    println!("export_in_flight_hwm_kib={}", profile_memory_kib("VmHWM:"));
+
+    cancel.cancel();
+    assert!(matches!(fetcher.next_page(), Err(ExportError::Cancelled)));
+    fetcher.finish().expect("finish cancelled export");
+    assert!(export_page_weak.upgrade().is_none());
+    println!("after_export_cancel_rss_mib={}", profile_memory_mib("VmRSS:"));
+    println!("after_export_cancel_hwm_mib={}", profile_memory_mib("VmHWM:"));
+    println!("after_export_cancel_rss_kib={}", profile_memory_kib("VmRSS:"));
+    println!("after_export_cancel_hwm_kib={}", profile_memory_kib("VmHWM:"));
+
+    drop(editors);
+    assert!(editor_pages.iter().all(|page| page.upgrade().is_none()));
+    println!("after_editor_close_rss_mib={}", profile_memory_mib("VmRSS:"));
+    println!("after_editor_close_hwm_mib={}", profile_memory_mib("VmHWM:"));
+    println!("after_editor_close_rss_kib={}", profile_memory_kib("VmRSS:"));
+    println!("after_editor_close_hwm_kib={}", profile_memory_kib("VmHWM:"));
+}
