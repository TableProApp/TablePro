 use tablepro_core::{ColumnInfo, QueryResult, Value};
 
+fn profile_large_page(bytes_per_cell: usize, byte: u8) -> Arc<QueryResult> {
+    let columns = (0..60)
+        .map(|index| ColumnInfo {
+            name: format!("payload_{index}"),
+            data_type: "BYTEA".into(),
+            nullable: true,
+            primary_key: false,
+            is_auto_increment: false,
+            default_value: None,
+            is_generated: false,
+            comment: None,
+            collation: None,
+            enum_type: None,
+            domain_type: None,
+        })
+        .collect::<Vec<_>>();
+    let row = (0..60)
+        .map(|_| Value::Bytes(vec![byte; bytes_per_cell]))
+        .collect::<Vec<_>>();
+    assert!(tablepro_core::QueryResultBudget::default().admit(&row));
+    Arc::new(QueryResult {
+        columns,
+        rows: vec![row],
+        truncated: false,
+    })
+}
+
+fn profile_streamed(sql: &str, page: Arc<QueryResult>) -> StatementOutcome {
+    let mut cache = super::super::stream_pages::StreamPageCache::default();
+    cache.append(0, page).expect("append profile page");
+    StatementOutcome {
+        kind: StatementOutcomeKind::Streamed(Box::new(
+            cache.snapshot(super::super::stream_pages::StreamTerminal::Complete, None),
+        )),
+        ..rows(sql)
+    }
+}
+
+fn profile_memory_mib(field: &str) -> usize {
+    profile_memory_kib(field) / 1024
+}
+
+fn profile_memory_kib(field: &str) -> usize {
+    std::fs::read_to_string("/proc/self/status")
+        .expect("process status")
+        .lines()
+        .find_map(|line| {
+            line.strip_prefix(field)?
+                .split_whitespace()
+                .next()?
+                .parse::<usize>()
+                .ok()
+        })
+        .expect("memory sample")
+}
