{
    "app-id": "com.tablepro.linux",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "command": "bookie",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=ssh-auth",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=host-etc:ro",
        "--filesystem=/run/.heim_org.h5l.kcm-socket",
        "--env=KRB5_CONFIG=/run/host/etc/krb5.conf",
        "--talk-name=org.freedesktop.secrets"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "env": {
            "CARGO_HOME": "/run/build/tablepro-app/cargo",
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib"
        }
    },
    "modules": [
        {
            "name": "tablepro-app",
            "buildsystem": "simple",
            "build-options": {
                "build-args": [
                    "--share=network"
                ],
                "env": {
                    "RUSTUP_HOME": "/run/build/tablepro-app/rustup",
                    "CARGO_HOME": "/run/build/tablepro-app/cargo"
                }
            },
            "build-commands": [
                "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.98.0 --profile minimal",
                "export PATH=\"${CARGO_HOME}/bin:${PATH}\"; rustc --version; cargo --version",
                "export PATH=\"${CARGO_HOME}/bin:${PATH}\"; cargo build --release -p tablepro-app -p tablepro-agentd --locked",
                "export PATH=\"${CARGO_HOME}/bin:${PATH}\"; cargo build --release -p tablepro-ssh --bin tablepro-askpass --locked",
                "install -Dm755 target/release/tablepro-app /app/bin/bookie",
                "install -Dm755 target/release/tablepro-agentd /app/bin/bookie-agentd",
                "install -Dm755 target/release/tablepro-askpass /app/bin/tablepro-askpass",
                "ln -s bookie-agentd /app/bin/tablepro-agentd",
                "ln -s bookie /app/bin/tablepro",
                "install -Dm644 data/com.tablepro.linux.gschema.xml /app/share/glib-2.0/schemas/com.tablepro.linux.gschema.xml",
                "glib-compile-schemas /app/share/glib-2.0/schemas",
                "install -Dm644 flatpak/com.tablepro.linux.desktop /app/share/applications/com.tablepro.linux.desktop",
                "install -Dm644 flatpak/com.tablepro.linux.metainfo.xml /app/share/metainfo/com.tablepro.linux.metainfo.xml",
                "install -Dm644 flatpak/icons/scalable/com.tablepro.linux.svg /app/share/icons/hicolor/scalable/apps/com.tablepro.linux.svg",
                "if [ -f po/LINGUAS ]; then for lang in $(grep -v '^#' po/LINGUAS | grep -v '^$' || true); do mkdir -p /app/share/locale/$lang/LC_MESSAGES && msgfmt po/$lang.po -o /app/share/locale/$lang/LC_MESSAGES/tablepro.mo; done; fi"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                }
            ]
        }
    ]
}
