{
    "id": "app.tablepro.TablePro.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "command": "tablepro",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=ssh-auth",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=/mnt",
        "--filesystem=/run/.heim_org.h5l.kcm-socket",
        "--filesystem=/run/postgresql:ro",
        "--filesystem=/run/mysqld:ro",
        "--env=KRB5_CONFIG=/app/etc/krb5.conf"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "cxxflags": "-g0",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib"
        },
        "test-args": [
            "--socket=x11",
            "--share=network"
        ],
        "arch": {
            "aarch64": {
                "env": {
                    "CARGO_ENCODED_RUSTFLAGS": "-Clink-arg=-fuse-ld=lld"
                }
            }
        }
    },
    "cleanup": [
        "/share/man"
    ],
    "modules": [
        {
            "name": "cargo-nextest",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 cargo-nextest -t /app/bin"
            ],
            "cleanup": [
                "/bin/cargo-nextest"
            ],
            "sources": [
                {
                    "type": "archive",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-0.9.144/cargo-nextest-0.9.144-x86_64-unknown-linux-gnu.tar.gz",
                    "sha256": "8a4f726272b0a1c499bd87ca3978bfbb1a8c20bb08ccf075b9996e2081bd1e1e",
                    "strip-components": 0
                },
                {
                    "type": "archive",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-0.9.144/cargo-nextest-0.9.144-aarch64-unknown-linux-gnu.tar.gz",
                    "sha256": "7fecfd431b810c05c589d800524286b8f80ce2fe9fb1fef05caf16d095cea407",
                    "strip-components": 0
                }
            ]
        },
        {
            "name": "tablepro",
            "buildsystem": "meson",
            "subdir": "linux",
            "run-tests": true,
            "config-opts": [
                "-Dprofile=development",
                "-Dflatpak=true"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../../",
                    "dest": "linux",
                    "skip": [
                        ".flatpak-builder",
                        "_build",
                        "_flatpak",
                        "_packages",
                        "flatpak_app",
                        "repo",
                        "target",
                        "build-aux/flatpak/.flatpak-builder"
                    ]
                },
                {
                    "type": "dir",
                    "path": "../../../core",
                    "dest": "core"
                },
                {
                    "type": "file",
                    "path": "../../../Cargo.toml"
                },
                {
                    "type": "file",
                    "path": "../../../Cargo.lock"
                },
                {
                    "type": "file",
                    "path": "../../../.config/nextest.toml",
                    "dest": ".config"
                }
            ]
        }
    ]
}
