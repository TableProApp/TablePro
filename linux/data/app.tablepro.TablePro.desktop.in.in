[Desktop Entry]
# Translators: TablePro is the product name and is not translated.
Name=TablePro
GenericName=Database Client
Comment=Browse and edit PostgreSQL, MySQL, MariaDB, SQLite, DuckDB, SQL Server, ClickHouse, Cassandra, ScyllaDB, Redis and MongoDB databases
Keywords=SQL;Database;PostgreSQL;Postgres;MySQL;MariaDB;SQLite;DuckDB;SQL Server;MSSQL;ClickHouse;Cassandra;ScyllaDB;CQL;Redis;MongoDB;
Exec=tablepro %U
Icon=@app-id@
Terminal=false
Type=Application
Categories=Development;Database;
MimeType=application/vnd.sqlite3;application/sql;x-scheme-handler/cassandra;x-scheme-handler/ch;x-scheme-handler/clickhouse;x-scheme-handler/cql;x-scheme-handler/duckdb;x-scheme-handler/mariadb;x-scheme-handler/mongodb;x-scheme-handler/mongodb+srv;x-scheme-handler/mssql;x-scheme-handler/mysql;x-scheme-handler/mysqlx;x-scheme-handler/postgres;x-scheme-handler/postgresql;x-scheme-handler/redis;x-scheme-handler/rediss;x-scheme-handler/scylla;x-scheme-handler/scylladb;x-scheme-handler/sqlite;x-scheme-handler/sqlite3;x-scheme-handler/sqlserver;x-scheme-handler/tablepro;x-scheme-handler/valkey;x-scheme-handler/valkeys;
DBusActivatable=true
StartupNotify=true
X-GNOME-UsesNotifications=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=tablepro --new-window
