[Desktop Entry]
# Translators: TablePro is the product name and is not translated.
Name=TablePro
GenericName=Database Client
Comment=Browse and edit PostgreSQL, MySQL, SQLite, DuckDB, SQL Server, ClickHouse, Cassandra and ScyllaDB databases
Keywords=SQL;Database;PostgreSQL;MySQL;SQLite;DuckDB;SQL Server;ClickHouse;Cassandra;ScyllaDB;CQL;
Exec=tablepro %U
Icon=@app-id@
Terminal=false
Type=Application
Categories=Development;Database;
MimeType=application/vnd.sqlite3;
DBusActivatable=true
StartupNotify=true
X-GNOME-UsesNotifications=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=tablepro --new-window
