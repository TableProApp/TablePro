<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="tablepro">
  <enum id="@app-id@.CsvDelimiter">
    <value nick="comma" value="0"/>
    <value nick="semicolon" value="1"/>
    <value nick="tab" value="2"/>
    <value nick="pipe" value="3"/>
  </enum>

  <enum id="@app-id@.CsvQuote">
    <value nick="always" value="0"/>
    <value nick="if-needed" value="1"/>
    <value nick="never" value="2"/>
  </enum>

  <enum id="@app-id@.CsvLineBreak">
    <value nick="lf" value="0"/>
    <value nick="crlf" value="1"/>
    <value nick="cr" value="2"/>
  </enum>

  <enum id="@app-id@.CsvDecimal">
    <value nick="period" value="0"/>
    <value nick="comma" value="1"/>
  </enum>

  <enum id="@app-id@.AiProvider">
    <value nick="none" value="0"/>
    <value nick="anthropic" value="1"/>
    <value nick="openai" value="2"/>
    <value nick="openai-compatible" value="3"/>
  </enum>

  <schema id="@app-id@" path="@schema-path@">
    <key name="window-width" type="i">
      <default>1200</default>
      <range min="360" max="32767"/>
      <summary>Window width</summary>
      <description>Width of the main window in logical pixels.</description>
    </key>

    <key name="window-height" type="i">
      <default>760</default>
      <range min="294" max="32767"/>
      <summary>Window height</summary>
      <description>Height of the main window in logical pixels.</description>
    </key>

    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window is maximized</summary>
      <description>Whether the main window was maximized when it last closed.</description>
    </key>

    <key name="default-page-size" type="u">
      <default>1000</default>
      <range min="100" max="100000"/>
      <summary>Rows per page</summary>
      <description>How many rows a table page fetches at a time.</description>
    </key>

    <key name="confirm-bulk-delete" type="b">
      <default>true</default>
      <summary>Confirm before deleting rows</summary>
      <description>Ask before deleting 10 or more rows at once in a table tab. Deleted rows stay marked until Save, and Undo brings them back.</description>
    </key>

    <key name="save-query-history" type="b">
      <default>true</default>
      <summary>Save query history</summary>
      <description>Whether the SQL you run is kept in the query history. Statements that contain passwords or connection secrets are never saved. Turning this off keeps the entries already saved.</description>
    </key>

    <key name="history-retention-days" type="u">
      <default>30</default>
      <range min="0" max="365"/>
      <summary>Query history retention in days</summary>
      <description>Unpinned history entries older than this are pruned at startup. Zero keeps everything.</description>
    </key>

    <key name="query-timeout-secs" type="u">
      <default>60</default>
      <range min="0" max="3600"/>
      <summary>Query timeout in seconds</summary>
      <description>How long the editor waits before cancelling a running query. Zero disables the timeout.</description>
    </key>

    <key name="use-system-font" type="b">
      <default>true</default>
      <summary>Use the system monospace font</summary>
      <description>Whether the SQL editor follows the desktop monospace font instead of a custom one.</description>
    </key>

    <key name="custom-font" type="s">
      <default>'Monospace 12'</default>
      <summary>Custom editor font</summary>
      <description>Pango font description the SQL editor uses when the system font is turned off.</description>
    </key>

    <key name="style-scheme" type="s">
      <default>'Adwaita'</default>
      <summary>Editor style scheme</summary>
      <description>GtkSourceView style scheme id for the SQL editor.</description>
    </key>

    <key name="vim-keybindings" type="b">
      <default>false</default>
      <summary>Vim keybindings in the SQL editor</summary>
      <description>Whether the SQL editor takes Vim's modes and commands. The editor's own Ctrl shortcuts keep working in every mode.</description>
    </key>

    <key name="restore-session" type="b">
      <default>true</default>
      <summary>Restore session</summary>
      <description>Whether the connections open when TablePro quit are opened again at the next launch.</description>
    </key>

    <key name="mcp-server-enabled" type="b">
      <default>false</default>
      <summary>Run the MCP server</summary>
      <description>Whether MCP clients on this computer can reach your saved connections over http://127.0.0.1 while TablePro runs. Each connection's External Clients level decides what they may do.</description>
    </key>

    <key name="mcp-server-port" type="u">
      <default>23508</default>
      <range min="1024" max="65535"/>
      <summary>MCP server port</summary>
      <description>The port on 127.0.0.1 the MCP server listens on.</description>
    </key>

    <key name="ai-provider" enum="@app-id@.AiProvider">
      <default>'none'</default>
      <summary>AI assistant provider</summary>
      <description>Who answers the AI assistant: Anthropic, OpenAI, or Ollama and other servers that speak OpenAI's protocol. None turns the assistant off, and then nothing is sent anywhere.</description>
    </key>

    <key name="ai-anthropic-model" type="s">
      <default>'claude-opus-5-5'</default>
      <summary>Anthropic model</summary>
      <description>The model id the assistant asks Anthropic for.</description>
    </key>

    <key name="ai-openai-model" type="s">
      <default>''</default>
      <summary>OpenAI model</summary>
      <description>The model id the assistant asks OpenAI for.</description>
    </key>

    <key name="ai-compatible-model" type="s">
      <default>''</default>
      <summary>Compatible server model</summary>
      <description>The model id the assistant asks an Ollama or other OpenAI-compatible server for, such as llama3.2.</description>
    </key>

    <key name="ai-compatible-url" type="s">
      <default>'http://localhost:11434/v1'</default>
      <summary>Compatible server address</summary>
      <description>The address of an Ollama or other OpenAI-compatible server, version path included. An API key is sent over plain http only to this computer.</description>
    </key>

    <key name="ai-inline-suggestions" type="b">
      <default>false</default>
      <summary>Suggest SQL while typing</summary>
      <description>Whether the editor asks the assistant for a completion when you pause typing, and shows it as dimmed text that Tab accepts. Each pause sends the text around the cursor.</description>
    </key>

    <key name="connect-dialog-driver" type="s">
      <default>'postgres'</default>
      <summary>Driver the connect dialog opens with</summary>
      <description>Id of the driver last connected to, so the dialog opens on it with its own default port.</description>
    </key>

    <key name="csv-null-to-empty" type="b">
      <default>true</default>
      <summary>Write NULL as an empty field</summary>
      <description>Whether a CSV export writes NULL as an empty field rather than the text NULL.</description>
    </key>

    <key name="csv-line-break-to-space" type="b">
      <default>false</default>
      <summary>Replace line breaks with spaces</summary>
      <description>Whether a CSV export flattens line breaks inside a value into single spaces.</description>
    </key>

    <key name="csv-header-row" type="b">
      <default>true</default>
      <summary>Write a header row</summary>
      <description>Whether a CSV export starts with the column names.</description>
    </key>

    <key name="csv-sanitize-formulas" type="b">
      <default>true</default>
      <summary>Neutralise spreadsheet formulas</summary>
      <description>Whether a CSV export prefixes values starting with =, +, - or @ so a spreadsheet does not run them.</description>
    </key>

    <key name="csv-delimiter" enum="@app-id@.CsvDelimiter">
      <default>'comma'</default>
      <summary>CSV field delimiter</summary>
      <description>Character that separates fields in a CSV export.</description>
    </key>

    <key name="csv-quote" enum="@app-id@.CsvQuote">
      <default>'if-needed'</default>
      <summary>CSV quoting</summary>
      <description>When a CSV export wraps a field in quotes.</description>
    </key>

    <key name="csv-line-break" enum="@app-id@.CsvLineBreak">
      <default>'lf'</default>
      <summary>CSV line ending</summary>
      <description>Line ending a CSV export writes between records.</description>
    </key>

    <key name="csv-decimal" enum="@app-id@.CsvDecimal">
      <default>'period'</default>
      <summary>CSV decimal separator</summary>
      <description>Character a CSV export uses between the whole and fractional parts of a number.</description>
    </key>
  </schema>
</schemalist>
