<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <!-- Translators: TablePro is the product name and is not translated. -->
  <name translate="no">TablePro</name>
  <summary>Work with your databases</summary>
  <description>
    <p>
      TablePro connects to PostgreSQL, MySQL, MariaDB, SQLite, DuckDB, SQL
      Server, ClickHouse, Cassandra, ScyllaDB, Redis and MongoDB. Browse tables,
      edit rows in place, run SQL with syntax highlighting, and reach servers
      behind an SSH bastion.
    </p>
    <p>It can:</p>
    <ul>
      <li>Edit cells in place, with primary-key safety and an undo history</li>
      <li>Run SQL scripts statement by statement and cancel a slow query</li>
      <li>Tunnel through an SSH jump host using your own OpenSSH client</li>
      <li>Verify TLS, keep connections read-only, and reconnect on drop</li>
      <li>Export results to CSV, JSON, SQL, Excel, Markdown, HTML and XML</li>
    </ul>
  </description>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <developer id="app.tablepro">
    <name translate="no">TablePro Authors</name>
  </developer>
  <url type="homepage">https://tablepro.app</url>
  <url type="bugtracker">https://github.com/TableProApp/TablePro/issues</url>
  <url type="vcs-browser">https://github.com/TableProApp/TablePro</url>
  <url type="help">https://docs.tablepro.app/linux/install</url>
  <url type="translate">https://github.com/TableProApp/TablePro/blob/linux-v@version@/linux/po/README.md</url>
  <url type="contribute">https://github.com/TableProApp/TablePro/blob/linux-v@version@/linux/CONTRIBUTING.md</url>
  <translation type="gettext">@gettext-package@</translation>
  <branding>
    <color type="primary" scheme_preference="light">#ffd9a8</color>
    <color type="primary" scheme_preference="dark">#4d2e0f</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/TableProApp/TablePro/linux-v@version@/linux/data/screenshots/01-table.png</image>
      <caption>Browse and edit table rows</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/TableProApp/TablePro/linux-v@version@/linux/data/screenshots/02-editor.png</image>
      <caption>Run SQL in the editor</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/TableProApp/TablePro/linux-v@version@/linux/data/screenshots/03-structure.png</image>
      <caption>Change a table's columns and indexes</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/TableProApp/TablePro/linux-v@version@/linux/data/screenshots/04-connect.png</image>
      <caption>Connect through an SSH tunnel</caption>
    </screenshot>
  </screenshots>
  <agreement type="privacy" version_id="2026-11-05">
    <agreement_section id="account">
      <name>TablePro account</name>
      <description>
        <p>
          Signed in to a TablePro account, TablePro reaches account.tablepro.app and api.tablepro.app to keep
          the sign-in, to register this computer as a device with its host name, the TablePro and system
          versions and a machine ID hashed from /etc/machine-id, to check the plan at launch and once a day,
          and to list teams and devices while Preferences shows the account.
        </p>
      </description>
    </agreement_section>
    <agreement_section id="usage-data">
      <name>Usage data</name>
      <description>
        <p>
          Unless you turn it off in Preferences > General > Privacy, a daily launch with the kinds and number
          of open connections, the first connection and query, sign-in and sign-out, and upgrade clicks go to
          PostHog at eu.i.posthog.com, with a random installation ID, or the account's ID with the TablePro and
          system versions, processor type and language once signed in. Never a host name, a password, a query
          or a row.
        </p>
      </description>
    </agreement_section>
  </agreement>
  <!-- A signed-in account reaches TablePro's account service, usage data goes to PostHog once the user
       chooses to share it, and a toast asks about buying a license. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">moderate</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <provides>
    <binary>tablepro</binary>
  </provides>
  <releases>
    <release version="0.1.0~beta.2" type="development" date="2026-11-07">
      <url type="details">https://github.com/TableProApp/TablePro/releases/tag/linux-v0.1.0-beta.2</url>
      <description>
        <p>The second beta of TablePro for Linux.</p>
        <ul>
          <li>The app icon is TablePro's logo instead of a placeholder</li>
          <li>Preferences > Account names the Pro plan correctly</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0~beta.1" type="development" date="2026-11-07">
      <url type="details">https://github.com/TableProApp/TablePro/releases/tag/linux-v0.1.0-beta.1</url>
      <description>
        <p>The first beta of TablePro for Linux.</p>
        <ul>
          <li>Connect to PostgreSQL, MySQL, MariaDB, SQLite, DuckDB, SQL Server, ClickHouse, Cassandra, ScyllaDB, Redis and MongoDB, directly or through an SSH tunnel</li>
          <li>Browse tables and edit rows in place, with undo until you save</li>
          <li>Run SQL with completion, find and replace, and a searchable query history</li>
          <li>Change a table's columns, indexes and foreign keys</li>
          <li>Export results and tables to CSV, JSON, SQL and other formats</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
