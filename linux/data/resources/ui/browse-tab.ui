<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22" />
  <requires lib="libadwaita" version="1.9" />
  <menu id="structure_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Discard Changes…</attribute>
        <attribute name="action">structure.discard</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Stop Saving</attribute>
        <attribute name="action">structure.stop</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Drop _Table…</attribute>
        <attribute name="action">structure.drop</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>
  <template class="TableProBrowseTab" parent="AdwBreakpointBin">
    <property name="width-request">300</property>
    <property name="height-request">160</property>
    <child>
      <object class="AdwBreakpoint" id="narrow_breakpoint">
        <condition>max-width: 860sp</condition>
        <setter object="row_actions_box" property="visible">false</setter>
        <setter object="details_toggle" property="visible">false</setter>
        <setter object="export_button" property="visible">false</setter>
        <setter object="filter_button" property="visible">false</setter>
        <setter object="columns_button" property="visible">false</setter>
        <setter object="page_size_box" property="visible">false</setter>
        <setter object="more_button" property="visible">true</setter>
        <setter object="pager_bar" property="compact">true</setter>
        <setter object="view_toggle" property="display-mode">icons</setter>
        <setter object="structure_details" property="visible">false</setter>
        <setter object="structure_secondary" property="visible">false</setter>
        <setter object="structure_more" property="visible">true</setter>
      </object>
    </child>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="content">
          <object class="AdwViewStack" id="view_stack">
            <child>
              <object class="AdwViewStackPage">
                <property name="name">data</property>
                <property name="icon-name">view-grid-symbolic</property>
                <property name="child">
                  <object class="AdwToolbarView" id="toolbar">
                    <property name="top-bar-style">flat</property>
                    <child type="top">
                      <object class="AdwBanner" id="stale_banner">
                        <property name="title" translatable="yes">Couldn't refresh rows. Showing the last loaded page.</property>
                        <property name="use-markup">false</property>
                      </object>
                    </child>
                    <child type="top">
                      <object class="AdwBanner" id="read_only_banner">
                        <property name="title" translatable="yes">Read-only connection. Editing disabled.</property>
                      </object>
                    </child>
                    <child type="top">
                      <object class="AdwBanner" id="no_pk_banner">
                        <property name="title" translatable="yes">This table has no primary key. Use the SQL editor to modify rows.</property>
                      </object>
                    </child>
                    <child type="bottom">
                      <object class="TableProPendingChangesBar" id="pending_bar" />
                    </child>
                    <property name="content">
                      <object class="GtkStack" id="inner_stack">
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">loading</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="loading_page">
                                <property name="title" translatable="yes">Loading…</property>
                                <property name="child">
                                  <object class="AdwSpinner">
                                    <property name="width-request">32</property>
                                    <property name="height-request">32</property>
                                    <property name="halign">center</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">grid</property>
                            <property name="child">
                              <object class="GtkBox" id="grid_holder">
                                <property name="orientation">vertical</property>
                                <property name="vexpand">true</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">error</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="error_page">
                                <property name="icon-name">dialog-error-symbolic</property>
                                <property name="title" translatable="yes">Couldn't Load Rows</property>
                                <property name="child">
                                  <object class="GtkButton" id="retry_button">
                                    <property name="label" translatable="yes">Try Again</property>
                                    <property name="halign">center</property>
                                    <style>
                                      <class name="pill" />
                                      <class name="suggested-action" />
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="title" translatable="yes">Data</property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage">
                <property name="name">structure</property>
                <property name="visible">false</property>
                <property name="icon-name">view-list-symbolic</property>
                <property name="child">
                  <object class="AdwBin" id="structure_host" />
                </property>
                <property name="title" translatable="yes">Structure</property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage">
                <property name="name">json</property>
                <property name="icon-name">text-x-generic-symbolic</property>
                <property name="title" translatable="yes">JSON</property>
                <property name="child">
                  <object class="AdwBin" id="json_host"/>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="GtkActionBar" id="action_bar">
            <child type="start">
              <object class="AdwInlineViewSwitcher" id="view_toggle">
                <property name="stack">view_stack</property>
                <property name="display-mode">labels</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkBox" id="structure_start">
                <property name="visible">false</property>
                <child>
                  <object class="GtkBox" id="structure_details">
                    <property name="spacing">6</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="start">
              <object class="GtkBox" id="data_start">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox" id="row_actions_box">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton" id="insert_button">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="action-name">grid.insert-row</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="delete_button">
                        <property name="icon-name">list-remove-symbolic</property>
                        <property name="action-name">grid.delete-rows</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="selection_label">
                    <property name="visible">false</property>
                    <property name="ellipsize">end</property>
                    <property name="margin-start">12</property>
                    <property name="accessible-role">status</property>
                    <style>
                      <class name="accent" />
                      <class name="caption-heading" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child type="start">
              <object class="GtkBox" id="rows_start">
                <child>
                  <object class="TableProPagerBar" id="pager_bar" />
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkBox" id="json_end">
                <property name="visible">false</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton">
                    <property name="icon-name">edit-copy-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Copy JSON Preview</property>
                    <property name="action-name">json.copy</property>
                    <accessibility>
                      <property name="label" translatable="yes">Copy JSON Preview</property>
                    </accessibility>
                    <style><class name="flat"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="json_more">
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="tooltip-text" translatable="yes">More JSON Actions</property>
                    <accessibility>
                      <property name="label" translatable="yes">More JSON Actions</property>
                    </accessibility>
                    <style><class name="flat"/></style>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkBox" id="structure_end">
                <property name="visible">false</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox" id="structure_secondary">
                    <property name="spacing">6</property>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="structure_more">
                    <property name="visible">false</property>
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="tooltip-text" translatable="yes">More Structure Actions</property>
                    <property name="menu-model">structure_menu</property>
                    <accessibility>
                      <property name="label" translatable="yes">More Structure Actions</property>
                    </accessibility>
                    <style><class name="flat"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="structure_primary">
                    <property name="spacing">6</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkBox" id="data_end">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox" id="page_size_box">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Rows:</property>
                        <property name="mnemonic-widget">page_size_dropdown</property>
                        <style>
                          <class name="dimmed" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="page_size_dropdown" />
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="columns_button">
                    <property name="label" translatable="yes">Columns</property>
                    <property name="tooltip-text" translatable="yes">Choose which columns the grid shows</property>
                    <property name="action-name">grid.columns</property>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="filter_button">
                    <property name="tooltip-text" translatable="yes">Filter Rows</property>
                    <property name="action-name">browse.toggle-filter</property>
                    <style>
                      <class name="flat" />
                    </style>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Filter</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="filter_badge">
                            <property name="visible">false</property>
                            <style>
                              <class name="numeric" />
                              <class name="caption-heading" />
                              <class name="dimmed" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="export_button">
                    <property name="icon-name">document-save-symbolic</property>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="more_button">
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="visible">false</property>
                    <property name="tooltip-text" translatable="yes">More Actions</property>
                    <accessibility>
                      <property name="label" translatable="yes">More Actions</property>
                    </accessibility>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="details_toggle">
                    <property name="icon-name">sidebar-show-right-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Row Details</property>
                    <property name="action-name">grid.show-details</property>
                    <style>
                      <class name="flat" />
                    </style>
                    <accessibility>
                      <property name="label" translatable="yes">Row Details</property>
                    </accessibility>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
