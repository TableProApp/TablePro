<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProConnectDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Connect</property>
    <property name="content-width">480</property>
    <property name="content-height">720</property>
    <property name="default-widget">connect_button</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="test_button">
                <property name="label" translatable="yes">Test</property>
                <property name="tooltip-text" translatable="yes">Connect Once to Check the Settings</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="connect_button">
                <property name="label" translatable="yes">Connect</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Connection</property>
                    <child>
                      <!-- Left empty, the list names the connection by
                           where it connects. -->
                      <object class="AdwEntryRow" id="name_row">
                        <property name="title" translatable="yes">Name</property>
                        <property name="activates-default">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="driver_row">
                        <property name="title" translatable="yes">Driver</property>
                        <property name="model">
                          <object class="GtkStringList" id="driver_names"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="host_row">
                        <property name="title" translatable="yes">Host</property>
                        <property name="activates-default">true</property>
                      </object>
                    </child>
                    <child>
                      <!-- Shown for an engine that finds its servers from
                           a DNS seed list, as mongodb+srv:// does. -->
                      <object class="AdwSwitchRow" id="seed_list_row">
                        <property name="title" translatable="yes">DNS Seed List</property>
                        <property name="subtitle" translatable="yes">Find the servers from the host’s SRV record, as mongodb+srv:// does</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="port_row">
                        <property name="title" translatable="yes">Port</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">1</property>
                            <property name="upper">65535</property>
                            <property name="value">5432</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">10</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="database_row">
                        <property name="title" translatable="yes">Database</property>
                        <property name="activates-default">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="TableProDatabaseFileRow" id="file_row"/>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="auth_group">
                    <property name="title" translatable="yes">Authentication</property>
                    <child>
                      <object class="AdwComboRow" id="auth_mode_row">
                        <property name="title" translatable="yes">Method</property>
                        <property name="model">
                          <object class="GtkStringList" id="auth_mode_names"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="username_row">
                        <property name="title" translatable="yes">Username</property>
                        <property name="activates-default">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPasswordEntryRow" id="password_row">
                        <property name="title" translatable="yes">Password</property>
                        <property name="activates-default">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="auth_database_row">
                        <property name="title" translatable="yes">Authentication Database (optional)</property>
                        <property name="activates-default">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="remember_row">
                        <property name="title" translatable="yes">Remember Password</property>
                        <property name="subtitle" translatable="yes">Keep it in the keyring; otherwise it is asked for at each connect</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="TableProTlsSection" id="tls_section"/>
                </child>
                <child>
                  <object class="TableProSshSection" id="ssh_section"/>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Options</property>
                    <child>
                      <object class="AdwComboRow" id="safe_mode_row">
                        <property name="title" translatable="yes">Safe Mode</property>
                        <property name="model">
                          <object class="GtkStringList" id="safe_mode_names"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="external_access_row">
                        <property name="title" translatable="yes">External Clients</property>
                        <property name="model">
                          <object class="GtkStringList" id="external_access_names"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="ai_policy_row">
                        <property name="title" translatable="yes">AI Assistant</property>
                        <property name="model">
                          <object class="GtkStringList" id="ai_policy_names"/>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <!-- How the connection list shows the connection. -->
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Appearance</property>
                    <child>
                      <object class="AdwComboRow" id="icon_row">
                        <property name="title" translatable="yes">Icon</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwExpanderRow" id="tags_row">
                        <property name="title" translatable="yes">Tags</property>
                        <!-- The subtitle lists tag names, which are the user's text. -->
                        <property name="use-markup">false</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
