<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProHistoryDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Query History</property>
    <property name="content-width">640</property>
    <property name="content-height">640</property>
    <property name="child">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <child type="start">
                  <object class="GtkMenuButton" id="filter_button">
                    <property name="label" translatable="yes">Filter</property>
                    <property name="always-show-arrow">true</property>
                    <property name="tooltip-text" translatable="yes">Filter History</property>
                    <property name="popover">
                      <object class="GtkPopover">
                        <property name="child">
                          <object class="AdwPreferencesGroup">
                            <property name="header-suffix">
                              <object class="GtkButton" id="reset_filters_button">
                                <property name="label" translatable="yes">Reset</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </property>
                            <child>
                              <object class="AdwComboRow" id="connection_row">
                                <property name="title" translatable="yes">Connection</property>
                                <property name="use-markup">false</property>
                                <property name="model">
                                  <object class="GtkStringList" id="connection_labels">
                                    <items>
                                      <item translatable="yes">All Connections</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="status_row">
                                <property name="title" translatable="yes">Status</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item translatable="yes">Any</item>
                                      <item translatable="yes">Succeeded</item>
                                      <item translatable="yes">Failed</item>
                                      <item translatable="yes">Cancelled</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="window_row">
                                <property name="title" translatable="yes">Time Window</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item translatable="yes">Any Time</item>
                                      <item translatable="yes">Last 24 Hours</item>
                                      <item translatable="yes">Last 7 Days</item>
                                      <item translatable="yes">Last 30 Days</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkToggleButton" id="select_button">
                    <property name="label" translatable="yes">Select</property>
                    <property name="tooltip-text" translatable="yes">Select Queries</property>
                    <property name="active" bind-source="TableProHistoryDialog" bind-property="selecting" bind-flags="bidirectional|sync-create"/>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="menu-model">history_menu</property>
                    <property name="tooltip-text" translatable="yes">More Actions</property>
                    <accessibility>
                      <property name="label" translatable="yes">More Actions</property>
                    </accessibility>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton" id="search_toggle">
                    <property name="icon-name">system-search-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Search</property>
                    <property name="active" bind-source="search_bar" bind-property="search-mode-enabled" bind-flags="bidirectional|sync-create"/>
                    <accessibility>
                      <property name="label" translatable="yes">Search</property>
                    </accessibility>
                  </object>
                </child>
              </object>
            </child>
            <child type="top">
              <object class="GtkSearchBar" id="search_bar">
                <property name="show-close-button">true</property>
                <property name="child">
                  <object class="GtkSearchEntry" id="search_entry">
                    <property name="placeholder-text" translatable="yes">Search queries…</property>
                    <property name="search-delay">150</property>
                    <property name="hexpand">true</property>
                  </object>
                </property>
              </object>
            </child>
            <property name="content">
              <object class="GtkStack" id="stack">
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">loading</property>
                    <property name="child">
                      <object class="AdwSpinner">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="width-request">32</property>
                        <property name="height-request">32</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">list</property>
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scroll">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="GtkListView" id="list_view">
                            <property name="show-separators">true</property>
                            <property name="single-click-activate">true</property>
                            <accessibility>
                              <property name="label" translatable="yes">Queries</property>
                            </accessibility>
                            <style>
                              <class name="rich-list"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="status_page">
                        <property name="icon-name">document-open-recent-symbolic</property>
                        <property name="title" translatable="yes">No Queries Yet</property>
                        <property name="description" translatable="yes">Run a query in the SQL editor and it will appear here.</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
            <child type="bottom">
              <object class="GtkRevealer" id="selection_bar">
                <property name="transition-type">slide-up</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <child>
                      <object class="GtkLabel" id="selection_label">
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton">
                        <property name="label" translatable="yes">Export</property>
                        <property name="always-show-arrow">true</property>
                        <property name="menu-model">export_menu</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <property name="label" translatable="yes">Delete</property>
                        <property name="action-name">history.delete-selected</property>
                        <style>
                          <class name="destructive-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="history_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Show Storage Location</attribute>
        <attribute name="action">history.show-storage</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Clear All History…</attribute>
        <attribute name="action">history.clear-all</attribute>
      </item>
    </section>
  </menu>
  <menu id="export_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Export as SQL</attribute>
        <attribute name="action">history.export-sql</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Export as CSV</attribute>
        <attribute name="action">history.export-csv</attribute>
      </item>
    </section>
  </menu>
</interface>
