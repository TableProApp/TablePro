<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProPickerPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar" id="header_bar">
                <property name="title-widget">
                  <object class="AdwWindowTitle">
                    <property name="title" translatable="yes">TablePro</property>
                  </object>
                </property>
                <child type="start">
                  <object class="GtkButton" id="new_connection_button">
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="action-name">win.new-connection</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton" id="search_toggle">
                    <property name="icon-name">system-search-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="top">
              <!-- No close button: GTK gives it no accessible name, and
                   the search toggle and Escape close the bar. -->
              <object class="GtkSearchBar" id="search_bar">
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">600</property>
                    <property name="child">
                      <object class="GtkSearchEntry" id="search_entry">
                        <property name="placeholder-text" translatable="yes">Search connections…</property>
                        <property name="hexpand">true</property>
                        <accessibility>
                          <property name="label" translatable="yes">Search connections</property>
                        </accessibility>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child type="top">
              <object class="AdwBanner" id="connection_list_banner">
                <property name="use-markup">false</property>
              </object>
            </child>
            <property name="content">
              <object class="AdwBin" id="welcome_slot"/>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
