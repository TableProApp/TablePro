<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProDataBrowserGroup" parent="AdwPreferencesGroup">
    <property name="title" translatable="yes">Data Browser</property>
    <child>
      <object class="AdwSpinRow" id="page_size_row">
        <property name="title" translatable="yes">Default page size</property>
        <property name="subtitle" translatable="yes">Rows fetched per request when browsing a table</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="lower">100</property>
            <property name="upper">100000</property>
            <property name="step-increment">100</property>
            <property name="page-increment">1000</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="alternate_rows_row">
        <property name="title" translatable="yes">Show Alternate Row Backgrounds</property>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="row_numbers_row">
        <property name="title" translatable="yes">Show Row Numbers</property>
      </object>
    </child>
    <child>
      <object class="AdwComboRow" id="row_height_row">
        <property name="title" translatable="yes">Row Height</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Compact</item>
              <item translatable="yes">Normal</item>
              <item translatable="yes">Comfortable</item>
              <item translatable="yes">Spacious</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="auto_inspector_row">
        <property name="title" translatable="yes">Open Row Details on Selection</property>
        <property name="subtitle" translatable="yes">Selecting a row opens its details pane</property>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="invisibles_row">
        <property name="title" translatable="yes">Mark Spaces, Tabs and Line Breaks</property>
        <property name="subtitle" translatable="yes">In the value editor of the row details</property>
      </object>
    </child>
    <child>
      <object class="AdwComboRow" id="date_format_row">
        <property name="title" translatable="yes">Date Format</property>
        <property name="subtitle" translatable="yes">Year-month-day, month/day/year or day/month/year. Copy and export keep the database's spelling</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <!-- Examples rather than names, which the combo would cut
                   at the width of the page. Not translated. -->
              <item translatable="no">2024-12-31 23:59:59</item>
              <item translatable="no">2024-12-31</item>
              <item translatable="no">12/31/2024 11:59:59 PM</item>
              <item translatable="no">12/31/2024</item>
              <item translatable="no">31/12/2024 23:59:59</item>
              <item translatable="no">31/12/2024</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwComboRow" id="default_sort_row">
        <property name="title" translatable="yes">Default Sort</property>
        <property name="subtitle" translatable="yes">How a table is ordered when it opens</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">No sorting (server order)</item>
              <item translatable="yes">Primary key</item>
              <item translatable="yes">First column</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwComboRow" id="default_sort_direction_row">
        <property name="title" translatable="yes">Default Sort Direction</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Ascending</item>
              <item translatable="yes">Descending</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwComboRow" id="row_copy_format_row">
        <property name="title" translatable="yes">Copy Rows As</property>
        <property name="subtitle" translatable="yes">The format Copy writes when several rows are selected</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">TSV</item>
              <item translatable="yes">TSV with Headers</item>
              <item translatable="yes">JSON</item>
              <item translatable="yes">CSV</item>
              <item translatable="yes">CSV with Headers</item>
              <item translatable="yes">Markdown</item>
            </items>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwEntryRow" id="null_display_row">
        <property name="title" translatable="yes">Text for NULL</property>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="grid_system_font_row">
        <property name="title" translatable="yes">Use the System Monospace Font for Cells</property>
      </object>
    </child>
    <child>
      <object class="AdwActionRow" id="grid_font_row">
        <property name="title" translatable="yes">Cell font</property>
        <child type="suffix">
          <object class="GtkFontDialogButton" id="grid_font_button">
            <property name="valign">center</property>
            <property name="dialog">
              <object class="GtkFontDialog"/>
            </property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="confirm_row">
        <property name="title" translatable="yes">Confirm Before Deleting Rows</property>
      </object>
    </child>
  </template>
</interface>
