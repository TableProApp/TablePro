<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProEditorPage" parent="AdwPreferencesPage">
    <property name="title" translatable="yes">Editor</property>
    <property name="icon-name">text-editor-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Font</property>
        <child>
          <object class="AdwSwitchRow" id="system_font_row">
            <property name="title" translatable="yes">Use the System Monospace Font</property>
            <property name="subtitle" translatable="yes">Follows the font you picked in the desktop settings</property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="font_row">
            <property name="title" translatable="yes">Editor font</property>
            <child type="suffix">
              <object class="GtkFontDialogButton" id="font_button">
                <property name="valign">center</property>
                <property name="dialog">
                  <object class="GtkFontDialog"/>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Style Scheme</property>
        <child>
          <object class="GtkFlowBox" id="style_scheme_box">
            <property name="selection-mode">none</property>
            <property name="homogeneous">true</property>
            <property name="column-spacing">12</property>
            <property name="row-spacing">12</property>
            <property name="max-children-per-line">3</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Keyboard</property>
        <child>
          <object class="AdwSwitchRow" id="vim_row">
            <property name="title" translatable="yes">Vim Keybindings</property>
            <property name="subtitle" translatable="yes">Normal, insert and visual modes, and commands such as :w and :q</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Snippets</property>
        <property name="description" translatable="yes">Statements you write often, offered in completion beside the built-in ones. A file added to the folder or changed is read right away.</property>
        <child>
          <object class="AdwActionRow" id="snippets_row">
            <property name="title" translatable="yes">Snippets folder</property>
            <!-- The subtitle is a path, which may hold & or <. -->
            <property name="use-markup">false</property>
            <child type="suffix">
              <object class="GtkButton" id="snippets_button">
                <property name="label" translatable="yes">Open Folder</property>
                <property name="valign">center</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Running Queries</property>
        <child>
          <object class="AdwSpinRow" id="timeout_row">
            <property name="title" translatable="yes">Query timeout (seconds)</property>
            <property name="subtitle" translatable="yes">Cancel long-running queries automatically. Set to 0 to disable.</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">0</property>
                <property name="upper">3600</property>
                <property name="step-increment">5</property>
                <property name="page-increment">60</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
