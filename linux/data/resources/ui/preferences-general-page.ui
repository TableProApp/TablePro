<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProGeneralPage" parent="AdwPreferencesPage">
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">preferences-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Startup</property>
        <child>
          <object class="AdwSwitchRow" id="restore_session_row">
            <property name="title" translatable="yes">Restore Session</property>
            <property name="subtitle" translatable="yes">Reopen the connections that were open when TablePro quit</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="TableProDataBrowserGroup" id="data_browser_group"/>
    </child>
    <child>
      <object class="TableProHistoryGroup" id="history_group"/>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="privacy_group">
        <property name="visible">False</property>
        <property name="title" translatable="yes">Privacy</property>
        <property name="description" translatable="yes">Once a day, a summary to api.tablepro.app: this computer’s machine ID, hashed, the TablePro and system versions, the processor type, the interface language, the types and number of open connections, and whether a license is held. Never a query, a host name, a password or anything in your databases.</property>
        <child>
          <object class="AdwSwitchRow" id="share_usage_data_row">
            <property name="title" translatable="yes">Share Usage Data</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
