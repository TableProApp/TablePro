<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <requires lib="gtksourceview" version="5.18"/>
  <menu id="value_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Set to Empty</attribute>
        <attribute name="action">grid.set-empty</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Set to NULL</attribute>
        <attribute name="action">grid.set-null</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Set to DEFAULT</attribute>
        <attribute name="action">grid.set-default</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Copy Value</attribute>
        <attribute name="action">grid.copy</attribute>
      </item>
    </section>
  </menu>
  <template class="TableProRowDetailPane" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <property name="hhomogeneous">false</property>
        <property name="vhomogeneous">false</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="AdwStatusPage">
                <property name="title" translatable="yes">No Row Selected</property>
                <style>
                  <class name="compact"/>
                </style>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">row</property>
            <property name="child">
              <!-- A grid can be shorter than the fields and the value
                   need, so the row scrolls rather than being cut off. -->
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <property name="margin-top">6</property>
                        <property name="margin-bottom">6</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">6</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkLabel" id="title_label">
                                <property name="xalign">0</property>
                                <property name="ellipsize">end</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="state_box">
                                <property name="spacing">4</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="GtkImage" id="state_icon">
                                    <property name="pixel-size">16</property>
                                    <property name="accessible-role">presentation</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="state_label">
                                    <property name="xalign">0</property>
                                    <property name="ellipsize">end</property>
                                    <style>
                                      <class name="caption"/>
                                      <class name="dimmed"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="close_button">
                            <property name="icon-name">window-close-symbolic</property>
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Close Row Details</property>
                            <accessibility>
                              <property name="label" translatable="yes">Close Row Details</property>
                            </accessibility>
                            <style>
                              <class name="flat"/>
                              <class name="circular"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator"/>
                    </child>
                    <child>
                      <object class="GtkPaned">
                        <property name="orientation">vertical</property>
                        <property name="vexpand">true</property>
                        <property name="shrink-start-child">false</property>
                        <property name="shrink-end-child">false</property>
                        <property name="start-child">
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="min-content-height">120</property>
                            <property name="child">
                              <object class="GtkListView" id="field_list">
                                <accessibility>
                                  <property name="label" translatable="yes">Fields</property>
                                </accessibility>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="end-child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">6</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">6</property>
                                <child>
                                  <object class="GtkLabel" id="field_label">
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                    <property name="ellipsize">end</property>
                                    <style>
                                      <class name="caption-heading"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkMenuButton" id="calendar_button">
                                    <property name="icon-name">x-office-calendar-symbolic</property>
                                    <property name="visible">false</property>
                                    <property name="tooltip-text" translatable="yes">Pick a Date</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">Pick a Date</property>
                                    </accessibility>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="popover">
                                      <object class="GtkPopover" id="calendar_popover">
                                        <property name="child">
                                          <object class="GtkCalendar" id="calendar">
                                            <accessibility>
                                              <property name="label" translatable="yes">Pick a Date</property>
                                            </accessibility>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkMenuButton" id="clock_button">
                                    <property name="icon-name">preferences-system-time-symbolic</property>
                                    <property name="visible">false</property>
                                    <property name="tooltip-text" translatable="yes">Pick a Time</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">Pick a Time</property>
                                    </accessibility>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="popover">
                                      <object class="GtkPopover" id="clock_popover">
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <property name="margin-top">6</property>
                                            <property name="margin-bottom">6</property>
                                            <property name="margin-start">6</property>
                                            <property name="margin-end">6</property>
                                            <child>
                                              <object class="GtkSpinButton" id="hour">
                                                <property name="orientation">vertical</property>
                                                <property name="numeric">true</property>
                                                <property name="wrap">true</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="upper">23</property>
                                                    <property name="step-increment">1</property>
                                                    <property name="page-increment">6</property>
                                                  </object>
                                                </property>
                                                <accessibility>
                                                  <property name="label" translatable="yes">Hour</property>
                                                </accessibility>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label">:</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="minute">
                                                <property name="orientation">vertical</property>
                                                <property name="numeric">true</property>
                                                <property name="wrap">true</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="upper">59</property>
                                                    <property name="step-increment">1</property>
                                                    <property name="page-increment">10</property>
                                                  </object>
                                                </property>
                                                <accessibility>
                                                  <property name="label" translatable="yes">Minute</property>
                                                </accessibility>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label">:</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="second">
                                                <property name="orientation">vertical</property>
                                                <property name="numeric">true</property>
                                                <property name="wrap">true</property>
                                                <property name="adjustment">
                                                  <object class="GtkAdjustment">
                                                    <property name="upper">59</property>
                                                    <property name="step-increment">1</property>
                                                    <property name="page-increment">10</property>
                                                  </object>
                                                </property>
                                                <accessibility>
                                                  <property name="label" translatable="yes">Second</property>
                                                </accessibility>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="clock_set">
                                                <property name="label" translatable="yes">Set</property>
                                                <property name="valign">center</property>
                                                <property name="margin-start">6</property>
                                                <style>
                                                  <class name="suggested-action"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkMenuButton" id="value_menu_button">
                                    <property name="icon-name">view-more-symbolic</property>
                                    <property name="menu-model">value_menu</property>
                                    <property name="tooltip-text" translatable="yes">More Actions</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">More Actions</property>
                                    </accessibility>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <!-- A text view has no placeholder of its own, so
                                   one is drawn over it while it is empty. -->
                              <object class="GtkOverlay">
                                <property name="vexpand">true</property>
                                <property name="child">
                                  <object class="GtkScrolledWindow">
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="min-content-height">120</property>
                                    <property name="child">
                                      <object class="GtkSourceView" id="value_view">
                                        <property name="monospace">true</property>
                                        <property name="wrap-mode">word-char</property>
                                        <property name="auto-indent">true</property>
                                        <property name="top-margin">6</property>
                                        <property name="bottom-margin">6</property>
                                        <property name="left-margin">12</property>
                                        <property name="right-margin">12</property>
                                        <property name="buffer">
                                          <object class="GtkSourceBuffer" id="value_buffer"/>
                                        </property>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                                <child type="overlay">
                                  <object class="GtkLabel" id="placeholder_label">
                                    <property name="halign">start</property>
                                    <property name="valign">start</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-start">12</property>
                                    <property name="can-target">false</property>
                                    <property name="visible">false</property>
                                    <property name="accessible-role">presentation</property>
                                    <attributes>
                                      <attribute name="style" value="italic"/>
                                    </attributes>
                                    <style>
                                      <class name="monospace"/>
                                      <class name="dimmed"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="message_label">
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                                <property name="wrap-mode">word-char</property>
                                <property name="visible">false</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">6</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <style>
                                  <class name="caption"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
