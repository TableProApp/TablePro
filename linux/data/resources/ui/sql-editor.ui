<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <requires lib="gtksourceview" version="5.18"/>
  <menu id="editor_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Open SQL File…</attribute>
        <attribute name="action">editor.open-file</attribute>
        <attribute name="accel">&lt;Primary&gt;o</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save</attribute>
        <attribute name="action">editor.save</attribute>
        <attribute name="accel">&lt;Primary&gt;s</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save As…</attribute>
        <attribute name="action">editor.save-as</attribute>
        <attribute name="accel">&lt;Primary&gt;&lt;Shift&gt;s</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Save Query…</attribute>
        <attribute name="action">win.save-query</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Format</attribute>
        <attribute name="action">editor.format</attribute>
        <attribute name="accel">&lt;Primary&gt;&lt;Shift&gt;f</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Explain with AI</attribute>
        <attribute name="action">editor.ai-explain</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Review with AI</attribute>
        <attribute name="action">editor.ai-review</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Optimize with AI</attribute>
        <attribute name="action">editor.ai-optimize</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Find…</attribute>
        <attribute name="action">editor.find</attribute>
        <attribute name="accel">&lt;Primary&gt;f</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Find and Replace…</attribute>
        <attribute name="action">editor.find-replace</attribute>
        <attribute name="accel">&lt;Primary&gt;h</attribute>
      </item>
    </section>
  </menu>
  <!-- Added after the text view's own context menu items. -->
  <menu id="assistant_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Explain with AI</attribute>
        <attribute name="action">editor.ai-explain</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Review with AI</attribute>
        <attribute name="action">editor.ai-review</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Optimize with AI</attribute>
        <attribute name="action">editor.ai-optimize</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>
  <template class="TableProSqlEditor" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">8</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <child>
              <object class="GtkLabel" id="cursor_info">
                <property name="hexpand">true</property>
                <property name="halign">end</property>
                <property name="margin-end">8</property>
                <style>
                  <class name="dim-label"/>
                  <class name="monospace"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="menu_button">
                <property name="tooltip-text" translatable="yes">Editor Options</property>
                <property name="menu-model">editor_menu</property>
                <style>
                  <class name="flat"/>
                </style>
                <accessibility>
                  <property name="label" translatable="yes">Editor Options</property>
                </accessibility>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="stop_button">
                <property name="label" translatable="yes">Stop</property>
                <property name="tooltip-text" translatable="yes">Stop the Running Query</property>
                <property name="visible">false</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="run_button">
                <property name="label" translatable="yes">Run</property>
                <property name="tooltip-text" translatable="yes">Run the Script</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="TableProFindBar" id="find_bar"/>
        </child>
        <property name="content">
          <object class="GtkPaned">
            <property name="orientation">vertical</property>
            <property name="position">280</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="shrink-end-child">false</property>
            <property name="start-child">
              <object class="AdwToolbarView" id="text_pane">
                <property name="reveal-bottom-bars">false</property>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="min-content-height">200</property>
                    <property name="child">
                      <object class="TableProEditorView" id="source_view">
                        <property name="show-line-numbers">true</property>
                        <property name="monospace">true</property>
                        <property name="auto-indent">true</property>
                        <property name="highlight-current-line">true</property>
                        <property name="tab-width">4</property>
                        <!-- Tab moves between a snippet's stops only with this on. -->
                        <property name="enable-snippets">true</property>
                        <property name="top-margin">8</property>
                        <property name="bottom-margin">8</property>
                        <property name="left-margin">8</property>
                        <property name="right-margin">8</property>
                        <style>
                          <class name="sql-editor"/>
                        </style>
                        <accessibility>
                          <property name="label" translatable="yes">SQL editor</property>
                        </accessibility>
                      </object>
                    </property>
                  </object>
                </property>
                <child type="bottom">
                  <object class="GtkBox" id="vim_bar">
                    <property name="accessible-role">status</property>
                    <property name="spacing">12</property>
                    <property name="margin-top">4</property>
                    <property name="margin-bottom">4</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <accessibility>
                      <property name="label" translatable="yes">Vim mode</property>
                    </accessibility>
                    <child>
                      <object class="GtkLabel" id="vim_command_bar">
                        <property name="hexpand">true</property>
                        <property name="xalign">0</property>
                        <property name="ellipsize">end</property>
                        <style>
                          <class name="monospace"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="vim_command">
                        <property name="xalign">1</property>
                        <property name="width-chars">8</property>
                        <property name="ellipsize">start</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="monospace"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="end-child">
              <object class="TableProResultsPane" id="results"/>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
