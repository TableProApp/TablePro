<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="libadwaita" version="1.9"/>
  <template class="TableProWorkspace" parent="AdwBin">
    <property name="child">
      <!-- libadwaita expects the overview as the window's direct
           content, so it covers both header bars when it opens. -->
      <object class="AdwTabOverview" id="tab_overview">
        <property name="view">tab_view</property>
        <property name="enable-new-tab">true</property>
        <property name="enable-search">true</property>
        <property name="child">
          <object class="AdwBreakpointBin" id="breakpoint_bin">
            <!-- A breakpoint bin needs a minimum size to measure
                 against; it is the window's own floor. -->
            <property name="width-request">360</property>
            <property name="height-request">294</property>
            <child>
              <object class="AdwBreakpoint" id="collapse_breakpoint">
                <condition>max-width: 600sp</condition>
                <setter object="split_view" property="collapsed">true</setter>
              </object>
            </child>
            <child>
              <!-- Only the last breakpoint that matches applies, so it
                   collapses the split view again. -->
              <object class="AdwBreakpoint" id="narrow_breakpoint">
                <condition>max-width: 450sp</condition>
                <setter object="split_view" property="collapsed">true</setter>
                <setter object="tab_bar" property="visible">false</setter>
                <setter object="tab_button" property="visible">true</setter>
              </object>
            </child>
            <property name="child">
              <object class="AdwToastOverlay" id="toast_overlay">
                <property name="child">
                  <object class="AdwOverlaySplitView" id="split_view">
                    <property name="min-sidebar-width">220</property>
                    <property name="max-sidebar-width">280</property>
                    <property name="sidebar">
                      <object class="AdwToolbarView" id="sidebar_root">
                        <child type="top">
                          <object class="AdwHeaderBar" id="sidebar_header">
                            <property name="title-widget">
                              <object class="AdwWindowTitle" id="sidebar_title"/>
                            </property>
                            <child type="start">
                              <object class="GtkToggleButton" id="table_search_toggle">
                                <property name="icon-name">system-search-symbolic</property>
                              </object>
                            </child>
                            <child type="start">
                              <object class="GtkButton" id="refresh_tables_button">
                                <property name="icon-name">view-refresh-symbolic</property>
                                <property name="action-name">win.refresh-tables</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="top">
                          <!-- No close button: GTK gives it no accessible name,
                               and the search toggle and Escape close the bar. -->
                          <object class="GtkSearchBar" id="table_search_bar">
                            <property name="child">
                              <object class="GtkSearchEntry" id="table_search">
                                <property name="placeholder-text" translatable="yes">Filter tables…</property>
                                <property name="hexpand">true</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Filter tables</property>
                                </accessibility>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child type="top">
                          <!-- The list stays as it was when a read fails, so
                               the banner says it may be out of date. -->
                          <object class="AdwBanner" id="catalog_banner">
                            <property name="use-markup">false</property>
                            <property name="button-label" translatable="yes">Retry</property>
                            <property name="action-name">win.refresh-tables</property>
                          </object>
                        </child>
                        <property name="content">
                          <object class="AdwBin" id="sidebar_slot">
                            <property name="vexpand">true</property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="AdwToolbarView" id="content_root">
                        <child type="top">
                          <object class="AdwHeaderBar" id="content_header">
                            <child type="start">
                              <object class="GtkToggleButton" id="sidebar_toggle">
                                <property name="icon-name">sidebar-show-symbolic</property>
                                <property name="action-name">win.show-sidebar</property>
                              </object>
                            </child>
                            <child type="start">
                              <object class="GtkButton" id="new_tab_button">
                                <property name="icon-name">tab-new-symbolic</property>
                                <property name="action-name">win.new-editor-tab</property>
                              </object>
                            </child>
                            <property name="title-widget">
                              <object class="AdwWindowTitle" id="window_title"/>
                            </property>
                            <child type="end">
                              <object class="AdwTabButton" id="tab_button">
                                <property name="view">tab_view</property>
                                <property name="action-name">overview.open</property>
                                <property name="visible">false</property>
                              </object>
                            </child>
                            <child type="end">
                              <object class="TableProExportOperationsButton" id="export_operations_button"/>
                            </child>
                            <child type="end">
                              <object class="AdwSpinner" id="row_op_spinner">
                                <property name="visible">false</property>
                                <property name="margin-end">6</property>
                                <property name="tooltip-text" translatable="yes">Saving…</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="top">
                          <object class="AdwTabBar" id="tab_bar">
                            <property name="view">tab_view</property>
                            <property name="autohide">true</property>
                          </object>
                        </child>
                        <child type="top">
                          <object class="AdwBanner" id="reconnect_banner">
                            <property name="use-markup">false</property>
                            <property name="button-label" translatable="yes">Retry</property>
                            <property name="action-name">win.reconnect</property>
                          </object>
                        </child>
                        <child type="top">
                          <!-- Until the unreadable file is moved aside, no tab
                               of this session is saved, so it stays up. -->
                          <object class="AdwBanner" id="layout_banner">
                            <property name="use-markup">false</property>
                            <property name="title" translatable="yes">Saved tabs could not be read, so the open tabs are not saved</property>
                            <property name="button-label" translatable="yes">Reset</property>
                            <property name="action-name">win.reset-workspace-layout</property>
                            <property name="tooltip-text" translatable="yes">Moves the unreadable file aside, so the open tabs can be saved</property>
                          </object>
                        </child>
                        <property name="content">
                          <object class="GtkStack" id="tab_stack">
                            <property name="transition-type">crossfade</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">empty</property>
                                <property name="child">
                                  <object class="AdwStatusPage">
                                    <property name="icon-name">view-grid-symbolic</property>
                                    <property name="title" translatable="yes">Select a Table</property>
                                    <property name="description" translatable="yes">Choose a table in the sidebar or open the SQL editor.</property>
                                    <property name="child">
                                      <object class="GtkButton">
                                        <property name="label" translatable="yes">Open SQL Editor</property>
                                        <property name="action-name">win.new-editor-tab</property>
                                        <property name="halign">center</property>
                                        <style>
                                          <class name="suggested-action"/>
                                          <class name="pill"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">tabs</property>
                                <property name="child">
                                  <object class="AdwTabView" id="tab_view"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
