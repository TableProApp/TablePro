+
+#[tokio::test]
+async fn review_snapshot_write_refusal_has_a_terminal_audit_outcome() {
+    let h = harness(SessionScript::default(), false);
+    let mut session = h.guard.open_session().await.expect("open session");
+    run(&mut session, "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY").await.expect("begin");
+    assert!(matches!(run(&mut session, "DELETE FROM items WHERE id = 1").await, Err(DriverError::ReadOnly)));
+    let events = h.audit.events.lock().expect("events");
+    assert_eq!(events.iter().filter(|event| event.phase == AuditRecordPhase::Outcome && event.terminal_status == AuditTerminalStatus::Denied).count(), 1);
+}
