{
    "app-id": "app.tablepro.TablePro",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "command": "tablepro",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=/etc/krb5.conf:ro",
        "--filesystem=/run/.heim_org.h5l.kcm-socket",
        "--talk-name=org.freedesktop.secrets"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm18/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm18/lib",
        "env": {
            "CARGO_HOME": "/run/build/tablepro/cargo",
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm18/lib",
            "TABLEPRO_APP_ID": "app.tablepro.TablePro",
            "TABLEPRO_PROFILE": "default",
            "TABLEPRO_LOCALEDIR": "/app/share/locale",
            "TABLEPRO_LIBEXECDIR": "/app/libexec"
        }
    },
    "modules": [
        {
            "name": "tablepro",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release -p tablepro",
                "install -Dm755 target/release/tablepro /app/bin/tablepro",
                "install -Dm644 flatpak/app.tablepro.TablePro.desktop /app/share/applications/app.tablepro.TablePro.desktop",
                "install -Dm644 flatpak/app.tablepro.TablePro.metainfo.xml /app/share/metainfo/app.tablepro.TablePro.metainfo.xml",
                "install -Dm644 flatpak/icons/scalable/app.tablepro.TablePro.svg /app/share/icons/hicolor/scalable/apps/app.tablepro.TablePro.svg",
                "if [ -f po/LINGUAS ]; then for lang in $(grep -v '^#' po/LINGUAS | grep -v '^$' || true); do mkdir -p /app/share/locale/$lang/LC_MESSAGES && msgfmt po/$lang.po -o /app/share/locale/$lang/LC_MESSAGES/tablepro.mo; done; fi"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                }
            ]
        }
    ]
}
