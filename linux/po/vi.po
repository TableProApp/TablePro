#, rust-format
msgid ""
"The SSH configuration for {host} accepts only keys already in known_hosts. "
"Add the server's key to known_hosts outside TablePro, then retry."
msgstr ""
"Cấu hình SSH cho {host} chỉ chấp nhận các khóa đã có trong known_hosts. Hãy "
"thêm khóa của máy chủ vào known_hosts bên ngoài TablePro, rồi thử lại."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "{host} is not in known_hosts. Connect once to review and trust its key."
msgstr ""
"{host} không có trong known_hosts. Hãy kết nối một lần để xem và tin cậy "
"khóa của nó."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid ""
"{host} is not in known_hosts (key {fingerprint}). Connect once to review and "
"trust its key."
msgstr ""
"{host} không có trong known_hosts (khóa {fingerprint}). Hãy kết nối một lần "
"để xem và tin cậy khóa của nó."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "ssh exited with status {status} and printed nothing."
msgstr "ssh đã thoát với mã {status} và không in ra gì."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "ssh exited with status {status}: {detail}"
msgstr "ssh đã thoát với mã {status}: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
msgid "ssh did not answer as TablePro expected."
msgstr "ssh không phản hồi như TablePro mong đợi."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "ssh printed something unexpected: {detail}"
msgstr "ssh đã in ra nội dung không mong đợi: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
msgid "it belongs to another user"
msgstr "nó thuộc về người dùng khác"

#: crates/app/src/ui/error_text/ssh.rs
msgid "it is not a directory"
msgstr "nó không phải là thư mục"

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "other users can open it (mode {mode})"
msgstr "người dùng khác có thể mở nó (quyền {mode})"

#: crates/app/src/ui/error_text/ssh.rs
msgid "its path does not end in a directory name"
msgstr "đường dẫn của nó không kết thúc bằng tên thư mục"

