#: crates/app/src/ui/assistant/error_text.rs
msgid "Choose a provider in Preferences to use the assistant."
msgstr "Chọn nhà cung cấp trong Tùy chỉnh để dùng trợ lý."

#: crates/app/src/ui/assistant/error_text.rs
msgid "The request stopped before it finished."
msgstr "Yêu cầu đã dừng trước khi hoàn tất."

#: crates/app/src/ui/assistant/error_text.rs
#, rust-format
msgid "Add your {provider} API key in Preferences."
msgstr "Thêm khóa API {provider} của bạn trong Tùy chỉnh."

#: crates/app/src/ui/assistant/error_text.rs
msgid "Choose a model in Preferences."
msgstr "Chọn model trong Tùy chỉnh."

#: crates/app/src/ui/assistant/error_text.rs
msgid "The server address in Preferences is not an http or https address."
