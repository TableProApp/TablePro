#, rust-format
msgid "The SSH server would not forward to {target}: {detail}"
msgstr "Máy chủ SSH không chịu chuyển tiếp tới {target}: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH server could not reach {target}."
msgstr "Máy chủ SSH không kết nối tới được {target}."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH server could not reach {target}: {detail}"
msgstr "Máy chủ SSH không kết nối tới được {target}: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
