#: crates/app/src/services/account_service.rs
msgid "You can close this tab and go back to TablePro."
msgstr "Bạn có thể đóng tab này và quay lại TablePro."

#: crates/app/src/services/account_service.rs
msgid ""
"TablePro is not waiting for this sign-in. Start it again from TablePro."
msgstr "TablePro không chờ lần đăng nhập này. Hãy bắt đầu lại từ TablePro."

#: crates/app/src/services/account_service.rs
