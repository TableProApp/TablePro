"Câu hỏi được gửi đến {destination} cùng cấu trúc bảng của kết nối này và SQL"
" trong trình soạn thảo. Trợ lý không đọc dòng nào."

#: crates/app/src/ui/assistant/assistant_pane.rs
#, rust-format
msgid "Sent with the structure of {tables}"
msgstr "Đã gửi cùng cấu trúc của {tables}"

#: crates/app/src/ui/assistant/assistant_pane.rs
msgid "The assistant may not send from this connection now."
msgstr "Hiện tại trợ lý không được phép gửi từ kết nối này."

#: crates/app/src/ui/assistant/assistant_pane.rs
msgid "The reply reached its length limit."
msgstr "Câu trả lời đã đạt giới hạn độ dài."

#: crates/app/src/ui/assistant/assistant_pane.rs
msgid "The model declined to answer."
msgstr "Model từ chối trả lời."

#: crates/app/src/ui/assistant/assistant_pane.rs
#, rust-format
msgid "{n} token"
msgid_plural "{n} tokens"
msgstr[0] "{n} token"

#: crates/app/src/ui/assistant/assistant_pane.rs
msgid "The assistant answered."
msgstr "Trợ lý đã trả lời."

#: crates/app/src/ui/assistant/assistant_pane.rs
#: crates/app/src/ui/error_text/driver.rs
#: crates/app/src/ui/error_text/operation.rs
