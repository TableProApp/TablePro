msgstr "Các khóa ngoại trên bảng khác phụ thuộc vào nó: {keys}"

#: crates/app/src/ui/error_text/ddl.rs
msgid "The database didn't report this column's full definition."
msgstr "Cơ sở dữ liệu không trả về định nghĩa đầy đủ của cột này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "This column's {attribute} doesn't allow this change."
msgstr "{attribute} của cột này không cho phép thay đổi này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"Its definition names column {column}, which this save renames. Save the "
"rename on its own first."
msgstr ""
"Định nghĩa của nó dùng tới cột {column}, cột mà lần lưu này đổi tên. Hãy lưu "
"việc đổi tên riêng trước."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"Trigger {triggers} inserts into this table without naming its columns, so "
"adding or removing a column would break it."
msgid_plural ""
"Triggers {triggers} insert into this table without naming its columns, so "
"adding or removing a column would break them."
msgstr[0] ""
"Trigger {triggers} chèn vào bảng này mà không ghi rõ tên cột, nên thêm hoặc "
"xóa một cột sẽ làm hỏng chúng."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Table name is required."
msgstr "Cần nhập tên bảng."

#: crates/app/src/ui/error_text/ddl.rs
msgid "At least one column is required."
msgstr "Cần có ít nhất một cột."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Every column needs a name."
msgstr "Mỗi cột đều cần có tên."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Duplicate column name: {name}"
msgstr "Tên cột bị trùng: {name}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Column {name} needs a type."
msgstr "Cột {name} cần có kiểu."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Primary key columns must be NOT NULL: {name}"
msgstr "Các cột khóa chính phải là NOT NULL: {name}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Column {column} is removed but {users} still use it. Remove them first."
msgstr "Cột {column} bị xóa nhưng {users} vẫn dùng nó. Hãy xóa chúng trước."

#: crates/app/src/ui/error_text/ddl.rs
#: crates/app/src/ui/structure_tab/index_draft.rs
msgid "Index name is required."
msgstr "Cần nhập tên chỉ mục."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Index {name} has no columns."
msgstr "Chỉ mục {name} không có cột nào."

#: crates/app/src/ui/error_text/ddl.rs
#: crates/app/src/ui/structure_tab/foreign_key_draft.rs
msgid "Foreign key name is required."
msgstr "Cần nhập tên khóa ngoại."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Foreign key {name} needs as many referenced columns as source columns."
msgstr "Khóa ngoại {name} cần có số cột được tham chiếu bằng số cột nguồn."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Fix the highlighted fields first."
msgstr "Hãy sửa các trường được tô sáng trước."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Column {column} can't be changed this way. {reason}"
msgstr "Không thể thay đổi cột {column} theo cách này. {reason}"

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"A NOT NULL column needs a default here, since the rows already in the table "
"need a value."
msgstr ""
"Cột NOT NULL cần có giá trị mặc định ở đây, vì các dòng đã có trong bảng cần "
"một giá trị."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "The type of column {column} can't be used. {reason}"
msgstr "Không dùng được kiểu của cột {column}. {reason}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "The default of column {column} can't be written as SQL. {reason}"
msgstr "Không thể viết giá trị mặc định của cột {column} thành SQL. {reason}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "The database didn't report the type of column {column}."
msgstr "Cơ sở dữ liệu không trả về kiểu của cột {column}."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "This database doesn't take {action} on a foreign key."
msgstr "Cơ sở dữ liệu này không hỗ trợ {action} trên khóa ngoại."

#: crates/app/src/ui/error_text/ddl.rs
msgid "The database gave no CREATE statement for this table."
msgstr "Cơ sở dữ liệu không trả về câu lệnh CREATE cho bảng này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"The table can't be rebuilt: the stored statement of {name}, which uses it, "
"can't be run again."
msgstr ""
"Không thể dựng lại bảng: câu lệnh đã lưu của {name}, đối tượng dùng bảng "
"này, không thể chạy lại."

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"The changes were edited or the connection changed during the review, so "
"nothing was saved. Save again to review them."
msgstr ""
"Các thay đổi đã bị sửa hoặc kết nối đã thay đổi trong lúc xem lại, nên chưa "
"có gì được lưu. Hãy lưu lại để xem lại chúng."

#: crates/app/src/ui/error_text/driver.rs crates/app/src/ui/error_text/tls.rs
msgid "The secure connection failed."
msgstr "Kết nối bảo mật thất bại."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server refused the request."
msgstr "Máy chủ đã từ chối yêu cầu."

#: crates/app/src/ui/error_text/driver.rs
#: crates/app/src/ui/error_text/operation.rs
msgid "Stopped."
msgstr "Đã dừng."

#: crates/app/src/ui/error_text/driver.rs
msgid "The connection was closed. Try reconnecting."
msgstr "Kết nối đã bị đóng. Hãy thử kết nối lại."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"The server has no room for another connection right now. Try again shortly."
msgstr "Máy chủ hiện không còn chỗ cho thêm kết nối. Hãy thử lại sau ít phút."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"Another program, or an editor tab with an open transaction, holds a lock on "
"this database file. Try again when it has finished."
msgstr ""
"Một chương trình khác, hoặc một tab trình soạn thảo có giao dịch đang mở, "
"đang khóa tệp cơ sở dữ liệu này. Hãy thử lại khi nó đã xong."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This tab is still running a statement. Stop it or wait for it to finish."
msgstr "Tab này vẫn đang chạy một câu lệnh. Hãy dừng nó hoặc chờ nó chạy xong."

#: crates/app/src/ui/error_text/driver.rs
msgid "The connection settings cannot be used."
msgstr "Không dùng được thiết lập kết nối này."

#: crates/app/src/ui/error_text/driver.rs
msgid "Enter the server's host name."
msgstr "Nhập tên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid "The host name has spaces or control characters in it."
msgstr "Tên máy chủ có chứa dấu cách hoặc ký tự điều khiển."

#: crates/app/src/ui/error_text/driver.rs
msgid "The port must be a number from 1 to 65535."
msgstr "Cổng phải là một số từ 1 đến 65535."

#: crates/app/src/ui/error_text/driver.rs
msgid "Use a full path, starting with /."
msgstr "Hãy dùng đường dẫn đầy đủ, bắt đầu bằng /."

#: crates/app/src/ui/error_text/driver.rs
msgid "This database does not offer that TLS mode."
msgstr "Cơ sở dữ liệu này không có chế độ TLS đó."

#: crates/app/src/ui/error_text/driver.rs
msgid "A CA certificate needs Verify full and a database that accepts one."
msgstr ""
"Chứng chỉ CA cần chế độ Xác minh đầy đủ và một cơ sở dữ liệu chấp nhận nó."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"A client certificate needs TLS turned on and a database that accepts one."
msgstr "Chứng chỉ máy khách cần bật TLS và một cơ sở dữ liệu chấp nhận nó."

#: crates/app/src/ui/error_text/driver.rs
msgid "A client certificate needs both its certificate file and its key file."
msgstr "Chứng chỉ máy khách cần cả tệp chứng chỉ lẫn tệp khóa."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The CA certificate {path} cannot be used: {problem}"
msgstr "Không dùng được chứng chỉ CA {path}: {problem}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The client certificate {path} cannot be used: {problem}"
msgstr "Không dùng được chứng chỉ máy khách {path}: {problem}"

#: crates/app/src/ui/error_text/driver.rs
msgid "The TLS server name is not a valid host name or IP address."
msgstr "Tên máy chủ TLS không phải là tên máy chủ hay địa chỉ IP hợp lệ."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This database cannot check the certificate against another server name here."
msgstr ""
"Cơ sở dữ liệu này không thể đối chiếu chứng chỉ với một tên máy chủ khác ở "
"đây."

#: crates/app/src/ui/error_text/driver.rs
msgid "This database does not support that way of logging in."
msgstr "Cơ sở dữ liệu này không hỗ trợ cách đăng nhập đó."

#: crates/app/src/ui/error_text/driver.rs
msgid "Enter the name of the database to open."
msgstr "Nhập tên cơ sở dữ liệu cần mở."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "{host}:{port} refused the connection. Is the database running?"
msgstr "{host}:{port} đã từ chối kết nối. Cơ sở dữ liệu có đang chạy không?"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Could not look up {host}."
msgstr "Không tra cứu được {host}."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Could not reach {host}:{port}."
msgstr "Không kết nối tới được {host}:{port}."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server could not be reached."
msgstr "Không kết nối tới được máy chủ."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Username or password is wrong. The server said: {detail}"
msgstr "Tên người dùng hoặc mật khẩu không đúng. Máy chủ báo: {detail}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The server refused this login. The server said: {detail}"
msgstr "Máy chủ đã từ chối lần đăng nhập này. Máy chủ báo: {detail}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"Kerberos login failed: {detail}. Check that klist shows a valid ticket, run "
"kinit if it does not, and make sure the server's SPN matches the host you "
"typed."
msgstr ""
"Đăng nhập Kerberos thất bại: {detail}. Hãy kiểm tra klist có hiện vé hợp lệ "
"không, chạy kinit nếu không có, và đảm bảo SPN của máy chủ khớp với máy chủ "
"bạn đã nhập."

#: crates/app/src/ui/error_text/driver.rs
msgid "Username or password is wrong."
msgstr "Tên người dùng hoặc mật khẩu không đúng."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The server refused the write: {message}"
msgstr "Máy chủ đã từ chối thao tác ghi: {message}"

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"Safe Mode is Read-Only on this connection. Choose another level in the main "
"menu to make changes."
msgstr ""
"Chế độ an toàn trên kết nối này là Chỉ đọc. Hãy chọn mức khác trong menu "
"chính để thực hiện thay đổi."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Query failed ({code}): {message}"
msgstr "Truy vấn thất bại ({code}): {message}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Query failed: {message}"
msgstr "Truy vấn thất bại: {message}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Hint: {hint}"
msgstr "Gợi ý: {hint}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "SQLSTATE {code}"
msgstr "SQLSTATE {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "MySQL error {code}"
msgstr "Lỗi MySQL {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "SQL Server error {code}"
msgstr "Lỗi SQL Server {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "ClickHouse code {code}"
msgstr "Mã ClickHouse {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "SQLite error {code}"
msgstr "Lỗi SQLite {code}"

#: crates/app/src/ui/error_text/driver.rs
msgid "The server took too long to answer."
msgstr "Máy chủ phản hồi quá lâu."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server did not answer the connection in time."
msgstr "Máy chủ không phản hồi kết nối kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server did not finish the login in time."
msgstr "Máy chủ không hoàn tất đăng nhập kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid "The SSH server did not finish the handshake in time."
msgstr "Máy chủ SSH không hoàn tất bắt tay kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid "The SSH server did not open the tunnel to the database in time."
msgstr "Máy chủ SSH không mở đường hầm tới cơ sở dữ liệu kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"Another session holds a lock this needs. Try again when it has finished."
msgstr ""
"Một phiên khác đang giữ khóa mà thao tác này cần. Hãy thử lại khi nó đã xong."

#: crates/app/src/ui/error_text/driver.rs
msgid "The statement ran past its time limit, so the server stopped it."
msgstr "Câu lệnh chạy quá giới hạn thời gian, nên máy chủ đã dừng nó."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"The statement ran past its time limit. The server may still be running it."
msgstr "Câu lệnh chạy quá giới hạn thời gian. Máy chủ có thể vẫn đang chạy nó."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server did not answer a check in time."
msgstr "Máy chủ không trả lời lần kiểm tra kịp thời."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"Save failed at statement {n}: {error}. The transaction was rolled back; no "
"rows were changed."
msgstr ""
"Lưu thất bại ở câu lệnh {n}: {error}. Giao dịch đã được rollback; không dòng "
"nào bị thay đổi."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"The save matched {actual} rows where it expected {expected}, so the row is "
"not the one that was loaded. Nothing was changed; reload and try again."
msgstr ""
"Lần lưu khớp {actual} dòng trong khi lẽ ra là {expected}, nên dòng này không "
"phải dòng đã được tải. Chưa có gì thay đổi; hãy tải lại và thử lại."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"{applied} of the save's statements were applied before statement {n} failed, "
"and this database has no transaction to undo them. Reload to see what the "
"server has."
msgstr ""
"{applied} câu lệnh của lần lưu đã được áp dụng trước khi câu lệnh {n} thất "
"bại, và cơ sở dữ liệu này không có giao dịch để hoàn tác chúng. Hãy tải lại "
"để xem dữ liệu trên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"The connection was lost after the save was sent, so whether it was applied "
"is not known. Reload to see what the server has."
msgstr ""
"Kết nối bị mất sau khi gửi lần lưu, nên không biết nó đã được áp dụng hay "
"chưa. Hãy tải lại để xem dữ liệu trên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "No database file at {path}."
msgstr "Không có tệp cơ sở dữ liệu tại {path}."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "No permission to open {path}."
msgstr "Không có quyền mở {path}."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "{path} is not a database file."
msgstr "{path} không phải là tệp cơ sở dữ liệu."

#: crates/app/src/ui/error_text/driver.rs
msgid "The database file cannot be used."
msgstr "Không dùng được tệp cơ sở dữ liệu này."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This database does not report how many rows a statement changed, so the save "
"cannot be checked. Use a table with a primary key."
msgstr ""
"Cơ sở dữ liệu này không cho biết một câu lệnh đã thay đổi bao nhiêu dòng, "
"nên không thể kiểm tra lần lưu. Hãy dùng một bảng có khóa chính."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The driver could not read a value in column {column}."
msgstr "Trình điều khiển không đọc được một giá trị trong cột {column}."

#: crates/app/src/ui/error_text/driver.rs
msgid "The driver could not read the server's reply."
msgstr "Trình điều khiển không đọc được phản hồi của máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid "The driver hit an internal error."
msgstr "Trình điều khiển gặp lỗi nội bộ."

#: crates/app/src/ui/error_text/edit.rs
msgid "This column needs a value"
msgstr "Cột này cần có giá trị"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter a whole number"
msgstr "Nhập một số nguyên"

#: crates/app/src/ui/error_text/edit.rs
#, rust-format
msgid "Enter a whole number from {min} to {max}"
msgstr "Nhập một số nguyên từ {min} đến {max}"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter a number"
msgstr "Nhập một số"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter a decimal number, such as 12.50"
msgstr "Nhập một số thập phân, ví dụ 12.50"

#: crates/app/src/ui/error_text/edit.rs
#, rust-format
msgid "This column keeps at most {n} digit"
msgid_plural "This column keeps at most {n} digits"
msgstr[0] "Cột này giữ tối đa {n} chữ số"

#: crates/app/src/ui/error_text/edit.rs
#, rust-format
msgid "This column keeps at most {n} decimal place"
msgid_plural "This column keeps at most {n} decimal places"
msgstr[0] "Cột này giữ tối đa {n} chữ số thập phân"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter true or false"
msgstr "Nhập true hoặc false"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter a UUID"
msgstr "Nhập một UUID"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter valid JSON: it ends too early"
msgstr "Nhập JSON hợp lệ: nội dung kết thúc quá sớm"

#: crates/app/src/ui/error_text/edit.rs
#, rust-format
msgid "Enter valid JSON: check line {line}, column {column}"
msgstr "Nhập JSON hợp lệ: hãy kiểm tra dòng {line}, cột {column}"

#: crates/app/src/ui/error_text/edit.rs
msgid "Enter a date as YYYY-MM-DD"
msgstr "Nhập ngày theo dạng YYYY-MM-DD"

#: crates/app/src/ui/error_text/edit.rs
