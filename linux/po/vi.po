#: crates/app/src/services/deletion_error.rs
#: crates/app/src/ui/session_window/connections.rs
msgid "The stored passwords could not be deleted, so the connection was kept."
msgstr "Không xóa được các mật khẩu đã lưu, nên kết nối vẫn được giữ lại."

#: crates/app/src/services/deletion_error.rs
#, rust-format
msgid ""
"“{name}” is still listed, but its stored passwords were deleted. Connecting "
"will ask for them."
msgstr ""
"“{name}” vẫn còn trong danh sách, nhưng các mật khẩu đã lưu của nó đã bị "
"xóa. Khi kết nối, ứng dụng sẽ hỏi lại."

#: crates/app/src/services/deletion_error.rs
#, rust-format
msgid "“{name}” could not be deleted"
msgstr "Không xóa được “{name}”"

#: crates/app/src/services/deletion_report.rs
#, rust-format
msgid ""
"“{name}” was deleted, but some saved tabs or settings could not be removed"
msgstr "Đã xóa “{name}”, nhưng không gỡ được một số tab hoặc cài đặt đã lưu"

#: crates/app/src/services/deletion_report.rs
#, rust-format
msgid ""
"“{name}” was deleted, but some of what was stored for it could not be removed"
msgstr "Đã xóa “{name}”, nhưng không gỡ được một phần dữ liệu đã lưu cho nó"

#: crates/app/src/services/deletion_report.rs
#, rust-format
msgid ""
"“{name}” was deleted, but its saved queries and query history could not be "
"removed"
msgstr ""
"Đã xóa “{name}”, nhưng không gỡ được các truy vấn đã lưu và lịch sử truy vấn "
"của nó"

#: crates/app/src/services/deletion_report.rs
#, rust-format
msgid "“{name}” was deleted, but its saved queries could not be removed"
msgstr "Đã xóa “{name}”, nhưng không gỡ được các truy vấn đã lưu của nó"

#: crates/app/src/services/deletion_report.rs
#, rust-format
msgid "“{name}” was deleted, but its query history could not be removed"
msgstr "Đã xóa “{name}”, nhưng không gỡ được lịch sử truy vấn của nó"

#: crates/app/src/services/duplicate_name.rs
#, rust-format
msgid "{name} (Copy)"
msgstr "{name} (Bản sao)"

#: crates/app/src/services/duplicate_name.rs
#, rust-format
msgid "{name} (Copy {n})"
msgstr "{name} (Bản sao {n})"

#: crates/app/src/services/grid/cell_lock.rs
msgid "A saved row's key can't be changed here"
msgstr "Không thể đổi khóa của dòng đã lưu ở đây"

#: crates/app/src/services/grid/cell_lock.rs
msgid "The database computes this column's values"
msgstr "Cơ sở dữ liệu tự tính giá trị của cột này"

#: crates/app/src/services/grid/cell_lock.rs
msgid "The database numbers this column's values"
msgstr "Cơ sở dữ liệu tự đánh số giá trị của cột này"

#: crates/app/src/services/grid/cell_lock.rs
#: crates/app/src/services/grid/result_refusal.rs
msgid "Rows of a table without a primary key can't be edited"
msgstr "Không thể sửa dòng trong bảng không có khóa chính"

#: crates/app/src/services/grid/cell_lock.rs
msgid "Query results can't be edited here"
msgstr "Không thể sửa kết quả truy vấn ở đây"

#: crates/app/src/services/grid/cell_lock.rs
msgid "This column can't be written back to the table"
msgstr "Không thể ghi cột này trở lại bảng"

#: crates/app/src/services/grid/cell_lock.rs
#: crates/app/src/services/grid/edit_policy.rs
#: crates/app/src/services/grid/result_refusal.rs
#: crates/app/src/ui/workspace/catalog_ops.rs
#: crates/app/src/ui/workspace/database_transfer.rs
#: crates/app/src/ui/workspace/import.rs
#: crates/app/src/workspace/save_rejection.rs
msgid "This connection is read-only."
msgstr "Kết nối này chỉ cho phép đọc."

#: crates/app/src/services/grid/cell_lock.rs
msgid "Rows marked for deletion can't be edited"
msgstr "Không thể sửa dòng đã đánh dấu để xóa"

#: crates/app/src/services/grid/cell_lock.rs
msgid ""
"A field whose name has a dot or starts with $ can only be changed in the "
"editor"
msgstr ""
"Trường có tên chứa dấu chấm hoặc bắt đầu bằng $ chỉ có thể được sửa trong "
"trình soạn thảo"

#: crates/app/src/services/grid/cell_lock.rs
#: crates/app/src/ui/data_grid/edit/mod.rs
msgid "This row is being saved. Change it again once the save finishes."
msgstr "Dòng này đang được lưu. Hãy sửa lại sau khi lưu xong."

#: crates/app/src/services/grid/delete_availability.rs
msgid "Rows without a primary key or unique key can't be deleted here"
msgstr "Không thể xóa ở đây các dòng không có khóa chính hoặc khóa duy nhất"

#: crates/app/src/services/grid/delete_availability.rs
msgid "This connection is read-only"
msgstr "Kết nối này chỉ cho phép đọc"

#: crates/app/src/services/grid/display_text.rs
msgid "<NULL>"
msgstr "<NULL>"

#: crates/app/src/services/grid/display_text.rs
msgid "(auto)"
msgstr "(tự động)"

#: crates/app/src/services/grid/display_text.rs
#, rust-format
msgid "<{count} byte>"
msgid_plural "<{count} bytes>"
msgstr[0] "<{count} byte>"

#: crates/app/src/services/grid/display_text.rs
#, rust-format
msgid "<unreadable {type}>"
msgstr "<{type} không đọc được>"

#: crates/app/src/services/grid/display_text.rs
#: crates/app/src/ui/source_dialog.rs
#, rust-format
msgid "… ({count} more byte)"
msgid_plural "… ({count} more bytes)"
msgstr[0] "… (thêm {count} byte)"

#: crates/app/src/services/grid/edit_parse.rs
#: crates/app/src/ui/import_from_app/wording.rs
msgid "Required"
msgstr "Bắt buộc"

#: crates/app/src/services/grid/edit_policy.rs
msgid "This table has no primary key, so editing is turned off."
msgstr "Bảng này không có khóa chính, nên tính năng sửa đã bị tắt."

#: crates/app/src/services/grid/edit_policy.rs
#: crates/app/src/ui/editor/result_editing.rs
msgid "Wait for the changes to finish saving"
msgstr "Hãy chờ lưu xong các thay đổi"

#: crates/app/src/services/grid/edit_policy.rs
msgid ""
"Rows of this result can't be duplicated, since some values were read as text"
msgstr ""
"Không thể nhân bản các dòng của kết quả này vì một số giá trị được đọc dưới "
"dạng văn bản"

#: crates/app/src/services/grid/edit_policy.rs
#, rust-format
msgid "{n} selected · press Delete to remove"
msgstr "Đã chọn {n} · bấm Delete để gỡ"

#: crates/app/src/services/grid/edit_policy.rs
#: crates/app/src/ui/history_dialog/mod.rs
#, rust-format
msgid "{n} selected"
msgid_plural "{n} selected"
msgstr[0] "Đã chọn {n}"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Only the rows of one SELECT can be edited"
msgstr "Chỉ có thể sửa dòng từ một câu lệnh SELECT"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Rows from more than one table, a subquery or a CTE can't be edited"
msgstr "Không thể sửa dòng từ nhiều bảng, truy vấn con hoặc CTE"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Grouped, distinct or computed rows can't be edited"
msgstr "Không thể sửa dòng đã nhóm, lọc trùng hoặc tính toán"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Only rows read straight from a table can be edited"
msgstr "Chỉ có thể sửa dòng được đọc trực tiếp từ bảng"

#: crates/app/src/services/grid/result_refusal.rs
msgid ""
"The result leaves out part of the table's primary key, so its rows can't be "
"edited"
msgstr "Kết quả thiếu một phần khóa chính của bảng nên không thể sửa các dòng"

#: crates/app/src/services/grid/result_refusal.rs
msgid "The table changed since the query ran. Run it again to edit its rows."
msgstr "Bảng đã thay đổi từ khi chạy truy vấn. Hãy chạy lại để sửa các dòng."

#: crates/app/src/services/grid/result_refusal.rs
msgid "Rows read inside an open transaction can't be edited here"
msgstr "Không thể sửa dòng được đọc trong giao dịch đang mở ở đây"

#: crates/app/src/services/grid/result_refusal.rs
msgid ""
"The server doesn't say whether a transaction is open, so these rows can't be"
" edited here"
msgstr ""
"Máy chủ không cho biết có giao dịch đang mở hay không nên không thể sửa các "
"dòng này ở đây"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Rows from another database than the connection's can't be edited here"
msgstr ""
"Không thể sửa dòng từ cơ sở dữ liệu khác với cơ sở dữ liệu của kết nối ở đây"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Rows can be edited when the run returns one result"
msgstr "Có thể sửa dòng khi lần chạy trả về một kết quả"

#: crates/app/src/services/grid/result_refusal.rs
msgid "Checking whether these rows can be edited…"
msgstr "Đang kiểm tra xem có thể sửa các dòng này không…"

#: crates/app/src/services/grid/result_refusal.rs
msgid "The table's columns couldn't be read, so its rows can't be edited"
msgstr "Không đọc được các cột của bảng nên không thể sửa các dòng"

#: crates/app/src/services/history_availability.rs
msgid ""
"The query history was written by a newer version of TablePro. Update "
"TablePro to read it."
msgstr ""
"Lịch sử truy vấn được ghi bởi một phiên bản TablePro mới hơn. Hãy cập nhật "
"TablePro để đọc được nó."

#: crates/app/src/services/history_availability.rs
msgid "The query history could not be updated for this version of TablePro."
msgstr "Không cập nhật được lịch sử truy vấn cho phiên bản TablePro này."

#: crates/app/src/services/history_availability.rs
#: crates/app/src/ui/error_text/files.rs
#, rust-format
msgid "TablePro is not allowed to write {path}."
msgstr "TablePro không được phép ghi vào {path}."

#: crates/app/src/services/history_availability.rs
#, rust-format
msgid "The disk that holds {path} is full."
msgstr "Ổ đĩa chứa {path} đã đầy."

#: crates/app/src/services/history_availability.rs
#, rust-format
msgid "{path} could not be created."
msgstr "Không tạo được {path}."

#: crates/app/src/services/history_availability.rs
#: crates/app/src/ui/saved_queries_dialog/mod.rs
msgid "The query history file could not be read. It may be damaged."
msgstr "Không đọc được tệp lịch sử truy vấn. Tệp có thể đã bị hỏng."

#: crates/app/src/services/secret_labels.rs
msgid "TablePro MCP access token"
msgstr "Access Token MCP của TablePro"

#: crates/app/src/services/secret_labels.rs
msgid "TablePro API key for Anthropic"
msgstr "Khóa API Anthropic của TablePro"

#: crates/app/src/services/secret_labels.rs
msgid "TablePro API key for OpenAI"
msgstr "Khóa API OpenAI của TablePro"

#: crates/app/src/services/secret_labels.rs
msgid "TablePro API key for an OpenAI-compatible server"
msgstr "Khóa API của TablePro cho máy chủ tương thích với OpenAI"

#: crates/app/src/services/secret_labels.rs
#, rust-format
msgid "TablePro database password for {target}"
msgstr "Mật khẩu cơ sở dữ liệu TablePro cho {target}"

#: crates/app/src/services/secret_labels.rs
#, rust-format
msgid "TablePro SSH password for {target}"
msgstr "Mật khẩu SSH TablePro cho {target}"

#: crates/app/src/services/secret_labels.rs
#, rust-format
msgid "TablePro SSH key passphrase for {target}"
msgstr "Cụm mật khẩu khóa SSH TablePro cho {target}"

#: crates/app/src/services/secret_save_report.rs
msgid ""
"No keyring is running, so the password was not saved. It will be asked for "
"next time."
msgstr ""
"Không có chùm khóa nào đang chạy, nên mật khẩu chưa được lưu. Lần sau ứng "
"dụng sẽ hỏi lại."

#: crates/app/src/services/secret_save_report.rs
msgid ""
"The secret portal is unavailable, so the password was not saved. It will be "
"asked for next time."
msgstr ""
"Cổng thông tin bí mật (secret portal) không khả dụng, nên mật khẩu chưa được "
"lưu. Lần sau ứng dụng sẽ hỏi lại."

#: crates/app/src/services/secret_save_report.rs
msgid ""
"The keyring stayed locked, so the password was not saved. It will be asked "
"for next time."
msgstr ""
"Chùm khóa vẫn bị khóa, nên mật khẩu chưa được lưu. Lần sau ứng dụng sẽ hỏi "
"lại."

#: crates/app/src/services/secret_save_report.rs
#, rust-format
msgid "The keyring did not save the password: {reason}"
msgstr "Chùm khóa không lưu mật khẩu: {reason}"

#: crates/app/src/services/secret_save_report.rs
msgid "The keyring did not save the password."
msgstr "Chùm khóa không lưu mật khẩu."

#: crates/app/src/ui/ai_policy.rs
msgid "Ask Each Time"
msgstr "Hỏi mỗi lần"

#: crates/app/src/ui/ai_policy.rs
msgid "Allow"
msgstr "Cho phép"

#: crates/app/src/ui/ai_policy.rs crates/app/src/ui/export/dialog.rs
msgid "Never"
msgstr "Không bao giờ"

#: crates/app/src/ui/ai_policy.rs
msgid ""
"The assistant asks before it first sends this connection’s structure, and "
"your answer lasts until the window disconnects."
msgstr ""
"Trợ lý hỏi trước khi gửi cấu trúc của kết nối này lần đầu. Câu trả lời của "
"bạn có hiệu lực cho đến khi cửa sổ ngắt kết nối."

#: crates/app/src/ui/ai_policy.rs
msgid ""
"The assistant sends this connection’s table structure and your SQL to the "
"provider without asking. It reads no rows."
msgstr ""
"Trợ lý gửi cấu trúc bảng của kết nối này và SQL của bạn đến nhà cung cấp mà "
"không hỏi. Trợ lý không đọc dòng nào."

#: crates/app/src/ui/ai_policy.rs
msgid ""
"Nothing from this connection is sent to the AI provider, and the assistant "
"is off here."
msgstr ""
"Không có dữ liệu nào từ kết nối này được gửi đến nhà cung cấp AI và trợ lý "
"bị tắt ở đây."

#: crates/app/src/ui/assistant/assistant_access.rs
msgid "Use the AI Assistant Here?"
msgstr "Dùng trợ lý AI ở đây?"

#: crates/app/src/ui/assistant/assistant_access.rs
#, rust-format
msgid ""
"The assistant sends your questions, your SQL and the structure of the tables"
" involved from “{connection}” to {destination}. It reads no rows. Your "
"answer lasts until this window disconnects."
msgstr ""
"Trợ lý gửi câu hỏi, SQL của bạn và cấu trúc các bảng liên quan từ "
"“{connection}” đến {destination}. Trợ lý không đọc dòng nào. Câu trả lời của"
" bạn có hiệu lực cho đến khi cửa sổ này ngắt kết nối."

