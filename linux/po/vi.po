#: crates/app/src/ui/error_text/ssh.rs
msgid "the disk is full"
msgstr "ổ đĩa đã đầy"

#: crates/app/src/ui/error_text/ssh.rs
msgid "the disk is read-only"
msgstr "ổ đĩa chỉ cho phép đọc"

#: crates/app/src/ui/error_text/ssh.rs
msgid "a directory in its path is missing or is a file"
msgstr "một thư mục trong đường dẫn của nó bị thiếu hoặc là một tệp"

#: crates/app/src/ui/error_text/ssh.rs
msgid "the file system refused it"
msgstr "hệ thống tệp đã từ chối nó"

#: crates/app/src/ui/error_text/ssh.rs
msgid "the host name is empty"
msgstr "tên máy chủ trống"

#: crates/app/src/ui/error_text/ssh.rs
msgid "the username is empty"
msgstr "tên người dùng trống"

#: crates/app/src/ui/error_text/ssh.rs
msgid "the host name starts with “-”"
msgstr "tên máy chủ bắt đầu bằng “-”"

#: crates/app/src/ui/error_text/ssh.rs
msgid "the username starts with “-”"
msgstr "tên người dùng bắt đầu bằng “-”"

