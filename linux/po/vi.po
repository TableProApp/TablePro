#: crates/app/src/ui/error_text/account.rs
msgid ""
"TablePro could not reach its account service. Check the internet connection "
"and try again."
msgstr ""
"TablePro không kết nối được với dịch vụ tài khoản. Hãy kiểm tra kết nối "
"internet rồi thử lại."

#: crates/app/src/ui/error_text/account.rs
msgid "TablePro could not open the sign-in page in a web browser."
msgstr "TablePro không mở được trang đăng nhập trong trình duyệt web."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"The sign-in was not finished in the browser within 10 minutes. Start it "
"again."
msgstr ""
"Chưa hoàn tất đăng nhập trong trình duyệt sau 10 phút. Hãy bắt đầu lại."

#: crates/app/src/ui/error_text/account.rs
msgid "The sign-in was canceled."
msgstr "Đã hủy đăng nhập."

#: crates/app/src/ui/error_text/account.rs
msgid "The sign-in was declined in the browser."
msgstr "Đăng nhập bị từ chối trong trình duyệt."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid "The account service refused the sign-in ({code})."
msgstr "Dịch vụ tài khoản từ chối đăng nhập ({code})."

#: crates/app/src/ui/error_text/account.rs
msgid "You were signed out. Sign in again."
msgstr "Bạn đã đăng xuất. Hãy đăng nhập lại."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"This computer was removed from your account, so TablePro signed out here."
msgstr ""
"Máy tính này đã bị xóa khỏi tài khoản của bạn nên TablePro đã đăng xuất ở "
"đây."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid ""
"Your license is in use on {n} other device. Remove one to use it on this "
"computer."
msgid_plural ""
"Your license is in use on {n} other devices. Remove one to use it on this "
"computer."
msgstr[0] ""
"Giấy phép của bạn đang được dùng trên {n} thiết bị khác. Hãy xóa một thiết "
"bị để dùng trên máy tính này."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"This file was made for another account. Make one with the account signed in "
"here, or sign out first."
msgstr ""
"Tệp này được tạo cho tài khoản khác. Hãy tạo tệp bằng tài khoản đang đăng "
"nhập ở đây hoặc đăng xuất trước."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid "The account service is busy. Try again in {n} minute."
msgid_plural "The account service is busy. Try again in {n} minutes."
msgstr[0] "Dịch vụ tài khoản đang bận. Hãy thử lại sau {n} phút."

#: crates/app/src/ui/error_text/account.rs
msgid "The account service is busy. Try again in a few minutes."
msgstr "Dịch vụ tài khoản đang bận. Hãy thử lại sau vài phút."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid "TablePro could not keep the account’s state in {path}."
msgstr "TablePro không lưu được trạng thái tài khoản vào {path}."

#: crates/app/src/ui/error_text/account.rs
msgid "TablePro could not read the account service’s answer. Try again later."
msgstr ""
"TablePro không đọc được phản hồi từ dịch vụ tài khoản. Hãy thử lại sau."

#: crates/app/src/ui/error_text/account.rs
msgid "The offline file could not be read."
msgstr "Không đọc được tệp ngoại tuyến."

#: crates/app/src/ui/error_text/account.rs
msgid "This is not an offline file: it is far too large."
msgstr "Đây không phải tệp ngoại tuyến: kích thước quá lớn."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"That device has an offline file that is still valid, so it keeps its license"
" slot until the file expires."
msgstr ""
"Thiết bị đó có tệp ngoại tuyến còn hiệu lực nên vẫn chiếm một suất giấy phép"
" cho đến khi tệp hết hạn."

#: crates/app/src/ui/error_text/account.rs
msgid "Your account is locked. Contact TablePro support."
msgstr "Tài khoản của bạn bị khóa. Hãy liên hệ bộ phận hỗ trợ TablePro."

#: crates/app/src/ui/error_text/account.rs
msgid "The account service no longer has it. Refresh and try again."
msgstr "Dịch vụ tài khoản không còn mục này. Hãy làm mới rồi thử lại."

#: crates/app/src/ui/error_text/account.rs
msgid "TablePro signed out here, but could not tell the account service."
msgstr ""
"TablePro đã đăng xuất ở đây nhưng không thông báo được cho dịch vụ tài "
"khoản."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid "The account service had a problem (error {status}). Try again later."
msgstr "Dịch vụ tài khoản gặp sự cố (lỗi {status}). Hãy thử lại sau."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid "The account service refused the request (error {status})."
msgstr "Dịch vụ tài khoản từ chối yêu cầu (lỗi {status})."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"This file was made for another computer. Make one for the machine ID this "
"computer shows."
msgstr ""
"Tệp này được tạo cho máy tính khác. Hãy tạo tệp cho mã máy mà máy tính này "
"hiển thị."

#: crates/app/src/ui/error_text/account.rs
#, rust-format
msgid "It expired on {date}."
msgstr "Đã hết hạn vào {date}."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"This computer’s clock is behind. Set the date and time, then try again."
msgstr "Đồng hồ máy tính này bị chậm. Hãy đặt ngày giờ rồi thử lại."

#: crates/app/src/ui/error_text/account.rs
msgid ""
"This build of TablePro cannot check it: it is signed with a key the build "
"does not have."
msgstr ""
"Bản dựng TablePro này không kiểm tra được: mục này được ký bằng khóa mà bản "
"dựng không có."

#: crates/app/src/ui/error_text/account.rs
msgid "This is not a TablePro entitlement, or it was changed."
msgstr "Đây không phải quyền sử dụng TablePro hoặc đã bị thay đổi."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "This is not a connection URL."
msgstr "Đây không phải URL kết nối."

#: crates/app/src/ui/error_text/connection_url.rs
#, rust-format
msgid "No driver opens {scheme} URLs."
msgstr "Không có trình điều khiển nào mở được URL {scheme}."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "The URL names no host."
msgstr "URL không có tên máy chủ."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "The URL lists several hosts, which only a MongoDB connection takes."
msgstr "URL liệt kê nhiều máy chủ, chỉ kết nối MongoDB mới chấp nhận."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "The URL's port is not a number from 1 to 65535."
msgstr "Cổng trong URL không phải số từ 1 đến 65535."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "A mongodb+srv URL names one host and no port."
msgstr "URL mongodb+srv chỉ có một máy chủ và không có cổng."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "A Redis URL ends with the database's number, such as /0."
msgstr "URL Redis kết thúc bằng số cơ sở dữ liệu, chẳng hạn /0."

#: crates/app/src/ui/error_text/connection_url.rs
msgid "A path in the URL must be a full path, starting with /."
msgstr "Đường dẫn trong URL phải là đường dẫn đầy đủ, bắt đầu bằng /."

#: crates/app/src/ui/error_text/connection_url.rs
msgid ""
"SQL Server instance names are not supported. Put the instance's port in the "
"URL instead."
msgstr ""
"Không hỗ trợ tên instance SQL Server. Hãy dùng cổng của instance trong URL."

#: crates/app/src/ui/error_text/connection_url.rs
msgid ""
"directConnection=true takes one host and no DNS seed list, and false takes a"
" replicaSet or several hosts."
msgstr ""
"directConnection=true yêu cầu một máy chủ và không dùng danh sách seed DNS; "
"false yêu cầu replicaSet hoặc nhiều máy chủ."

#: crates/app/src/ui/error_text/connection_url.rs
#, rust-format
msgid ""
"The URL asks for {name}, a protection TablePro cannot enforce. Remove it to "
"connect without it."
msgstr ""
"URL yêu cầu {name}, một biện pháp bảo vệ TablePro không thể áp dụng. Hãy bỏ "
"tùy chọn này để kết nối mà không có biện pháp đó."

#: crates/app/src/ui/error_text/connection_url.rs
#, rust-format
msgid ""
"The URL logs in with {mechanism}, and TablePro logs in to MongoDB with a "
"password only."
msgstr ""
"URL đăng nhập bằng {mechanism}, nhưng TablePro chỉ đăng nhập MongoDB bằng "
"mật khẩu."

#: crates/app/src/ui/error_text/ddl.rs
msgid "This database can't make this change."
msgstr "Cơ sở dữ liệu này không thể thực hiện thay đổi này."

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"This column is part of the table's sorting or partition key, which only "
"rebuilding the table can change."
msgstr ""
"Cột này thuộc khóa sắp xếp hoặc khóa phân vùng của bảng, chỉ có thể thay đổi "
"bằng cách dựng lại bảng."

#: crates/app/src/ui/error_text/ddl.rs
msgid "The database computes this column."
msgstr "Cơ sở dữ liệu tự tính toán cột này."

#: crates/app/src/ui/error_text/ddl.rs
msgid "The database numbers this column, so it has no default."
msgstr "Cơ sở dữ liệu tự đánh số cột này, nên nó không có giá trị mặc định."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Only an integer column can number itself."
msgstr "Chỉ cột số nguyên mới có thể tự đánh số."

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"The database numbers this column while it is the table's integer primary "
"key. Change its type or the primary key to stop it."
msgstr ""
"Cơ sở dữ liệu tự đánh số cột này khi nó là khóa chính số nguyên của bảng. "
"Đổi kiểu của nó hoặc đổi khóa chính để dừng việc này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "This column has an attribute TablePro can't restate: {attribute}"
msgstr "Cột này có một thuộc tính mà TablePro không thể viết lại: {attribute}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Still used by {users}."
msgstr "Vẫn đang được {users} sử dụng."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Foreign keys on other tables depend on it: {keys}"
msgstr "Các khóa ngoại trên bảng khác phụ thuộc vào nó: {keys}"

#: crates/app/src/ui/error_text/ddl.rs
msgid "The database didn't report this column's full definition."
msgstr "Cơ sở dữ liệu không trả về định nghĩa đầy đủ của cột này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "This column's {attribute} doesn't allow this change."
msgstr "{attribute} của cột này không cho phép thay đổi này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"Its definition names column {column}, which this save renames. Save the "
"rename on its own first."
msgstr ""
"Định nghĩa của nó dùng tới cột {column}, cột mà lần lưu này đổi tên. Hãy lưu "
"việc đổi tên riêng trước."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"Trigger {triggers} inserts into this table without naming its columns, so "
"adding or removing a column would break it."
msgid_plural ""
"Triggers {triggers} insert into this table without naming its columns, so "
"adding or removing a column would break them."
msgstr[0] ""
"Trigger {triggers} chèn vào bảng này mà không ghi rõ tên cột, nên thêm hoặc "
"xóa một cột sẽ làm hỏng chúng."

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"Save column and primary key changes before converting existing columns."
msgstr ""
"Hãy lưu thay đổi cột và khóa chính trước khi chuyển đổi các cột hiện có."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Table name is required."
msgstr "Cần nhập tên bảng."

#: crates/app/src/ui/error_text/ddl.rs
msgid "At least one column is required."
msgstr "Cần có ít nhất một cột."

#: crates/app/src/ui/error_text/ddl.rs
msgid "A primary key is required."
msgstr "Bắt buộc phải có khóa chính."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Every column needs a name."
msgstr "Mỗi cột đều cần có tên."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Duplicate column name: {name}"
msgstr "Tên cột bị trùng: {name}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Column {name} needs a type."
msgstr "Cột {name} cần có kiểu."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Primary key columns must be NOT NULL: {name}"
msgstr "Các cột khóa chính phải là NOT NULL: {name}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Column {column} is removed but {users} still use it. Remove them first."
msgstr "Cột {column} bị xóa nhưng {users} vẫn dùng nó. Hãy xóa chúng trước."

#: crates/app/src/ui/error_text/ddl.rs
#: crates/app/src/ui/structure_tab/index_draft.rs
msgid "Index name is required."
msgstr "Cần nhập tên chỉ mục."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Index {name} has no columns."
msgstr "Chỉ mục {name} không có cột nào."

#: crates/app/src/ui/error_text/ddl.rs
#: crates/app/src/ui/structure_tab/foreign_key_draft.rs
msgid "Foreign key name is required."
msgstr "Cần nhập tên khóa ngoại."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Foreign key {name} needs as many referenced columns as source columns."
msgstr "Khóa ngoại {name} cần có số cột được tham chiếu bằng số cột nguồn."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Fix the highlighted fields first."
msgstr "Hãy sửa các trường được tô sáng trước."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "Column {column} can't be changed this way. {reason}"
msgstr "Không thể thay đổi cột {column} theo cách này. {reason}"

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"A NOT NULL column needs a default here, since the rows already in the table "
"need a value."
msgstr ""
"Cột NOT NULL cần có giá trị mặc định ở đây, vì các dòng đã có trong bảng cần "
"một giá trị."

#: crates/app/src/ui/error_text/ddl.rs
msgid "This database has no column defaults."
msgstr "Cơ sở dữ liệu này không có giá trị mặc định cho cột."

#: crates/app/src/ui/error_text/ddl.rs
msgid "This database can make only primary key columns NOT NULL."
msgstr "Cơ sở dữ liệu này chỉ cho phép đặt NOT NULL cho cột khóa chính."

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"This database can't change this table's character set, collation or next "
"auto increment value."
msgstr ""
"Cơ sở dữ liệu này không cho phép đổi bộ ký tự, đối chiếu hoặc giá trị tự "
"động tăng tiếp theo của bảng."

#: crates/app/src/ui/error_text/ddl.rs
msgid "This database can't change a column's character set or collation."
msgstr "Cơ sở dữ liệu này không cho phép đổi bộ ký tự hoặc đối chiếu của cột."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "The type of column {column} can't be used. {reason}"
msgstr "Không dùng được kiểu của cột {column}. {reason}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "The default of column {column} can't be written as SQL. {reason}"
msgstr "Không thể viết giá trị mặc định của cột {column} thành SQL. {reason}"

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "The database didn't report the type of column {column}."
msgstr "Cơ sở dữ liệu không trả về kiểu của cột {column}."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "This database doesn't take {action} on a foreign key."
msgstr "Cơ sở dữ liệu này không hỗ trợ {action} trên khóa ngoại."

#: crates/app/src/ui/error_text/ddl.rs
msgid "The database gave no CREATE statement for this table."
msgstr "Cơ sở dữ liệu không trả về câu lệnh CREATE cho bảng này."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"The table can't be rebuilt: the stored statement of {name}, which uses it, "
"can't be run again."
msgstr ""
"Không thể dựng lại bảng: câu lệnh đã lưu của {name}, đối tượng dùng bảng "
"này, không thể chạy lại."

#: crates/app/src/ui/error_text/ddl.rs
msgid ""
"The changes were edited or the connection changed during the review, so "
"nothing was saved. Save again to review them."
msgstr ""
"Các thay đổi đã bị sửa hoặc kết nối đã thay đổi trong lúc xem lại, nên chưa "
"có gì được lưu. Hãy lưu lại để xem lại chúng."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Enter a name."
msgstr "Nhập tên."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid ""
"“{name}” is longer than this server keeps a name, or holds a character it "
"refuses."
msgstr ""
"“{name}” dài hơn giới hạn tên của máy chủ hoặc chứa ký tự máy chủ từ chối."

#: crates/app/src/ui/error_text/ddl.rs
msgid "Enter the name of the first collection."
msgstr "Nhập tên collection đầu tiên."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "This database takes no {option} for a new database."
msgstr "Cơ sở dữ liệu này không chấp nhận {option} cho cơ sở dữ liệu mới."

#: crates/app/src/ui/error_text/ddl.rs
#, rust-format
msgid "“{value}” is not a {option} this database takes."
msgstr "“{value}” không phải {option} mà cơ sở dữ liệu này chấp nhận."

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "name"
msgstr "tên"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "owner"
msgstr "chủ sở hữu"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "template"
msgstr "mẫu"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "encoding"
msgstr "bảng mã"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "locale"
msgstr "thiết lập vùng"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "character set"
msgstr "bộ ký tự"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "collation"
msgstr "đối chiếu"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "cluster"
msgstr "cụm"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "data centre"
msgstr "trung tâm dữ liệu"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "replication factor"
msgstr "hệ số sao chép"

#: crates/app/src/ui/error_text/ddl.rs
msgctxt "database option"
msgid "collection"
msgstr "collection"

#: crates/app/src/ui/error_text/driver.rs crates/app/src/ui/error_text/tls.rs
msgid "The secure connection failed."
msgstr "Kết nối bảo mật thất bại."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server refused the request."
msgstr "Máy chủ đã từ chối yêu cầu."

#: crates/app/src/ui/error_text/driver.rs
msgid "The connection was closed. Try reconnecting."
msgstr "Kết nối đã bị đóng. Hãy thử kết nối lại."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"The server has no room for another connection right now. Try again shortly."
msgstr "Máy chủ hiện không còn chỗ cho thêm kết nối. Hãy thử lại sau ít phút."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"Another program, or an editor tab with an open transaction, holds a lock on "
"this database file. Try again when it has finished."
msgstr ""
"Một chương trình khác, hoặc một tab trình soạn thảo có giao dịch đang mở, "
"đang khóa tệp cơ sở dữ liệu này. Hãy thử lại khi nó đã xong."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This tab is still running a statement. Stop it or wait for it to finish."
msgstr "Tab này vẫn đang chạy một câu lệnh. Hãy dừng nó hoặc chờ nó chạy xong."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The database “{database}” does not exist on the server."
msgstr "Cơ sở dữ liệu “{database}” không tồn tại trên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid "The connection settings cannot be used."
msgstr "Không dùng được cài đặt kết nối này."

#: crates/app/src/ui/error_text/driver.rs
msgid "Enter the server's host name."
msgstr "Nhập tên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid "The host name has spaces or control characters in it."
msgstr "Tên máy chủ có chứa dấu cách hoặc ký tự điều khiển."

#: crates/app/src/ui/error_text/driver.rs
msgid "The port must be a number from 1 to 65535."
msgstr "Cổng phải là một số từ 1 đến 65535."

#: crates/app/src/ui/error_text/driver.rs
msgid "Use a full path, starting with /."
msgstr "Hãy dùng đường dẫn đầy đủ, bắt đầu bằng /."

#: crates/app/src/ui/error_text/driver.rs
msgid "This database does not offer that TLS mode."
msgstr "Cơ sở dữ liệu này không có chế độ TLS đó."

#: crates/app/src/ui/error_text/driver.rs
msgid "A CA certificate needs Verify full and a database that accepts one."
msgstr ""
"Chứng chỉ CA cần chế độ Xác minh đầy đủ và một cơ sở dữ liệu chấp nhận nó."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"A client certificate needs TLS turned on and a database that accepts one."
msgstr "Chứng chỉ máy khách cần bật TLS và một cơ sở dữ liệu chấp nhận nó."

#: crates/app/src/ui/error_text/driver.rs
msgid "A client certificate needs both its certificate file and its key file."
msgstr "Chứng chỉ máy khách cần cả tệp chứng chỉ lẫn tệp khóa."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The CA certificate {path} cannot be used: {problem}"
msgstr "Không dùng được chứng chỉ CA {path}: {problem}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The client certificate {path} cannot be used: {problem}"
msgstr "Không dùng được chứng chỉ máy khách {path}: {problem}"

#: crates/app/src/ui/error_text/driver.rs
msgid "The TLS server name is not a valid host name or IP address."
msgstr "Tên máy chủ TLS không phải là tên máy chủ hay địa chỉ IP hợp lệ."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This database cannot check the certificate against another server name here."
msgstr ""
"Cơ sở dữ liệu này không thể đối chiếu chứng chỉ với một tên máy chủ khác ở "
"đây."

#: crates/app/src/ui/error_text/driver.rs
msgid "This database does not support that way of logging in."
msgstr "Cơ sở dữ liệu này không hỗ trợ cách đăng nhập đó."

#: crates/app/src/ui/error_text/driver.rs
msgid "Enter the name of the database to open."
msgstr "Nhập tên cơ sở dữ liệu cần mở."

#: crates/app/src/ui/error_text/driver.rs
msgid "Enter the database's number, such as 0, or leave it empty."
msgstr "Nhập số cơ sở dữ liệu, chẳng hạn 0, hoặc để trống."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"A DNS seed list names servers an SSH tunnel cannot reach. Turn it off and "
"enter one server's host."
msgstr ""
"Danh sách seed DNS chỉ định các máy chủ mà đường hầm SSH không truy cập "
"được. Hãy tắt và nhập tên một máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid "This database does not take one of this connection's options."
msgstr "Cơ sở dữ liệu này không chấp nhận một tùy chọn của kết nối."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"A replica set's other members cannot be reached through an SSH tunnel. "
"Remove the other hosts and the replica set, or turn the tunnel off."
msgstr ""
"Không thể truy cập các thành viên khác của replica set qua đường hầm SSH. "
"Hãy bỏ các máy chủ khác và replica set hoặc tắt đường hầm."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"A DNS seed list names the servers itself. Remove the other hosts, or turn "
"the seed list off."
msgstr ""
"Danh sách seed DNS tự chỉ định các máy chủ. Hãy bỏ các máy chủ khác hoặc tắt"
" danh sách seed."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This database does not connect through a socket. Enter the server's host "
"name."
msgstr "Cơ sở dữ liệu này không kết nối qua socket. Hãy nhập tên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"A socket is on this computer, so an SSH tunnel cannot reach it. Turn the "
"tunnel off, or enter the server's host name."
msgstr ""
"Socket nằm trên máy tính này nên đường hầm SSH không truy cập được. Hãy tắt "
"đường hầm hoặc nhập tên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"This connection asks for TLS over a socket on this computer, which takes "
"none. Edit the connection and save it to turn TLS off."
msgstr ""
"Kết nối này yêu cầu TLS qua socket trên máy tính này, nhưng socket không hỗ "
"trợ TLS. Hãy sửa và lưu kết nối để tắt TLS."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "{host}:{port} refused the connection. Is the database running?"
msgstr "{host}:{port} đã từ chối kết nối. Cơ sở dữ liệu có đang chạy không?"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Could not look up {host}."
msgstr "Không tra cứu được {host}."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Could not reach {host}:{port}."
msgstr "Không kết nối tới được {host}:{port}."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server could not be reached."
msgstr "Không kết nối tới được máy chủ."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"No socket is at {path}. The Flatpak sees only the sockets under "
"/run/postgresql and /run/mysqld; connect to 127.0.0.1 for another one."
msgstr ""
"Không có socket tại {path}. Flatpak chỉ thấy socket trong /run/postgresql và"
" /run/mysqld; hãy kết nối đến 127.0.0.1 để dùng socket khác."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"No socket is at {path}. Is the database running, and is this where it puts "
"its socket?"
msgstr ""
"Không có socket tại {path}. Cơ sở dữ liệu có đang chạy và đặt socket ở đây "
"không?"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Nothing is listening on {path}. Is the database running?"
msgstr ""
"Không có dịch vụ nào lắng nghe tại {path}. Cơ sở dữ liệu có đang chạy không?"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"You may not open the socket {path}. Ask for access to it, or connect over "
"the network."
msgstr ""
"Bạn không có quyền mở socket {path}. Hãy xin quyền truy cập hoặc kết nối qua"
" mạng."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Could not connect to the socket {path}: {detail}"
msgstr "Không kết nối được đến socket {path}: {detail}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Username or password is wrong. The server said: {detail}"
msgstr "Tên người dùng hoặc mật khẩu không đúng. Máy chủ báo: {detail}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The server refused this login. The server said: {detail}"
msgstr "Máy chủ đã từ chối lần đăng nhập này. Máy chủ báo: {detail}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"Kerberos login failed: {detail}. Check that klist shows a valid ticket, run "
"kinit if it does not, and make sure the server's SPN matches the host you "
"typed."
msgstr ""
"Đăng nhập Kerberos thất bại: {detail}. Hãy kiểm tra klist có hiện vé hợp lệ "
"không, chạy kinit nếu không có, và đảm bảo SPN của máy chủ khớp với máy chủ "
"bạn đã nhập."

#: crates/app/src/ui/error_text/driver.rs
msgid "Username or password is wrong."
msgstr "Tên người dùng hoặc mật khẩu không đúng."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "The server refused the write: {message}"
msgstr "Máy chủ đã từ chối thao tác ghi: {message}"

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"Safe Mode is Read-Only on this connection. Choose another level in the main "
"menu to make changes."
msgstr ""
"Chế độ an toàn trên kết nối này là Chỉ đọc. Hãy chọn mức khác trong menu "
"chính để thực hiện thay đổi."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Query failed ({code}): {message}"
msgstr "Truy vấn thất bại ({code}): {message}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Query failed: {message}"
msgstr "Truy vấn thất bại: {message}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "Hint: {hint}"
msgstr "Gợi ý: {hint}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "SQLSTATE {code}"
msgstr "SQLSTATE {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "MySQL error {code}"
msgstr "Lỗi MySQL {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "SQL Server error {code}"
msgstr "Lỗi SQL Server {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "ClickHouse code {code}"
msgstr "Mã ClickHouse {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "SQLite error {code}"
msgstr "Lỗi SQLite {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "DuckDB {code} error"
msgstr "Lỗi DuckDB {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "CQL error {code}"
msgstr "Lỗi CQL {code}"

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid "MongoDB error {code}"
msgstr "Lỗi MongoDB {code}"

#: crates/app/src/ui/error_text/driver.rs
msgid "The server took too long to answer."
msgstr "Máy chủ phản hồi quá lâu."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server did not answer the connection in time."
msgstr "Máy chủ không phản hồi kết nối kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server did not finish the login in time."
msgstr "Máy chủ không hoàn tất đăng nhập kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid "The SSH server did not finish the handshake in time."
msgstr "Máy chủ SSH không hoàn tất bắt tay kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid "The SSH server did not open the tunnel to the database in time."
msgstr "Máy chủ SSH không mở đường hầm tới cơ sở dữ liệu kịp thời."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"Another session holds a lock this needs. Try again when it has finished."
msgstr ""
"Một phiên khác đang giữ khóa mà thao tác này cần. Hãy thử lại khi nó đã xong."

#: crates/app/src/ui/error_text/driver.rs
msgid "The statement ran past its time limit, so the server stopped it."
msgstr "Câu lệnh chạy quá giới hạn thời gian, nên máy chủ đã dừng nó."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"The statement ran past its time limit. The server may still be running it."
msgstr "Câu lệnh chạy quá giới hạn thời gian. Máy chủ có thể vẫn đang chạy nó."

#: crates/app/src/ui/error_text/driver.rs
msgid "The server did not answer a check in time."
msgstr "Máy chủ không trả lời lần kiểm tra kịp thời."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"Save failed at statement {n}: {error}. The transaction was rolled back; no "
"rows were changed."
msgstr ""
"Lưu thất bại ở câu lệnh {n}: {error}. Giao dịch đã được rollback; không dòng "
"nào bị thay đổi."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"The save matched {actual} rows where it expected {expected}, so the row is "
"not the one that was loaded. Nothing was changed; reload and try again."
msgstr ""
"Lần lưu khớp {actual} dòng trong khi lẽ ra là {expected}, nên dòng này không "
"phải dòng đã được tải. Chưa có gì thay đổi; hãy tải lại và thử lại."

#: crates/app/src/ui/error_text/driver.rs
#, rust-format
msgid ""
"{applied} of the save's statements were applied before statement {n} failed, "
"and this database has no transaction to undo them. Reload to see what the "
"server has."
msgstr ""
"{applied} câu lệnh của lần lưu đã được áp dụng trước khi câu lệnh {n} thất "
"bại, và cơ sở dữ liệu này không có giao dịch để hoàn tác chúng. Hãy tải lại "
"để xem dữ liệu trên máy chủ."

#: crates/app/src/ui/error_text/driver.rs
msgid ""
"The connection was lost after the save was sent, so whether it was applied "
"is not known. Reload to see what the server has."
msgstr ""
"Kết nối bị mất sau khi gửi lần lưu, nên không biết nó đã được áp dụng hay "
