#: crates/app/src/ui/error_text/secret.rs
msgid ""
"No keyring is running, so saved passwords cannot be read. Start a keyring, "
"or enter the password by hand."
msgstr ""
"Không có chùm khóa nào đang chạy, nên không đọc được các mật khẩu đã lưu. "
"Hãy khởi động một chùm khóa, hoặc nhập mật khẩu bằng tay."

#: crates/app/src/ui/error_text/secret.rs
msgid ""
"The secret portal is unavailable, so saved passwords cannot be read inside "
"the sandbox. Check that xdg-desktop-portal and a keyring are running, or "
"enter the password by hand."
msgstr ""
"Cổng thông tin bí mật (secret portal) không khả dụng, nên không đọc được mật "
"khẩu đã lưu bên trong sandbox. Hãy kiểm tra xdg-desktop-portal và một chùm "
"khóa có đang chạy không, hoặc nhập mật khẩu bằng tay."

#: crates/app/src/ui/error_text/secret.rs
msgid "The keyring is locked. Unlock it and try again."
msgstr "Chùm khóa đang bị khóa. Hãy mở khóa rồi thử lại."

#: crates/app/src/ui/error_text/secret.rs
msgid "The keyring stayed locked because the unlock prompt was dismissed."
msgstr "Chùm khóa vẫn bị khóa vì lời nhắc mở khóa đã bị đóng."

#: crates/app/src/ui/error_text/secret.rs
msgid "The stored password is not readable text. Enter it again to replace it."
msgstr ""
"Mật khẩu đã lưu không phải là văn bản đọc được. Hãy nhập lại để thay thế nó."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid ""
"The OpenSSH client {program} is not installed. Install openssh-client to "
"connect over SSH."
msgstr ""
"Chưa cài trình khách OpenSSH {program}. Hãy cài openssh-client để kết nối "
"qua SSH."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid ""
"TablePro's SSH helper is missing at {program}. Reinstall TablePro to connect "
"over SSH."
msgstr ""
"Không tìm thấy trình trợ giúp SSH của TablePro tại {program}. Hãy cài lại "
"TablePro để kết nối qua SSH."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH host or jump host is not valid: {detail}"
msgstr "Máy chủ SSH hoặc máy chủ trung gian không hợp lệ: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid ""
"ssh refused the configuration. Check ~/.ssh/config for this host: {detail}"
msgstr ""
"ssh đã từ chối cấu hình. Hãy kiểm tra ~/.ssh/config cho máy chủ này: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH configuration file {path} could not be read."
msgstr "Không đọc được tệp cấu hình SSH {path}."

#: crates/app/src/ui/error_text/ssh.rs
msgid ""
"The runtime directory path is too long for an SSH control socket. Use a "
"shorter XDG_RUNTIME_DIR."
msgstr ""
"Đường dẫn thư mục runtime quá dài cho socket điều khiển SSH. Hãy dùng "
"XDG_RUNTIME_DIR ngắn hơn."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH runtime directory {path} cannot be used safely: {detail}"
msgstr "Không thể dùng thư mục runtime SSH {path} một cách an toàn: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid ""
"The host key of {host} changed since it was trusted ({file}, line {line}). "
"This can mean someone is intercepting the connection; check with the "
"server's administrator before removing the old key."
msgstr ""
"Khóa máy chủ của {host} đã thay đổi kể từ khi được tin cậy ({file}, dòng "
"{line}). Điều này có thể có nghĩa là ai đó đang chặn kết nối; hãy hỏi quản "
"trị viên máy chủ trước khi xóa khóa cũ."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The host key of {host} is revoked, so the connection was refused."
msgstr "Khóa máy chủ của {host} đã bị thu hồi, nên kết nối bị từ chối."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid ""
"The SSH server {host} refused the login for {user}. Check the key, the agent "
"or the password."
msgstr ""
"Máy chủ SSH {host} đã từ chối đăng nhập của {user}. Hãy kiểm tra khóa, agent "
"hoặc mật khẩu."

#: crates/app/src/ui/error_text/ssh.rs
msgid "The SSH login was cancelled."
msgstr "Đăng nhập SSH đã bị hủy."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH server would not forward to {target}: {detail}"
msgstr "Máy chủ SSH không chịu chuyển tiếp tới {target}: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH server could not reach {target}."
msgstr "Máy chủ SSH không kết nối tới được {target}."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH server could not reach {target}: {detail}"
msgstr "Máy chủ SSH không kết nối tới được {target}: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
msgid "The SSH connection ended."
msgstr "Kết nối SSH đã kết thúc."

#: crates/app/src/ui/error_text/ssh.rs
#, rust-format
msgid "The SSH connection ended: {detail}"
msgstr "Kết nối SSH đã kết thúc: {detail}"

#: crates/app/src/ui/error_text/ssh.rs
msgid "The SSH connection failed."
msgstr "Kết nối SSH thất bại."

