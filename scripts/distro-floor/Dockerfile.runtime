ARG BASE
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xvfb xauth dbus dbus-x11 dbus-user-session \
    python3 python3-pyatspi at-spi2-core gnome-keyring libsecret-tools \
    scrot libglib2.0-bin fuse3 x11-utils openssh-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
