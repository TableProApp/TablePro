+/**
+ * \ingroup dblib_core
+ * \brief Set the federated authentication access token in a \c LOGINREC structure.
+ *
+ * The token is sent in the LOGIN7 FEDAUTH feature extension instead of a user
+ * name and password, and requires TDS 7.4. It is kept out of \c dbsetlname()
+ * because that caps values at \c TDS_MAX_LOGIN_STR_SZ and dumps them to the log,
+ * neither of which suits a bearer token.
+ *
+ * \param login the \c LOGINREC* to modify.
+ * \param token the access token, which must be ASCII.
+ * \retval SUCCEED the value was set.
+ * \retval FAIL out of memory, or \a login or \a token was invalid.
+ */
+RETCODE
+dbsetlfedauthtoken(LOGINREC * login, const char *token)
+{
+	const unsigned char *p;
+
+	tdsdump_log(TDS_DBG_FUNC, "dbsetlfedauthtoken(%p, [%lu bytes])\n",
+		    login, token ? (unsigned long) strlen(token) : 0UL);
+
+	if (login == NULL) {
+		dbperror(NULL, SYBEASNL, 0);
 		return FAIL;
+	}
+
+	if (token == NULL || *token == '\0') {
+		dbperror(NULL, SYBEASUL, 0);
+		return FAIL;
+	}
+
+	/* the token is widened byte by byte to UTF-16LE, so it has to be ASCII */
+	for (p = (const unsigned char *) token; *p; ++p) {
+		if (*p >= 0x80) {
+			dbperror(NULL, SYBEASUL, 0);
+			return FAIL;
+		}
+	}
+
+	if (!tds_dstr_copy(&login->tds_login->fedauth_token, token))
+		return FAIL;
+	login->tds_login->use_fedauth = 1;
 	return SUCCEED;
 }
 
