{
  "schema_version": 1,
  "layers": {
    "harness": {
      "purpose": "Test the test runners, function-size guard and workflow contracts",
      "prerequisites": "Python 3",
      "hosted_gate": "Linux CI contracts / harness",
      "steps": [
        {
          "argv": [
            "python3",
            "scripts/validate-evidence.py",
            "--strict",
            "docs/evidence/sqlite-numeric-affinity-grid-results-2026-10-06/manifest.json",
            "docs/evidence/sqlite-affinity-check-constraint-results-2026-10-06/manifest.json"
          ],
          "timeout_seconds": 180,
          "evidence": "exit"
        },
        {
          "argv": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "scripts/tests",
            "-p",
            "test_*.py"
          ],
          "timeout_seconds": 180,
          "evidence": "python-tests"
        },
        {
          "argv": [
            "python3",
            "scripts/tests/test_function_size.py"
          ],
          "timeout_seconds": 180,
          "evidence": "exit"
        }
      ]
    },
    "quick": {
      "purpose": "Non-GTK formatting, Clippy, unit and sandbox regressions",
      "prerequisites": "Rust 1.98; native non-GTK development libraries",
      "hosted_gate": "Build Linux / preflight",
      "steps": [
        {
          "argv": [
            "bash",
            "scripts/ci-local.sh",
