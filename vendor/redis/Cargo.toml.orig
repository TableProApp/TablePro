[package]
name = "redis"
version = "1.7.0"
keywords = ["redis", "valkey", "cluster", "sentinel", "pubsub"]
description = "Redis driver for Rust."
repository = "https://github.com/redis-rs/redis-rs"
documentation = "https://docs.rs/redis"
license = "BSD-3-Clause"
edition = "2024"
rust-version = "1.88"
readme = "../README.md"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[lib]
bench = false

[dependencies]
# These two are generally really common simple dependencies so it does not seem
# much of a point to optimize these, but these could in theory be removed for
# an indirection through std::Formatter.
ryu = "1.0"
itoa = "1.0"

# This is a dependency that already exists in url
percent-encoding = "2.3"

# We need this for redis url parsing
url = "2.5"

# We need this for script support
sha1_smol = { version = "1.0", optional = true }

combine = { version = "4.6.8", default-features = false, features = ["std"] }

# Only needed for AIO
bytes = { version = "1", optional = true }
cfg-if = { version = "1", optional = true }
futures-util = { version = "0.3.31", default-features = false, features = [
  "std",
  "sink",
], optional = true }
pin-project-lite = { version = "0.2", optional = true }
tokio-util = { version = "0.7.5", optional = true }
async-lock = { version = "3", optional = true }
tokio = { version = "1", features = ["sync"], optional = true }

# Only needed for the connection manager
arc-swap = { version = "1.9.1", optional = true }
futures-channel = { version = "0.3.31", optional = true }
backon = { version = "1.6.0", optional = true, default-features = false }

# Only needed for the r2d2 feature
r2d2 = { version = "0.8.10", optional = true }

# Only needed for the bb8 feature
bb8 = { version = "0.9.1", optional = true }

# Only needed for cluster
crc16 = { version = "0.4", optional = true }
rand = { version = "0.10", optional = true }

#only needed for smol support
smol = { workspace = true, optional = true }
async-io = { version = "2", optional = true }
smol-timeout = { version = "0.6", optional = true }

# Only needed for native tls
native-tls = { version = "0.2", optional = true }
tokio-native-tls = { version = "0.3", optional = true }
async-native-tls = { version = "0.6", optional = true }

# Only needed for rustls
rustls = { version = "0.23", optional = true, default-features = false }
webpki-roots = { version = "1.0", optional = true }
rustls-native-certs = { version = "0.8", optional = true }
tokio-rustls = { version = "0.26", optional = true, default-features = false }
futures-rustls = { version = "0.26", optional = true, default-features = false }

# Needed for modules Support
serde = { version = "1.0.219", optional = true }
serde_json = { version = "1.0.149", optional = true }

# Only needed for bignum Support
rust_decimal = { version = "1.42.0", optional = true }
bigdecimal = { version = "0.4.10", optional = true }
num-bigint = { version = "0.5.1", optional = true }

# Optional aHash support
ahash = { version = "0.8.11", optional = true }

log = { version = "0.4", optional = true }

# Optional uuid support
uuid = { version = "1.21.0", optional = true }

# Optional hashbrown support
hashbrown = { version = "0.17", optional = true }

# xxhash support for digest utilities
xxhash-rust = { version = "0.8", features = ["xxh3"] }

lru = { version = "0.18", optional = true }
arcstr = "1.2.0"

[target.'cfg(not(target_family = "wasm"))'.dependencies]
socket2 = { version = "0.6", features = ["all"] }

# Only needed for Entra ID authentication
azure_identity = { version = "0.31", optional = true, features = [
  "client_certificate",
] }
azure_core = { version = "0.31", optional = true }
base64 = { version = "0.22.1", optional = true }

[target.'cfg(all(target_os = "wasi", target_env = "p2"))'.dependencies]
tokio = { version = "1.51", features = ["sync"], optional = true }

[features]
default = ["acl", "streams", "geospatial", "script", "num-bigint"]
acl = []
bloom = []
geospatial = []
json = ["dep:serde", "serde/derive", "dep:serde_json"]
vector-sets = ["dep:serde", "serde/derive", "dep:serde_json"]
search_unfinished = []
cluster = ["dep:crc16", "dep:rand"]
script = ["dep:sha1_smol"]
tls-native-tls = ["dep:native-tls"]
tls-rustls = ["dep:rustls", "rustls/std", "dep:rustls-native-certs"]
tls-rustls-insecure = ["tls-rustls"]
tls-rustls-webpki-roots = ["tls-rustls", "dep:webpki-roots"]
smol-comp = ["aio", "dep:smol", "dep:smol-timeout", "dep:async-io"]
smol-native-tls-comp = ["smol-comp", "dep:async-native-tls", "tls-native-tls"]
smol-rustls-comp = ["smol-comp", "dep:futures-rustls", "tls-rustls"]
tokio-comp = ["aio", "tokio/net", "tokio/rt", "tokio/time"]
tokio-native-tls-comp = ["tokio-comp", "tls-native-tls", "dep:tokio-native-tls"]
tokio-rustls-comp = ["tokio-comp", "tls-rustls", "dep:tokio-rustls"]
connection-manager = [
  "dep:arc-swap",
  "dep:futures-channel",
  "aio",
  "dep:backon",
]
streams = []
cluster-async = ["aio", "cluster", "dep:log", "dep:futures-channel"]
sentinel = ["dep:log", "dep:rand"]
num-bigint = ["dep:num-bigint"]
cache-aio = ["aio", "dep:lru"]
r2d2 = ["dep:r2d2"]
bb8 = ["dep:bb8"]
token-based-authentication = ["dep:futures-util", "dep:log", "dep:backon"]
entra-id = [
  "dep:azure_identity",
  "dep:azure_core",
  "dep:base64",
  "token-based-authentication",
  "tokio-comp",
]

# Instead of specifying "aio", use either "tokio-comp" or "smol-comp".
aio = [
  "bytes",
  "dep:pin-project-lite",
  "dep:futures-util",
  "dep:tokio",
  "dep:tokio-util",
  "dep:async-lock",
  "tokio-util/codec",
  "combine/tokio",
  "dep:cfg-if",
]

[dev-dependencies]
async-trait = "0.1"
assert_approx_eq = "1.0"
fnv = "1.0.5"
futures = "0.3"
futures-time = "3"
criterion = "0.8"
partial-io = { version = "0.5", features = ["tokio", "quickcheck1"] }
quickcheck = "1.1.0"
tokio = { workspace = true, features = ["macros", "io-util"] }
tempfile = "3.27.0"
anyhow = "1"
redis-test = { path = "../redis-test" }
rstest = "0.26"
rand = "0.10"
rustls = { version = "0.23", features = ["ring"] }
test-macros = { path = "../test-macros" }
assert_matches = "1.5.0"
env_logger = "0.11.10"
futures-channel = "0.3.31"

[[test]]
name = "test_async"
required-features = ["tokio-comp"]

[[test]]
name = "parser"
required-features = ["aio"]

[[test]]
name = "test_acl"

[[test]]
name = "test_module_bloom"
required-features = ["bloom"]

[[test]]
name = "test_module_json"
required-features = ["json", "serde/derive"]

[[test]]
name = "test_cluster_async"
required-features = ["cluster-async"]

[[test]]
name = "test_bignum"

[[test]]
name = "test_script"
required-features = ["script"]

[[test]]
name = "test_digest_utils"

[[test]]
name = "test_tls_cert_auth"
required-features = ["acl", "tls-rustls", "tokio-rustls-comp", "cluster"]

[[bench]]
name = "bench_basic"
harness = false
required-features = ["tokio-comp"]

[[bench]]
name = "bench_cluster"
harness = false
required-features = ["cluster"]

[[bench]]
name = "bench_cluster_async"
harness = false
required-features = ["cluster-async", "tokio-comp"]

[[bench]]
name = "bench_cache"
harness = false
required-features = ["tokio-comp", "cache-aio"]

[[example]]
name = "async-multiplexed"
required-features = ["tokio-comp"]

[[example]]
name = "acl"
required-features = ["acl"]

[[example]]
name = "async-await"
required-features = ["tokio-comp"]

[[example]]
name = "async-resp2-pub-sub"
required-features = ["tokio-comp"]

[[example]]
name = "async-resp3-pub-sub"
required-features = ["tokio-comp", "connection-manager"]

[[example]]
name = "async-scan"
required-features = ["tokio-comp"]

[[example]]
name = "async-connection-loss"
required-features = ["tokio-comp", "connection-manager"]

[[example]]
name = "bloom"
required-features = ["bloom"]

[[example]]
name = "streams"
required-features = ["streams"]

[[example]]
name = "async-typed"
required-features = ["tokio-comp"]

[[example]]
name = "typed"

[[example]]
name = "async-caching"
required-features = ["tokio-comp", "cache-aio"]

[[example]]
name = "latency-aware-routing"
required-features = ["cluster-async", "tokio-comp"]

[lints]
workspace = true
