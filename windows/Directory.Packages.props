<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below override a vulnerable transitive dependency. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="App">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Drivers">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.20" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="ClickHouse.Client" Version="7.14.0" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageVersion Include="CassandraCSharpDriver" Version="3.23.0" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.109.3" />
    <PackageVersion Include="Snowflake.Data" Version="6.4.0" />
    <PackageVersion Include="Google.Cloud.BigQuery.V2" Version="3.12.0" />
    <PackageVersion Include="Google.Cloud.Spanner.Data" Version="5.12.0" />
    <PackageVersion Include="Teradata.Client.Provider" Version="20.0.10" />
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <!-- SqlClient 7.1.1 brings 9.0.18 transitively, which has GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Data.Odbc" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
    <!-- SqlClient 7 moved Microsoft Entra ID sign-in into this extension. -->
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <!-- Entra tokens for Azure Database for PostgreSQL and MySQL, and the AWS credential chain for RDS IAM tokens. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.101.4" />
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.100.20" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.100.19" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>
