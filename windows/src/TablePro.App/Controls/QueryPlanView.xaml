<UserControl
    x:Class="TablePro.App.Controls.QueryPlanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TablePro.App.Controls">

    <UserControl.Resources>
        <Style x:Key="PlanCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PlanHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <!--  A column the plan cannot fill is zero wide; wrapping would stack its title a letter per line.  -->
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  One outline row: the step, its bar for the chosen metric, then the columns the plan can fill.  -->
        <DataTemplate x:Key="PlanRowTemplate" x:DataType="local:QueryPlanRow">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind AccessibleName}"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                ItemsSource="{x:Bind Children}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="{x:Bind Columns.MagnitudeWidth}" />
                        <ColumnDefinition Width="{x:Bind Columns.CostWidth}" />
                        <ColumnDefinition Width="{x:Bind Columns.RowsWidth}" />
                        <ColumnDefinition Width="{x:Bind Columns.TimeWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Symbol"
                            FontSize="10"
                            Foreground="{x:Bind SeverityBrush}"
                            Text="{x:Bind SeverityGlyph}"
                            ToolTipService.ToolTip="{x:Bind SeverityLabel}"
                            Visibility="{x:Bind HasSeverity}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run FontWeight="SemiBold" Text="{x:Bind Operation}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Target}" />
                        </TextBlock>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="{x:Bind HasWarnings}">
                            <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                            <TextBlock FontSize="11" Text="{x:Bind WarningText}" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        Grid.Column="1"
                        ColumnSpacing="8"
                        Visibility="{x:Bind HasBar, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Height="6"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                            CornerRadius="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind BarFill, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind BarRest, Mode=OneWay}" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{x:Bind BarBrush, Mode=OneWay}" CornerRadius="3" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind BarText, Mode=OneWay}"
                            TextAlignment="Right" />
                    </Grid>
                    <TextBlock Grid.Column="2" Style="{StaticResource PlanCellStyle}" Text="{x:Bind CostText}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource PlanCellStyle}" Text="{x:Bind RowsText}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource PlanCellStyle}" Text="{x:Bind TimeText}" />
                </Grid>
            </TreeViewItem>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid Padding="4,0,8,0" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Uid="/Plan/Modes" x:Name="Modes" SelectionChanged="OnModeChanged">
                <SelectorBarItem x:Uid="/Plan/DiagramMode" x:Name="DiagramMode" />
                <SelectorBarItem x:Uid="/Plan/TreeMode" x:Name="TreeMode" />
                <SelectorBarItem x:Uid="/Plan/RawMode" x:Name="RawMode" />
                <SelectorBarItem x:Uid="/Plan/CompareMode" x:Name="CompareMode" />
            </SelectorBar>
            <ComboBox
                x:Uid="/Plan/MetricBox"
                x:Name="MetricBox"
                Grid.Column="1"
                MinWidth="140"
                VerticalAlignment="Center"
                SelectionChanged="OnMetricChanged" />
            <TextBlock x:Name="Timings" Grid.Column="2" Style="{StaticResource StatusTextStyle}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <StackPanel x:Name="ZoomButtons" Orientation="Horizontal" Spacing="2">
                    <Button x:Uid="/Plan/ZoomOutButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnZoomOut">
                        <FontIcon FontSize="14" Glyph="&#xE71F;" />
                    </Button>
                    <Button x:Uid="/Plan/ZoomInButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnZoomIn">
                        <FontIcon FontSize="14" Glyph="&#xE8A3;" />
                    </Button>
                    <Button x:Uid="/Plan/FitButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnFit">
                        <FontIcon FontSize="14" Glyph="&#xE9A6;" />
                    </Button>
                    <AppBarSeparator />
                </StackPanel>
                <Button x:Uid="/Plan/CopyButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnCopy">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Uid="/Plan/UnparsedBar"
            x:Name="UnparsedBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="SplitterColumn" Width="8" />
                <ColumnDefinition x:Name="DetailColumn" Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <local:QueryPlanDiagram x:Name="Diagram" />

            <Grid x:Name="TreeHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  The header shares the rows' column widths; the right margin matches the item's own padding.  -->
                <Grid x:Name="TreeHeader" Padding="16,6,8,6" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="MagnitudeHeaderColumn" />
                        <ColumnDefinition x:Name="CostHeaderColumn" />
                        <ColumnDefinition x:Name="RowsHeaderColumn" />
                        <ColumnDefinition x:Name="TimeHeaderColumn" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="/Plan/OperationHeader" Style="{StaticResource PlanHeaderStyle}" TextAlignment="Left" />
                    <TextBlock x:Name="MagnitudeHeader" Grid.Column="1" Style="{StaticResource PlanHeaderStyle}" TextAlignment="Left" />
                    <TextBlock x:Uid="/Plan/CostHeader" Grid.Column="2" Style="{StaticResource PlanHeaderStyle}" />
                    <TextBlock x:Uid="/Plan/RowsHeader" x:Name="RowsHeader" Grid.Column="3" Style="{StaticResource PlanHeaderStyle}" />
                    <TextBlock x:Uid="/Plan/ActualTimeHeader" Grid.Column="4" Style="{StaticResource PlanHeaderStyle}" />
                </Grid>
                <TreeView
                    x:Uid="/Plan/Tree"
                    x:Name="Tree"
                    Grid.Row="1"
                    ItemTemplate="{StaticResource PlanRowTemplate}"
                    ItemInvoked="OnTreeItemInvoked"
                    SelectionChanged="OnTreeSelectionChanged"
                    SelectionMode="Single" />
            </Grid>

            <TextBox
                x:Uid="/Plan/RawText"
                x:Name="RawText"
                Visibility="Collapsed"
                AcceptsReturn="True"
                BorderThickness="0"
                FontFamily="{StaticResource CodeFontFamily}"
                FontSize="12"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap" />

            <local:QueryPlanComparisonView x:Name="Comparison" Visibility="Collapsed" />

            <local:PaneSplitter x:Name="Splitter" Grid.Column="1" Orientation="Vertical" TargetIndex="2" Invert="True" />
            <Border x:Name="DetailHost" Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <local:QueryPlanDetailPane x:Name="Details" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
