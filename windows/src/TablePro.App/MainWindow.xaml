<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TablePro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="AppTitleBar"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <MenuBar x:Name="AppMenuBar" Grid.Row="1" AutomationProperties.AutomationId="AppMenuBar">
            <MenuBarItem x:Uid="FileMenu" x:Name="FileMenu">
                <MenuFlyoutItem x:Uid="MenuNewConnection" x:Name="MenuNewConnection" Click="OnNewConnection">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuOpenFile" x:Name="MenuOpenFile" Click="OnOpenFile">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Uid="MenuOpenRecent" x:Name="MenuOpenRecent" />
                <MenuFlyoutItem x:Uid="MenuImport" x:Name="MenuImport" Click="OnImport">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Import" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="ImportAppMenu" x:Name="MenuImportFromApp" AutomationProperties.AutomationId="MenuImportFromApp" Click="OnImportFromApp" />
                <MenuFlyoutItem x:Uid="MenuExportConnections" x:Name="MenuExportConnections" Click="OnExportConnections" />
                <!-- The Connections page's switcher, here for the keyboard and for a window with no Connections page. -->
                <MenuFlyoutSubItem x:Uid="MenuProject" x:Name="MenuProject" AutomationProperties.AutomationId="MenuProject" />
                <MenuFlyoutSeparator />
                <!-- The command palette. Its key and label come from the keymap in code, like the managed items below. -->
                <MenuFlyoutItem x:Uid="MenuCommandPalette" x:Name="MenuCommandPalette" AutomationProperties.AutomationId="MenuCommandPalette" Click="OnCommandPalette" />
                <MenuFlyoutItem x:Uid="MenuNewQueryTab" x:Name="MenuNewQueryTab" Click="OnNewQueryTab" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuCloseTab" x:Name="MenuCloseTab" Click="OnCloseTab" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuReopenTab" x:Name="MenuReopenTab" Click="OnReopenTab" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuMoveTab" x:Name="MenuMoveTab" Click="OnMoveTab" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="NewWindow" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <!-- The keymap gives the managed items their keys and labels in code (docs/decisions/0025), so one press never runs twice. -->
                <MenuFlyoutItem x:Uid="MenuSaveChanges" x:Name="MenuSaveChanges" Click="OnSaveChanges" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuSaveAs" x:Name="MenuSaveAs" Click="OnSaveAs" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuDiscardChanges" x:Name="MenuDiscardChanges" Click="OnDiscardChanges" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuExportResults" x:Name="MenuExportResults" Click="OnExportResults" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Download" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuShareResult" x:Name="MenuShareResult" Click="OnShareResult" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Share" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuShareQuery" x:Name="MenuShareQuery" Click="OnShareQuery" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuManageSharedLinks" x:Name="MenuManageSharedLinks" Click="OnManageSharedLinks">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Globe" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuSettings" x:Name="MenuSettings" Click="OnShowSettings">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuExit" x:Name="MenuExit" Click="OnExit" />
            </MenuBarItem>

            <MenuBarItem x:Uid="EditMenu" x:Name="EditMenu">
                <MenuFlyoutItem x:Uid="MenuUndo" x:Name="MenuUndo" Click="OnUndo">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Undo" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuRedo" x:Name="MenuRedo" Click="OnRedo">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Redo" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuCut" x:Name="MenuCut" Click="OnCut">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Cut" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuCopy" x:Name="MenuCopy" Click="OnCopy">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuPaste" x:Name="MenuPaste" Click="OnPaste">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Paste" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuSelectAll" x:Name="MenuSelectAll" Click="OnSelectAll" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuFind" x:Name="MenuFind" Click="OnFind">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Find" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuReplace" x:Name="MenuReplace" Click="OnReplace" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuAddRow" x:Name="MenuAddRow" Click="OnAddRow" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuDuplicateRow" x:Name="MenuDuplicateRow" Click="OnDuplicateRow" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuDeleteRows" x:Name="MenuDeleteRows" Click="OnDeleteRows" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Uid="ViewMenu" x:Name="ViewMenu">
                <MenuFlyoutItem x:Uid="MenuShowConnections" x:Name="MenuShowConnections" Click="OnShowConnections">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Home" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Uid="MenuShowObjects" x:Name="MenuShowObjects" IsChecked="True" Click="OnToggleObjects" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuFilterObjects" x:Name="MenuFilterObjects" Click="OnFilterObjects" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Uid="MenuShowHistory" x:Name="MenuShowHistory" Click="OnToggleHistory" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Uid="MenuShowSavedQueries" x:Name="MenuShowSavedQueries" Click="OnToggleSavedQueries" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Uid="MenuShowAssistant" x:Name="MenuShowAssistant" Click="OnToggleAssistant" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Uid="MenuWrapText" x:Name="MenuWrapText" Click="OnToggleWrapText" IsEnabled="False" />
            </MenuBarItem>

            <MenuBarItem x:Uid="DatabaseMenu" x:Name="DatabaseMenu">
                <MenuFlyoutItem x:Uid="MenuRefresh" x:Name="MenuRefresh" Click="OnRefresh" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuSwitchDatabase" x:Name="MenuSwitchDatabase" Click="OnSwitchDatabase" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE1D3;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuNewDatabase" x:Name="MenuNewDatabase" Click="OnNewDatabase" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuNewSchema" x:Name="MenuNewSchema" Click="OnNewSchema" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuEditConnection" x:Name="MenuEditConnection" Click="OnEditConnection" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuReconnect" x:Name="MenuReconnect" Click="OnReconnect" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuDisconnect" x:Name="MenuDisconnect" Click="OnDisconnect" IsEnabled="False" />
            </MenuBarItem>

            <MenuBarItem x:Uid="QueryMenu" x:Name="QueryMenu">
                <MenuFlyoutItem x:Uid="MenuRun" x:Name="MenuRun" Click="OnRun" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuRunStatement" x:Name="MenuRunStatement" Click="OnRunStatement" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuStop" x:Name="MenuStop" Click="OnStop" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Stop" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuFormatQuery" x:Name="MenuFormatQuery" Click="OnFormatQuery" IsEnabled="False" />
                <!-- No shortcut: Ctrl+D is the editor's next occurrence. -->
                <MenuFlyoutItem x:Uid="MenuSaveQuery" x:Name="MenuSaveQuery" Click="OnSaveQuery" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuAiReview" x:Name="MenuAiReview" Click="OnAiReview" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuAiExplain" x:Name="MenuAiExplain" Click="OnAiExplain" IsEnabled="False" />
                <MenuFlyoutItem x:Uid="MenuAiOptimize" x:Name="MenuAiOptimize" Click="OnAiOptimize" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuFilterRows" x:Name="MenuFilterRows" Click="OnFilterRows" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Filter" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuPreviewSql" x:Name="MenuPreviewSql" Click="OnPreviewSql" IsEnabled="False">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Preview" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Uid="HelpMenu" x:Name="HelpMenu">
                <MenuFlyoutItem x:Uid="MenuDocumentation" x:Name="MenuDocumentation" Click="OnDocumentation">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Help" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MenuReportIssue" x:Name="MenuReportIssue" Click="OnReportIssue" />
                <MenuFlyoutItem x:Uid="MenuSetupGuide" x:Name="MenuSetupGuide" AutomationProperties.AutomationId="MenuSetupGuide" Click="OnSetupGuide" />
                <MenuFlyoutItem x:Uid="MenuSample" x:Name="MenuSample" AutomationProperties.AutomationId="MenuSample" Click="OnOpenSample" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuCheckForUpdates" AutomationProperties.AutomationId="MenuCheckForUpdates" Click="OnCheckForUpdates" />
                <MenuFlyoutItem x:Uid="MenuAbout" x:Name="MenuAbout" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <StackPanel Grid.Row="2">
            <!-- App-wide news about the app itself: an update to install, or the update that just arrived. -->
            <InfoBar
                x:Name="UpdateBar"
                AutomationProperties.AutomationId="UpdateBar"
                IsOpen="False"
                Severity="Informational"
                Closed="OnUpdateBarClosed" />

            <!-- The license ask: inline, since nothing waits on its answer (docs/decisions/0023-license-ask-and-paid-feature-gate.md). -->
            <InfoBar
                x:Name="LicenseAskBar"
                AutomationProperties.AutomationId="LicenseAskBar"
                IsOpen="False"
                Severity="Informational"
                Closed="OnLicenseAskClosed">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="LicenseAskBuy"
                            AutomationProperties.AutomationId="LicenseAskBuy"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnLicenseAskBuy" />
                        <Button
                            x:Uid="LicenseAskPersonal"
                            AutomationProperties.AutomationId="LicenseAskPersonal"
                            Click="OnLicenseAskPersonal" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <NavigationView
            x:Name="Rail"
            Grid.Row="3"
            AutomationProperties.AutomationId="Rail"
            PaneDisplayMode="LeftCompact"
            IsPaneVisible="False"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnRailSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="HomeItem" x:Name="HomeItem" Tag="home" AutomationProperties.AutomationId="HomeItem">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator x:Name="RailSeparator" />
            </NavigationView.MenuItems>
        </NavigationView>
    </Grid>
</Window>
