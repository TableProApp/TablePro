<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TablePro.App</RootNamespace>
    <AssemblyName>TablePro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <!-- Every trim and AOT warning on its own, not one per assembly, so each is fixed where it starts. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <Version>0.1.0</Version>
    <!-- Unpackaged by default, which the UI tests launch; the MSIX build passes -p:WindowsPackageType=MSIX. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- One sideload package per architecture, every scale in it; the release workflow bundles them (windows/RELEASING.md). -->
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- Program.cs is the entry point, so a second launch on one data folder hands over before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)apple/TablePro/Resources/SampleDatabases/Chinook.sqlite"
             Link="Assets\Samples\Chinook.sqlite"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" />
    <!-- The Toolkit names the metapackage, whose AI, ML, Search, Widgets and DWrite the app never loads (docs/decisions/0005-distribution.md). -->
    <PrunePackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TablePro.App.Model/TablePro.App.Model.csproj" />
    <ProjectReference Include="../TablePro.DataGrid/TablePro.DataGrid.csproj" />
    <ProjectReference Include="../TablePro.Editor/TablePro.Editor.csproj" />
    <ProjectReference Include="../TablePro.Interop/TablePro.Interop.csproj" />
  </ItemGroup>

</Project>
