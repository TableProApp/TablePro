<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.AccountKeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="AccountKeysPage">
        <!-- Left-aligned up to the width Settings uses, as the keyboard shortcuts page lays itself out. -->
        <Grid Margin="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    x:Uid="AccountKeysTitle"
                    Margin="0,0,0,4"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="AccountKeysIntro"
                    Margin="1,0,0,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <InfoBar x:Name="KeysBar" AutomationProperties.AutomationId="KeysBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" />
                <StackPanel x:Name="StateHost" Spacing="{StaticResource SettingsCardSpacing}" />
                <TextBlock
                    x:Uid="KeysResetHeader"
                    x:Name="ResetHeader"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SettingsSectionHeaderStyle}"
                    Visibility="Collapsed" />
                <StackPanel x:Name="ResetHost" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
