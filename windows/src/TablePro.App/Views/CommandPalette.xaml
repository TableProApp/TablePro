<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TablePro.App.Views">

    <Border
        x:Name="Panel"
        Width="640"
        MaxHeight="460"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Resources>
            <DataTemplate x:Key="RowTemplate" x:DataType="views:PaletteRowView">
                <Grid ColumnSpacing="12" Padding="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{x:Bind Glyph}"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Subtitle}"
                            Visibility="{x:Bind SubtitleVisibility}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Border.Resources>

        <Grid Margin="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="Search"
                x:Uid="PaletteSearch"
                AutomationProperties.AutomationId="PaletteSearch"
                TextChanged="OnSearchChanged" />

            <SelectorBar
                x:Name="ScopeBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="PaletteScopes"
                SelectionChanged="OnScopeChanged">
                <SelectorBarItem x:Uid="PaletteScopeAll" x:Name="ScopeAll" AutomationProperties.AutomationId="PaletteScopeAll" IsSelected="True" />
                <SelectorBarItem x:Uid="PaletteScopeTables" x:Name="ScopeTables" AutomationProperties.AutomationId="PaletteScopeTables" />
                <SelectorBarItem x:Uid="PaletteScopeDatabases" x:Name="ScopeDatabases" AutomationProperties.AutomationId="PaletteScopeDatabases" />
                <SelectorBarItem x:Uid="PaletteScopeQueries" x:Name="ScopeQueries" AutomationProperties.AutomationId="PaletteScopeQueries" />
                <SelectorBarItem x:Uid="PaletteScopeConnections" x:Name="ScopeConnections" AutomationProperties.AutomationId="PaletteScopeConnections" />
                <SelectorBarItem x:Uid="PaletteScopeCommands" x:Name="ScopeCommands" AutomationProperties.AutomationId="PaletteScopeCommands" />
            </SelectorBar>

            <ListView
                x:Name="Rows"
                Grid.Row="2"
                AutomationProperties.AutomationId="PaletteResults"
                IsItemClickEnabled="True"
                SelectionMode="Single"
                ItemClick="OnRowClick"
                ItemTemplate="{StaticResource RowTemplate}">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="views:PaletteSection">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Visibility="{x:Bind HeaderVisibility}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <TextBlock
                x:Name="NoResults"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                <TextBlock x:Uid="PaletteHintOpen" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="PaletteHintNewTab" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="PaletteHintScope" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="PaletteHintClose" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
