<UserControl
    x:Class="TablePro.App.Views.DebuggerTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TablePro.App.Controls"
    xmlns:grid="using:TablePro.App.Controls.DataGrid"
    xmlns:vm="using:TablePro.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="CompactListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="12,6,12,4" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="8" />
            <RowDefinition Height="240" MinHeight="80" />
        </Grid.RowDefinitions>

        <!--  The debug commands, with the run's status beside them  -->
        <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Uid="/Debugger/ContinueButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.ContinueCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE768;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>
                <Button x:Uid="/Debugger/StepOverButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.StepOverCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                </Button>
                <Button x:Uid="/Debugger/StepIntoButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.StepIntoCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE74B;" />
                </Button>
                <Button x:Uid="/Debugger/StepOutButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.StepOutCommand}" Visibility="{x:Bind ViewModel.SupportsStepOut, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Button x:Uid="/Debugger/StopButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.StopCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>
                <AppBarSeparator />
                <Button x:Uid="/Debugger/ToggleBreakpointButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.ToggleBreakpointCommand}">
                    <FontIcon FontSize="14" Glyph="&#xEA3B;" />
                </Button>
                <Button x:Uid="/Debugger/RemoveAllBreakpointsButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.RemoveAllBreakpointsCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  The call stack beside the source  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="140" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Uid="/Debugger/CallStackHeader" Style="{StaticResource PaneHeaderStyle}" />
                <ListView
                    x:Name="StackList"
                    x:Uid="/Debugger/StackList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Frames}"
                    SelectionMode="Single"
                    SelectionChanged="OnFrameSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebugFrameItem">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:PaneSplitter Grid.Column="1" Orientation="Vertical" TargetIndex="0" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PaneHeaderStyle}" Text="{x:Bind ViewModel.UnitName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <InfoBar
                    Grid.Row="1"
                    Margin="12,0,12,8"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NotNullConverter}}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
                <ListView
                    x:Name="SourceList"
                    x:Uid="/Debugger/SourceList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Lines}"
                    ItemContainerStyle="{StaticResource CompactListItemStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnSourceLineSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebugSourceLine">
                            <Grid Height="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" MinWidth="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border x:Uid="/Debugger/BreakpointGutter" Background="Transparent" Tapped="OnGutterTapped">
                                    <Grid>
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind HasBreakpoint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon FontSize="10" Glyph="&#xE76C;" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Number}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="12"
                                    Text="{x:Bind Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <controls:PaneSplitter Grid.Row="2" Orientation="Horizontal" TargetIndex="3" Invert="True" />

        <!--  Variables beside the output  -->
        <Grid Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,6,12,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="/Debugger/VariableColumn" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="/Debugger/TypeColumn" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="/Debugger/ValueColumn" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Uid="/Debugger/VariablesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Variables}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebugVariableItem">
                            <Grid ColumnSpacing="8" Padding="0,2" ToolTipService.ToolTip="{x:Bind Kind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:PaneSplitter Grid.Column="1" Orientation="Vertical" TargetIndex="0" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="OutputTabs" SelectionChanged="OnOutputTabChanged">
                    <SelectorBarItem x:Uid="/Debugger/OutputTab" Tag="Output" IsSelected="True" />
                    <SelectorBarItem x:Name="ResultTab" x:Uid="/Debugger/ResultTab" Tag="Result" Visibility="Collapsed" />
                </SelectorBar>
                <TextBox
                    x:Name="OutputBox"
                    x:Uid="/Debugger/OutputBox"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    BorderThickness="0"
                    FontFamily="{StaticResource CodeFontFamily}"
                    FontSize="12"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}" />
                <grid:DataGridView x:Name="ResultGrid" Grid.Row="1" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
