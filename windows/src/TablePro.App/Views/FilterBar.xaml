<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.FilterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Uid="FilterPanel"
        Padding="8"
        AutomationProperties.AutomationId="FilterPanel"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="MessageBar"
            AutomationProperties.AutomationId="FilterMessageBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Error">
            <InfoBar.Content>
                <Button
                    x:Uid="FilterRetryButton"
                    x:Name="RetryButton"
                    Margin="0,0,0,12"
                    AutomationProperties.AutomationId="FilterRetryButton"
                    Click="OnRetry"
                    Visibility="Collapsed" />
            </InfoBar.Content>
        </InfoBar>

        <ProgressRing
            x:Name="LoadingRing"
            x:Uid="FilterLoadingRing"
            Grid.Row="1"
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="FilterLoadingRing"
            IsActive="False"
            Visibility="Collapsed" />

        <StackPanel x:Name="RulesPanel" Grid.Row="1" Spacing="4" />

        <!-- The same columns as a rule row, so the condition lines up with the values above it. -->
        <Grid x:Name="RawSqlRow" Grid.Row="2" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="FilterRawSqlLabel" VerticalAlignment="Center" />
            <TextBox
                x:Uid="FilterRawSql"
                x:Name="RawSqlBox"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                AutomationProperties.AutomationId="FilterRawSql"
                IsSpellCheckEnabled="False"
                KeyDown="OnValueKeyDown"
                TextChanged="OnRawSqlChanged" />
            <Button
                x:Uid="AddFilterRaw"
                Grid.Column="5"
                AutomationProperties.AutomationId="AddFilterRaw"
                Click="OnAddFromRawSql">
                <SymbolIcon Symbol="Add" />
            </Button>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="3" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Shown once two conditions meet, and only where the engine has OR. -->
            <ComboBox
                x:Uid="FilterMatch"
                x:Name="MatchBox"
                AutomationProperties.AutomationId="FilterMatch"
                SelectionChanged="OnMatchChanged"
                Visibility="Collapsed">
                <ComboBoxItem x:Uid="FilterMatchAll" AutomationProperties.AutomationId="FilterMatchAll" />
                <ComboBoxItem x:Uid="FilterMatchAny" AutomationProperties.AutomationId="FilterMatchAny" />
            </ComboBox>
            <Button
                x:Uid="ClearFilterButton"
                x:Name="ClearButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="ClearFilterButton"
                Click="OnClear"
                IsEnabled="False" />
            <Button
                x:Uid="ApplyFilterButton"
                x:Name="ApplyButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="ApplyFilterButton"
                Click="OnApply"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
