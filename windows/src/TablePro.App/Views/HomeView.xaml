<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TablePro.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="HomeTitle"
            Margin="0,0,0,12"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar
                x:Name="HomeCommands"
                x:Uid="HomeCommands"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="HomeCommands"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton x:Uid="NewConnectionButton" x:Name="NewConnectionButton" AutomationProperties.AutomationId="NewConnectionButton" Icon="Add" Click="OnNewConnection" />
                <AppBarButton x:Uid="OpenFileButton" x:Name="OpenFileButton" AutomationProperties.AutomationId="OpenFileButton" Icon="OpenFile" Click="OnOpenFile" />
                <AppBarButton x:Uid="ImportButton" x:Name="ImportButton" AutomationProperties.AutomationId="ImportButton" Icon="Import" Click="OnImport" />
                <AppBarSeparator x:Name="LibrarySeparator" />
                <AppBarButton x:Uid="NewGroupButton" x:Name="NewGroupButton" AutomationProperties.AutomationId="NewGroupButton" Icon="NewFolder" Click="OnNewGroup" />
                <AppBarButton x:Uid="TagsButton" x:Name="TagsButton" AutomationProperties.AutomationId="TagsButton" Icon="Tag">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="TagsMenu" Opening="OnTagsMenuOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarToggleButton x:Uid="SelectButton" x:Name="SelectButton" AutomationProperties.AutomationId="SelectButton" Icon="Bullets" Click="OnSelectMode" />
                <AppBarButton x:Uid="SelectionConnectButton" x:Name="SelectionConnectButton" AutomationProperties.AutomationId="SelectionConnectButton" Icon="Play" Click="OnConnectSelected" Visibility="Collapsed" />
                <AppBarButton x:Uid="SelectionFavoriteButton" x:Name="SelectionFavoriteButton" AutomationProperties.AutomationId="SelectionFavoriteButton" Icon="Favorite" Click="OnFavoriteSelected" Visibility="Collapsed" />
                <AppBarButton x:Uid="SelectionMoveButton" x:Name="SelectionMoveButton" AutomationProperties.AutomationId="SelectionMoveButton" Icon="MoveToFolder" Visibility="Collapsed">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="SelectionMoveMenu" Opening="OnSelectionMoveOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="SelectionDeleteButton" x:Name="SelectionDeleteButton" AutomationProperties.AutomationId="SelectionDeleteButton" Icon="Delete" Click="OnDeleteSelected" Visibility="Collapsed" />
                <AppBarSeparator x:Name="SettingsSeparator" />
                <AppBarButton x:Uid="SettingsButton" x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton" Icon="Setting" Click="OnSettings" />
            </CommandBar>
            <AutoSuggestBox
                x:Uid="LibrarySearch"
                x:Name="LibrarySearch"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LibrarySearch"
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                TextChanged="OnSearchChanged" />
        </Grid>

        <InfoBar
            x:Name="MessageBar"
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="HomeMessageBar"
            IsOpen="False" />

        <ScrollViewer x:Name="GetStarted" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock x:Uid="GetStartedHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="1,0,0,4" />
                <toolkit:SettingsCard x:Uid="NewConnectionCard" x:Name="NewConnectionCard" AutomationProperties.AutomationId="NewConnectionCard" IsClickEnabled="True" Click="OnNewConnection">
                    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Add" /></toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Uid="OpenFileCard" x:Name="OpenFileCard" AutomationProperties.AutomationId="OpenFileCard" IsClickEnabled="True" Click="OnOpenFile">
                    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="OpenFile" /></toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Uid="ImportCard" x:Name="ImportCard" AutomationProperties.AutomationId="ImportCard" IsClickEnabled="True" Click="OnImport">
                    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Import" /></toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard x:Uid="SampleCard" x:Name="SampleCard" AutomationProperties.AutomationId="SampleCard" IsClickEnabled="True" Click="OnSample">
                    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Library" /></toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- The tree starts each drag; its own reorder stays off, and the rows take the drops, so each goes through the
             core. -->
        <TreeView
            x:Name="ConnectionTree"
            x:Uid="ConnectionTree"
            Grid.Row="3"
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="ConnectionTree"
            CanDragItems="True"
            CanReorderItems="False"
            DragItemsCompleted="OnDragItemsCompleted"
            DragItemsStarting="OnDragItemsStarting"
            Collapsed="OnLibraryCollapsed"
            Expanding="OnLibraryExpanding"
            ItemsSource="{x:Bind Items}"
            PreviewKeyDown="OnLibraryKeyDown"
            SelectionChanged="OnLibrarySelectionChanged"
            SelectionMode="Single"
            Visibility="Collapsed">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:LibraryItem">
                    <TreeViewItem
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ContextRequested="OnLibraryContextRequested"
                        DoubleTapped="OnLibraryDoubleTapped"
                        HorizontalContentAlignment="Stretch"
                        Loaded="OnLibraryRowLoaded"
                        ItemsSource="{x:Bind Children}">
                        <Grid
                            Padding="0,4"
                            AllowDrop="{x:Bind AllowDrop}"
                            Background="Transparent"
                            ColumnSpacing="12"
                            DragEnter="OnRowDragOver"
                            DragLeave="OnRowDragLeave"
                            DragOver="OnRowDragOver"
                            Drop="OnRowDrop">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <ContentPresenter Content="{x:Bind Glyph}" />
                            </Viewbox>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Title}"
                                VerticalAlignment="Center"
                                Style="{x:Bind TitleStyle}"
                                Visibility="{x:Bind TitleVisibility, Mode=OneWay}" />
                            <TextBox
                                x:Uid="RenameBox"
                                Grid.Column="1"
                                MinWidth="220"
                                AutomationProperties.AutomationId="RenameBox"
                                KeyDown="OnRenameKeyDown"
                                LostFocus="OnRenameLostFocus"
                                Text="{x:Bind Title}"
                                Visibility="{x:Bind RenameVisibility, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <ItemsRepeater Grid.Column="3" VerticalAlignment="Center" ItemsSource="{x:Bind Tags}" Visibility="{x:Bind TagsVisibility}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:TagChip">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind Fill}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock
            x:Name="NoResultsText"
            x:Uid="NoResultsText"
            Grid.Row="3"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
