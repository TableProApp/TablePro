<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TablePro.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Not a KeyDown handler: an accelerator also fires with the focus on the rail, the title bar or nowhere. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid Padding="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="16">
            <TextBlock
                x:Uid="HomeTitle"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />
            <!-- Its content is the active project's name; the same choices are in File, Project. -->
            <DropDownButton
                x:Name="ProjectSwitcher"
                x:Uid="ProjectSwitcher"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ProjectSwitcher">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="ProjectMenu" Placement="BottomEdgeAlignedLeft" Opening="OnProjectMenuOpening" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar
                x:Name="HomeCommands"
                x:Uid="HomeCommands"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="HomeCommands"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton x:Uid="NewConnectionButton" x:Name="NewConnectionButton" AutomationProperties.AutomationId="NewConnectionButton" Icon="Add" Click="OnNewConnection" />
                <AppBarButton x:Uid="NewFromUrlButton" x:Name="NewFromUrlButton" AutomationProperties.AutomationId="NewFromUrlButton">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71B;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout x:Name="HomeUrlFlyout" Placement="Bottom" Opened="OnHomeUrlFlyoutOpened">
                            <StackPanel Width="440" Spacing="12">
                                <TextBox x:Uid="UrlBox" x:Name="HomeUrlBox" AutomationProperties.AutomationId="HomeUrlBox" KeyDown="OnHomeUrlKeyDown" />
                                <Button x:Uid="UrlContinueButton" x:Name="HomeUrlContinueButton" AutomationProperties.AutomationId="HomeUrlContinueButton" HorizontalAlignment="Right" Click="OnHomeUrlContinue" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="OpenFileButton" x:Name="OpenFileButton" AutomationProperties.AutomationId="OpenFileButton" Icon="OpenFile" Click="OnOpenFile" />
                <AppBarButton x:Uid="ImportButton" x:Name="ImportButton" AutomationProperties.AutomationId="ImportButton" Icon="Import">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="ImportAppFromFile" AutomationProperties.AutomationId="ImportFromFileMenuItem" Click="OnImport" />
                            <MenuFlyoutItem x:Uid="ImportAppFromApp" AutomationProperties.AutomationId="ImportFromAppMenuItem" Click="OnImportFromApp" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="ExportConnectionsButton" x:Name="ExportConnectionsButton" AutomationProperties.AutomationId="ExportConnectionsButton" Click="OnExportConnections">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator x:Name="LibrarySeparator" />
                <AppBarButton x:Uid="NewGroupButton" x:Name="NewGroupButton" AutomationProperties.AutomationId="NewGroupButton" Icon="NewFolder" Click="OnNewGroup" />
                <AppBarButton x:Uid="TagsButton" x:Name="TagsButton" AutomationProperties.AutomationId="TagsButton" Icon="Tag">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="TagsMenu" Opening="OnTagsMenuOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarToggleButton x:Uid="SelectButton" x:Name="SelectButton" AutomationProperties.AutomationId="SelectButton" Icon="Bullets" Click="OnSelectMode" />
                <AppBarButton x:Uid="SelectionConnectButton" x:Name="SelectionConnectButton" AutomationProperties.AutomationId="SelectionConnectButton" Icon="Play" Click="OnConnectSelected" Visibility="Collapsed" />
                <AppBarButton x:Uid="SelectionFavoriteButton" x:Name="SelectionFavoriteButton" AutomationProperties.AutomationId="SelectionFavoriteButton" Icon="Favorite" Click="OnFavoriteSelected" Visibility="Collapsed" />
                <AppBarButton x:Uid="SelectionMoveButton" x:Name="SelectionMoveButton" AutomationProperties.AutomationId="SelectionMoveButton" Icon="MoveToFolder" Visibility="Collapsed">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="SelectionMoveMenu" Opening="OnSelectionMoveOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="SelectionDeleteButton" x:Name="SelectionDeleteButton" AutomationProperties.AutomationId="SelectionDeleteButton" Icon="Delete" Click="OnDeleteSelected" Visibility="Collapsed" />
                <AppBarSeparator x:Name="SettingsSeparator" />
                <AppBarButton x:Uid="SettingsButton" x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton" Icon="Setting" Click="OnSettings" />
            </CommandBar>
            <AutoSuggestBox
                x:Uid="LibrarySearch"
                x:Name="LibrarySearch"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LibrarySearch"
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                TextChanged="OnSearchChanged" />
        </Grid>

        <InfoBar
            x:Name="MessageBar"
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="HomeMessageBar"
            IsOpen="False" />

        <ScrollViewer x:Name="GetStarted" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock x:Uid="GetStartedHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="1,0,0,4" />
                <toolkit:SettingsCard x:Uid="NewConnectionCard" x:Name="NewConnectionCard" AutomationProperties.AutomationId="NewConnectionCard" IsClickEnabled="True" Click="OnNewConnection">
                    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Add" /></toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
                <!-- Importing, a connections file and the sample are the setup guide's steps (core 0057). -->
                <toolkit:SettingsCard x:Uid="SetupGuideCard" x:Name="SetupGuideCard" AutomationProperties.AutomationId="SetupGuideCard" IsClickEnabled="True" Click="OnSetupGuide">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE82D;" /></toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- The rows take the drops instead of the tree's own reorder, so each move goes through the core. -->
        <TreeView
            x:Name="ConnectionTree"
            x:Uid="ConnectionTree"
            Grid.Row="3"
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="ConnectionTree"
            CanDragItems="True"
            CanReorderItems="False"
            DragItemsCompleted="OnDragItemsCompleted"
            DragItemsStarting="OnDragItemsStarting"
            Collapsed="OnLibraryCollapsed"
            Expanding="OnLibraryExpanding"
            ItemsSource="{x:Bind Items}"
            PreviewKeyDown="OnLibraryKeyDown"
            SelectionChanged="OnLibrarySelectionChanged"
            SelectionMode="Single"
            Visibility="Collapsed">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:LibraryItem">
                    <TreeViewItem
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ContextRequested="OnLibraryContextRequested"
                        DoubleTapped="OnLibraryDoubleTapped"
                        HorizontalContentAlignment="Stretch"
                        Loaded="OnLibraryRowLoaded"
                        ItemsSource="{x:Bind Children}">
                        <Grid
                            Padding="0,4"
                            AllowDrop="{x:Bind AllowDrop}"
                            Background="Transparent"
                            ColumnSpacing="12"
                            DragEnter="OnRowDragOver"
                            DragLeave="OnRowDragLeave"
                            DragOver="OnRowDragOver"
                            Drop="OnRowDrop">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <ContentPresenter Content="{x:Bind Glyph}" />
                            </Viewbox>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Title}"
                                VerticalAlignment="Center"
                                Style="{x:Bind TitleStyle}"
                                Visibility="{x:Bind TitleVisibility, Mode=OneWay}" />
                            <TextBox
                                x:Uid="RenameBox"
                                Grid.Column="1"
                                MinWidth="220"
                                AutomationProperties.AutomationId="RenameBox"
                                KeyDown="OnRenameKeyDown"
                                LostFocus="OnRenameLostFocus"
                                Text="{x:Bind Title}"
                                Visibility="{x:Bind RenameVisibility, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <ItemsRepeater Grid.Column="3" VerticalAlignment="Center" ItemsSource="{x:Bind Tags}" Visibility="{x:Bind TagsVisibility}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:TagChip">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind Fill}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel
            x:Name="EmptyProject"
            Grid.Row="3"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="EmptyProjectTitle"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="EmptyProjectTitle"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="EmptyProjectMessage"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Uid="EmptyProjectNewConnection"
                x:Name="EmptyProjectNewConnection"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="EmptyProjectNewConnection"
                Click="OnNewConnection"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,24,0,0" HorizontalAlignment="Center" Spacing="8">
            <TextBlock
                x:Name="NoResultsText"
                x:Uid="NoResultsText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
            <!-- Only inside a project: the rest of the library may hold the match. -->
            <HyperlinkButton
                x:Name="SearchAllConnectionsButton"
                x:Uid="SearchAllConnectionsButton"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="SearchAllConnectionsButton"
                Click="OnSearchAllConnections"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
