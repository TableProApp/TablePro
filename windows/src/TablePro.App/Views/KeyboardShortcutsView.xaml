<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.KeyboardShortcutsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="KeyboardShortcutsPage">
        <!-- Left-aligned up to the width Settings uses, as the setup guide and Settings lay out their pages. -->
        <Grid Margin="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    x:Uid="KeyboardShortcutsTitle"
                    Margin="0,0,0,12"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <toolkit:SettingsCard x:Uid="ShortcutPresetCard" x:Name="PresetCard">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="PresetBox"
                        x:Uid="ShortcutPresetBox"
                        AutomationProperties.AutomationId="ShortcutPresetBox"
                        MinWidth="200"
                        SelectionChanged="OnPresetChanged" />
                </toolkit:SettingsCard>

                <Grid Margin="1,0,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SummaryText"
                        AutomationProperties.AutomationId="ShortcutSummary"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button
                        x:Uid="ShortcutRestoreButton"
                        x:Name="RestoreButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="shortcut-restore-defaults"
                        Click="OnRestore" />
                </Grid>

                <StackPanel x:Name="RowsHost" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
