<UserControl
    x:Class="TablePro.App.Views.QueryTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TablePro.App.Controls"
    xmlns:editor="using:TablePro.App.Controls.Editor"
    xmlns:grid="using:TablePro.App.Controls.DataGrid">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="ResultsRow" Height="320" MinHeight="64" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid Padding="8,6" ColumnSpacing="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <SplitButton x:Name="RunButton" Click="OnRunClicked" ToolTipService.ToolTip="Run the selection or the statement at the caret (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Run Current" Click="OnRunCurrent" KeyboardAcceleratorTextOverride="Ctrl+Enter">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Run All" Click="OnRunAll" KeyboardAcceleratorTextOverride="F5">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Explain" Click="OnExplain" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.StopCommand}" ToolTipService.ToolTip="Stop the running query">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>
                <AppBarSeparator />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnFormat" ToolTipService.ToolTip="Format SQL (Ctrl+Shift+F)">
                    <FontIcon FontSize="14" Glyph="&#xE8E4;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenFile" ToolTipService.ToolTip="Open SQL file">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveFile" ToolTipService.ToolTip="Save SQL file (Ctrl+S)">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveFavorite" ToolTipService.ToolTip="Save as favorite">
                    <FontIcon FontSize="14" Glyph="&#xE734;" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <editor:SqlEditor x:Name="Editor" Grid.Row="1" />

        <controls:PaneSplitter Grid.Row="2" Orientation="Horizontal" TargetIndex="3" Invert="True" />

        <!--  Results  -->
        <Grid Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="4,0,8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="ResultTabs" SelectionChanged="OnResultTabChanged" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultSummary" Style="{StaticResource StatusTextStyle}" Margin="0,0,8,0" />
                    <Button x:Name="ExportButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnExportResult" ToolTipService.ToolTip="Export this result">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                    </Button>
                </StackPanel>
            </Grid>

            <grid:DataGridView x:Name="ResultGrid" Grid.Row="1" />

            <ScrollViewer x:Name="MessagePanel" Grid.Row="1" Visibility="Collapsed" Padding="16,12">
                <StackPanel Spacing="12">
                    <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Title="The statement failed" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <FontIcon FontSize="28" Glyph="&#xE9F9;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Run a query to see results" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Ctrl+Enter runs the statement at the caret, F5 runs everything" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
