<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.QueryTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:TablePro.Editor"
    xmlns:local="using:TablePro.App.Views">

    <Grid>
        <!-- Vim's mode badge, colored by mode as the macOS editor bar colors it. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VimModes">
                <VisualState x:Name="VimNormal" />
                <VisualState x:Name="VimInsert">
                    <VisualState.Setters>
                        <Setter Target="VimBadge.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="VimBadge.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="VimModeText.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VimReplace">
                    <VisualState.Setters>
                        <Setter Target="VimBadge.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="VimModeText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VimVisual">
                    <VisualState.Setters>
                        <Setter Target="VimBadge.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="VimModeText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VimCommand">
                    <VisualState.Setters>
                        <Setter Target="VimBadge.Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="VimModeText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="96" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="96" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="Commands"
            x:Uid="QueryCommands"
            AutomationProperties.AutomationId="QueryCommands"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True"
            VerticalContentAlignment="Center">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Shown while Vim mode is on: the mode, or the command line being typed, then the keys still pending. -->
                    <Border
                        x:Name="VimBadge"
                        Margin="12,0,0,0"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="VimModeText"
                            AutomationProperties.AutomationId="VimMode"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                    <TextBlock
                        x:Name="VimKeysText"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="VimKeys"
                        FontFamily="Cascadia Mono, Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="QueryStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </CommandBar.Content>
            <!-- Shown where the server has more than one database; its label and its menu are set in code. -->
            <AppBarButton
                x:Uid="QueryDatabaseButton"
                x:Name="DatabaseButton"
                AutomationProperties.AutomationId="QueryDatabaseButton"
                Click="OnDatabase"
                Visibility="Collapsed">
                <AppBarButton.Icon><FontIcon Glyph="&#xE1D3;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="RunButton" x:Name="RunButton" AutomationProperties.AutomationId="RunButton" Icon="Play" Click="OnRun" />
            <AppBarButton x:Uid="StopButton" x:Name="StopButton" AutomationProperties.AutomationId="StopButton" Icon="Stop" IsEnabled="False" Click="OnStop" />
            <!-- Shown while the result's rows edit, as a table tab's; Ctrl+S in the grid saves them. -->
            <AppBarSeparator x:Name="EditSeparator" Visibility="Collapsed" />
            <AppBarButton x:Uid="SaveChangesButton" x:Name="SaveChangesButton" AutomationProperties.AutomationId="ResultSaveChangesButton" Icon="Save" IsEnabled="False" Click="OnSaveChanges" Visibility="Collapsed" />
            <AppBarButton x:Uid="DiscardChangesButton" x:Name="DiscardChangesButton" AutomationProperties.AutomationId="ResultDiscardChangesButton" Icon="Undo" IsEnabled="False" Click="OnDiscardChanges" Visibility="Collapsed" />
            <AppBarButton x:Uid="ResultEditPreviewButton" x:Name="PreviewSqlButton" AutomationProperties.AutomationId="ResultPreviewSqlButton" Icon="Preview" IsEnabled="False" Click="OnPreviewSql" Visibility="Collapsed" />
        </CommandBar>

        <editor:SqlEditor x:Name="SqlText" Grid.Row="1" AutomationProperties.AutomationId="SqlEditor" />

        <StackPanel Grid.Row="2">
            <InfoBar
                x:Name="FileBar"
                Margin="8,8,8,0"
                AutomationProperties.AutomationId="FileChangedBar"
                CloseButtonClick="OnFileBarClosed"
                IsOpen="False"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Name="FileBarButton" AutomationProperties.AutomationId="FileBarButton" Click="OnFileBarAction" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The app ended without a close while this tab held a transaction, which the server then rolled back. -->
            <InfoBar
                x:Name="RolledBackBar"
                Margin="8,8,8,0"
                AutomationProperties.AutomationId="RolledBackBar"
                Closed="OnRolledBackBarClosed"
                IsOpen="False"
                Severity="Warning"
                Visibility="Collapsed" />

            <!-- The transaction lives on this tab's own connection, so its bar and its end are here. -->
            <InfoBar
                x:Name="TransactionBar"
                Margin="8,8,8,0"
                AutomationProperties.AutomationId="TransactionBar"
                IsClosable="False"
                IsOpen="False">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="CommitButton"
                            x:Name="CommitButton"
                            AutomationProperties.AutomationId="CommitButton"
                            Click="OnCommit"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="RollBackButton" x:Name="RollBackButton" AutomationProperties.AutomationId="RollBackButton" Click="OnRollBack" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <local:ResultsPane x:Name="Results" Grid.Row="3" />
    </Grid>
</UserControl>
