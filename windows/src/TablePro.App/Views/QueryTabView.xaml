<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.QueryTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:TablePro.Editor"
    xmlns:local="using:TablePro.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="96" />
            <RowDefinition Height="*" MinHeight="96" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="Commands"
            x:Uid="QueryCommands"
            AutomationProperties.AutomationId="QueryCommands"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True"
            VerticalContentAlignment="Center">
            <CommandBar.Content>
                <TextBlock
                    x:Name="StatusText"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="QueryStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </CommandBar.Content>
            <AppBarButton x:Uid="RunButton" x:Name="RunButton" AutomationProperties.AutomationId="RunButton" Icon="Play" Click="OnRun" />
            <AppBarButton x:Uid="StopButton" x:Name="StopButton" AutomationProperties.AutomationId="StopButton" Icon="Stop" IsEnabled="False" Click="OnStop" />
        </CommandBar>

        <editor:SqlEditor x:Name="SqlText" Grid.Row="1" AutomationProperties.AutomationId="SqlEditor" />

        <local:ResultsPane x:Name="Results" Grid.Row="2" />
    </Grid>
</UserControl>
