<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.ResultsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="using:TablePro.DataGrid">

    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ErrorBar"
            Margin="8,8,8,0"
            AutomationProperties.AutomationId="ResultsErrorBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <grid:DataGridView
            x:Name="ResultGrid"
            x:Uid="ResultsGrid"
            Grid.Row="1"
            AutomationProperties.AutomationId="ResultsGrid"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="Placeholder"
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="ResultsPlaceholder"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
