<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.ResultsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ErrorBar"
            Margin="8,8,8,0"
            AutomationProperties.AutomationId="ResultsErrorBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!-- The data grid goes in GridHost (windows/docs/decisions/0004-app-shell.md, Results). -->
        <ContentControl
            x:Name="GridHost"
            x:Uid="GridHost"
            Grid.Row="1"
            AutomationProperties.AutomationId="GridHost"
            HorizontalContentAlignment="Stretch"
            IsTabStop="False"
            VerticalContentAlignment="Stretch" />

        <TextBlock
            x:Name="Placeholder"
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="ResultsSummary"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
