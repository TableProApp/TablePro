<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.ResultsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="using:TablePro.DataGrid">

    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ErrorBar"
            Margin="8,8,8,0"
            AutomationProperties.AutomationId="ResultsErrorBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!-- Only a run the server said something in has more than its results to show. -->
        <SelectorBar
            x:Name="ViewBar"
            x:Uid="ResultsViews"
            Grid.Row="1"
            Margin="4,0"
            AutomationProperties.AutomationId="ResultsViews"
            SelectionChanged="OnViewChanged"
            Visibility="Collapsed">
            <SelectorBarItem
                x:Name="ResultsItem"
                x:Uid="ResultsViewItem"
                AutomationProperties.AutomationId="ResultsViewItem"
                IsSelected="True" />
            <SelectorBarItem
                x:Name="MessagesItem"
                x:Uid="MessagesViewItem"
                AutomationProperties.AutomationId="MessagesViewItem" />
        </SelectorBar>

        <Grid x:Name="ResultsArea" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Only a run with more than one result set has one to pick. -->
            <ComboBox
                x:Name="ResultPicker"
                x:Uid="ResultPicker"
                Margin="8,8,8,4"
                MinWidth="200"
                AutomationProperties.AutomationId="ResultPicker"
                SelectionChanged="OnResultPicked"
                Visibility="Collapsed" />

            <grid:DataGridView
                x:Name="ResultGrid"
                x:Uid="ResultsGrid"
                Grid.Row="1"
                AutomationProperties.AutomationId="ResultsGrid"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="Placeholder"
                Grid.Row="1"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ResultsPlaceholder"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>

        <TextBox
            x:Name="MessagesText"
            x:Uid="ResultsMessages"
            Grid.Row="2"
            Margin="8"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="ResultsMessages"
            FontFamily="Cascadia Mono, Consolas, Courier New"
            IsReadOnly="True"
            IsSpellCheckEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- Data or JSON at the leading edge; the selected cells' figures at the trailing edge, as a spreadsheet's status bar. -->
        <Grid
            x:Name="BottomBar"
            Grid.Row="3"
            Padding="4,0,8,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Uid="ResultModes"
                AutomationProperties.AutomationId="ResultModes"
                SelectionChanged="OnResultModeChanged">
                <SelectorBarItem
                    x:Uid="ResultsDataView"
                    AutomationProperties.AutomationId="ResultsDataView"
                    IsSelected="True" />
                <SelectorBarItem
                    x:Name="JsonModeItem"
                    x:Uid="ResultsJsonView"
                    AutomationProperties.AutomationId="ResultsJsonView" />
            </SelectorBar>
            <DropDownButton
                x:Name="SummaryButton"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SelectionSummary"
                Background="Transparent"
                BorderThickness="0"
                FontSize="12"
                Visibility="Collapsed">
                <DropDownButton.Flyout>
                    <Flyout x:Name="SummaryFlyout" Placement="TopEdgeAlignedRight" Opening="OnSummaryOpening">
                        <Grid x:Name="SummaryFigures" ColumnSpacing="16" RowSpacing="4" AutomationProperties.AutomationId="SummaryFigures" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
    </Grid>
</UserControl>
