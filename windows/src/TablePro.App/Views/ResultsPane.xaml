<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.ResultsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="using:TablePro.DataGrid">

    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ErrorBar"
            Margin="8,8,8,0"
            AutomationProperties.AutomationId="ResultsErrorBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!-- Only a run the server said something in has more than its results to show. -->
        <SelectorBar
            x:Name="ViewBar"
            x:Uid="ResultsViews"
            Grid.Row="1"
            Margin="4,0"
            AutomationProperties.AutomationId="ResultsViews"
            SelectionChanged="OnViewChanged"
            Visibility="Collapsed">
            <SelectorBarItem
                x:Name="ResultsItem"
                x:Uid="ResultsViewItem"
                AutomationProperties.AutomationId="ResultsViewItem"
                IsSelected="True" />
            <SelectorBarItem
                x:Name="MessagesItem"
                x:Uid="MessagesViewItem"
                AutomationProperties.AutomationId="MessagesViewItem" />
        </SelectorBar>

        <Grid x:Name="ResultsArea" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Only a run with more than one result set has one to pick. -->
            <ComboBox
                x:Name="ResultPicker"
                x:Uid="ResultPicker"
                Margin="8,8,8,4"
                MinWidth="200"
                AutomationProperties.AutomationId="ResultPicker"
                SelectionChanged="OnResultPicked"
                Visibility="Collapsed" />

            <grid:DataGridView
                x:Name="ResultGrid"
                x:Uid="ResultsGrid"
                Grid.Row="1"
                AutomationProperties.AutomationId="ResultsGrid"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="Placeholder"
                Grid.Row="1"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ResultsPlaceholder"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>

        <TextBox
            x:Name="MessagesText"
            x:Uid="ResultsMessages"
            Grid.Row="2"
            Margin="8"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="ResultsMessages"
            FontFamily="Cascadia Mono, Consolas, Courier New"
            IsReadOnly="True"
            IsSpellCheckEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
