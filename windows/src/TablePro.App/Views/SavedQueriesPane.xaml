<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.SavedQueriesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TablePro.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Uid="SavedQueriesCommands"
            AutomationProperties.AutomationId="SavedQueriesCommands"
            DefaultLabelPosition="Collapsed"
            OverflowButtonVisibility="Collapsed"
            VerticalContentAlignment="Center">
            <CommandBar.Content>
                <TextBlock
                    x:Uid="SavedQueriesHeader"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </CommandBar.Content>
            <AppBarButton x:Uid="NewSavedFolderButton" x:Name="NewFolderButton" AutomationProperties.AutomationId="NewSavedFolderButton" Icon="NewFolder" Click="OnNewFolder" />
            <AppBarButton x:Uid="CloseSavedQueriesButton" x:Name="CloseSavedQueriesButton" AutomationProperties.AutomationId="CloseSavedQueriesButton" Icon="Cancel" Click="OnClose" />
        </CommandBar>

        <InfoBar
            x:Name="FailureBar"
            Grid.Row="1"
            Margin="8,0,8,4"
            AutomationProperties.AutomationId="SavedQueriesFailureBar"
            Closed="OnFailureBarClosed"
            IsClosable="False"
            IsOpen="False"
            Visibility="Collapsed"
            Severity="Error" />

        <!-- A click opens or closes a folder; double-click or Enter puts a query in the editor. -->
        <TreeView
            x:Name="QueryTree"
            x:Uid="SavedQueriesTree"
            Grid.Row="2"
            AutomationProperties.AutomationId="SavedQueriesTree"
            CanDragItems="False"
            CanReorderItems="False"
            Collapsed="OnFolderCollapsed"
            Expanding="OnFolderExpanding"
            ItemInvoked="OnItemInvoked"
            ItemsSource="{x:Bind Items}"
            PreviewKeyDown="OnTreeKeyDown"
            SelectionMode="Single">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:SavedQueryItem">
                    <TreeViewItem
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ContextRequested="OnRowContextRequested"
                        DoubleTapped="OnRowDoubleTapped"
                        Loaded="OnRowLoaded"
                        ItemsSource="{x:Bind Children}">
                        <Grid Padding="0,6" ColumnSpacing="8" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <SymbolIcon Symbol="{x:Bind Icon}" />
                            </Viewbox>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontFamily="Cascadia Mono, Consolas, Courier New"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                Visibility="{x:Bind DetailVisibility}" />
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock
            x:Name="EmptyText"
            x:Uid="SavedQueriesEmpty"
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="SavedQueriesEmpty"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
