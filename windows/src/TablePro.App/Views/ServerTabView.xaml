<UserControl
    x:Class="TablePro.App.Views.ServerTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="using:TablePro.App.Controls.DataGrid">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="8,4" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Sections" SelectionChanged="OnSectionChanged">
                <SelectorBarItem x:Uid="/Server/SectionActivity" Tag="Activity" IsSelected="True">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE9D9;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Uid="/Server/SectionVariables" Tag="Variables">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Uid="/Server/SectionUsers" Tag="Users">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE716;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <ToggleSwitch x:Uid="/Server/AutoRefreshSwitch" x:Name="AutoRefreshSwitch" IsOn="{x:Bind ViewModel.AutoRefresh, Mode=TwoWay}" MinWidth="0" />
                <Button x:Uid="/Server/RefreshButton" Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>
        <grid:DataGridView x:Name="Grid" Grid.Row="1" />
        <InfoBar Grid.Row="1" VerticalAlignment="Top" Margin="12" Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NotNullConverter}}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
        <ContentControl
            x:Name="UsersHost"
            Grid.Row="1"
            Visibility="Collapsed"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False" />
    </Grid>
</UserControl>
