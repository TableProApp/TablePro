<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="SettingsPage">
        <!-- Left-aligned up to the width the settings guidance gives, as Windows Settings lays out its pages. -->
        <Grid Margin="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock
                x:Uid="SettingsTitle"
                Margin="0,0,0,12"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock x:Uid="AppearanceHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="1,0,0,4" />
            <toolkit:SettingsCard x:Uid="ThemeCard" x:Name="ThemeCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="FontColor" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" x:Uid="ThemeBox" AutomationProperties.AutomationId="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                    <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                    <ComboBoxItem x:Uid="ThemeSystem" Tag="System" />
                </ComboBox>
            </toolkit:SettingsCard>
            <HyperlinkButton x:Uid="WindowsColorSettings" Margin="0,0,0,0" NavigateUri="ms-settings:colors" />

            <TextBlock x:Uid="StartupHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="ReopenCard" x:Name="ReopenCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Refresh" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ReopenSwitch" x:Uid="ReopenSwitch" AutomationProperties.AutomationId="ReopenSwitch" Toggled="OnReopenToggled" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="EditorHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="FontSizeCard" x:Name="FontSizeCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="FontSize" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="FontSizeBox"
                    x:Uid="FontSizeBox"
                    AutomationProperties.AutomationId="FontSizeBox"
                    Maximum="36"
                    Minimum="8"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnFontSizeChanged" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="QueriesHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="RowLimitCard" x:Name="RowLimitCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="List" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="RowLimitBox"
                    x:Uid="RowLimitBox"
                    AutomationProperties.AutomationId="RowLimitBox"
                    LargeChange="1000"
                    Maximum="1000000"
                    Minimum="1"
                    SmallChange="100"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnRowLimitChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="TimeoutCard" x:Name="TimeoutCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="TimeoutBox"
                    x:Uid="TimeoutBox"
                    AutomationProperties.AutomationId="TimeoutBox"
                    Maximum="86400"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnTimeoutChanged" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="DriversHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <InfoBar x:Name="DriversMessage" AutomationProperties.AutomationId="DriversMessage" IsOpen="False" Margin="0,0,0,4" />
            <toolkit:SettingsExpander
                x:Name="InstalledDriversExpander"
                x:Uid="InstalledDriversExpander"
                AutomationProperties.AutomationId="InstalledDrivers"
                IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEA86;" /></toolkit:SettingsExpander.HeaderIcon>
                <Button x:Name="InstallDriverFileButton" x:Uid="InstallDriverFileButton" AutomationProperties.AutomationId="InstallDriverFileButton" Click="OnInstallDriverFile" />
            </toolkit:SettingsExpander>
            <toolkit:SettingsExpander
                x:Name="AvailableDriversExpander"
                x:Uid="AvailableDriversExpander"
                AutomationProperties.AutomationId="AvailableDrivers"
                IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon><SymbolIcon Symbol="Download" /></toolkit:SettingsExpander.HeaderIcon>
                <ProgressRing x:Name="DriversProgress" Width="20" Height="20" IsActive="False" />
            </toolkit:SettingsExpander>

            <TextBlock x:Uid="AboutHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsExpander x:Name="AboutExpander" x:Uid="AboutExpander" AutomationProperties.AutomationId="AboutExpander">
                <toolkit:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Uid="DocumentationCard" IsClickEnabled="True" Click="OnDocumentation">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="ReportIssueCard" IsClickEnabled="True" Click="OnReportIssue">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="DataFolderCard" x:Name="DataFolderCard" IsClickEnabled="True" Click="OnOpenDataFolder">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="OpenLocal" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
