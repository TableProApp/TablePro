<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="SettingsPage">
        <!-- Left-aligned up to the width the settings guidance gives, as Windows Settings lays out its pages. -->
        <Grid Margin="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock
                x:Uid="SettingsTitle"
                Margin="0,0,0,12"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock x:Uid="AccountHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="1,0,0,4" />
            <InfoBar x:Name="AccountBar" AutomationProperties.AutomationId="AccountBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" />
            <toolkit:SettingsCard x:Name="AccountCard" AutomationProperties.AutomationId="AccountCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Contact" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="AccountProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                    <Button x:Name="AccountButton" AutomationProperties.AutomationId="AccountButton" Click="OnAccountButton" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander x:Uid="AccountDetails" x:Name="AccountDetails" AutomationProperties.AutomationId="AccountDetails" Visibility="Collapsed">
                <toolkit:SettingsExpander.HeaderIcon><SymbolIcon Symbol="Refresh" /></toolkit:SettingsExpander.HeaderIcon>
                <Button x:Uid="AccountRefreshButton" x:Name="AccountRefreshButton" AutomationProperties.AutomationId="AccountRefreshButton" Click="OnAccountRefresh" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Uid="ManageAccountCard" IsClickEnabled="True" Click="OnManageAccount">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="ManageSharedLinksCard" IsClickEnabled="True" Click="OnManageSharedLinks">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsExpander x:Uid="DevicesExpander" x:Name="DevicesExpander" AutomationProperties.AutomationId="DevicesExpander" Visibility="Collapsed" Expanded="OnDevicesExpanded">
                <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></toolkit:SettingsExpander.HeaderIcon>
                <ProgressRing x:Name="DevicesProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
            </toolkit:SettingsExpander>

            <TextBlock x:Uid="AppearanceHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="ThemeCard" x:Name="ThemeCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="FontColor" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" x:Uid="ThemeBox" AutomationProperties.AutomationId="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                    <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                    <ComboBoxItem x:Uid="ThemeSystem" Tag="System" />
                </ComboBox>
            </toolkit:SettingsCard>
            <HyperlinkButton x:Uid="WindowsColorSettings" Margin="0,0,0,0" NavigateUri="ms-settings:colors" />

            <TextBlock x:Uid="StartupHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="ReopenCard" x:Name="ReopenCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Refresh" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ReopenSwitch" x:Uid="ReopenSwitch" AutomationProperties.AutomationId="ReopenSwitch" Toggled="OnReopenToggled" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="EditorHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="FontSizeCard" x:Name="FontSizeCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="FontSize" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="FontSizeBox"
                    x:Uid="FontSizeBox"
                    AutomationProperties.AutomationId="FontSizeBox"
                    Maximum="36"
                    Minimum="8"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnFontSizeChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="FontFamilyCard" x:Name="FontFamilyCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Font" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="FontFamilyBox" x:Uid="FontFamilyBox" AutomationProperties.AutomationId="FontFamilyBox" MinWidth="200" SelectionChanged="OnFontFamilyChanged" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="GridHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="GridFontCard" x:Name="GridFontCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Font" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="GridFontBox" x:Uid="GridFontBox" AutomationProperties.AutomationId="GridFontBox" MinWidth="200" SelectionChanged="OnGridFontChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="GridFontSizeCard" x:Name="GridFontSizeCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="FontSize" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="GridFontSizeBox"
                    x:Uid="GridFontSizeBox"
                    AutomationProperties.AutomationId="GridFontSizeBox"
                    Maximum="36"
                    Minimum="8"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnGridFontSizeChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="NullDisplayCard" x:Name="NullDisplayCard">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C4;" /></toolkit:SettingsCard.HeaderIcon>
                <TextBox x:Name="NullDisplayBox" x:Uid="NullDisplayBox" AutomationProperties.AutomationId="NullDisplayBox" MinWidth="200" MaxLength="20" TextChanged="OnNullDisplayChanged" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="QueriesHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="RowLimitCard" x:Name="RowLimitCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="List" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="RowLimitBox"
                    x:Uid="RowLimitBox"
                    AutomationProperties.AutomationId="RowLimitBox"
                    LargeChange="1000"
                    Maximum="1000000"
                    Minimum="1"
                    SmallChange="100"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnRowLimitChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="ResultsKeptCard" x:Name="ResultsKeptCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="ViewAll" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ResultsKeptBox" x:Uid="ResultsKeptBox" AutomationProperties.AutomationId="ResultsKeptBox" MinWidth="200" SelectionChanged="OnResultsKeptChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="TimeoutCard" x:Name="TimeoutCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="TimeoutBox"
                    x:Uid="TimeoutBox"
                    AutomationProperties.AutomationId="TimeoutBox"
                    Maximum="86400"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnTimeoutChanged" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="PaginationHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="PageSizeCard" x:Name="PageSizeCard">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="PageSizeBox" x:Uid="PageSizeBox" AutomationProperties.AutomationId="PageSizeBox" MinWidth="200" SelectionChanged="OnPageSizeChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="CountThresholdCard" x:Name="CountThresholdCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Calculator" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="CountThresholdBox" x:Uid="CountThresholdBox" AutomationProperties.AutomationId="CountThresholdBox" MinWidth="200" SelectionChanged="OnCountThresholdChanged" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="HistoryHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="HistoryRetentionCard" x:Name="HistoryRetentionCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Clock" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="HistoryRetentionBox" x:Uid="HistoryRetentionBox" AutomationProperties.AutomationId="HistoryRetentionBox" MinWidth="200" SelectionChanged="OnHistoryRetentionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="HistoryMaxCard" x:Name="HistoryMaxCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="List" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="HistoryMaxBox" x:Uid="HistoryMaxBox" AutomationProperties.AutomationId="HistoryMaxBox" MinWidth="200" SelectionChanged="OnHistoryMaxChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="ClearHistoryCard" x:Name="ClearHistoryCard">
                <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Delete" /></toolkit:SettingsCard.HeaderIcon>
                <Button x:Uid="ClearHistoryButton" x:Name="ClearHistoryButton" AutomationProperties.AutomationId="ClearHistoryButton" Click="OnClearHistory" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="AboutHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <toolkit:SettingsExpander x:Name="AboutExpander" x:Uid="AboutExpander" AutomationProperties.AutomationId="AboutExpander">
                <toolkit:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Uid="DocumentationCard" IsClickEnabled="True" Click="OnDocumentation">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="ReportIssueCard" IsClickEnabled="True" Click="OnReportIssue">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="Globe" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="DataFolderCard" x:Name="DataFolderCard" IsClickEnabled="True" Click="OnOpenDataFolder">
                        <toolkit:SettingsCard.ActionIcon><SymbolIcon Symbol="OpenLocal" /></toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
