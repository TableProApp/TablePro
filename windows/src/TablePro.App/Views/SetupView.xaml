<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="SetupView">

    <Grid Padding="36,24,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="StepTitle"
            AutomationProperties.AutomationId="SetupTitle"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            x:Name="StepDescription"
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <InfoBar
            x:Name="MessageBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="SetupMessageBar"
            IsOpen="False" />

        <ScrollViewer Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                </Grid.ColumnDefinitions>

                <!-- Cards are the commands here, so the step has no Continue (Win32 wizards, command links). -->
                <StackPanel x:Name="OriginStep" Spacing="{StaticResource SettingsCardSpacing}">
                    <toolkit:SettingsCard x:Uid="SetupOtherAppCard" AutomationProperties.AutomationId="SetupOtherAppCard" IsClickEnabled="True" Click="OnOtherApp">
                        <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Import" /></toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="SetupFileCard" AutomationProperties.AutomationId="SetupFileCard" IsClickEnabled="True" Click="OnImportFile">
                        <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="OpenFile" /></toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="SetupNewCard" AutomationProperties.AutomationId="SetupNewCard" IsClickEnabled="True" Click="OnStartNew">
                        <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Add" /></toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="ImportStep" Spacing="12" Visibility="Collapsed">
                    <StackPanel x:Name="ImportChoose" Spacing="12">
                        <StackPanel x:Name="ImportLooking" Orientation="Horizontal" Spacing="12">
                            <ProgressRing Width="20" Height="20" IsActive="True" />
                            <TextBlock x:Uid="SetupLooking" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Uid="SetupSourcesHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <ListView x:Name="SourceList" AutomationProperties.AutomationId="SetupSources" SelectionMode="None" />
                        <TextBlock x:Name="NoSourcesText" x:Uid="SetupNoSources" Visibility="Collapsed" />
                        <CheckBox x:Name="PasswordsBox" x:Uid="SetupPasswords" AutomationProperties.AutomationId="SetupPasswords" IsChecked="True" />
                        <CheckBox x:Name="QueriesBox" x:Uid="SetupQueries" AutomationProperties.AutomationId="SetupQueries" IsChecked="True" />
                    </StackPanel>
                    <ContentControl
                        x:Name="ImportPanelHost"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="FirstConnectionStep" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Name="NewConnectionChoice" x:Uid="NewConnectionCard" AutomationProperties.AutomationId="SetupNewConnectionCard" IsClickEnabled="True" Click="OnRecordNewConnection">
                        <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Add" /></toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="SampleChoice" x:Uid="SampleCard" AutomationProperties.AutomationId="SetupSampleCard" IsClickEnabled="True" Click="OnRecordSample">
                        <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Library" /></toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="OptionsStep" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                    <toolkit:SettingsCard x:Uid="ThemeCard">
                        <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="FontColor" /></toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeBox" x:Uid="ThemeBox" AutomationProperties.AutomationId="SetupThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged">
                            <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                            <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                            <ComboBoxItem x:Uid="ThemeSystem" Tag="System" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="ShortcutsCard">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ShortcutsBox" x:Uid="ShortcutsBox" AutomationProperties.AutomationId="SetupShortcutsBox" MinWidth="200" SelectionChanged="OnShortcutsChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="VimCard">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="VimSwitch" x:Uid="VimSwitch" AutomationProperties.AutomationId="SetupVimSwitch" Toggled="OnVimToggled" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" x:Uid="SetupSkip" AutomationProperties.AutomationId="SetupSkip" Click="OnSkip" />
            <Button
                x:Name="PrimaryButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="SetupPrimary"
                Click="OnPrimary"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
