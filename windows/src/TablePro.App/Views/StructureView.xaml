<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.StructureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="using:TablePro.DataGrid">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,8,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar
                x:Name="Sections"
                x:Uid="StructureSections"
                AutomationProperties.AutomationId="StructureSections"
                SelectionChanged="OnSectionChanged">
                <SelectorBarItem
                    x:Name="ColumnsItem"
                    x:Uid="StructureColumnsItem"
                    AutomationProperties.AutomationId="StructureColumnsItem"
                    IsSelected="True" />
                <SelectorBarItem
                    x:Name="IndexesItem"
                    x:Uid="StructureIndexesItem"
                    AutomationProperties.AutomationId="StructureIndexesItem" />
                <SelectorBarItem
                    x:Name="ForeignKeysItem"
                    x:Uid="StructureForeignKeysItem"
                    AutomationProperties.AutomationId="StructureForeignKeysItem" />
                <SelectorBarItem
                    x:Name="DdlItem"
                    x:Uid="StructureDdlItem"
                    AutomationProperties.AutomationId="StructureDdlItem" />
            </SelectorBar>

            <Button
                x:Uid="CopyDdlButton"
                x:Name="CopyButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="CopyDdlButton"
                Click="OnCopyDdl"
                Visibility="Collapsed" />
            <Button
                x:Uid="StructureRefreshButton"
                x:Name="RefreshButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StructureRefreshButton"
                Click="OnRefresh">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Margin="8,8,8,0"
            AutomationProperties.AutomationId="StructureErrorBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Error">
            <InfoBar.Content>
                <Button
                    x:Uid="StructureRetryButton"
                    Margin="0,0,0,12"
                    AutomationProperties.AutomationId="StructureRetryButton"
                    Click="OnRetry" />
            </InfoBar.Content>
        </InfoBar>

        <Grid Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ProgressRing
                x:Name="LoadingRing"
                x:Uid="StructureLoadingRing"
                Width="32"
                Height="32"
                AutomationProperties.AutomationId="StructureLoadingRing"
                IsActive="False"
                Visibility="Collapsed" />

            <grid:DataGridView
                x:Name="StructureGrid"
                x:Uid="StructureGrid"
                AutomationProperties.AutomationId="StructureGrid"
                Visibility="Collapsed" />

            <TextBox
                x:Name="DdlText"
                x:Uid="StructureDdl"
                Margin="8"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="StructureDdl"
                FontFamily="Cascadia Mono, Consolas, Courier New"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="EmptyText"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StructureEmpty"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
