<UserControl
    x:Class="TablePro.App.Views.TableTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TablePro.App.ViewModels"
    xmlns:editor="using:TablePro.App.Controls.Editor"
    xmlns:grid="using:TablePro.App.Controls.DataGrid">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4,8,4" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Sections" SelectionChanged="OnSectionChanged">
                <SelectorBarItem Text="Data" Tag="Data" IsSelected="True">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE80A;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Structure" Tag="Structure">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A9;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Definition" Tag="Definition">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE943;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!--  Data  -->
        <Grid x:Name="DataPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True" Background="Transparent">
                <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.LoadCommand}">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="R" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Filter" Label="Filter" Command="{x:Bind ViewModel.AddFilterCommand}" />
                <AppBarSeparator />
                <AppBarButton Icon="Add" Label="Add Row" Command="{x:Bind ViewModel.AddRowCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="I" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Delete" Label="Delete" Click="OnDeleteRows" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
                <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}" LabelPosition="Collapsed">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}" LabelPosition="Collapsed">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Icon="Save" Label="{x:Bind ViewModel.SaveText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}">
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Cancel" Label="Discard" Command="{x:Bind ViewModel.DiscardCommand}" />
                <AppBarSeparator />
                <AppBarButton Label="Export" Click="OnExport">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Import" Click="OnImport" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <!--  Filter strip  -->
            <Grid x:Name="FilterStrip" Grid.Row="1" Padding="12,4,12,8" RowSpacing="6" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Filters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterRuleViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" />
                                <ComboBox Width="180" ItemsSource="{x:Bind Columns}" SelectedItem="{x:Bind ColumnItem, Mode=TwoWay}" />
                                <ComboBox Width="160" ItemsSource="{x:Bind Operators}" SelectedItem="{x:Bind OperatorItem, Mode=TwoWay}" />
                                <TextBox Width="220" PlaceholderText="Value" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnFilterKeyDown" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnRemoveFilter" Tag="{x:Bind}" AutomationProperties.Name="Remove condition" ToolTipService.ToolTip="Remove condition">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Width="420" PlaceholderText="Raw WHERE clause, for example: price &gt; 10 AND status = 'open'" Text="{x:Bind ViewModel.RawWhere, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFontFamily}" KeyDown="OnFilterKeyDown" />
                    <ToggleSwitch OnContent="Match all" OffContent="Match any" IsOn="{x:Bind ViewModel.MatchAllFilters, Mode=TwoWay}" MinWidth="0" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="Apply" Command="{x:Bind ViewModel.ApplyFiltersCommand}" />
                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                    <Button Content="Add Condition" Command="{x:Bind ViewModel.AddFilterCommand}" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ReadOnlyBar" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational" Margin="8,0,8,6" />

            <grid:DataGridView x:Name="RowsGrid" Grid.Row="3" />

            <!--  Pager  -->
            <Grid Grid.Row="4" Padding="12,4" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionText" Style="{StaticResource StatusTextStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.PageText, Mode=OneWay}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.FirstPageCommand}" AutomationProperties.Name="First page" ToolTipService.ToolTip="First page">
                        <FontIcon FontSize="12" Glyph="&#xE892;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}" AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous page">
                        <FontIcon FontSize="12" Glyph="&#xE76B;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}" AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next page">
                        <FontIcon FontSize="12" Glyph="&#xE76C;" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.LastPageCommand}" AutomationProperties.Name="Last page" ToolTipService.ToolTip="Last page">
                        <FontIcon FontSize="12" Glyph="&#xE893;" />
                    </Button>
                    <ComboBox x:Name="PageSizeBox" SelectionChanged="OnPageSizeChanged" MinWidth="96" Margin="6,0,0,0" ToolTipService.ToolTip="Rows per page" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Structure  -->
        <Grid x:Name="StructurePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="StructureSections" SelectionChanged="OnStructureSectionChanged">
                    <SelectorBarItem Text="Columns" Tag="Columns" IsSelected="True" />
                    <SelectorBarItem Text="Indexes" Tag="Indexes" />
                    <SelectorBarItem Text="Foreign Keys" Tag="ForeignKeys" />
                    <SelectorBarItem Text="Triggers" Tag="Triggers" />
                </SelectorBar>
                <CommandBar Grid.Column="1" DefaultLabelPosition="Right" HorizontalAlignment="Right" Background="Transparent">
                    <AppBarButton x:Name="StructureAdd" Icon="Add" Label="Add" Click="OnStructureAdd" />
                    <AppBarButton x:Name="StructureEdit" Icon="Edit" Label="Edit" Click="OnStructureEdit" />
                    <AppBarButton x:Name="StructureDrop" Icon="Delete" Label="Drop" Click="OnStructureDrop" />
                    <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshStructureCommand}" />
                </CommandBar>
            </Grid>
            <grid:DataGridView x:Name="StructureGrid" Grid.Row="1" />
        </Grid>

        <!--  Definition  -->
        <Grid x:Name="DefinitionPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
                <AppBarButton Icon="Copy" Label="Copy" Click="OnCopyDefinition" />
                <AppBarButton Label="Open in Query Tab" Click="OnOpenDefinition">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A7;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <editor:SqlEditor x:Name="DefinitionEditor" Grid.Row="1" />
        </Grid>
    </Grid>
</UserControl>
