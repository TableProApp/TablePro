<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.TeamKeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="TeamKeysPage">
        <!-- Left-aligned up to the width Settings uses, as the end-to-end encryption page lays itself out. -->
        <Grid Margin="36,24,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    x:Uid="TeamKeysTitle"
                    Margin="0,0,0,4"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="TeamKeysIntro"
                    Margin="1,0,0,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <toolkit:SettingsCard x:Uid="TeamOwnWordsCard" AutomationProperties.AutomationId="TeamOwnWordsCard">
                    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D4;" /></toolkit:SettingsCard.HeaderIcon>
                    <Button x:Uid="TeamShowMyWords" AutomationProperties.AutomationId="TeamShowMyWords" Click="OnShowMyWords" />
                </toolkit:SettingsCard>
                <StackPanel x:Name="TeamsHost" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
