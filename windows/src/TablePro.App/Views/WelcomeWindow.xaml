<Window
    x:Class="TablePro.App.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TablePro.App.ViewModels"
    xmlns:views="using:TablePro.App.Views">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="GroupTemplate" x:DataType="vm:ConnectionListItem">
                <TextBlock Text="{x:Bind Title}" Margin="4,14,0,4" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
            </DataTemplate>
            <DataTemplate x:Key="ConnectionTemplate" x:DataType="vm:ConnectionListItem">
                <Grid ColumnSpacing="14" Padding="4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                        <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Fill="{x:Bind views:WelcomeWindow.ColorFor(Profile)}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <views:ConnectionTemplateSelector x:Key="ConnectionSelector" Group="{StaticResource GroupTemplate}" Item="{StaticResource ConnectionTemplate}" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Left: brand and actions, straight on the acrylic backdrop  -->
        <Grid Padding="28,20,24,24" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="28" />
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,24,0,0">
                <Image Source="ms-appx:///Assets/Logo.png" Width="72" Height="72" HorizontalAlignment="Left" />
                <TextBlock Text="TablePro" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,0" />
                <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="6" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnNewConnection" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock x:Uid="/Welcome/NewConnection" />
                    </StackPanel>
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnOpenFile" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        <TextBlock x:Uid="/Welcome/OpenDatabaseFile" />
                    </StackPanel>
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnImport" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                        <TextBlock x:Uid="/Welcome/ImportConnections" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnNewGroup" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                        <TextBlock x:Uid="/Welcome/NewGroup" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <HyperlinkButton x:Uid="/Welcome/Settings" Grid.Row="3" Click="OnSettings" Padding="0" />
        </Grid>

        <!--  Right: saved connections on a Fluent layer  -->
        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid Padding="24,56,24,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Uid="/Welcome/SearchConnections" x:Name="SearchBox" QueryIcon="Find" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                    <ComboBox x:Uid="/Welcome/Sort" Grid.Column="1" x:Name="SortBox" SelectionChanged="OnSortChanged" MinWidth="150">
                        <ComboBoxItem x:Uid="/Welcome/SortManual" />
                        <ComboBoxItem x:Uid="/Welcome/SortName" />
                        <ComboBoxItem x:Uid="/Welcome/SortLastConnected" />
                    </ComboBox>
                </Grid>
                <ListView
                    x:Name="ConnectionList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    ItemTemplateSelector="{StaticResource ConnectionSelector}"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    DoubleTapped="OnConnectionDoubleTapped"
                    RightTapped="OnConnectionRightTapped"
                    KeyDown="OnConnectionKeyDown" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon FontSize="40" Glyph="&#xE968;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Uid="/Welcome/EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="/Welcome/EmptyMessage" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!--  Connecting overlay  -->
                <Border Grid.RowSpan="2" Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="8">
                    <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.ConnectingText, Mode=OneWay}" HorizontalAlignment="Center" />
                            <Button x:Uid="/Welcome/CancelConnect" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CancelConnectCommand}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!--  Drag region across the top; the caption buttons sit over its right end.  -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Height="48" VerticalAlignment="Top" />
    </Grid>
</Window>
