<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TablePro.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <StackPanel
            x:Name="ConnectingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <ProgressRing x:Name="ConnectingRing" IsActive="False" Width="32" Height="32" />
            <TextBlock
                x:Name="ConnectingText"
                AutomationProperties.AutomationId="ConnectingText"
                AutomationProperties.LiveSetting="Polite"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center" />
            <Button
                x:Uid="CancelConnectButton"
                x:Name="CancelConnectButton"
                AutomationProperties.AutomationId="CancelConnectButton"
                HorizontalAlignment="Center"
                Click="OnCancelConnect" />
        </StackPanel>

        <StackPanel
            x:Name="FailedPanel"
            MaxWidth="720"
            Margin="24"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <InfoBar
                x:Name="FailureBar"
                AutomationProperties.AutomationId="FailureBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="RetryButton" x:Name="RetryButton" AutomationProperties.AutomationId="RetryButton" Click="OnRetry" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="EditConnectionButton" x:Name="EditConnectionButton" AutomationProperties.AutomationId="EditConnectionButton" Click="OnEditConnection" />
                        <Button x:Uid="CopyDetailsButton" x:Name="CopyDetailsButton" AutomationProperties.AutomationId="CopyDetailsButton" Click="OnCopyDetails" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ObjectsColumn" Width="280" MinWidth="180" MaxWidth="640" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ObjectsPane"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                SizeChanged="OnObjectsPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Uid="ObjectFilter"
                    x:Name="ObjectFilter"
                    Margin="8,8,8,4"
                    AutomationProperties.AutomationId="ObjectFilter"
                    QueryIcon="Find"
                    TextChanged="OnFilterChanged" />

                <Grid x:Name="ListHeader" Grid.Row="1" Margin="8,0,8,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="BackToTreeButton" x:Name="BackToTreeButton" Click="OnBackToTree">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <TextBlock
                        x:Name="ListHeaderText"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <TreeView
                    x:Name="ObjectTree"
                    x:Uid="ObjectTree"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="ObjectTree"
                    CanDragItems="False"
                    CanReorderItems="False"
                    Expanding="OnTreeExpanding"
                    ItemInvoked="OnTreeItemInvoked"
                    ItemsSource="{x:Bind Objects}"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local:ObjectNode">
                            <TreeViewItem
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ContextRequested="OnObjectRowContextRequested"
                                Loaded="OnObjectRowLoaded"
                                HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                ItemsSource="{x:Bind Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="16" Height="16">
                                        <SymbolIcon Symbol="{x:Bind Icon}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ListView
                    x:Name="ObjectList"
                    x:Uid="ObjectList"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="ObjectList"
                    ContextRequested="OnObjectListContextRequested"
                    IsItemClickEnabled="True"
                    ItemClick="OnObjectListClick"
                    SelectionMode="Single"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ObjectNode">
                            <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Viewbox Width="16" Height="16">
                                    <SymbolIcon Symbol="{x:Bind Icon}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Detail}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="NoMatchesText"
                    Grid.Row="2"
                    Margin="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="HealthBar"
                    Margin="8,8,8,0"
                    AutomationProperties.AutomationId="HealthBar"
                    IsClosable="False"
                    IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Uid="ReconnectButton" x:Name="ReconnectButton" AutomationProperties.AutomationId="ReconnectButton" Click="OnReconnect" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    x:Name="ElsewhereBar"
                    Grid.Row="1"
                    Margin="8,8,8,0"
                    AutomationProperties.AutomationId="TransactionElsewhereBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Uid="ShowTransactionTabButton" x:Name="ShowTransactionTabButton" AutomationProperties.AutomationId="ShowTransactionTabButton" Click="OnShowTransactionTab" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    x:Name="ChangesBar"
                    Grid.Row="2"
                    Margin="8,8,8,0"
                    AutomationProperties.AutomationId="ChangesBar"
                    IsOpen="False"
                    Visibility="Collapsed"
                    Severity="Warning" />

                <!-- Over the tabs, since the user may switch tabs while a file is written. -->
                <InfoBar
                    x:Name="ExportBar"
                    Grid.Row="3"
                    Margin="8,8,8,0"
                    AutomationProperties.AutomationId="ExportBar"
                    Closed="OnExportBarClosed"
                    IsOpen="False"
                    Visibility="Collapsed">
                    <InfoBar.ActionButton>
                        <Button x:Uid="CancelExportButton" x:Name="CancelExportButton" AutomationProperties.AutomationId="CancelExportButton" Click="OnCancelExport" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <ProgressBar x:Name="ExportProgress" x:Uid="ExportProgress" Margin="0,0,0,12" IsIndeterminate="True" />
                    </InfoBar.Content>
                </InfoBar>

                <!-- TabView's style sets VerticalAlignment to Top, which sizes a tab's content to its smallest. -->
                <!-- CanTearOutTabs is set once the strip is on screen and cleared before it leaves (WorkspaceView.Leave). -->
                <TabView
                    x:Name="Tabs"
                    x:Uid="Tabs"
                    Grid.Row="4"
                    AddTabButtonClick="OnAddTab"
                    AutomationProperties.AutomationId="Tabs"
                    CanDragTabs="False"
                    CanReorderTabs="True"
                    ExternalTornOutTabsDropped="OnExternalTornOutTabsDropped"
                    ExternalTornOutTabsDropping="OnExternalTornOutTabsDropping"
                    IsAddTabButtonVisible="True"
                    SelectionChanged="OnTabSelectionChanged"
                    TabCloseRequested="OnTabCloseRequested"
                    TabTearOutRequested="OnTabTearOutRequested"
                    TabTearOutWindowRequested="OnTabTearOutWindowRequested"
                    TabWidthMode="Equal"
                    VerticalAlignment="Stretch" />
            </Grid>

            <!-- Closed by default; View > Show query history or Show saved queries opens one of them beside the tabs. -->
            <Border
                x:Name="SideHost"
                Grid.Column="2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed" />

            <!-- On the next column's left edge, over the pane's border, as the Toolkit's sizers page lays it out. -->
            <toolkit:GridSplitter
                x:Name="ObjectsSplitter"
                x:Uid="ObjectsSplitter"
                Grid.Column="1"
                Width="16"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ObjectsSplitter"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Auto">
                <toolkit:GridSplitter.RenderTransform>
                    <TranslateTransform X="-7" />
                </toolkit:GridSplitter.RenderTransform>
            </toolkit:GridSplitter>
        </Grid>
    </Grid>
</UserControl>
