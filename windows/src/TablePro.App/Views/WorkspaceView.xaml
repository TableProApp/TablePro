<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TablePro.App.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TablePro.App.Views">

    <Grid>
        <StackPanel
            x:Name="ConnectingPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <ProgressRing x:Name="ConnectingRing" IsActive="False" Width="32" Height="32" />
            <TextBlock
                x:Name="ConnectingText"
                AutomationProperties.AutomationId="ConnectingText"
                AutomationProperties.LiveSetting="Polite"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center" />
            <Button
                x:Uid="CancelConnectButton"
                x:Name="CancelConnectButton"
                AutomationProperties.AutomationId="CancelConnectButton"
                HorizontalAlignment="Center"
                Click="OnCancelConnect" />
        </StackPanel>

        <StackPanel
            x:Name="FailedPanel"
            MaxWidth="720"
            Margin="24"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <InfoBar
                x:Name="FailureBar"
                AutomationProperties.AutomationId="FailureBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="RetryButton" x:Name="RetryButton" AutomationProperties.AutomationId="RetryButton" Click="OnRetry" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="EditConnectionButton" x:Name="EditConnectionButton" AutomationProperties.AutomationId="EditConnectionButton" Click="OnEditConnection" />
                        <Button x:Uid="CopyDetailsButton" x:Name="CopyDetailsButton" AutomationProperties.AutomationId="CopyDetailsButton" Click="OnCopyDetails" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ObjectsColumn" Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ObjectsPane"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Uid="ObjectFilter"
                    x:Name="ObjectFilter"
                    Margin="8,8,8,4"
                    AutomationProperties.AutomationId="ObjectFilter"
                    QueryIcon="Find"
                    TextChanged="OnFilterChanged" />

                <Grid x:Name="ListHeader" Grid.Row="1" Margin="8,0,8,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="BackToTreeButton" x:Name="BackToTreeButton" Click="OnBackToTree">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <TextBlock
                        x:Name="ListHeaderText"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <TreeView
                    x:Name="ObjectTree"
                    x:Uid="ObjectTree"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="ObjectTree"
                    CanDragItems="False"
                    CanReorderItems="False"
                    Expanding="OnTreeExpanding"
                    ItemInvoked="OnTreeItemInvoked"
                    ItemsSource="{x:Bind Objects}"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local:ObjectNode">
                            <TreeViewItem
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Loaded="OnObjectRowLoaded"
                                HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                ItemsSource="{x:Bind Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="16" Height="16">
                                        <SymbolIcon Symbol="{x:Bind Icon}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ListView
                    x:Name="ObjectList"
                    x:Uid="ObjectList"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="ObjectList"
                    IsItemClickEnabled="True"
                    ItemClick="OnObjectListClick"
                    SelectionMode="Single"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ObjectNode">
                            <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Viewbox Width="16" Height="16">
                                    <SymbolIcon Symbol="{x:Bind Icon}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Detail}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="NoMatchesText"
                    Grid.Row="2"
                    Margin="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>

            <TabView
                x:Name="Tabs"
                x:Uid="Tabs"
                Grid.Column="1"
                AddTabButtonClick="OnAddTab"
                AutomationProperties.AutomationId="Tabs"
                CanDragTabs="False"
                CanReorderTabs="True"
                IsAddTabButtonVisible="True"
                SelectionChanged="OnTabSelectionChanged"
                TabCloseRequested="OnTabCloseRequested"
                TabWidthMode="Equal" />
        </Grid>
    </Grid>
</UserControl>
