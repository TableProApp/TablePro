<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TableProTargetFramework)</TargetFramework>
    <RootNamespace>TablePro.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- A fully managed Parquet encoder: its Snappy, Zstd and LZ4 codecs are managed ports, so nothing native ships. -->
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>
</Project>
