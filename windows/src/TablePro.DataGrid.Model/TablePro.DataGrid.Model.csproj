<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0 with no WinUI, so its tests run on any machine (windows/docs/decisions/0003-data-grid-control.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TablePro.DataGrid.Model</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.DataGrid.Model.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TablePro.Interop/TablePro.Interop.csproj" />
  </ItemGroup>

</Project>
