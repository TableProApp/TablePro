<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TablePro.DataGrid</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Lets the macOS CI job and a Mac compile the control, as the editor does. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxGeneratePriEnabled Condition="'$(OS)' != 'Windows_NT'">false</AppxGeneratePriEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.DataGrid.Tests" />
    <InternalsVisibleTo Include="TablePro.DataGrid.Gate" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TablePro.DataGrid.Model/TablePro.DataGrid.Model.csproj" />
    <ProjectReference Include="../TablePro.Graphics/TablePro.Graphics.csproj" />
  </ItemGroup>

</Project>
