<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TableProTargetFramework)</TargetFramework>
    <RootNamespace>TablePro.Drivers.Elasticsearch</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TablePro.Core/TablePro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The HTTP and JSON plumbing the search drivers share, compiled into each one since drivers reference only Core. -->
    <Compile Include="../TablePro.Drivers.Search.Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.Drivers.Search.Tests" />
  </ItemGroup>
</Project>
