<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TableProTargetFramework)</TargetFramework>
    <RootNamespace>TablePro.Drivers.SqlServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TablePro.Core/TablePro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- The Authentication keyword's Entra ID modes. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <!-- Lifts the transitive 9.0.18 that SqlClient brings to the patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.Drivers.Tests" />
  </ItemGroup>
</Project>
