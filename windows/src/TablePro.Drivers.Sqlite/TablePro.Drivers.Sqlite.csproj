<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TableProTargetFramework)</TargetFramework>
    <RootNamespace>TablePro.Drivers.Sqlite</RootNamespace>
    <!-- LibraryImport's generated marshalling for LoadLibraryExW, which extension loading uses. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TablePro.Core/TablePro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.Drivers.Sqlite.Tests" />
    <InternalsVisibleTo Include="TablePro.Drivers.Tests" />
  </ItemGroup>
</Project>
