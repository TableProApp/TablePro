<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TablePro.Editor</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Lets the macOS CI job and a Mac compile the control. It has no XAML or resources, so it needs no PRI file. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TablePro.Editor.Model/TablePro.Editor.Model.csproj" />
    <ProjectReference Include="../TablePro.Interop/TablePro.Interop.csproj" />
  </ItemGroup>

</Project>
