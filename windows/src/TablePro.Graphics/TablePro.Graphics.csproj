<Project Sdk="Microsoft.NET.Sdk">

  <!-- One text and drawing stack for every control: Direct3D, Direct2D and DirectWrite through TerraFX. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TablePro.Graphics</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxGeneratePriEnabled Condition="'$(OS)' != 'Windows_NT'">false</AppxGeneratePriEnabled>
  </PropertyGroup>

  <!-- The layer is shared by the controls, not offered to the app. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TablePro.Editor" />
    <InternalsVisibleTo Include="TablePro.DataGrid" />
    <InternalsVisibleTo Include="TablePro.DataGrid.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>

</Project>
