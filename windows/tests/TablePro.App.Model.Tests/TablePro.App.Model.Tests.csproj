<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TablePro.App.Model.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TablePro.App.Model/TablePro.App.Model.csproj" />
  </ItemGroup>

  <!-- LocalizationTests read the app's XAML, code and strings from here. -->
  <ItemGroup>
    <AssemblyMetadata Include="Sources" Value="$(MSBuildThisFileDirectory)../../src" />
  </ItemGroup>

</Project>
