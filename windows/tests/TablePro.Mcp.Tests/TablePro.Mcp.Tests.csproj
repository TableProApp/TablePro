<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TableProTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>TablePro.Mcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- global.json does not opt into the Microsoft.Testing.Platform runner, so dotnet test runs through VSTest. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TablePro.Mcp/TablePro.Mcp.csproj" />
  </ItemGroup>
</Project>
