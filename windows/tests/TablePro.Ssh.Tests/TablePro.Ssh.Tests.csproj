<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TableProTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- global.json does not opt into the Microsoft.Testing.Platform runner, so dotnet test runs through VSTest. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TablePro.Ssh\TablePro.Ssh.csproj" />
    <ProjectReference Include="..\TablePro.Ssh.FakeSsh\TablePro.Ssh.FakeSsh.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
